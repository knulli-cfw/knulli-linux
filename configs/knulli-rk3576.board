include knulli-board.common

# Target definition
BR2_aarch64=y
BR2_cortex_a72_a53=y
BR2_ARM_FPU_NEON_FP_ARMV8=y
BR2_PACKAGE_BATOCERA_TARGET_RK3576=y
BR2_TARGET_OPTIMIZATION="-pipe -fsigned-char -mcpu=cortex-a72+crypto -mtune=cortex-a72"
#BR2_TARGET_GENERIC_GETTY_PORT="tty1"
BR2_TARGET_GENERIC_GETTY_BAUDRATE_115200=y
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_KNULLI_PATH)/board/patches $(BR2_EXTERNAL_KNULLI_PATH)/board/rockchip/patches $(BR2_EXTERNAL_KNULLI_PATH)/board/rockchip/rk3576/patches"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_KNULLI_PATH)/board/fsoverlay $(BR2_EXTERNAL_KNULLI_PATH)/board/rockchip/fsoverlay $(BR2_EXTERNAL_KNULLI_PATH)/board/rockchip/rk3576/fsoverlay"

# Linux headers same as kernel, a BSP 5.10series
BR2_KERNEL_HEADERS_AS_KERNEL=y
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_1=y

# Kernel
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_GIT=y
BR2_LINUX_KERNEL_CUSTOM_REPO_URL="https://github.com/unifreq/linux-6.1.y-rockchip.git"
BR2_LINUX_KERNEL_CUSTOM_REPO_VERSION="1629d4d841456f20b8b4736e9815d4539b0dd0ae"
BR2_LINUX_KERNEL_PATCH="$(BR2_EXTERNAL_BATOCERA_PATH)/board/rockchip/rk3576/linux_patches"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_BATOCERA_PATH)/board/rockchip/rk3576/linux-defconfig.config"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_BATOCERA_PATH)/board/rockchip/rk3576/linux-defconfig-fragment.config"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y

# U-Boot blobs for RK3576 BSP boards
BR2_PACKAGE_UBOOT_RK3576=y

# FIXME: Build the DTB from the kernel sources
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="rockchip/rk3576-evb1-v10-linux"

# Bootloader
#BR2_PACKAGE_UBOOT_RK3588=y

# RG552 Bootloader
# BR2_PACKAGE_ROCKPRO64_BLOBS=y

# System
BR2_TARGET_ROOTFS_SQUASHFS4_ZSTD=y

# GPU - Using proprietary Mali blob via mali-libs package (kernel has no Panfrost support)
BR2_PACKAGE_MALI_LIBS=y
BR2_PACKAGE_MALI_LIBS_PROVIDES_EGL=y
BR2_PACKAGE_MALI_LIBS_PROVIDES_GLES=y
BR2_PACKAGE_MALI_LIBS_PROVIDES_GBM=y

# GTK3 - Force Wayland backend only (no X11/GLX)
BR2_PACKAGE_LIBGTK3_WAYLAND=y
# BR2_PACKAGE_LIBGTK3_X11 is not set
# BR2_PACKAGE_LIBGTK3_BROADWAY is not set

#BR2_PACKAGE_BATOCERA_SWAY=y
BR2_PACKAGE_BATOCERA_WAYLAND=y
BR2_PACKAGE_WESTON=y
BR2_PACKAGE_WESTON_DEFAULT_DRM=y
BR2_PACKAGE_WESTON_DEFAULT_COMPOSITOR="drm"
BR2_PACKAGE_WESTON_DRM=y

# Firmware
BR2_PACKAGE_FIRMWARE_ARMBIAN=y

# choices can be put in _defconfig files only
BR2_PACKAGE_BATOCERA_SPLASH_MPV=y

# Rocknix joypad
#BR2_PACKAGE_ROCKNIX_JOYPAD=y
BR2_PACKAGE_XUTIL_UTIL_MACROS=y

# ADB
BR2_PACKAGE_ANDROID_TOOLS=y
BR2_PACKAGE_ANDROID_TOOLS_ADBD=y
