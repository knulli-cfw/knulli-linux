include knulli-board.common

# Target definition
BR2_aarch64=y
BR2_cortex_a53=y
BR2_ARM_FPU_NEON_FP_ARMV8=y
BR2_PACKAGE_BATOCERA_TARGET_H700=y
BR2_TARGET_OPTIMIZATION="-pipe -fsigned-char -mcpu=cortex-a53 -mtune=cortex-a53"
#BR2_TARGET_GENERIC_GETTY_PORT="tty1"
BR2_TARGET_GENERIC_GETTY_BAUDRATE_115200=y
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_KNULLI_PATH)/board/patches $(BR2_EXTERNAL_KNULLI_PATH)/board/allwinner/patches $(BR2_EXTERNAL_KNULLI_PATH)/board/allwinner/h700/patches"
# fsoverlay-vendor-modules: prebuilt modules for the vendor 4.9 kernel.
# Append it again for devices that still boot the vendor boot.img.
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_KNULLI_PATH)/board/fsoverlay $(BR2_EXTERNAL_KNULLI_PATH)/board/allwinner/h700/fsoverlay"
BR2_TARGET_ROOTFS_SQUASHFS4_ZSTD=y

# batocera splash screen
BR2_PACKAGE_BATOCERA_SPLASH_MPV=y

# Batocera system
BR2_PACKAGE_BATOCERA_KODI20=n
BR2_PACKAGE_MPV=y
# BR2_PACKAGE_LVM2_STANDARD_INSTALL is not set

# Bootloader
#BR2_TARGET_ARM_TRUSTED_FIRMWARE_CUSTOM_VERSION=y
#BR2_TARGET_ARM_TRUSTED_FIRMWARE_CUSTOM_VERSION_VALUE="lts-v2.10.2"
#BR2_TARGET_ARM_TRUSTED_FIRMWARE_PLATFORM="sun50i_h616"
#BR2_TARGET_ARM_TRUSTED_FIRMWARE_IMAGES="bl31.bin"
#BR2_PACKAGE_UBOOT_MULTI_H616=y

# spi flash support
#BR2_PACKAGE_MTD=y

######
# Kernel: orangepi 5.4 sun50iw9 BSP (orange-pi-5.4-sun50iw9, pinned).
# Toolchain headers stay 4.9.
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_GIT=y
BR2_LINUX_KERNEL_CUSTOM_REPO_URL="https://github.com/orangepi-xunlong/linux-orangepi.git"
BR2_LINUX_KERNEL_CUSTOM_REPO_VERSION="3a4a29414d558664847202f4d8919b8ab8bcf4a8"
BR2_LINUX_KERNEL_PATCH="$(BR2_EXTERNAL_KNULLI_PATH)/board/allwinner/h700/linux_patches"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_KNULLI_PATH)/board/allwinner/h700/linux-sunxi64-5.4.config"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="sunxi/sun50i-h700-anbernic-rg28xx sunxi/sun50i-h700-anbernic-rg34xx sunxi/sun50i-h700-anbernic-rg34xx-sp sunxi/sun50i-h700-anbernic-rg35xx-h sunxi/sun50i-h700-anbernic-rg35xx-plus sunxi/sun50i-h700-anbernic-rg35xx-pro sunxi/sun50i-h700-anbernic-rg35xx-sp sunxi/sun50i-h700-anbernic-rg40xx-h sunxi/sun50i-h700-anbernic-rg40xx-v sunxi/sun50i-h700-anbernic-rg-cubexx sunxi/sun50i-h700-anbernic-rg-sp sunxi/sun50i-h700-anbernic-select"
BR2_LINUX_KERNEL_CUSTOM_DTS_PATH="$(BR2_EXTERNAL_KNULLI_PATH)/board/allwinner/h700/dts/*"
BR2_KERNEL_HEADERS_VERSION=y
BR2_PACKAGE_MALI_KBASE_SUNXI=y
BR2_PACKAGE_RTL8821CS=y
# buttons + sticks (analog mux on the gpadc) as one device
BR2_PACKAGE_ROCKNIX_JOYPAD=y
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_4_9=y
BR2_DEFAULT_KERNEL_VERSION="4.9.170"
BR2_DEFAULT_KERNEL_HEADERS="4.9.170"
BR2_TOOLCHAIN_HEADERS_AT_LEAST="4.9"

# H700 uboot packages
BR2_PACKAGE_UBOOT_H700=y

# Filesystem
# BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_MDEV=y
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_MTOOLS=y
BR2_PACKAGE_HOST_UBOOT_TOOLS=y

# FS
BR2_TARGET_ROOTFS_EXT2_3=y
BR2_TARGET_ROOTFS_EXT2_GEN=3
BR2_TARGET_ROOTFS_EXT2_REV=1
BR2_TARGET_ROOTFS_EXT2_LABEL="rootfs"
BR2_TARGET_ROOTFS_EXT2_SIZE="3300M"
BR2_TARGET_ROOTFS_EXT2_INODES=0
BR2_TARGET_ROOTFS_EXT2_RESBLKS=5
BR2_TARGET_ROOTFS_EXT2_MKFS_OPTIONS="-O ^64bit"
BR2_TARGET_ROOTFS_EXT2_NONE=y

BR2_PACKAGE_HAS_LIBMALI=y
BR2_PACKAGE_PROVIDES_LIBMALI="mali-g31-fbdev"
BR2_PACKAGE_MALI_G31_FBDEV=y


# ADB
BR2_PACKAGE_ANDROID_TOOLS=y
BR2_PACKAGE_ANDROID_TOOLS_ADBD=y

# SDL1 
BR2_PACKAGE_SDL=y
BR2_PACKAGE_SDL_FBCON=y
BR2_PACKAGE_SDL_GFX=y
BR2_PACKAGE_SDL_IMAGE=y
BR2_PACKAGE_SDL_IMAGE_BMP=y
BR2_PACKAGE_SDL_IMAGE_JPEG=y
BR2_PACKAGE_SDL_IMAGE_PNG=y
BR2_PACKAGE_SDL_SOUND=y
BR2_PACKAGE_SDL_TTF=y
BR2_PACKAGE_SDL12_COMPAT=y

# GDISK

# MISC
BR2_PACKAGE_DHCPD=y

BR2_PACKAGE_M8C=y

# Libretro cores are NOT compiled by Buildroot.  The gate below turns off every
# "select BR2_PACKAGE_LIBRETRO_*" in knulli-system/Config.in; the cores come
# from the external libretro-super build instead (package/cores/libretro-super).
#
# The DEVICE names which devices/<name>.device file describes this board, and
# that file names the ABI profile it consumes.  Boards sharing a profile share
# the compiled cores: the drop is built once and reused, so only the first
# board on a given ABI pays the compile.
BR2_PACKAGE_KNULLI_EXTERNAL_LIBRETRO_CORES=y
BR2_PACKAGE_LIBRETRO_SUPER_DEVICE="h700"

# Standalone emulators and ports come from the emulators drop, not this build.
BR2_PACKAGE_KNULLI_EXTERNAL_EMULATORS=y
BR2_PACKAGE_IPUTILS=y

# 32-bit (armhf) runtime for the 32-bit emulators this 64-bit image ships.
# Installed from armhf-cache/drop/h700, built by "make h700-armhf-drop".
BR2_PACKAGE_KNULLI_ARMHF_DROP=y
BR2_PACKAGE_KNULLI_ARMHF_DROP_DEVICE="h700"
