include knulli-board.common

# Target definition
BR2_aarch64=y
BR2_cortex_a73_a53=y
BR2_ARM_FPU_NEON_FP_ARMV8=y
BR2_PACKAGE_BATOCERA_TARGET_SM6115=y
BR2_TARGET_OPTIMIZATION="-pipe -fsigned-char"
BR2_TARGET_GENERIC_GETTY_PORT="ttyMSM0"
BR2_TARGET_GENERIC_GETTY_BAUDRATE_115200=y
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_KNULLI_PATH)/board/patches $(BR2_EXTERNAL_KNULLI_PATH)/board/qualcomm/sm6115/patches"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_KNULLI_PATH)/board/fsoverlay $(BR2_EXTERNAL_KNULLI_PATH)/board/qualcomm/sm6115/fsoverlay"

# Kernel
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="7.2.8"
BR2_KERNEL_HEADERS_7_2=y
BR2_LINUX_KERNEL_PATCH="$(BR2_EXTERNAL_KNULLI_PATH)/board/qualcomm/sm6115/linux_patches"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_KNULLI_PATH)/board/qualcomm/sm6115/linux_sm6115-defconfig.config"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="qcom/sm6115-mangmi-air-x-mq65 qcom/sm6115-mangmi-air-x-mq66 qcom/sm6115-mangmi-air-x-mq66b"
BR2_LINUX_KERNEL_CUSTOM_DTS_PATH="$(BR2_EXTERNAL_KNULLI_PATH)/board/qualcomm/sm6115/dts/*"

# System
BR2_PACKAGE_BATOCERA_USE_QCOM_FW=y
BR2_TARGET_ROOTFS_SQUASHFS4_ZSTD=y

# GPU
BR2_PACKAGE_BATOCERA_FREEDRENO_MESA3D=y
BR2_PACKAGE_BATOCERA_WAYLAND_LABWC=y
BR2_PACKAGE_BATOCERA_XWAYLAND=y

# Filesystem tools
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_MTOOLS=y

# ABL Bootloader
BR2_PACKAGE_ROCKNIX_ABL=y
BR2_PACKAGE_HOST_PYTHON_MKBOOTIMG=y

# Batocera Splash Support
BR2_PACKAGE_BATOCERA_SPLASH_MPV=n

BR2_PACKAGE_XCB_UTIL_KEYSYMS=y

# Cores come from the external libretro-super drop.  sm6115.device is on
# aarch64-v8a, not the v8.2a the other Qualcomm boards use: the A73 is ARMv8.0-A.
BR2_PACKAGE_KNULLI_EXTERNAL_LIBRETRO_CORES=y
BR2_PACKAGE_LIBRETRO_SUPER_DEVICE="sm6115"
BR2_PACKAGE_IPUTILS=y
BR2_PACKAGE_MPV=y

# Emulators come from the drop harvested on this board (v8a + adreno).
BR2_PACKAGE_KNULLI_EXTERNAL_EMULATORS=y
