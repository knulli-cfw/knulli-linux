include knulli-board.common
BR2_aarch64=y
BR2_cortex_a75_a55=y
BR2_ARM_FPU_NEON_FP_ARMV8=y
BR2_PACKAGE_BATOCERA_TARGET_T618=y
BR2_TARGET_OPTIMIZATION="-pipe -fsigned-char"
# no broken-out UART on this board
BR2_TARGET_GENERIC_GETTY_PORT="tty0"
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_KNULLI_PATH)/board/patches $(BR2_EXTERNAL_KNULLI_PATH)/board/unisoc/t618/patches"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_KNULLI_PATH)/board/fsoverlay $(BR2_EXTERNAL_KNULLI_PATH)/board/unisoc/t618/fsoverlay"

BR2_KERNEL_HEADERS_6_12=y
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_GIT=y
BR2_LINUX_KERNEL_CUSTOM_REPO_URL="https://github.com/beebono/linux-mainline-sprd.git"
BR2_LINUX_KERNEL_CUSTOM_REPO_VERSION="8e1c938823b8d27cb66a82e74622f4cd91faa463"
BR2_LINUX_KERNEL_PATCH="$(BR2_EXTERNAL_KNULLI_PATH)/board/unisoc/t618/linux_patches"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_KNULLI_PATH)/board/unisoc/t618/linux-t618-defconfig.config"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_KNULLI_PATH)/board/unisoc/t618/linux-defconfig-fragment.config"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="sprd/ums512-rg-rotate"

BR2_PACKAGE_UBOOT_T618=y
BR2_TARGET_ROOTFS_SQUASHFS4_ZSTD=y
BR2_TARGET_ROOTFS_CPIO_LZ4=y

BR2_PACKAGE_MALI_KBASE=y
BR2_PACKAGE_MALI_LIBS=y
BR2_PACKAGE_MALI_LIBS_PROVIDES_EGL=y
BR2_PACKAGE_MALI_LIBS_PROVIDES_GLES=y
BR2_PACKAGE_MALI_LIBS_PROVIDES_GBM=y
BR2_PACKAGE_KNULLI_MALI_G52_VULKAN=y

BR2_PACKAGE_BATOCERA_WAYLAND=y
BR2_PACKAGE_WESTON=y
BR2_PACKAGE_WESTON_DEFAULT_DRM=y
BR2_PACKAGE_WESTON_DEFAULT_COMPOSITOR="drm"
BR2_PACKAGE_WESTON_DRM=y
BR2_PACKAGE_BATOCERA_SPLASH_MPV=n

BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_MTOOLS=y

BR2_PACKAGE_KNULLI_EXTERNAL_LIBRETRO_CORES=y
BR2_PACKAGE_LIBRETRO_SUPER_DEVICE="t618"
BR2_PACKAGE_KNULLI_EXTERNAL_EMULATORS=y
BR2_PACKAGE_IPUTILS=y
BR2_PACKAGE_MPV=y
