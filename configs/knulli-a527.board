include knulli-board.common

# Target definition
BR2_aarch64=y
BR2_cortex_a55=y
BR2_ARM_FPU_NEON_FP_ARMV8=y
BR2_PACKAGE_BATOCERA_TARGET_T527=y
BR2_TARGET_OPTIMIZATION="-pipe -fsigned-char -mcpu=cortex-a55 -mtune=cortex-a55"
#BR2_TARGET_GENERIC_GETTY_PORT="tty1"
BR2_TARGET_GENERIC_GETTY_BAUDRATE_115200=y
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_KNULLI_PATH)/board/patches $(BR2_EXTERNAL_KNULLI_PATH)/board/allwinner/a527/patches"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_KNULLI_PATH)/board/fsoverlay $(BR2_EXTERNAL_KNULLI_PATH)/board/allwinner/a527/fsoverlay"
BR2_TARGET_ROOTFS_SQUASHFS4_ZSTD=y

# Linux headers same as kernel, a 5.15 series
BR2_KERNEL_HEADERS_AS_KERNEL=y
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_5_15=y

# Kernel - https://github.com/orangepi-xunlong/linux-orangepi/tree/orange-pi-5.15-sun55iw3
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_GIT=y
BR2_LINUX_KERNEL_CUSTOM_REPO_URL="https://github.com/orangepi-xunlong/linux-orangepi"
BR2_LINUX_KERNEL_CUSTOM_REPO_VERSION="orange-pi-5.15-sun55iw3"
BR2_LINUX_KERNEL_PATCH="$(BR2_EXTERNAL_KNULLI_PATH)/board/allwinner/a527/linux_patches"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_KNULLI_PATH)/board/allwinner/a527/linux-a523-current.config"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_KNULLI_PATH)/board/allwinner/a527/linux-defconfig-fragment.config"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="allwinner/sun55i-t527-orangepi-4a"

BR2_PACKAGE_UBOOT_ORANGEPI_4A=y

# spi flash support
BR2_PACKAGE_MTD=y

# Mesa driver
#BR2_PACKAGE_BATOCERA_PANFROST_MESA3D=y

# Mali G57 GPU driver
BR2_PACKAGE_MALI_G57_SUNXI=y
BR2_PACKAGE_XUTIL_UTIL_MACROS=y

# Vulkan support
BR2_PACKAGE_VULKAN_HEADERS=y
BR2_PACKAGE_VULKAN_LOADER=y

# Enable Wayland & XWayland
BR2_PACKAGE_BATOCERA_WAYLAND=y
BR2_PACKAGE_WESTON=y
BR2_PACKAGE_WESTON_DEFAULT_DRM=y
BR2_PACKAGE_WESTON_DEFAULT_COMPOSITOR="drm"
BR2_PACKAGE_WESTON_DRM=y

# Include Kodi Media Center
#BR2_PACKAGE_BATOCERA_KODI21=y

# batocera splash screen
#BR2_PACKAGE_BATOCERA_SPLASH_MPV=y
#BR2_PACKAGE_XCB_UTIL_KEYSYMS=y

# EXT rootfs
#BR2_TARGET_ROOTFS_EXT2=y
#BR2_TARGET_ROOTFS_EXT2_3=y
#BR2_TARGET_ROOTFS_EXT2_3=y
#BR2_TARGET_ROOTFS_EXT2_GEN=3
#BR2_TARGET_ROOTFS_EXT2_REV=1
#BR2_TARGET_ROOTFS_EXT2_LABEL="rootfs"
#BR2_TARGET_ROOTFS_EXT2_SIZE="5000M"
#BR2_TARGET_ROOTFS_EXT2_INODES=0
#BR2_TARGET_ROOTFS_EXT2_RESBLKS=5
#BR2_TARGET_ROOTFS_EXT2_MKFS_OPTIONS="-O ^64bit"
#BR2_TARGET_ROOTFS_EXT2_NONE=y

# ADB
BR2_PACKAGE_ANDROID_TOOLS=y
BR2_PACKAGE_ANDROID_TOOLS_ADBD=y

