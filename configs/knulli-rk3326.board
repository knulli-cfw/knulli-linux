include knulli-board.common

# Target definition
BR2_aarch64=y
BR2_cortex_a35=y
BR2_ARM_FPU_NEON_FP_ARMV8=y
BR2_PACKAGE_BATOCERA_TARGET_RK3326=y
BR2_TARGET_OPTIMIZATION="-pipe -fsigned-char -mcpu=cortex-a35+crypto -mtune=cortex-a35"
BR2_TARGET_GENERIC_GETTY_BAUDRATE_115200=y
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_KNULLI_PATH)/board/patches $(BR2_EXTERNAL_KNULLI_PATH)/board/rockchip/patches $(BR2_EXTERNAL_KNULLI_PATH)/board/rockchip/rk3326/patches"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_KNULLI_PATH)/board/fsoverlay $(BR2_EXTERNAL_KNULLI_PATH)/board/rockchip/fsoverlay $(BR2_EXTERNAL_KNULLI_PATH)/board/rockchip/rk3326/fsoverlay"

# Linux headers same as kernel, a BSP 6.1 series
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_1=y

# Kernel - same BSP 6.1.x tree, patches and defconfig as rk3566
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_GIT=y
BR2_LINUX_KERNEL_CUSTOM_REPO_URL="https://github.com/knulli-cfw/linux-6.1.y-rockchip.git"
BR2_LINUX_KERNEL_CUSTOM_REPO_VERSION="1629d4d841456f20b8b4736e9815d4539b0dd0ae"
BR2_LINUX_KERNEL_PATCH="$(BR2_EXTERNAL_KNULLI_PATH)/board/rockchip/rk3326/linux_bsp_patches"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_KNULLI_PATH)/board/rockchip/rk3326/linux-bsp-defconfig.config"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_KNULLI_PATH)/board/rockchip/rk3326/linux-defconfig-fragment.config"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y

# Build the DTB from the kernel sources
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="rockchip/rk3326-a10mini-linux rockchip/rk3326-batlexp-linux rockchip/rk3326-gkd-pixel2-linux rockchip/rk3326-magicx-mini-m-linux rockchip/rk3326-mymini-linux rockchip/rk3326-odroid-go2 rockchip/rk3326-r36max-linux rockchip/rk3326-r36pro-linux rockchip/rk3326-r36s-linux rockchip/rk3326-rppocket-linux rockchip/rk3326-xf40h-linux"

# gpu
BR2_PACKAGE_MALI_G31_GBM=y

# batocera splash screen
BR2_PACKAGE_BATOCERA_SPLASH_MPV=y
BR2_PACKAGE_MPV=y

# Controller
BR2_PACKAGE_UINPUT_JOYSTICK=y

# Bootloader - single image, device detected from SARADC
BR2_PACKAGE_UBOOT_RK3326=y

# Firmware
BR2_PACKAGE_FIRMWARE_ESP8089=y
BR2_PACKAGE_ARMBIAN_FIRMWARE=y
BR2_PACKAGE_ARMBIAN_FIRMWARE_RTL8723BX=y

# Firmware for the USB WiFi dongles enabled in the kernel fragment
BR2_PACKAGE_LINUX_FIRMWARE=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_81XX=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_87XX=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_88XX=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_RTW88=y
BR2_PACKAGE_LINUX_FIRMWARE_RALINK_RT2XX=y
BR2_PACKAGE_LINUX_FIRMWARE_ATHEROS_9271=y
BR2_PACKAGE_LINUX_FIRMWARE_ATHEROS_7010=y
BR2_PACKAGE_LINUX_FIRMWARE_ATHEROS_9170=y
BR2_PACKAGE_LINUX_FIRMWARE_MEDIATEK_MT7601U=y

# ADB
BR2_PACKAGE_ANDROID_TOOLS=y
BR2_PACKAGE_ANDROID_TOOLS_ADBD=y


# Libretro cores are NOT compiled by Buildroot.  The gate below turns off every
# "select BR2_PACKAGE_LIBRETRO_*" in knulli-system/Config.in; the cores come
# from the external libretro-super build instead (package/cores/libretro-super).
#
# The DEVICE names which devices/<name>.device file describes this board, and
# that file names the ABI profile it consumes.  Boards sharing a profile share
# the compiled cores: the drop is built once and reused, so only the first
# board on a given ABI pays the compile.
BR2_PACKAGE_KNULLI_EXTERNAL_LIBRETRO_CORES=y
BR2_PACKAGE_LIBRETRO_SUPER_DEVICE="rk3326"
BR2_PACKAGE_IPUTILS=y

# Emulators
BR2_PACKAGE_KNULLI_EXTERNAL_EMULATORS=y

# 32-bit (armhf) runtime for the 32-bit emulators this 64-bit image ships.
# Installed from armhf-cache/drop/rk3326, built by "make rk3326-armhf-drop".
BR2_PACKAGE_KNULLI_ARMHF_DROP=y
BR2_PACKAGE_KNULLI_ARMHF_DROP_DEVICE="rk3326"

# XF40H / R36 Max built-in WiFi (Rockchip RK915 on SDIO)
BR2_PACKAGE_RK915=y
