include knulli-board.common

# Target definition
BR2_arm=y
BR2_cortex_a7=y
BR2_ARM_EABIHF=y
BR2_ARM_FPU_NEON_VFPV4=y
BR2_PACKAGE_BATOCERA_TARGET_RK3128=y
BR2_TARGET_OPTIMIZATION="-pipe -fsigned-char"
BR2_TARGET_GENERIC_GETTY_BAUDRATE_115200=y
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_KNULLI_PATH)/board/patches $(BR2_EXTERNAL_KNULLI_PATH)/board/rockchip/patches $(BR2_EXTERNAL_KNULLI_PATH)/board/rockchip/rk3128/patches"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_KNULLI_PATH)/board/fsoverlay $(BR2_EXTERNAL_KNULLI_PATH)/board/rockchip/fsoverlay $(BR2_EXTERNAL_KNULLI_PATH)/board/rockchip/rk3128/fsoverlay"
BR2_TARGET_ROOTFS_SQUASHFS4_ZSTD=y

# Linux headers same as kernel, a BSP 6.1 series
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_1=y

# Kernel - same BSP 6.1.x tree as rk3326/rk3566
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_GIT=y
BR2_LINUX_KERNEL_CUSTOM_REPO_URL="https://github.com/knulli-cfw/linux-6.1.y-rockchip.git"
BR2_LINUX_KERNEL_CUSTOM_REPO_VERSION="1629d4d841456f20b8b4736e9815d4539b0dd0ae"
BR2_LINUX_KERNEL_PATCH="$(BR2_EXTERNAL_KNULLI_PATH)/board/rockchip/rk3128/linux_bsp_patches"
BR2_LINUX_KERNEL_USE_DEFCONFIG=y
BR2_LINUX_KERNEL_DEFCONFIG="rockchip_linux"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_KNULLI_PATH)/board/rockchip/rk3128/linux-defconfig-fragment.config"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="rk3128-ps5000 rk3128-ps7000 rk3128-powkiddy-a13-rev-ab rk3128-powkiddy-a12-rev-c rk3128-powkiddy-a12-rev-d"

# Batocera System
# BR2_PACKAGE_BATOCERA_KODI21=y
BR2_PACKAGE_LIBENET=y

# gpu
BR2_PACKAGE_MALI_MP400_GBM=y
BR2_PACKAGE_LIBDRM=y
#BR2_PACKAGE_WESTON=y
#BR2_PACKAGE_WESTON_FBDEV=y
#BR2_PACKAGE_WESTON_DEFAULT_FBDEV=y

# Filesystem tools
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_MTOOLS=y
# BR2_PACKAGE_LVM2_STANDARD_INSTALL is not set

# spi flash support
BR2_PACKAGE_MTD=y

# Bootloader and Rotation
BR2_PACKAGE_UBOOT_PS5000=y
BR2_PACKAGE_UBOOT_PS7000=y
BR2_PACKAGE_UBOOT_POWKIDDY_A13=y
BR2_PACKAGE_RKBIN=y

# Misc
# BR2_PACKAGE_XOW is not set
BR2_PACKAGE_LIBCEC=y
BR2_PACKAGE_INPUT_EVENT_DAEMON=y
BR2_PACKAGE_LIBSODIUM=y
#BR2_PACKAGE_MOONLIGHT_EMBEDDED=n

# ADB
BR2_PACKAGE_ANDROID_TOOLS=y
BR2_PACKAGE_ANDROID_TOOLS_ADBD=y

# SDL1 
BR2_PACKAGE_SDL=y
BR2_PACKAGE_SDL_FBCON=y
BR2_PACKAGE_SDL_GFX=y
BR2_PACKAGE_SDL_IMAGE=y
BR2_PACKAGE_SDL_IMAGE_BMP=y
BR2_PACKAGE_SDL_IMAGE_JPEG=y
BR2_PACKAGE_SDL_IMAGE_PNG=y
BR2_PACKAGE_SDL_SOUND=y
BR2_PACKAGE_SDL_TTF=y
BR2_PACKAGE_SDL12_COMPAT=y

# Libretro cores are NOT compiled by Buildroot.  The gate below turns off every
# "select BR2_PACKAGE_LIBRETRO_*" in knulli-system/Config.in; the cores come
# from the external libretro-super build instead (package/cores/libretro-super).
#
# The DEVICE names which devices/<name>.device file describes this board, and
# that file names the ABI profile it consumes.  Boards sharing a profile share
# the compiled cores: the drop is built once and reused, so only the first
# board on a given ABI pays the compile.
BR2_PACKAGE_KNULLI_EXTERNAL_LIBRETRO_CORES=y
BR2_PACKAGE_LIBRETRO_SUPER_DEVICE="rk3128"
BR2_PACKAGE_IPUTILS=y
