config BR2_PACKAGE_KNULLI_UTILS
       bool "Knulli Utils"
       select BR2_PACKAGE_SDL2
       select BR2_PACKAGE_SDL2_IMAGE
       select BR2_PACKAGE_SDL2_TTF
       select BR2_PACKAGE_SDL2_GFX
       select BR2_PACKAGE_ZLIB
       # charger is SDL1 and only built for h700
       select BR2_PACKAGE_SDL           if BR2_PACKAGE_BATOCERA_TARGET_H700
       select BR2_PACKAGE_SDL_IMAGE     if BR2_PACKAGE_BATOCERA_TARGET_H700
       select BR2_PACKAGE_SDL_TTF       if BR2_PACKAGE_BATOCERA_TARGET_H700
       select BR2_PACKAGE_SDL_GFX       if BR2_PACKAGE_BATOCERA_TARGET_H700
       help
          Knulli utitlities like progressbar, charger, etc.
