+# --- local: pinned-revision support (recipe field 4 = "<branch>@<sha>").
+ensure_pinned_rev() {
+	# $1 = checkout dir, $2 = branch, $3 = commit.  Leaves the work tree hard
+	# reset to $3.  Non-zero if the commit cannot be obtained.
+	local d="$1" br="$2" sha="$3" depth
+	if ! git -C "$d" cat-file -e "${sha}^{commit}" 2>/dev/null; then
+		# GitHub serves `fetch <sha>` only with uploadpack.allowReachableSHA1InWant,
+		# which it does not enable -- so try it (other hosts do allow it), then
+		# deepen the branch progressively.  Deepening beats unshallowing every
+		# repo up front: most pins are recent and land in the first step.
+		git -C "$d" fetch --depth 1 origin "$sha" 2>/dev/null
+		for depth in 64 512 4096; do
+			git -C "$d" cat-file -e "${sha}^{commit}" 2>/dev/null && break
+			echo "deepening ${d} to ${depth} commits looking for ${sha:0:12}..."
+			git -C "$d" fetch --depth "$depth" origin "$br" >/dev/null 2>&1
+		done
+		if ! git -C "$d" cat-file -e "${sha}^{commit}" 2>/dev/null; then
+			echo "unshallowing ${d}..."
+			git -C "$d" fetch --unshallow origin "$br" >/dev/null 2>&1 || \
+				git -C "$d" fetch origin "$br" >/dev/null 2>&1
+		fi
+	fi
+	git -C "$d" cat-file -e "${sha}^{commit}" 2>/dev/null || return 1
+	git -C "$d" reset --hard "$sha" >/dev/null 2>&1
+}
+# --- end local ---
