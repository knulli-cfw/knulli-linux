config BR2_PACKAGE_LIBRETRO_MAKECODE_ARCADE
	bool "libretro-makecode-arcade"
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_aarch64 || BR2_x86_64
	help
	  MakeCode Arcade libretro core (unofficial).

	  Runs Microsoft MakeCode Arcade games compiled to PXT64 bytecode.
	  Cartridges must be .pxt64 images; the .png files the MakeCode editor
	  produces hold source code only and cannot be run.

	  64-bit only: the official PXT compiler emits no 32-bit bytecode and the
	  runtime's PXT32 image patching is an unimplemented upstream TODO, so a
	  32-bit build loads but cannot run anything.

	  https://github.com/whmzsu/makecode-arcade-libretro

comment "libretro-makecode-arcade needs a toolchain w/ C++, 64-bit target"
	depends on !BR2_INSTALL_LIBSTDCPP || !(BR2_aarch64 || BR2_x86_64)
