#!/bin/bash

do_usage() {
	echo "$1 list"
	echo "$1 get"
	echo "$1 set {auto|<device>}"
	echo "$1 list-profiles"
	echo "$1 get-profile"
	echo "$1 set-profile {auto|<profile>}"
	echo "$1 getSystemVolume"
	echo "$1 setSystemVolume {mute|unmute|mute-toggle|[+-]<0...100>}"
	echo "$1 test"
}

# Export XDG for PW
export XDG_RUNTIME_DIR=/var/run

# One rk3326 image serves every board, so /boot/boot/knulli.board only says
# "rk3326"; U-Boot passes the detected board on the command line.
BOARD=$(sed -n 's/.*\bboard=\([^ ]*\).*/\1/p' /proc/cmdline 2>/dev/null)
[ -n "${BOARD}" ] || BOARD=$(cat /boot/boot/knulli.board 2>/dev/null)

# Where the rk817 output goes on each board:
#   SPK_HP  speaker and jack both live: R36S has both on the headphone stage
#           and the jack switches by itself (no amp switches); R36 Max has
#           the speaker on the codec class D, selected with the spk switch
#   HP      external amplifier fed from the headphone stage, the speaker
#           and jack selected with the multicodecs spk/hp switches
#           (XF40H design: use-ext-amplifier in the DTS)
#   SPK     codec class D straight to the speaker (G350, Pixel2, ...)
# HAS_AMP_SWITCHES: 1 only for multicodecs cards (spk/hp switch controls);
# simple-audio-card boards let the codec drive its own spk-ctl-gpios.
case "${BOARD}" in
    r36s)                          SPEAKER_PATH=SPK_HP; HAS_AMP_SWITCHES=0 ;;
    r36max)                        SPEAKER_PATH=SPK_HP; HAS_AMP_SWITCHES=1 ;;
    xf40h|mymini|r36pro)           SPEAKER_PATH=HP;     HAS_AMP_SWITCHES=1 ;;
    *)                             SPEAKER_PATH=SPK;    HAS_AMP_SWITCHES=0 ;;
esac

# The only sink: the rk817 node (profiles are disabled for this card, see the
# wireplumber rule in the rk3326 overlay).
RK817_SINK=$(LANG=C pactl list short sinks 2>/dev/null | awk '$2 ~ /rk817-sound/ { print $2; exit }')

# The I2S "BCLK Ratio" control has been seen holding garbage after boot
# (frame of 65 bit-clocks instead of 64 -> thin, distorted output); pin it.
fix_bclk_ratio() {
    amixer -c 0 cset name='BCLK Ratio' 64 >/dev/null 2>&1
}

amp_switches() {
    [ "${HAS_AMP_SWITCHES}" = "1" ] || return 0
    amixer -c 0 cset name='spk switch' "$1" >/dev/null 2>&1
    amixer -c 0 cset name='hp switch' "$2" >/dev/null 2>&1
    return 0
}

# Set variables
MAX_VOLUME="$(/usr/bin/knulli-settings-get audio.volume.boost)" || MAX_VOLUME=100
DEFAULT_SINK=$(LANG=C pactl info | grep -E '^Default Sink: ' | sed -e s+"^Default Sink: "+""+ | head -1)
DETECT_VOLUME=$(LANG=C pactl list sinks-raw | grep -E '^[^ ]* name="'"${DEFAULT_SINK}"'"' | sed -e s+"^.* volume=\"\([0-9]*\)\" .*$"+'\1'+)

ACTION="$1"

case "${ACTION}" in
    list)
	printf "auto\tauto\n"
	printf "speakers\tspeakers\n"
	printf "headphone\theadphone\n"
	LANG=C pactl list sinks-raw | sed -e s+"^sink=\"[0-9]*\" name=\"\([^ ]*\)\" .* description=\"\(.*\)\"$"+"\1\t\2"+
	;;

    get)
	/usr/bin/knulli-settings-get audio.device
	;;

    set)
	MODE="$2"
	# Needed for audio resume after suspend
	amixer -c 0 sset 'Resume Path' 'ON' >/dev/null 2>&1
	case "${MODE}" in
	    auto | speakers)
		fix_bclk_ratio
		[ -n "${RK817_SINK}" ] && LANG=C pactl set-default-sink "${RK817_SINK}"
		amixer -c 0 cset name='Playback Path' "${SPEAKER_PATH}" >/dev/null || exit 1
		amp_switches 1 0
		;;

	    headphone)
		fix_bclk_ratio
		[ -n "${RK817_SINK}" ] && LANG=C pactl set-default-sink "${RK817_SINK}"
		amixer -c 0 cset name='Playback Path' HP >/dev/null || exit 1
		amp_switches 0 1
		;;
	    *)
		LANG=C pactl set-default-sink "${MODE}"
	esac
	;;

    list-profiles)
	printf "auto\tauto\n"
	LANG=C pactl list cards-profiles-raw | grep "available=\"1\"" | sed -e s+"^card=\"[0-9]*\" name=\"\(.*\)\" profile=\"\(.*\)\" available=\"[01]\" active=\"[01]\" description=\"\(.*\)\"$"+"\2@\1\t\3"+
	;;

    get-profile)
	/usr/bin/knulli-settings-get audio.profile
	;;

    set-profile)
	MODE="$2"
	if test "${MODE}" != "auto"
	then
	    PROFILE_NAME=$(echo "${MODE}" | cut -d @ -f 1)
	    CARD_NAME=$(echo "${MODE}" | cut -d @ -f 2)
	    LANG=C pactl set-card-profile "${CARD_NAME}" "${PROFILE_NAME}" || exit 1
	else
		# The rk817 card runs without ACP profiles (wireplumber rule in
		# the rk3326 overlay): a single 2-channel node, nothing to select.
		true
	fi
	;;

    getSystemVolume)
	echo "${DETECT_VOLUME}"
	;;

    setSystemVolume)
	VOLUME="$2"
	case "${VOLUME}" in
	    "mute")
		LANG=C pactl set-sink-mute @DEFAULT_SINK@ 1
		;;
	    "unmute")
		LANG=C pactl set-sink-mute @DEFAULT_SINK@ 0
		;;
	    "mute-toggle")
		LANG=C pactl set-sink-mute @DEFAULT_SINK@ toggle
		;;
	    *)
		if echo "${VOLUME}" | grep -qE '^[0-9]+$'
		then
		    if test "${VOLUME}" -ge 0 -a "${VOLUME}" -le "${MAX_VOLUME}"
		    then
		        LANG=C pactl set-sink-volume @DEFAULT_SINK@ "${VOLUME}%"
		        exit 0
		    fi
		else
		    if echo "${VOLUME}" | grep -qE '^[+-][0-9]+$'
		    then
		        let NEWVOLUME=${DETECT_VOLUME}${VOLUME}
		        test "${NEWVOLUME}" -lt 0 && NEWVOLUME=0
		        test "${NEWVOLUME}" -gt "${MAX_VOLUME}" && NEWVOLUME=${MAX_VOLUME}
		        LANG=C pactl set-sink-volume @DEFAULT_SINK@ "${NEWVOLUME}%"
		        exit 0
		    fi
		    echo "invalid volume value" >&2
		    exit 1
		fi
	esac
	;;

    test)
		aplay "/usr/share/sounds/Mallet.wav"
	;;
	*)
		do_usage $(basename $0)
esac
