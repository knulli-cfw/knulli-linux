# Anbernic RG 55G1 default values

# Rotate DRM for splash
display.rotate.DSI=1

# Rotate Wayland LabWC
display.rotate.DSI-1=3

# default suspend on handled boards
system.suspendmode=suspend

# Audio: speakers (2x aw88166) through the UCM HiFi verb
audio.device=alsa_output._sys_devices_platform_sound_sound_card0.HiFi__Speaker__sink
audio.profile=pro-audio@alsa_card._sys_devices_platform_sound_sound_card0
