#!/bin/sh

export LC_ALL=C

notify() {
    [ -n "$1" ] && curl -s http://localhost:1234/notify -d "$1" >/dev/null
}

do_help() {
    echo "$0 scanlist" >&2
    echo "$0 list" >&2
    echo "$0 connected" >&2
    echo "$0 start" >&2
    echo "$0 enable [ssid key [country]]" >&2
    echo "$0 disable" >&2
    echo "$0 configure" >&2
    echo "$0 connect ssid" >&2
    echo "$0 get_route" >&2
    echo "$0 get_interface" >&2
    echo "$0 has_ap_mode" >&2
}

do_list() {
    connmanctl services | sed 's/^...[ ]*//' | awk -F '[ ]*[ ]wifi_[[:alnum:]]*_' '{if (NF==2) print $1}' | sort -u # remove duplicates (a single wifi can appear under 2 interfaces)
}

do_connected() {
    connmanctl services 2>/dev/null |
        awk '
            substr($0, 3, 1) ~ /^[RO]$/ && $NF ~ /^wifi_[[:alnum:]_]+$/ {
                name = substr($0, 4)
                sub(/^[[:space:]]+/, "", name)
                sub(/[[:space:]]+wifi_[[:alnum:]_]+$/, "", name)
                print name
                exit
            }
        '
}

do_scanlist() {
    connmanctl scan wifi >/dev/null 2>/dev/null
    sleep 1
    do_list
}

wait_for_ip() {
    local mode=$1
    local success=false

    for i in $(seq 1 40); do
        if [ "$mode" = "up" ]; then
            if ip -4 addr show | grep "inet " | grep -qv "127\.0\.0\.1"; then
                success=true
                break
            fi
        elif [ "$mode" = "down" ]; then
            if ! ip -4 addr show | grep "inet " | grep -qv "127\.0\.0\.1"; then
                success=true
                break
            fi
        fi
        sleep 0.5
    done

    if [ "$mode" = "up" ] && [ "$success" = false ]; then
        # Double check before stating connetion failed
        if knulli-internet-check >/dev/null 2>&1; then
            return 0   # internet is actually up
        fi
        notify "Wi-Fi failed to connect"
        return 1
    fi
}

connect_wifi() {
    local ssid="$1"
    local ssid_hex
    local services
    local service
    local candidate
    local strength
    local attempt

    [ -n "$ssid" ] || return 1

    /etc/init.d/S08connman configure || return 1
    connmanctl scan wifi >/dev/null 2>&1
    sleep 1

    ssid_hex="$(printf '%s' "$ssid" | od -An -v -tx1 | tr -d ' \n')"

    services="$(
        connmanctl services 2>/dev/null |
            awk -v ssid="$ssid_hex" '
                {
                    id = $NF
                    split(id, parts, "_")
                    if (parts[1] == "wifi" && parts[3] == ssid)
                        print id
                }
            '
    )"

    [ -n "$services" ] || return 1

    # Choose the strongest signal if more than one service matches.
    service="$(
        for candidate in $services; do
            strength="$(
                connmanctl services "$candidate" 2>/dev/null |
                    awk '$1 == "Strength" && $2 == "=" {print $3; exit}'
            )"
            printf '%s %s\n' "${strength:-0}" "$candidate"
        done |
            sort -rn |
            awk 'NR == 1 {print $2}'
    )"

    connmanctl connect "$service" >/dev/null 2>&1

    # Wait for the selected Wi-Fi network to connect.
    attempt=0
    while [ "$attempt" -lt 20 ]; do
        if connmanctl services "$service" 2>/dev/null |
            grep -qE '^[[:space:]]*State[[:space:]]*=[[:space:]]*(ready|online)[[:space:]]*$'; then
            return 0
        fi

        attempt=$((attempt + 1))
        sleep 0.5
    done

    return 1
}

get_route() {
    echo $(ip route show default | awk '/^default/ && $0 ~ /wl/ { print $3 }')
}

get_interface() {
    echo $(ip link show | awk -F: '$2 ~ /w[l]/ { gsub(/ /, "", $2); print $2 }' | head -n1)
}

has_ap_mode() {
    WIFI_DEV=$(get_interface)
    PHY=$(basename "$(readlink /sys/class/net/${WIFI_DEV}/phy80211)")
    if iw phy "${PHY}" info | sed -n '/Supported interface modes/,/^[^*]*$/s|^.*[*] ||p' | grep -q 'AP'; then
        exit 0
    else
        exit 1
    fi
}

if [ $# -eq 0 ]; then
    do_help
    exit 1
fi

ACTION=$1
shift

case "${ACTION}" in
    "list")
        do_list
        ;;
    "connected")
        do_connected
        ;;
    "scanlist")
        do_scanlist
        ;;
    "start")
        /etc/init.d/S08connman restart
        ;;
    "configure")
        # provision the saved networks without restarting connman
        /etc/init.d/S08connman configure
        ;;
    "connect")
        connect_wifi "$1"
        ;;
    "enable")
        knulli-settings-set wifi.enabled 1

        if [ $# -ge 2 ]; then
            knulli-settings-set wifi.ssid "$1"
            knulli-settings-set wifi.key "$2"
        fi

        # An empty country clears the saved setting.
        if [ $# -ge 3 ]; then
            knulli-settings-set wifi.country "$3"
        fi
        /etc/init.d/S08connman reload

        settings_ssid="$(knulli-settings-get wifi.ssid)"

        # We don't need to wait for an IP if no saved ssid
        if [ -n "${settings_ssid}" ]; then
            wait_for_ip up
        else
            sleep 1 # wait 1 second for connman to initialize and start scanning
        fi
        ;;
    "disable")
        knulli-settings-set wifi.enabled 0
        /etc/init.d/S08connman reload
        wait_for_ip down
        ;;
    "get_route")
        get_route
        ;;
    "get_interface")
        get_interface
        ;;
    "has_ap_mode")
        has_ap_mode
        ;;
    *)
        do_help
        >&2 echo "error: invalid command ${ACTION}"
        exit 1
        ;;
esac
