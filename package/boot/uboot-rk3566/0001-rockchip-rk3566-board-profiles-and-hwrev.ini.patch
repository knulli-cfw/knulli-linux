-	 */
 	{
 		const char *fdtfile = fdt_getprop(fdt_addr, 0,
 						  "uboot,fdtfile", NULL);
@@ -1145,13 +996,7 @@ export_props:
 			env_set("fdtfile", fdtfile);
 			printf("fdtfile: %s\n", fdtfile);
 		}
-		/*
-		 * Per-device framebuffer console rotation for the kernel
