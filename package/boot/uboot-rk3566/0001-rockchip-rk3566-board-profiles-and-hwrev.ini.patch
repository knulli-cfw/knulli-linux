-/*
- * Boot-partition DTB override.
- *
- * Some handhelds cannot be told apart by SARADC/GPIO hwid — e.g. their ADC
- * channels are the analog sticks (no dedicated board-id divider), so the
- * stick-at-rest values collide with another board within the match margin.
- * For those, drop a small text file on the FAT boot partition naming the DTB
- * to use; it is honoured BEFORE hwid auto-detection.
- *
- *   File:    /dtb_override.txt  (boot FAT, part 3 then 1 — same as resource.img)
- *   Content: a DTB name, one per line. The first name that resolves wins;
- *            blank lines and lines starting with '#' are ignored; leading/
- *            trailing whitespace is trimmed. Each name may be either:
- *              (a) a STANDALONE .dtb file sitting on the same FAT partition,
- *                  e.g.  rk3566-gkd-bubble-uboot.dtb
- *                  — loaded directly, no resource.img repack needed (this is
- *                  how new/undetectable devices are added: drop a dtb + name it);
- *              (b) an entry already packed inside resource.img, e.g.
- *                  rk-kernel#_saradc_ch1=539#_saradc_ch0=527.dtb
- *            A standalone file of the same name takes precedence over a packed
- *            entry.
- *
- * If the file is absent, empty, or nothing resolves, we silently fall through
- * to the normal hwid detection.
- *
- * Return: 1 = standalone .dtb loaded straight into fdt_addr (*out_file left NULL);
- *         0 = resolved to a resource.img entry (*out_file set, caller copies it);
- *        <0 = no usable override, fall through to hwid.
- */
-#define DTB_OVERRIDE_FILE	"/dtb_override.txt"
-#define DTB_OVERRIDE_MAXLEN	256
-
-static bool ends_with_dtb(const char *s)
-{
-	int n = strlen(s);
-
-	return n >= 4 && !strcmp(s + n - 4, ".dtb");
-}
-
