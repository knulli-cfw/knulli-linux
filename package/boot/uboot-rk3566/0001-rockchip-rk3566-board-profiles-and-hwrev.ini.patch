Subject: [PATCH] rockchip: rk3566 board profiles and hwrev.ini

One profile per handheld (SARADC ID, U-Boot and kernel DTB, framebuffer
rotation), applied as a unit; /hwrev.ini on the boot FAT names a board
and replaces whatever detection chose.  The RG DS and RG DS Plus read the
same on every ID channel and differ in RAM (3 GiB vs 1 GiB).  U-Boot loads dtbs/<board>.dtb from the
boot partition, falling back to the resource.img hwid path when it is
missing.
---
diff --git a/arch/arm/mach-rockchip/Makefile b/arch/arm/mach-rockchip/Makefile
index a880840..f759cab 100644
--- a/arch/arm/mach-rockchip/Makefile
+++ b/arch/arm/mach-rockchip/Makefile
@@ -43,7 +43,7 @@ obj-$(CONFIG_ROCKCHIP_FIT_IMAGE) += fit.o
 obj-$(CONFIG_ROCKCHIP_UIMAGE) += uimage.o
 obj-$(CONFIG_ROCKCHIP_SMCCC) += rockchip_smccc.o
 obj-$(CONFIG_ROCKCHIP_VENDOR_PARTITION) += vendor.o
-obj-$(CONFIG_ROCKCHIP_RESOURCE_IMAGE) += resource_img.o
+obj-$(CONFIG_ROCKCHIP_RESOURCE_IMAGE) += resource_img.o hwrev.o
 obj-$(CONFIG_ROCKCHIP_DEBUGGER) += rockchip_debugger.o
 obj-$(CONFIG_FPGA_ROCKCHIP) += fpga.o
 endif
