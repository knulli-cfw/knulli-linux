 #else
-	if (!file)
-		file = get_file_info(DTB_FILE);
+	file = get_file_info(DTB_FILE);
 #endif
 	if (!file)
 		return -ENODEV;
@@ -1129,12 +986,6 @@ int rockchip_read_resource_dtb(void *fdt_addr, char **hash, int *hash_size)
 	*hash_size = file->hash_size;
 	printf("DTB: %s\n", file->name);
 
-export_props:
-	/*
-	 * Export the kernel dtb name from the loaded dtb's 'uboot,fdtfile'
