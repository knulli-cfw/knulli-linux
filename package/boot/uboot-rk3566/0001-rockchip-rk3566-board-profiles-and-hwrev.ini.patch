 	 */
+	printf("DTB: %s not found, using resource.img\n", path);
 	file = NULL;
-	ret = rockchip_read_dtb_override(fdt_addr, &file);
-	if (ret == 1) {
-		/* Standalone .dtb already loaded + header-checked in fdt_addr. */
-		*hash = NULL;
-		*hash_size = 0;
-		goto export_props;
-	}
 
 #ifdef CONFIG_ROCKCHIP_HWID_DTB
-	/* Else find dtb by matched hardware id(GPIO/ADC) */
-	if (!file)
-		file = rockchip_read_hwid_dtb();
+	/* Find dtb by matched hardware id(GPIO/ADC) */
+	file = rockchip_read_hwid_dtb();
 	/* If dtbs matched hardware id(GPIO/ADC) not found, try the default */
 	if (!file)
