diff --git a/arch/arm/include/asm/arch-rockchip/hwrev.h b/arch/arm/include/asm/arch-rockchip/hwrev.h
new file mode 100644
index 0000000..680fb37
--- /dev/null
+++ b/arch/arm/include/asm/arch-rockchip/hwrev.h
@@ -0,0 +1,14 @@
+/*
+ * SPDX-License-Identifier:	GPL-2.0+
+ */
+
+#ifndef __ASM_ARCH_HWREV_H
+#define __ASM_ARCH_HWREV_H
+
+#include <fs.h>
+
+void hwrev_setup(void);
+int hwrev_apply_board(const char *name);
+int hwrev_fat_read(const char *path, void *buf, loff_t max, loff_t *size);
+
+#endif
diff --git a/arch/arm/mach-rockchip/hwrev.c b/arch/arm/mach-rockchip/hwrev.c
new file mode 100644
index 0000000..02de789
--- /dev/null
+++ b/arch/arm/mach-rockchip/hwrev.c
@@ -0,0 +1,298 @@
+/*
+ * RK3566 board profiles: SARADC detection plus the hwrev.ini override.
+ *
+ * SPDX-License-Identifier:	GPL-2.0+
+ */
+
+#include <common.h>
+#include <command.h>
+#include <adc.h>
+#include <fs.h>
+#include <memalign.h>
+#include <boot_rkimg.h>
+#include <asm/arch/hwrev.h>
+
+DECLARE_GLOBAL_DATA_PTR;
+
+/*
+ * One profile per supported RK3566 handheld.  A profile is applied as a unit:
+ * partially overriding one board with another's values is what produces the
+ * unbootable mixtures this table exists to prevent.
+ *
+ * A board matches when every channel it lists reads within HWREV_MARGIN of
+ * the listed value; ch = -1 ends the list.  A board with no channels has no
+ * SARADC identity of its own and is only reachable from hwrev.ini.  The RG DS
+ * and RG DS Plus read the same on all their ID channels (ch5 follows the
+ * charger on both), so their RAM tells them apart: 3 GiB vs 1 GiB.
+ *
+ * Order matters: the first match wins, as it did for the resource.img hwid
+ * entries this table replaces.
+ */
+#define HWREV_MARGIN	30
+
+struct hwrev_adc {
+	s8 ch;
+	u16 val;
+};
+
+struct rk3566_board {
+	const char *name;
+	struct hwrev_adc adc[3];
+	const char *dtb_uboot;	/* dtbs/<name>.dtb on the boot partition */
+	const char *dtb_kernel;	/* fdts/<name>.dtb, picked by extlinux FDTDIR */
+	u8 fb_rotate;
+	u16 ram_min_mb;		/* RAM window, 0 = no bound */
+	u16 ram_max_mb;
+};
+
+#define NO_ADC	{ { -1, 0 }, { -1, 0 }, { -1, 0 } }
+
+static const struct rk3566_board boards[] = {
+	{ "rg-arc-s",		{ { 1, 187 }, { -1, 0 } },
+	  "rk3566-anbernic-rg-arc-s",	"rk3566-anbernic-rg-arc-s",	1 },
+	{ "powkiddy-rgb30",	{ { 1, 383 }, { 0, 1023 }, { -1, 0 } },
+	  "rk3566-powkiddy-rgb30",	"rk3566-powkiddy-rgb30",	0 },
+	{ "miniloong",		{ { 1, 922 }, { -1, 0 } },
+	  "rk3566-miniloong",		"rk3566-miniloong",		3 },
+	{ "powkiddy-x55",	{ { 1, 539 }, { 0, 527 }, { -1, 0 } },
+	  "rk3566-powkiddy-x55",	"rk3566-powkiddy-x55",		3 },
+	{ "rg-ds-plus",		{ { 1, 525 }, { 0, 1023 }, { -1, 0 } },
+	  "rk3566-anbernic-rg-ds-plus",	"rk3566-anbernic-rg-ds-plus",	0, 0, 2047 },
+	{ "rg-ds",		{ { 1, 525 }, { 0, 1023 }, { -1, 0 } },
+	  "rk3566-anbernic-rg-ds",	"rk3566-anbernic-rg-ds",	0, 2048, 0 },
+	{ "miyoo-flip",		{ { 0, 356 }, { -1, 0 } },
+	  "rk3566-miyoo-flip",		"rk3566-miyoo-flip",		0 },
+
+	/* Anything unrecognised: must stay last (the old rk-kernel.dtb). */
+	{ "rk3566",		NO_ADC,
+	  "rk3566-powkiddy-rgb30",	"rk3566-powkiddy-rgb30",	0 },
+};
+
+#define BOARD_DEFAULT (&boards[ARRAY_SIZE(boards) - 1])
+
+static void board_apply(const struct rk3566_board *b)
+{
+	char buf[64];
+
+	env_set("hwrev", b->name);
+	snprintf(buf, sizeof(buf), "dtbs/%s.dtb", b->dtb_uboot);
+	env_set("dtb_uboot", buf);
+	snprintf(buf, sizeof(buf), "%s.dtb", b->dtb_kernel);
+	env_set("dtb_kernel", buf);
+	snprintf(buf, sizeof(buf), "%d", b->fb_rotate);
+	env_set("fb_rotate", buf);
+}
+
+/*
+ * Select a board by name, replacing everything SARADC detection decided.  This
+ * is how hwrev.ini corrects a misdetection: naming the board is enough, so no
+ * stale value from the wrong profile can survive.
+ */
+int hwrev_apply_board(const char *name)
+{
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(boards); i++) {
+		if (!strcmp(name, boards[i].name)) {
+			board_apply(&boards[i]);
+			return 0;
+		}
+	}
+
+	return -ENOENT;
+}
+
+static bool board_matches(const struct rk3566_board *b, int *v)
+{
+	u64 ram_mb = gd->ram_size >> 20;
+	int i, n = 0;
+
+	if ((b->ram_min_mb && ram_mb < b->ram_min_mb) ||
+	    (b->ram_max_mb && ram_mb > b->ram_max_mb))
+		return false;
+
+	for (i = 0; i < ARRAY_SIZE(b->adc) && b->adc[i].ch >= 0; i++, n++) {
+		int got = v[b->adc[i].ch];
+
+		if (got < 0 || abs(got - b->adc[i].val) > HWREV_MARGIN)
+			return false;
+	}
+
+	return n > 0;
+}
+
+static int hwrev_detect(void)
+{
+	int v[2] = { -1, -1 };
+	unsigned int raw;
+	int ch, i;
+
+	for (ch = 0; ch < ARRAY_SIZE(v); ch++)
+		if (!adc_channel_single_shot("saradc", ch, &raw))
+			v[ch] = raw;
+
+	for (i = 0; i < ARRAY_SIZE(boards); i++)
+		if (board_matches(&boards[i], v))
+			break;
+
+	board_apply(i < ARRAY_SIZE(boards) ? &boards[i] : BOARD_DEFAULT);
+	printf("hwrev: saradc ch0=%d ch1=%d, %llu MiB -> %s\n", v[0], v[1],
+	       (unsigned long long)(gd->ram_size >> 20), env_get("hwrev"));
+
+	return 0;
+}
+
+static int do_hwrev(cmd_tbl_t *cmdtp, int flag, int argc, char * const argv[])
+{
+	if (argc > 1) {
+		if (hwrev_apply_board(argv[1])) {
+			printf("hwrev: unknown board '%s'\n", argv[1]);
+			return CMD_RET_FAILURE;
+		}
+		return CMD_RET_SUCCESS;
+	}
+
+	return hwrev_detect() ? CMD_RET_FAILURE : CMD_RET_SUCCESS;
+}
+
+U_BOOT_CMD(
+	hwrev, 2, 1, do_hwrev,
+	"detect or select the RK3566 board",
+	"[board]"
+);
+
+/*
+ * The boot FAT partition: part 3 on the current GPT layout, part 1 on older
+ * Knulli/JELOS cards -- the same search resource.img uses.
+ */
+static const int fat_parts[] = { 3, 1 };
+
+int hwrev_fat_read(const char *path, void *buf, loff_t max, loff_t *size)
+{
+	struct blk_desc *dev_desc = rockchip_get_bootdev();
+	const char *ifname;
+	char devpart[16];
+	int i;
+
+	if (!dev_desc)
+		return -ENODEV;
+	ifname = blk_get_if_type_name(dev_desc->if_type);
+
+	for (i = 0; i < ARRAY_SIZE(fat_parts); i++) {
+		loff_t len = 0, actread = 0;
+
+		snprintf(devpart, sizeof(devpart), "%d:%d",
+			 dev_desc->devnum, fat_parts[i]);
+		if (fs_set_blk_dev(ifname, devpart, FS_TYPE_FAT) ||
+		    fs_size(path, &len) || len <= 0)
+			continue;
+		if (len > max)
+			return -EFBIG;
+
+		fs_set_blk_dev(ifname, devpart, FS_TYPE_FAT);
+		if (fs_read(path, (ulong)buf, 0, len, &actread) ||
+		    actread != len)
+			return -EIO;
+
+		*size = len;
+		return 0;
+	}
+
+	return -ENOENT;
+}
+
+/*
+ * Optional manual override: hwrev.ini on the boot FAT partition, one U-Boot
+ * command per line ('#' comments and blank lines skipped).  It runs after the
+ * SARADC detection and before anything consumes its results.
+ */
+#define HWREV_INI	"/hwrev.ini"
+#define HWREV_INI_MAX	8192
+
+static int hwrev_ini_load(char *buf)
+{
+	loff_t size = 0;
+
+	if (hwrev_fat_read(HWREV_INI, buf, HWREV_INI_MAX, &size))
+		return -ENOENT;
+
+	buf[size] = '\0';
+
+	return 0;
+}
+
+/* Run every non-comment line as a U-Boot command.  Destroys the buffer. */
+static void hwrev_ini_run(char *p)
+{
+	char *eol;
+	size_t len;
+
+	while (*p) {
+		eol = strchr(p, '\n');
+		if (eol)
+			*eol = '\0';
+
+		while (*p == ' ' || *p == '\t')
+			p++;
+
+		/* strip CR and trailing blanks: these files are often CRLF */
+		len = strlen(p);
+		while (len && (p[len - 1] == '\r' || p[len - 1] == ' ' ||
+			       p[len - 1] == '\t'))
+			p[--len] = '\0';
+
+		if (*p && *p != '#')
+			run_command(p, 0);
+
+		if (!eol)
+			break;
+		p = eol + 1;
+	}
+}
+
+static void hwrev_apply_override(void)
+{
+	ALLOC_CACHE_ALIGN_BUFFER(char, buf, HWREV_INI_MAX + 1);
+	char detected[24];
+	const char *now;
+
+	if (hwrev_ini_load(buf))
+		return;
+
+	printf("hwrev.ini:\n");
+
+	strlcpy(detected, env_get("hwrev") ? : "", sizeof(detected));
+
+	hwrev_ini_run(buf);
+
+	/*
+	 * The file named a different board.  Apply that board's whole profile:
+	 * detection's values must not survive next to it, and a file that fixes
+	 * hwrev but forgets dtb_kernel would otherwise leave exactly the
+	 * half-and-half mixture this override exists to prevent.  Then replay
+	 * the file so its own settings still win over the profile.
+	 */
+	now = env_get("hwrev") ? : "";
+	if (strcmp(detected, now) && !hwrev_apply_board(now) &&
+	    !hwrev_ini_load(buf)) {
+		printf("hwrev: %s profile applied\n", now);
+		hwrev_ini_run(buf);
+	}
+}
+
+/*
+ * Detect the board, let hwrev.ini override it, then publish what the rest of
+ * the boot consumes: fdtfile for extlinux FDTDIR, fbcon_rotate for its APPEND
+ * line (hwrev itself reaches Linux as board=${hwrev}).
+ */
+void hwrev_setup(void)
+{
+	hwrev_detect();
+	hwrev_apply_override();
+
+	env_set("fdtfile", env_get("dtb_kernel"));
+	env_set("fbcon_rotate", env_get("fb_rotate") ? : "0");
+
+	printf("hwrev: %s %s %s\n", env_get("hwrev"), env_get("dtb_uboot"),
+	       env_get("fdtfile"));
+}
