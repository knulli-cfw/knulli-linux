-				  const char *name, void *fdt_addr)
-{
-	char path[DTB_OVERRIDE_MAXLEN + 2];
-	loff_t dtb_size = 0, actread = 0;
-
-	snprintf(path, sizeof(path), "%s%s",
-		 (name[0] == '/') ? "" : "/", name);
-
-	if (fs_set_blk_dev(ifname, devpart, FS_TYPE_FAT) ||
-	    fs_size(path, &dtb_size) || dtb_size <= 0)
-		return -ENOENT;
-
-	fs_set_blk_dev(ifname, devpart, FS_TYPE_FAT);
-	if (fs_read(path, (ulong)fdt_addr, 0, dtb_size, &actread) ||
-	    actread != dtb_size)
-		return -EIO;
-
-	if (fdt_check_header(fdt_addr))
-		return -EBADF;
-
-	return 0;
-}
-
-static int rockchip_read_dtb_override(void *fdt_addr,
-				      struct resource_file **out_file)
-{
-	static const int fat_parts[] = { 3, 1 };
-	struct blk_desc *dev_desc;
-	const char *ifname;
-	char devpart[16];
-	/* cache-aligned: FAT/MMC reads DMA into this buffer */
-	ALLOC_CACHE_ALIGN_BUFFER(char, buf, DTB_OVERRIDE_MAXLEN + 1);
-	int i;
-
-	*out_file = NULL;
-
-	dev_desc = rockchip_get_bootdev();
-	if (!dev_desc)
-		return -ENODEV;
-	ifname = blk_get_if_type_name(dev_desc->if_type);
-
-	for (i = 0; i < ARRAY_SIZE(fat_parts); i++) {
-		loff_t file_size = 0, actread = 0;
-		char *line, *save = NULL;
-
-		snprintf(devpart, sizeof(devpart), "%d:%d",
-			 dev_desc->devnum, fat_parts[i]);
-		if (fs_set_blk_dev(ifname, devpart, FS_TYPE_FAT) ||
-		    fs_size(DTB_OVERRIDE_FILE, &file_size) || file_size <= 0)
-			continue;
-
-		if (file_size > DTB_OVERRIDE_MAXLEN)
-			file_size = DTB_OVERRIDE_MAXLEN;
-
-		fs_set_blk_dev(ifname, devpart, FS_TYPE_FAT);
-		if (fs_read(DTB_OVERRIDE_FILE, (ulong)buf, 0,
-			    file_size, &actread) || actread <= 0)
-			continue;
-		buf[actread] = '\0';
-		save = buf;
-
-		/* Walk lines: first name that resolves wins. */
-		while ((line = strsep(&save, "\r\n")) != NULL) {
-			struct resource_file *file;
-			char *name = line, *end;
-
-			while (*name == ' ' || *name == '\t')
-				name++;
-			if (*name == '\0' || *name == '#')
-				continue;
-			/* trim trailing whitespace */
-			end = name + strlen(name);
-			while (end > name && (end[-1] == ' ' || end[-1] == '\t'))
-				*--end = '\0';
-
-			/* (a) standalone .dtb file on this FAT partition */
-			if (ends_with_dtb(name) &&
-			    !load_dtb_file_from_fat(ifname, devpart, name,
-						    fdt_addr)) {
-				printf("DTB override[%s]: %s (file)\n",
-				       devpart, name);
-				return 1;
-			}
-
-			/* (b) entry packed in resource.img */
-			file = get_file_info(name);
-			if (file) {
-				printf("DTB override[%s]: %s (resource.img)\n",
-				       devpart, name);
-				*out_file = file;
-				return 0;
-			}
-
-			printf("DTB override: '%s' not found (file or resource.img)\n",
-			       name);
-		}
-
-		/* File was present but nothing resolved: stop, fall to hwid. */
-		return -ENOENT;
-	}
-
-	return -ENOENT;
-}
+/* Largest U-Boot dtb accepted from the boot partition. */
+#define HWREV_DTB_MAX	(2 << 20)
 
 int rockchip_read_resource_dtb(void *fdt_addr, char **hash, int *hash_size)
 {
 	struct resource_file *file;
+	char path[80];
+	loff_t size = 0;
 	int ret;
 
-	/* TEMP diagnostic: dump all SARADC channels (find a charge-stable hwid) */
-	{
-		unsigned int v;
-		int ch;
+	/*
+	 * Board profile: SARADC detection, then /hwrev.ini.  It names the U-Boot
+	 * dtb (dtbs/<name>.dtb on the boot partition) and sets fdtfile and
+	 * fbcon_rotate for extlinux.
+	 */
+	hwrev_setup();
 
-		for (ch = 0; ch < 8; ch++) {
-			if (!adc_channel_single_shot("saradc", ch, &v))
-				printf("hwid-dump: saradc ch%d = %u\n", ch, v);
-		}
+	snprintf(path, sizeof(path), "/%s", env_get("dtb_uboot") ? : "");
+	if (!hwrev_fat_read(path, fdt_addr, HWREV_DTB_MAX, &size) &&
+	    !fdt_check_header(fdt_addr)) {
+		*hash = NULL;
+		*hash_size = 0;
+		printf("DTB: %s\n", path);
+		return 0;
 	}
 
 	/*
-	 * Boot-partition file override wins over hwid auto-detection. It can
-	 * either load a standalone .dtb straight into fdt_addr (ret == 1) or
-	 * select a resource.img entry (ret == 0, 'file' set).
+	 * A boot partition without dtbs/ (older image): fall back to the
