From: knulli
Subject: [PATCH] sunxi: TrimUI Smart Pro S charge mode, battery detect, backlight and GPT fixes

---
--- a/board/sunxi/power_manage.c
+++ b/board/sunxi/power_manage.c
@@ -738,6 +738,9 @@
 			if (gd->chargemode == 1) {
 				pr_msg("start up to charge mode\n");
 				axp_show_bmp("bat\\battery_charge.bmp", 1);
+				mdelay(3000);
+				axp_black_light_control(DISP_LCD_BACKLIGHT_DISABLE);
+				sunxi_bat_key_handle();
 				charge_mode_update = 1;
 			}
 			break;
--- a/drivers/sunxi_power/bmu_axp519.c
+++ b/drivers/sunxi_power/bmu_axp519.c
@@ -301,7 +301,10 @@
 
 	/* AXP519_CHG_SET1 & BIT6:
 	   0: batter exist
-	   1: batter no exist */
+	   1: batter no exist
+	   When battery_exist=1 in DTS, clear any stale BIT6 set by a prior boot
+	   that had battery_exist=0, then re-read to get a fresh hardware state. */
+	pmic_bus_clrbits(AXP519_RUNTIME_ADDR, AXP519_CHG_SET1, BIT(6));
 	pmic_bus_read(AXP519_RUNTIME_ADDR, AXP519_CHG_SET1, &data);
 	if (data & BIT(6)) {
 		check = 1;
--- a/drivers/video/pwm_backlight.c
+++ b/drivers/video/pwm_backlight.c
@@ -38,7 +38,7 @@
 {
 	struct pwm_backlight_priv *priv = dev_get_priv(dev);
 	uint duty_cycle;
-	int ret, i;
+	int ret;
 #ifndef CONFIG_AW_DRM
 	struct dm_regulator_uclass_platdata *plat;
 	if (priv->reg) {
@@ -56,16 +56,19 @@
 
 	duty_cycle = priv->period_ns * (priv->default_level - priv->min_level) /
 		(priv->max_level - priv->min_level + 1);
-	ret = pwm_set_config(priv->pwm, priv->channel, priv->period_ns,
-			     duty_cycle);
+	ret = pwm_config(priv->sunxi_pwm, duty_cycle, priv->period_ns);
 	if (ret)
 		return ret;
-	ret = pwm_set_enable(priv->pwm, priv->channel, true);
+	ret = pwm_enable(priv->sunxi_pwm);
 	if (ret)
 		return ret;
 	mdelay(10);
+#ifdef CONFIG_DM_GPIO
 	dm_gpio_set_value(&priv->enable, 1);
+#endif
 #else
+	{
+	int i;
 	if (priv->regulator) {
 		sunxi_drm_power_enable(priv->regulator, 0);
 		mdelay(120);
@@ -87,15 +90,15 @@
 	for (i = 0; i < GPIO_NUM_MAX; i++) {
 		sunxi_drm_gpio_set_value(priv->enable_gpio[i], 1);
 	}
-
+	}
 #endif
 	return 0;
 }
