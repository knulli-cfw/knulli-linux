--- a/sprite/sprite_download.c
+++ b/sprite/sprite_download.c
@@ -44,7 +44,10 @@
 
 DECLARE_GLOBAL_DATA_PTR;
 
-#define GPT_BUFF_SIZE        (8*1024)
+/* MBR(512) + GPT header(512) + 128 entries * 128 bytes = 17408 bytes = 34 sectors.
+ * Must be large enough for the full entry array or sunxi_update_gpt will CRC
+ * over heap garbage past the end of the buffer and corrupt the partition table. */
+#define GPT_BUFF_SIZE        (GPT_ENTRY_OFFSET + 128 * 128)
 #define GPT_BUFF_4K_SIZE        (8 * 1024 * 8)
 #ifndef SUNXI_UFS_ALIGN_SECTOR
 #define SUNXI_UFS_ALIGN_SECTOR 8
@@ -1217,13 +1220,13 @@
 	typedef int (*FLASH_WIRTE)(uint start_block, uint nblock, void *buffer);
 	FLASH_WIRTE flash_write_pt = NULL;
 	char *buf;
-	int   data_len = GPT_UPDATE_BUF_SIZE;
+	int   data_len = GPT_BUFF_SIZE;
 	int   ret = 0;
 	int storage_type = get_boot_storage_type();
 	int i, j;
 
 	char char8_name[PARTNAME_SZ] = { 0 };
-	buf = (char *)memalign(CONFIG_SYS_CACHELINE_SIZE, GPT_UPDATE_BUF_SIZE);
+	buf = (char *)memalign(CONFIG_SYS_CACHELINE_SIZE, GPT_BUFF_SIZE);
 	if (buf == NULL) {
 		pr_err("malloc fail\n");
 		return -1;
