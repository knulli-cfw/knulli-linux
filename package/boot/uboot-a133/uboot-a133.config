# Fragment on top of sun50iw10p1_defconfig (orangepi-xunlong/u-boot-orangepi,
# branch v2018.05-h618).  No display: the kernel's disp2 brings the panel up.
CONFIG_AXP2202_POWER=y
CONFIG_AXP2202_SUNXI_I2C_SLAVE=0x34
CONFIG_SUNXI_BMU=y
# no env partition: the compiled-in environment is the whole configuration
CONFIG_ENV_IS_NOWHERE=y
# CONFIG_ENV_IS_IN_SUNXI_FLASH is not set
# extlinux: kernel, initrd and DTB come from the bootable FAT partition
# (patches/0001 lets a 32-bit build booti and honours the fdt)
CONFIG_CMD_PXE=y
CONFIG_CMD_BOOTI=y
CONFIG_CMD_PART=y
CONFIG_HUSH_PARSER=y
CONFIG_SUPPORT_RAW_INITRD=y
# no countdown; a key held on the UART still stops it
CONFIG_BOOTDELAY=0
CONFIG_USE_BOOTCOMMAND=y
# Board detection for extlinux's fdtdir: boot0's DRAM type (${dram_type})
# names the family: 8 Smart Pro, 3 Powkiddy (V90s; S03modules moves a V20
# on), 4 MagicX (Zero 28; S03modules moves a Zero 40/XU20 on), else TrimUI,
# where the Brick Pro's stick ADC answers at 0x28 on twi3 (PE3/PE4,
# function 2, pull-up; the pins are restored after).  twi3 is bus 0:
# adapters are numbered in link order, r_i2c0 (PMU) follows.
# The card is mmc 0, or mmc 2 on the MagicX boards.
CONFIG_I2C3_ENABLE=y
CONFIG_SYS_SUNXI_I2C3_SPEED=200000
CONFIG_BOOTCOMMAND="setenv fdtfile sun50i-a133-trimui-brick.dtb; if test \"${dram_type}\" = 8; then setenv fdtfile sun50i-a133-trimui-smart-pro.dtb; elif test \"${dram_type}\" = 3; then setenv fdtfile sun50i-a133-powkiddy-v90s.dtb; elif test \"${dram_type}\" = 4; then setenv fdtfile sun50i-a133-magicx-zero28.dtb; else setexpr pecfg *0x0300b090; setexpr pepull *0x0300b0ac; setexpr v ${pecfg} \"&\" 0xfff00fff; setexpr v ${v} \"|\" 0x22000; mw.l 0x0300b090 ${v}; setexpr v ${pepull} \"&\" 0xfffffc3f; setexpr v ${v} \"|\" 0x140; mw.l 0x0300b0ac ${v}; i2c dev 0; if i2c read 0x28 0xb0 1 ${scriptaddr}; then setenv fdtfile sun50i-a133-trimui-brick-pro.dtb; fi; mw.l 0x0300b090 ${pecfg}; mw.l 0x0300b0ac ${pepull}; fi; for d in 0 2; do if mmc dev ${d}; then part list mmc ${d} -bootable devplist; for p in ${devplist}; do sysboot mmc ${d}:${p} fat ${scriptaddr} /extlinux/extlinux.conf; done; fi; done"
