# Fragment on top of sun50iw9p1_defconfig (orangepi-xunlong/u-boot-orangepi,
# branch v2018.05-h618).  U-Boot needs the PMU (AXP2202 on R_I2C0), the
# extlinux loader and, once the board is known, the panel for the logo; the
# kernel can bring the panels up itself (board/allwinner/h700/linux_patches/0004).
CONFIG_AXP2202_POWER=y
CONFIG_AXP2202_SUNXI_I2C_SLAVE=0x34
CONFIG_SUNXI_BMU=y
# no env partition: the compiled-in environment is the whole configuration
CONFIG_ENV_IS_NOWHERE=y
# CONFIG_ENV_IS_IN_SUNXI_FLASH is not set
CONFIG_CMD_EXT2=y
# extlinux: kernel, initrd and the per-device DTB come from the bootable
# FAT partition (patches/0001 lets a 32-bit build booti and honours the fdt)
CONFIG_CMD_PXE=y
CONFIG_CMD_BOOTI=y
CONFIG_CMD_PART=y
CONFIG_HUSH_PARSER=y
CONFIG_SUPPORT_RAW_INITRD=y
CONFIG_BOOTDELAY=0
CONFIG_USE_BOOTCOMMAND=y
# knulli.env (written by /usr/bin/knulli-device once the board is known):
# knulli_device and knulli_logo; with it the board's DTB drives the panel
# init and the logo is up before the kernel (knulli_disp, patches/0003).
# Without it (first boot, select DTB) the display stays off.  After "part
# list": before it the card's partition table is not scanned yet.
# DTB and logo at 0x60000000: the secure monitor from the boot package runs
# at 0x48000000 and U-Boot never calls it before the jump to the kernel, so
# overwriting it only shows as a silent hang after "Starting kernel".
CONFIG_BOOTCOMMAND="part list mmc 0 -bootable devplist; for p in ${devplist}; do if fatload mmc 0:${p} ${pxefile_addr_r} knulli.env; then env import -t ${pxefile_addr_r} ${filesize}; if fatload mmc 0:${p} 0x60000000 dtb/sun50i-h700-anbernic-${knulli_device}.dtb && fatload mmc 0:${p} 0x60200000 ${knulli_logo}; then knulli_disp 0x60000000 0x60200000; fi; fi; sysboot mmc 0:${p} fat ${scriptaddr} /extlinux/extlinux.conf; done"
# display on request only: the boot package DTB describes no real board
CONFIG_DISP2_SUNXI=y
CONFIG_BOOT_GUI=y
CONFIG_SUNXI_DISP_ON_DEMAND=y
CONFIG_LCD_SUPPORT_ANBERNIC_H700=y
# CONFIG_CMD_SUNXI_BMP is not set
