+/* Generated by board/allwinner/h700/scripts/panel2c.py from
+ * board/allwinner/h700/panels/*.txt; do not edit. */
+
+struct anbernic_panel {
+	const char *name;
+	const u8 *cmds;
+	u32 cmds_len;
+};
+
+/* rg28xx */
