--- /dev/null
+++ b/board/sunxi/knulli_disp.c
@@ -0,0 +1,155 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * knulli_disp: bring the display up from a board device tree on request.
+ *
+ * knulli's H700 image boots every board with one U-Boot and one boot
+ * package; the panel is only known from the per-board device tree picked
+ * after the first boot.  The display code reads its configuration through
+ * working_fdt, so point that at the board's tree, run the init the vendor
+ * U-Boot does at board init, and show a bmp.  At bootm the frame buffer is
+ * handed to the kernel (knulli_disp_handoff) so disp2 keeps the picture
+ * instead of re-initialising the panel.
+ *
+ *   knulli_disp <dtb addr> [<bmp addr>]
+ */
+#include <common.h>
+#include <command.h>
+#include <fdt_support.h>
+#include <linux/libfdt.h>
+#include <mapmem.h>
+#include <asm/io.h>
+#include <asm/arch/gic.h>
+
+DECLARE_GLOBAL_DATA_PTR;
+
+extern s32 drv_disp_init(void);
+extern int boot_gui_init(void);
+extern int save_disp_cmd(void);
+extern int show_bmp_on_fb(char *bmp_head_addr, unsigned int fb_id);
+extern int irq_disable(int irq_no);
+
+static int knulli_disp_on;
+
+static int do_knulli_disp(cmd_tbl_t *cmdtp, int flag, int argc,
+			  char *const argv[])
+{
+	void *fdt;
+	int ret;
+
+	if (argc < 2)
+		return CMD_RET_USAGE;
+	if (knulli_disp_on) {
+		puts("knulli_disp: display already up\n");
+		return CMD_RET_FAILURE;
+	}
+	fdt = map_sysmem(simple_strtoul(argv[1], NULL, 16), 0);
+	if (fdt_check_header(fdt)) {
+		puts("knulli_disp: not a device tree\n");
+		return CMD_RET_FAILURE;
+	}
+	/* room for the props the display code stores in it */
+	fdt_open_into(fdt, fdt, fdt_totalsize(fdt) + 0x4000);
+	set_working_fdt_addr((ulong)fdt);
+
+	ret = drv_disp_init();
+	if (ret) {
+		printf("knulli_disp: disp init %d\n", ret);
+		return CMD_RET_FAILURE;
+	}
+	/* fb_init() returns the number of frame buffers: > 0 is success */
+	ret = boot_gui_init();
+	if (ret < 0) {
+		printf("knulli_disp: gui init %d\n", ret);
+		return CMD_RET_FAILURE;
+	}
+	knulli_disp_on = 1;
+	if (argc > 2)
+		show_bmp_on_fb(map_sysmem(simple_strtoul(argv[2], NULL, 16), 0), 0);
+	return CMD_RET_SUCCESS;
+}
+
+/*
+ * Called from sunxi_update_fdt_para_for_kernel() with working_fdt = the
+ * kernel's tree.  Hand the kernel the logo only, not the running display:
+ * with boot_disp set, disp2 adopts U-Boot's pipeline (smooth boot) and on
+ * the 5.4 BSP that keeps U-Boot's layer on top of the frame buffer and
+ * misses the tcon clock reparenting of knulli's trees.  With boot_disp = 0
+ * it re-initialises the display and still copies boot_fb0 into its frame
+ * buffer, so the logo stays up across the kernel's panel init.
+ *
+ * save_disp_cmd() writes /soc/disp, the kernel's disp node; knulli's trees
+ * also carry the vendor disp node the "disp" alias names, which disp2 reads
+ * first when it has boot_disp, so set both.
+ */
+static void knulli_disp_set_props(int node)
+{
+	char *s = env_get("boot_fb0");
+
+	if (s)
+		fdt_setprop_string(working_fdt, node, "boot_fb0", s);
+	fdt_setprop_u32(working_fdt, node, "boot_disp", 0);
+	fdt_setprop_u32(working_fdt, node, "boot_disp1", 0);
+	fdt_setprop_u32(working_fdt, node, "boot_disp2", 0);
+}
+
+void knulli_disp_handoff(void)
+{
+	unsigned long size, addr;
+	char *s, *end;
+	int node;
+
+	if (!knulli_disp_on)
+		return;
+	save_disp_cmd();
+
+	node = fdt_path_offset(working_fdt, "disp");
+	if (node >= 0)
+		knulli_disp_set_props(node);
+	node = fdt_node_offset_by_compatible(working_fdt, -1,
+					     "allwinner,sunxi-disp");
+	if (node >= 0)
+		knulli_disp_set_props(node);
+	/* the panel runs the board's init table already (kernel patch 0023) */
+	node = fdt_node_offset_by_compatible(working_fdt, -1,
+					     "allwinner,sunxi-lcd0");
+	if (node >= 0)
+		fdt_setprop(working_fdt, node, "knulli,panel-ready", NULL, 0);
+
+	/* the logo stays where it is until disp2 has copied it */
+	s = env_get("disp_reserve");	/* "<size>,0x<addr>" */
+	if (s) {
+		size = simple_strtoul(s, &end, 0);
+		if (*end == ',') {
+			addr = simple_strtoul(end + 1, NULL, 16);
+			fdt_add_mem_rsv(working_fdt, addr, size);
+		}
+	}
+	printf("knulli_disp: logo hand-off boot_fb0=%s\n",
+	       env_get("boot_fb0") ?: "-");
+}
+
+/*
+ * Called from board_quiesce_devices() right before the jump to the kernel.
+ * The display code enabled the tcon/de interrupts and the timer that runs
+ * the LCD open flow; the display-less boot never enabled any interrupt.
+ * Leave none armed for the switch to the kernel (it programs the GIC
+ * itself); the display keeps scanning out without them.
+ */
+void knulli_disp_quiesce(void)
+{
+	int irq;
+
+	if (!knulli_disp_on)
+		return;
+	disable_interrupts();
+	for (irq = 32; irq < GIC_IRQ_NUM; irq++)
+		irq_disable(irq);
+	for (irq = 32; irq < GIC_IRQ_NUM; irq += 32)
+		writel(0xffffffff, GIC_PEND_CLR(irq >> 5));
+}
+
+U_BOOT_CMD(
+	knulli_disp, 3, 0, do_knulli_disp,
+	"bring the display up from a board device tree",
+	"<dtb addr> [<bmp addr>]"
+);
--- /dev/null
+++ b/drivers/video/sunxi/disp2/disp/lcd/anbernic_h700.c
@@ -0,0 +1,240 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * disp2 panel driver for the Anbernic H700 handhelds, U-Boot side (knulli).
+ * The same driver as the kernel's lcd/fog_fj035fhd05_v1.c (knulli kernel
+ * patch 0004): RGB panels set up over a bit-banged 3-wire 9-bit SPI bus on
+ * lcd_gpio_0..4 (SCK, MOSI, CS active low, reset active low, power) with
+ * the vendor init tables of anbernic_panels.h.
+ *
+ * The U-Boot copy of lcd0 in knulli's device trees is the vendor node; the
+ * table name (lcd_panel_init) and the panel generation pin (lcd_id_gpio,
+ * PE6: low = second table) are read from the kernel's lcd0 node
+ * (compatible "allwinner,sunxi-lcd0") of the same tree.
+ */
+#include "anbernic_h700.h"
+#include <sys_config.h>
+#include "anbernic_panels.h"
+
+#define GPIO_SCK	0
+#define GPIO_MOSI	1
+#define GPIO_CS		2
+#define GPIO_RESET	3
+#define GPIO_POWER	4
+
+#define DCS_ENTER_SLEEP_MODE	0x10
+
+static void LCD_power_on(u32 sel);
+static void LCD_power_off(u32 sel);
+static void LCD_bl_open(u32 sel);
+static void LCD_bl_close(u32 sel);
+static void LCD_panel_init(u32 sel);
+static void LCD_panel_exit(u32 sel);
+
+/* 0: first table, 1: second table (vendor "boe", lcd_id gpio low) */
+static int anbernic_panel_type(int node)
+{
+	user_gpio_set_t id;
+	ulong h;
+	int level;
+
+	memset(&id, 0, sizeof(id));
+	if (fdt_get_one_gpio_by_offset(node, "lcd_id_gpio", &id) < 0)
+		return 0;
+	id.mul_sel = 0;		/* input, keep the pull the tree asks for */
+	h = sunxi_gpio_request(&id, 1);
+	if (!h)
+		return 0;
+	sunxi_lcd_delay_ms(1);
+	level = gpio_read_one_pin_value(h, NULL);
+	printf("anbernic panel: lcd_id reads %s\n", level ? "high" : "low");
+	return level ? 0 : 1;
+}
+
+static const struct anbernic_panel *anbernic_panel_lookup(u32 sel)
+{
+	const char *want = NULL;
+	unsigned int i;
+	int node, n, type;
+
+	node = fdt_node_offset_by_compatible(working_fdt, -1,
+					     "allwinner,sunxi-lcd0");
+	if (node >= 0) {
+		n = fdt_stringlist_count(working_fdt, node, "lcd_panel_init");
+		if (n > 0) {
+			type = n > 1 ? anbernic_panel_type(node) : 0;
+			if (type >= n)
+				type = 0;
+			want = fdt_stringlist_get(working_fdt, node,
+						  "lcd_panel_init", type, NULL);
+		}
+	}
+	if (!want)
+		want = "rg35xx-plus-old";
+
+	for (i = 0; i < ARRAY_SIZE(anbernic_panels); i++)
+		if (!strcmp(anbernic_panels[i].name, want))
+			break;
+	if (i == ARRAY_SIZE(anbernic_panels))
+		i = 0;
+	printf("anbernic panel: init table %s\n", anbernic_panels[i].name);
+	return &anbernic_panels[i];
+}
+
+/* one 9-bit word: D/C bit first, then the byte MSB first; SPI mode 0 */
+static void spi3_write_word(u32 sel, bool data, u8 byte)
+{
+	u32 word = (data ? 0x100 : 0) | byte;
+	int bit;
+
+	sunxi_lcd_gpio_set_value(sel, GPIO_CS, 0);
+	sunxi_lcd_delay_us(1);
+	for (bit = 8; bit >= 0; bit--) {
+		sunxi_lcd_gpio_set_value(sel, GPIO_MOSI, (word >> bit) & 1);
+		sunxi_lcd_delay_us(1);
+		sunxi_lcd_gpio_set_value(sel, GPIO_SCK, 1);
+		sunxi_lcd_delay_us(1);
+		sunxi_lcd_gpio_set_value(sel, GPIO_SCK, 0);
+	}
+	sunxi_lcd_delay_us(1);
+	sunxi_lcd_gpio_set_value(sel, GPIO_CS, 1);
+	sunxi_lcd_delay_us(1);
+}
+
+static void spi3_write_cmd(u32 sel, const u8 *buf, u32 len)
+{
+	u32 i;
+
+	spi3_write_word(sel, false, buf[0]);
+	for (i = 1; i < len; i++)
+		spi3_write_word(sel, true, buf[i]);
+}
+
+/* a length byte then that many bytes; length 0 is followed by a delay in ms */
+static void anbernic_run_cmds(u32 sel, const u8 *cmds, u32 len)
+{
+	u32 i = 0;
+
+	while (i + 1 < len) {
+		u8 n = cmds[i];
+
+		if (n == 0) {
+			sunxi_lcd_delay_ms(cmds[i + 1]);
+			i += 2;
+			continue;
+		}
+		if (i + 1 + n > len)
+			break;
+		spi3_write_cmd(sel, &cmds[i + 1], n);
+		i += 1 + n;
+	}
+}
+
+static void LCD_cfg_panel_info(panel_extend_para *info)
+{
+	u32 i;
+
+	for (i = 0; i < 256; i++)
+		info->lcd_gamma_tbl[i] = (i << 16) + (i << 8) + i;
+}
+
+static s32 LCD_open_flow(u32 sel)
+{
+	LCD_OPEN_FUNC(sel, LCD_power_on, 20);
+	LCD_OPEN_FUNC(sel, LCD_panel_init, 10);
+	LCD_OPEN_FUNC(sel, sunxi_lcd_tcon_enable, 100);
+	LCD_OPEN_FUNC(sel, LCD_bl_open, 0);
+	return 0;
+}
+
+static s32 LCD_close_flow(u32 sel)
+{
+	LCD_CLOSE_FUNC(sel, LCD_bl_close, 0);
+	LCD_CLOSE_FUNC(sel, sunxi_lcd_tcon_disable, 0);
+	LCD_CLOSE_FUNC(sel, LCD_panel_exit, 10);
+	LCD_CLOSE_FUNC(sel, LCD_power_off, 100);
+	return 0;
+}
+
+static void LCD_power_on(u32 sel)
+{
+	sunxi_lcd_power_enable(sel, 0);
+	sunxi_lcd_pin_cfg(sel, 1);
+	/* bus idle: SCK low, CS high */
+	sunxi_lcd_gpio_set_value(sel, GPIO_SCK, 0);
+	sunxi_lcd_gpio_set_value(sel, GPIO_MOSI, 0);
+	sunxi_lcd_gpio_set_value(sel, GPIO_CS, 1);
+	sunxi_lcd_gpio_set_value(sel, GPIO_RESET, 1);
+	sunxi_lcd_gpio_set_value(sel, GPIO_POWER, 1);
+}
+
+static void LCD_power_off(u32 sel)
+{
+	sunxi_lcd_gpio_set_value(sel, GPIO_POWER, 0);
+	sunxi_lcd_pin_cfg(sel, 0);
+	sunxi_lcd_power_disable(sel, 0);
+}
+
+static void LCD_bl_open(u32 sel)
+{
+	sunxi_lcd_pwm_enable(sel);
+	sunxi_lcd_backlight_enable(sel);
+}
+
+static void LCD_bl_close(u32 sel)
+{
+	sunxi_lcd_backlight_disable(sel);
+	sunxi_lcd_pwm_disable(sel);
+}
+
+static void LCD_panel_init(u32 sel)
+{
+	const struct anbernic_panel *p = anbernic_panel_lookup(sel);
+
+	/* the vendor's reset pulse */
+	sunxi_lcd_gpio_set_value(sel, GPIO_RESET, 1);
+	sunxi_lcd_delay_ms(15);
+	sunxi_lcd_gpio_set_value(sel, GPIO_RESET, 0);
+	sunxi_lcd_delay_ms(50);
+	sunxi_lcd_gpio_set_value(sel, GPIO_RESET, 1);
+	sunxi_lcd_delay_ms(100);
+
+	anbernic_run_cmds(sel, p->cmds, p->cmds_len);
+	sunxi_lcd_delay_ms(20);
+}
+
+static void LCD_panel_exit(u32 sel)
+{
+	u8 cmd = DCS_ENTER_SLEEP_MODE;
+
+	spi3_write_cmd(sel, &cmd, 1);
+	sunxi_lcd_delay_ms(120);
+	sunxi_lcd_gpio_set_value(sel, GPIO_RESET, 0);
+}
+
+static s32 LCD_user_defined_func(u32 sel, u32 para1, u32 para2, u32 para3)
+{
+	return 0;
+}
+
+#define ANBERNIC_PANEL_FUNCS {					\
+	.cfg_panel_info = LCD_cfg_panel_info,			\
+	.cfg_open_flow = LCD_open_flow,				\
+	.cfg_close_flow = LCD_close_flow,			\
+	.lcd_user_defined_func = LCD_user_defined_func,		\
+}
+
+/* names must match lcd_driver_name in the vendor lcd0 node */
+__lcd_panel_t fog_fj035fhd05_v1_panel = {
+	.name = "fog_fj035fhd05_v1",
+	.func = ANBERNIC_PANEL_FUNCS,
+};
+
+__lcd_panel_t rg34xx_v1_panel = {
+	.name = "rg34xx_v1",
+	.func = ANBERNIC_PANEL_FUNCS,
+};
+
+__lcd_panel_t rg34xxsp_v1_panel = {
+	.name = "rg34xxsp_v1",
+	.func = ANBERNIC_PANEL_FUNCS,
+};
