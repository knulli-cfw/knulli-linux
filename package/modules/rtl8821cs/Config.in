config BR2_PACKAGE_RTL8821CS
	bool "Realtek RTL8821CS SDIO WiFi driver (Anbernic H700)"
	depends on BR2_LINUX_KERNEL
	help
	  Out-of-tree Realtek RTL8821CS SDIO WiFi vendor driver (v5.12.0),
	  built against the sunxi 5.4 BSP kernel with its sunxi-rf power
	  glue. Used by the Anbernic H700 devices.
