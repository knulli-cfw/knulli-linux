From: Knulli <noreply@knulli.org>
Subject: Build against the 6.1 BSP kernel

Version-gated compatibility for kernels older than the 6.18 the port targets:
timer_delete, ieee80211_tx_status_skb, chanreq vs chandef, MODULE_IMPORT_NS
form, stop() without suspend, ops without radio_idx, no chanctx emulation,
device_find_child match and platform remove signatures.

diff --git a/Makefile b/Makefile
index c798eb0..aac04c9 100755
--- a/Makefile
+++ b/Makefile
@@ -8,7 +8,7 @@
 CONFIG_RK915 ?= m
 
 # Include paths (relative to this directory)
-ccflags-y += -I$(src)/inc -I$(src)/shared
+ccflags-y += -I$(src)/inc -I$(src)/shared -include $(src)/inc/compat.h
 
 # Feature flags
 ccflags-y += -DDEBUG
diff --git a/inc/compat.h b/inc/compat.h
new file mode 100644
index 0000000..f415cd9
--- /dev/null
+++ b/inc/compat.h
@@ -0,0 +1,14 @@
+/* Compatibility with kernels older than the 6.18 this port targets. */
+#ifndef RK915_COMPAT_H
+#define RK915_COMPAT_H
+#include <linux/version.h>
+#if LINUX_VERSION_CODE < KERNEL_VERSION(6, 2, 0)
+#include <linux/timer.h>
+#define timer_delete(t)		del_timer(t)
+#define timer_delete_sync(t)	del_timer_sync(t)
+#endif
+#if LINUX_VERSION_CODE < KERNEL_VERSION(6, 9, 0)
+#define ieee80211_tx_status_skb(hw, skb)	ieee80211_tx_status(hw, skb)
+#define RK915_OLD_MAC80211_API 1
+#endif
+#endif
