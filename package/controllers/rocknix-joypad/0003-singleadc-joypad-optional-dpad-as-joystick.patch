From: knulli
Subject: [PATCH] singleadc-joypad: optional D-pad as an emulated left stick (dpad_mode)

Boards without analogue sticks (rocknix,dpad-joystick in the DT) get a
sysfs "dpad_mode": 0 = the hat as usual, 1 = the D-pad drives ABS_X/ABS_Y at
full deflection (rocknix,dpad-joystick-max, default 1800) and the hat is
held centred.  Same interface as the rk3566 BSP joypad, for dpad-toggle.

--- a/rocknix-singleadc-joypad.c	2026-09-25 02:03:16.177243653 +0000
+++ b/rocknix-singleadc-joypad.c	2026-09-25 02:03:16.188243647 +0000
@@ -169,6 +169,17 @@
 	struct device *dev;
 	int poll_interval;
 
+	/*
+	 * D-pad as an emulated left stick (rocknix,dpad-joystick; switched at
+	 * runtime via sysfs "dpad_mode"): the hat buttons drive ABS_X/ABS_Y at
+	 * full deflection instead of ABS_HAT0X/Y.
+	 */
+	bool has_dpad_joystick;
+	bool dpad_as_joystick;
+	bool dpad_resync;
+	int dpad_axis_max;
+	int dpad_x, dpad_y;
+
 	/* report enable/disable */
 	bool enable;
 
@@ -816,10 +827,68 @@
 
 /*----------------------------------------------------------------------------*/
 /*----------------------------------------------------------------------------*/
+/*
+ * /sys/devices/platform/<joypad>/dpad_mode [rw]: 0/"dpad" = the hat (default),
+ * 1/"joystick" = the D-pad drives ABS_X/ABS_Y.  Only with rocknix,dpad-joystick.
+ */
+static ssize_t joypad_show_dpad_mode(struct device *dev,
+				     struct device_attribute *attr, char *buf)
+{
+	struct joypad *joypad = platform_get_drvdata(to_platform_device(dev));
+
+	return sprintf(buf, "%d\n", joypad->dpad_as_joystick ? 1 : 0);
+}
+
+static ssize_t joypad_store_dpad_mode(struct device *dev,
+				      struct device_attribute *attr,
+				      const char *buf, size_t count)
+{
+	struct joypad *joypad = platform_get_drvdata(to_platform_device(dev));
+	bool want;
+
+	if (sysfs_streq(buf, "1") || sysfs_streq(buf, "joystick"))
+		want = true;
+	else if (sysfs_streq(buf, "0") || sysfs_streq(buf, "dpad"))
+		want = false;
+	else
+		return -EINVAL;
+	mutex_lock(&joypad->lock);
+	if (want != joypad->dpad_as_joystick) {
+		joypad->dpad_as_joystick = want;
+		joypad->dpad_resync = true;	/* applied in poll context */
+	}
+	mutex_unlock(&joypad->lock);
+	return count;
+}
+
+static DEVICE_ATTR(dpad_mode, S_IWUSR | S_IRUGO,
+		   joypad_show_dpad_mode, joypad_store_dpad_mode);
+
+static struct attribute *joypad_dpad_attrs[] = {
+	&dev_attr_dpad_mode.attr,
+	NULL,
+};
+
+static struct attribute_group joypad_dpad_attr_group = {
+	.attrs = joypad_dpad_attrs,
+};
+
+/* the active mode carries the live D-pad state, the other one is held neutral */
+static void joypad_dpad_report(struct joypad *joypad, struct input_dev *input)
+{
+	bool js = joypad->dpad_as_joystick;
+
+	input_report_abs(input, ABS_X, js ? joypad->dpad_x * joypad->dpad_axis_max : 0);
+	input_report_abs(input, ABS_Y, js ? joypad->dpad_y * joypad->dpad_axis_max : 0);
+	input_report_abs(input, ABS_HAT0X, js ? 0 : joypad->dpad_x);
+	input_report_abs(input, ABS_HAT0Y, js ? 0 : joypad->dpad_y);
+}
+
 static void joypad_gpio_check(struct input_polled_dev *poll_dev)
 {
 	struct joypad *joypad = poll_dev->private;
 	int nbtn, value;
+	bool dpad_touched = false;
 
 	for (nbtn = 0; nbtn < joypad->bt_gpio_count; nbtn++) {
 		struct bt_gpio *gpio = &joypad->gpios[nbtn];
@@ -830,13 +899,31 @@
 		}
 		value = gpio_get_value(gpio->num);
 		if (value != gpio->old_value) {
+			gpio->old_value = value;
+			if (joypad->has_dpad_joystick && gpio->report_type == EV_ABS &&
+			    (gpio->linux_code == ABS_HAT0X || gpio->linux_code == ABS_HAT0Y)) {
+				int *axis = gpio->linux_code == ABS_HAT0X ? &joypad->dpad_x : &joypad->dpad_y;
+
+				/* a direction is one button; the other direction releases it */
+				if (value == gpio->active_level)
+					*axis = gpio->input_value;
+				else if (*axis == gpio->input_value)
+					*axis = 0;
+				dpad_touched = true;
+				continue;
+			}
 			input_event(poll_dev->input,
 				gpio->report_type,
 				gpio->linux_code,
 				(value == gpio->active_level) ? gpio->input_value : 0);
-			gpio->old_value = value;
 		}
 	}
+	if (joypad->dpad_resync) {
+		joypad->dpad_resync = false;
+		dpad_touched = true;
+	}
+	if (dpad_touched)
+		joypad_dpad_report(joypad, poll_dev->input);
 	input_sync(poll_dev->input);
 }
 
@@ -1340,9 +1427,16 @@
 	 * We always want 4 axes available if using Miyoo
 	 * or if we have actual amux_count > 0
 	 */
-	if (joypad->amux_count > 0 || joypad->use_miyoo_serial) {
+	if (joypad->amux_count > 0 || joypad->use_miyoo_serial ||
+	    joypad->has_dpad_joystick) {
 		__set_bit(EV_ABS, input->evbit);
 	}
+	if (joypad->has_dpad_joystick && joypad->amux_count == 0) {
+		input_set_abs_params(input, ABS_X, -joypad->dpad_axis_max,
+				     joypad->dpad_axis_max, 0, 0);
+		input_set_abs_params(input, ABS_Y, -joypad->dpad_axis_max,
+				     joypad->dpad_axis_max, 0, 0);
+	}
 
 	// Set mapped ones on dt
 	for(nbtn = 0; nbtn < joypad->amux_count; nbtn++) {
@@ -1721,6 +1815,10 @@
 	device_property_read_u32(dev, "amux-count",
 				&joypad->amux_count);
 
+	joypad->has_dpad_joystick = device_property_present(dev, "rocknix,dpad-joystick");
+	joypad->dpad_axis_max = 1800;
+	device_property_read_u32(dev, "rocknix,dpad-joystick-max", &joypad->dpad_axis_max);
+
 	device_property_read_u32(dev, "poll-interval",
 				&joypad->poll_interval);
 
@@ -1851,6 +1949,13 @@
 			error);
 		return error;
 	}
+	if (joypad->has_dpad_joystick) {
+		error = sysfs_create_group(&pdev->dev.kobj, &joypad_dpad_attr_group);
+		if (error) {
+			dev_err(dev, "create dpad sysfs group fail, error: %d\n", error);
+			return error;
+		}
+	}
 
 	/* poll input device setup */
 	error = joypad_input_setup(dev, joypad);
