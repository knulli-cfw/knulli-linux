config BR2_PACKAGE_MALI_LIBS
    bool "mali-libs"
    depends on BR2_PACKAGE_HAS_UDEV
    depends on BR2_TOOLCHAIN_HAS_THREADS
    depends on !BR2_STATIC_LIBS
    depends on BR2_INSTALL_LIBSTDCPP
    depends on BR2_TOOLCHAIN_GCC_AT_LEAST_4_9
    # no 'depends on WAYLAND': it closes a kconfig cycle back through
    # cog/wpewebkit to HAS_LIBGLES, which this package provides.  knulli-system
    # selects wayland unconditionally, so the dependency was always satisfied.
    select BR2_PACKAGE_LIBDRM
    help
      ARM Mali GPU userspace driver for Rockchip SoCs.
      
      Supports Mali Bifrost G52 for RK3566/RK3568.
      Works with both armhf (32-bit) and aarch64 (64-bit).
      
      https://github.com/knulli-cfw/libmali

if BR2_PACKAGE_MALI_LIBS

config BR2_PACKAGE_MALI_LIBS_PROVIDES_EGL
    bool "Provides EGL"
    default y
    select BR2_PACKAGE_HAS_LIBEGL
    help
      Select this if mali-libs should provide EGL.

config BR2_PACKAGE_MALI_LIBS_PROVIDES_GLES
    bool "Provides OpenGL ES"
    default y
    select BR2_PACKAGE_HAS_LIBGLES
    help
      Select this if mali-libs should provide OpenGL ES.

config BR2_PACKAGE_MALI_LIBS_PROVIDES_GBM
    bool "Provides GBM"
    default y
    select BR2_PACKAGE_HAS_LIBGBM
    help
      Select this if mali-libs should provide GBM.

# Virtual package provider declarations
if BR2_PACKAGE_MALI_LIBS_PROVIDES_EGL
config BR2_PACKAGE_PROVIDES_LIBEGL
    default "mali-libs"
endif

if BR2_PACKAGE_MALI_LIBS_PROVIDES_GLES
config BR2_PACKAGE_PROVIDES_LIBGLES
    default "mali-libs"
endif

if BR2_PACKAGE_MALI_LIBS_PROVIDES_GBM
config BR2_PACKAGE_PROVIDES_LIBGBM
    default "mali-libs"
endif

endif

comment "libmali needs udev, toolchain w/ threads, dynamic library, C++, gcc >= 4.9"
    depends on !BR2_PACKAGE_HAS_UDEV || !BR2_TOOLCHAIN_HAS_THREADS || \
        BR2_STATIC_LIBS || !BR2_INSTALL_LIBSTDCPP || \
        !BR2_TOOLCHAIN_GCC_AT_LEAST_4_9

