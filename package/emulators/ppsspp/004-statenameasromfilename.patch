 	std::string GetGamePrefix(const ParamSFOData &paramSFO) {
+		// batocera - name save states after the rom file, not the disc id, so
+		// they can be matched to the rom from outside the emulator.
+		const Path &romPath = PSP_CoreParameter().fileToStart;
+		if (!romPath.empty()) {
+			const std::string filename = romPath.GetFilename();
+			const size_t dot = filename.find_last_of('.');
+			return dot == std::string::npos ? filename : filename.substr(0, dot);
+		}
 		return GenerateFullDiscId(paramSFO);
 	}
 
