+#ifdef ADVDRASTIC_SDL_GL
+/* Save win/ctx pointers before releasing on main, so video_handler can
+ * pick them back up (SDL_GL_MakeCurrent(win, NULL) nulls current_glctx,
+ * so we can't rely on reading dev->current_glctx from video_handler
+ * after release). */
+static SDL_Window   *saved_glwin = NULL;
+static SDL_GLContext saved_glctx = NULL;
+
+/* Release SDL's GL context from the main thread (idempotent, one-shot).
+ * Called from any code path that is about to signal video_handler, so the
+ * mali blob will let video_handler's egl_init eglMakeCurrent the same
+ * context/surface from its own thread. */
+static void release_main_gl_context_once(void)
+{
+    static int done = 0;
+    SDL_VideoDevice *dev;
+    if (done) return;
+    dev = SDL_GetVideoDevice();
+    if (dev && dev->current_glwin && dev->current_glctx) {
+        saved_glwin = dev->current_glwin;
+        saved_glctx = dev->current_glctx;
+        SDL_GL_MakeCurrent(dev->current_glwin, NULL);
+        printf("release_main_gl_context_once: released (win=%p ctx=%p)\n",
+               saved_glwin, saved_glctx);
+    }
+    done = 1;
+}
+#endif
