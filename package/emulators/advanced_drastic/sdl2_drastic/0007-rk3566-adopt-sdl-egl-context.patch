 // 여긴 계속 호출되고 있음
+#ifdef ADVDRASTIC_SDL_GL
+/* Save win/ctx pointers before releasing on main, so video_handler can
+ * pick them back up (SDL_GL_MakeCurrent(win, NULL) nulls current_glctx,
+ * so we can't rely on reading dev->current_glctx from video_handler
+ * after release). */
+static SDL_Window   *saved_glwin = NULL;
+static SDL_GLContext saved_glctx = NULL;
+
+/* Release SDL's GL context from the main thread (idempotent, one-shot).
+ * Called from any code path that is about to signal video_handler, so the
+ * mali blob will let video_handler's egl_init eglMakeCurrent the same
+ * context/surface from its own thread. */
+static void release_main_gl_context_once(void)
+{
+    static int done = 0;
+    SDL_VideoDevice *dev;
+    if (done) return;
+    dev = SDL_GetVideoDevice();
+    if (dev && dev->current_glwin && dev->current_glctx) {
+        saved_glwin = dev->current_glwin;
+        saved_glctx = dev->current_glctx;
+        SDL_GL_MakeCurrent(dev->current_glwin, NULL);
+        printf("release_main_gl_context_once: released (win=%p ctx=%p)\n",
+               saved_glwin, saved_glctx);
+    }
+    done = 1;
+}
+
+/* Copy drastic's current NDS screen pixel buffers into a snapshot slot,
+ * then atomically publish that slot as consumer_idx. Called from main
+ * (drastic emulation thread) right before signalling video_handler. */
+static void snap_current_frame(void)
+{
+    int slot;
+    FrameSnap *s;
+    uint8_t hres0 = *(uint8_t *)VAR_SDL_SCREEN0_HRES_MODE;
+    uint8_t hres1 = *(uint8_t *)VAR_SDL_SCREEN1_HRES_MODE;
+    uint64_t *p0 = (uint64_t *)(*((uint64_t *)VAR_SDL_SCREEN0_PIXELS));
+    uint64_t *p1 = (uint64_t *)(*((uint64_t *)VAR_SDL_SCREEN1_PIXELS));
+    size_t sz0 = hres0 ? (NDS_Wx2 * NDS_Hx2 * 4) : (NDS_W * NDS_H * 4);
+    size_t sz1 = hres1 ? (NDS_Wx2 * NDS_Hx2 * 4) : (NDS_W * NDS_H * 4);
+
+    slot = snap_producer_idx;
+    s = &snap_slot[slot];
+    s->hres_mode0 = hres0;
+    s->hres_mode1 = hres1;
+    if (p0) memcpy(s->pixels0, p0, sz0);
+    if (p1) memcpy(s->pixels1, p1, sz1);
+
+    pthread_mutex_lock(&snap_mutex);
+    snap_consumer_idx = slot;
+    snap_producer_idx = 1 - slot;
+    pthread_mutex_unlock(&snap_mutex);
+}
+#endif
+
 void sdl_update_screens(void)
 {
+#ifdef ADVDRASTIC_SDL_GL
+    /* Threaded video: snapshot drastic's screen buffers into a ring slot,
+     * signal video_handler, return WITHOUT waiting. Main is free to
+     * emulate the next NDS frame immediately - render at native 60Hz
+     * regardless of how slow SDL_GL_SwapWindow is. */
+    release_main_gl_context_once();
+    snap_current_frame();
+    pthread_mutex_lock(&lock);
+    nds.update_screen = 1;
+    pthread_cond_signal(&request_update_screen_cond);
+    pthread_mutex_unlock(&lock);
+#else
     // acquire a lock
     pthread_mutex_lock(&lock);
-    
+
     nds.update_screen = 1;
     pthread_cond_signal(&request_update_screen_cond);
-    
+
     pthread_cond_wait(&response_update_screen_cond, &lock);
-    
-    // release lock 
-    pthread_mutex_unlock(&lock);     
+
+    // release lock
+    pthread_mutex_unlock(&lock);
+#endif
 }
 
