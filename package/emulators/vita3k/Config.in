config BR2_PACKAGE_VITA3K
    bool "vita3k"
    # selects, not depends: a "depends on sdl2" edge closes kconfig cycles back
    # through ffmpeg/kodi to this package's own selects.  Matches how batocera
    # writes the same package.
    select BR2_PACKAGE_SDL2
    select BR2_PACKAGE_SDL2_IMAGE
    select BR2_PACKAGE_SDL2_TTF
    select BR2_PACKAGE_LIBOGG
    select BR2_PACKAGE_LIBVORBIS
    select BR2_PACKAGE_ZLIB
    select BR2_PACKAGE_PYTHON_RUAMEL_YAML
    select BR2_PACKAGE_BOOST
    select BR2_PACKAGE_LIBGTK3
    help
      Experimental PlayStation Vita emulator

      https://github.com/vita3k/vita3k
