     pub tv_usec: __suseconds_t,
 }
+#[cfg(target_arch = "x86_64")]
 #[allow(clippy::unnecessary_operation, clippy::identity_op)]
 const _: () = {
     ["Size of timeval"][::std::mem::size_of::<timeval>() - 16usize];
@@ -73,6 +74,7 @@
     pub code: __u16,
     pub value: __s32,
 }
+#[cfg(target_arch = "x86_64")]
 #[allow(clippy::unnecessary_operation, clippy::identity_op)]
