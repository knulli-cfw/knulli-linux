# required for evmapy
CONFIG_INPUT_UINPUT=y

# required for squashfs + overlayfs
CONFIG_NLS_ISO8859_1=y
CONFIG_OVERLAY_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_SQUASHFS_FILE_DIRECT=y
CONFIG_SQUASHFS_DECOMP_MULTI_PERCPU=y
CONFIG_BLK_DEV_LOOP=y

# framebuffer console
CONFIG_FB=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
# CONFIG_LOGO is not set

# hw rng
CONFIG_HW_RANDOM_ROCKCHIP=y

# filesystems, zram swap, controllers
CONFIG_EXFAT_FS=y
CONFIG_NTFS_FS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_ZRAM=y
CONFIG_ZSMALLOC=y
CONFIG_CRYPTO_LZO=y
CONFIG_CRYPTO_ZSTD=y
CONFIG_HID_NINTENDO=y
CONFIG_USB_UAS=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y

# WX8 analog sticks and charger
CONFIG_JOYSTICK_WX8=y
CONFIG_CHARGER_WX8=y

# USB WiFi dongles
CONFIG_RTL8XXXU=m
CONFIG_RTL8XXXU_UNTESTED=y
CONFIG_RTW88=m
CONFIG_RTW88_USB=m
CONFIG_RTW88_8821CU=m
CONFIG_RTW88_8822BU=m
CONFIG_RTW88_8822CU=m
CONFIG_RTW88_8723DU=m
CONFIG_ATH9K_HTC=m
CONFIG_CARL9170=m
CONFIG_RT2X00=m
CONFIG_RT2800USB=m
CONFIG_RT2800USB_RT33XX=y
CONFIG_RT2800USB_RT35XX=y
CONFIG_RT2800USB_RT3573=y
CONFIG_RT2800USB_RT53XX=y
CONFIG_RT2800USB_RT55XX=y
CONFIG_RT2800USB_UNKNOWN=y

# USB tethering / USB-ethernet adapters
CONFIG_USB_USBNET=m
CONFIG_USB_NET_CDCETHER=m
CONFIG_USB_NET_CDC_NCM=m
CONFIG_USB_NET_RNDIS_HOST=m
CONFIG_USB_NET_AX8817X=m
CONFIG_USB_NET_AX88179_178A=m

# slim: tracing/debug and unused camera, ipvs, rk628
# CONFIG_FUNCTION_TRACER is not set
# CONFIG_BLK_DEV_IO_TRACE is not set
# CONFIG_DEBUG_INFO is not set
# CONFIG_SCHEDSTATS is not set
# CONFIG_SCHED_STACK_END_CHECK is not set
# CONFIG_DEBUG_SPINLOCK is not set
# CONFIG_DEBUG_CREDENTIALS is not set
# CONFIG_BUG_ON_DATA_CORRUPTION is not set
# CONFIG_DEBUG_LIST is not set
# CONFIG_MAC80211_DEBUG_MENU is not set
# CONFIG_CFG80211_DEBUGFS is not set
# CONFIG_MAC80211_DEBUGFS is not set
# CONFIG_IP_VS is not set
# CONFIG_VIDEO_ROCKCHIP_CIF is not set
# CONFIG_VIDEO_ROCKCHIP_RKISP1 is not set
# CONFIG_VIDEO_GC8034 is not set
# CONFIG_VIDEO_IMX219 is not set
# CONFIG_VIDEO_OV5647 is not set
# CONFIG_VIDEO_OV8858 is not set
# CONFIG_VIDEO_OV13850 is not set
# CONFIG_VIDEO_SGM3784 is not set
# CONFIG_VIDEO_RK628_CSI is not set
# CONFIG_VIDEO_RK628_BT1120 is not set
# CONFIG_RK628_MISC is not set
