+        gpios = <&gpio2 0x17 GPIO_ACTIVE_LOW>;
+    };
+
+    f1 {
+      gpios = <&gpio0 0x0b 0x01>;
+      label = "GPIO Button A";
+      linux,code = <BTN_A>;
+    };
+
+    f2 {
+      gpios = <&gpio0 0x09 0x01>;
+      label = "GPIO Button B";
+      linux,code = <BTN_B>;
+    };
+
+    f3 {
+      gpios = <&gpio1 0x09 0x01>;
+      label = "GPIO Button R";
+      linux,code = <BTN_TR>;
+    };
+
+    f4 {
+      gpios = <&gpio0 0x08 0x01>;
+      label = "GPIO Button L";
+      linux,code = <BTN_TL>;
+    };
+
+    f5 {
+      gpios = <&gpio0 0x0c 0x01>;
+      label = "GPIO Button X";
+      linux,code = <BTN_X>;
+    };
+
+    f6 {
+      gpios = <&gpio0 0x0d 0x01>;
+      label = "GPIO Button Y";
+      linux,code = <BTN_Y>;
+    };
+
+    f7 {
+      gpios = <&gpio3 0x15 0x01>;
+      label = "GPIO Button Back";
+      linux,code = <BTN_BACK>;
+    };
+
+    select {
+      gpios = <&gpio3 0x16 0x01>;
+      label = "GPIO Button Select";
+      linux,code = <BTN_SELECT>;
+    };
+
+    start {
+      gpios = <&gpio3 0x1b 0x01>;
+      label = "GPIO Button Start";
+      linux,code = <BTN_START>;
+    };
+
+    vol-down-key {
+      gpios = <&gpio1 0x0a 0x01>;
+      label = "GPIO Key Vol Down";
+      linux,code = <KEY_VOLUMEDOWN>;
+    };
+
+    vol-up-key {
+      gpios = <&gpio1 0x08 0x01>;
+      label = "GPIO Key Vol Up";
+      linux,code = <KEY_VOLUMEUP>;
+    };
+
+  };
+
+  panel {
+		compatible = "simple-panel";
+		power-supply = <&vcc_io>;
+		backlight = <&backlight>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&lcd_reset &lcd_enable>;
+		reset-gpios = <&gpio0 RK_PD0 GPIO_ACTIVE_LOW>;
+		enable-gpios = <&gpio1 RK_PB4 GPIO_ACTIVE_LOW>;
+		reset-delay-ms = <60>;
+		enable-delay-ms = <150>;
+		prepare-delay-ms = <100>;
+		unprepare-delay-ms = <2000>;
+		init-delay-ms = <1000>;
+
+		height-mm = <86>;
+		width-mm = <154>;
+		bus-format = <4105>;
+
+		display-timings {
+			native-mode = <&timing0>;
+
+			timing0: timing0 {
+				clock-frequency = <0x3e2df80>;
+
+				hactive = <0x320>;
+				vactive = <0x1e0>;
+
+        hback-porch = <160>;
+        hfront-porch = <160>;
+        hsync-active = <0>;
+        hsync-len = <10>;
+        vback-porch = <23>;
+        vfront-porch = <12>;
+        vsync-active = <0>;
+        vsync-len = <10>;
+
+        de-active = <0>;
+        pixelclk-active = <1>;
+			};
+		};
+
+		port {
+			panel_in_rgb: endpoint {
+				remote-endpoint = <&rgb_out_panel>;
+			};
+		};
+	};
+};
+
+&pwm0 {
+	status = "okay";
+};
+
+&display_subsystem {
+	status = "okay";
+	logo-memory-region = <&drm_logo>;
+
+	route {
+		route_rgb: route-rgb {
+			connect = <&vop_out_rgb>;
+			status = "okay";
+		};
+
+		route_hdmi: route-hdmi {
+			connect = <&vop_out_hdmi>;
+			status = "okay";
+		};
+	};
+
+};
+
+&rgb {
+	status = "okay";
+
+	ports {
+		port@1 {
+			reg = <1>;
+
+			rgb_out_panel: endpoint {
+				remote-endpoint = <&panel_in_rgb>;
+			};
+		};
+	};
+};
