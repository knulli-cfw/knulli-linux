+			gpios = <&gpio1 0x0a 0x01>;
+			label = "GPIO Key Down";
+			linux,code = <KEY_DOWN>;
+		};
+
+		f1 {
+			debounce-interval = <20>;
+			gpios = <&gpio0 0x0b 0x01>;
+			label = "GPIO Key A";
+			linux,code = <KEY_A>;
+		};
+
+		f2 {
+			debounce-interval = <20>;
+			gpios = <&gpio0 0x0d 0x01>;
+			label = "GPIO Key B";
+			linux,code = <KEY_B>;
+		};
+
+		f3 {
+			debounce-interval = <20>;
+			gpios = <&gpio0 0x0c 0x01>;
+			label = "GPIO Key R";
+			linux,code = <KEY_R>;
+		};
+
+		f4 {
+			debounce-interval = <20>;
+			gpios = <&gpio0 0x09 0x01>;
+			label = "GPIO Key L";
+			linux,code = <KEY_L>;
+		};
+
+		f5 {
+			debounce-interval = <20>;
+			gpios = <&gpio0 0x08 0x01>;
+			label = "GPIO Key X";
+			linux,code = <KEY_X>;
+		};
+
+		f6 {
+			debounce-interval = <20>;
+			gpios = <&gpio3 0x17 0x01>;
+			label = "GPIO Key Y";
+			linux,code = <KEY_Y>;
+		};
+
+		f7 {
+			debounce-interval = <20>;
+			gpios = <&gpio1 0x05 0x01>;
+			label = "GPIO Key C";
+			linux,code = <KEY_C>;
+		};
+
+		f8 {
+			debounce-interval = <20>;
+			gpios = <&gpio1 0x04 0x01>;
+			label = "GPIO Key Z";
+			linux,code = <KEY_Z>;
+		};
+
+		left {
+			debounce-interval = <20>;
+			gpios = <&gpio1 0x08 0x01>;
+			label = "GPIO Key Left";
+			linux,code = <KEY_LEFT>;
+		};
+
+		right {
+			debounce-interval = <20>;
+			gpios = <&gpio0 0x0e 0x01>;
+			label = "GPIO Key Right";
+			linux,code = <KEY_RIGHT>;
+		};
+
+		select {
+			debounce-interval = <20>;
+			gpios = <&gpio3 0x16 0x01>;
+			label = "GPIO Key Select";
+			linux,code = <KEY_RIGHTSHIFT>;
+		};
+
+		start {
+			debounce-interval = <20>;
+			gpios = <&gpio3 0x1b 0x01>;
+			label = "GPIO Key Enter";
+			linux,code = <KEY_ENTER>;
+		};
+
+		vol-down-key {
+			debounce-interval = <20>;
+			gpios = <&gpio1 0x02 0x01>;
+			label = "GPIO Key Vol Down";
+			linux,code = <KEY_VOLUMEDOWN>;
+		};
+
+		vol-up-key {
+			debounce-interval = <20>;
+			gpios = <&gpio1 0x01 0x01>;
+			label = "GPIO Key Vol Up";
+			linux,code = <KEY_VOLUMEUP>;
+		};
+
+		up {
+			debounce-interval = <20>;
+			gpios = <&gpio1 0x0b 0x01>;
+			label = "GPIO Key Up";
+			linux,code = <KEY_UP>;
+		};
+	};
+
+	panel {
+		compatible = "simple-panel";
+		power-supply = <&vcc_io>;
+		backlight = <&backlight>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&lcd_reset &lcd_enable>;
+		reset-gpios = <&gpio0 RK_PD0 GPIO_ACTIVE_LOW>;
+		enable-gpios = <&gpio1 RK_PB4 GPIO_ACTIVE_LOW>;
+		reset-delay-ms = <60>;
+		enable-delay-ms = <100>;
+		prepare-delay-ms = <100>;
+		unprepare-delay-ms = <2000>;
+		init-delay-ms = <1000>;
+
+		height-mm = <86>;
+		width-mm = <0x154>;
+		bus-format = <MEDIA_BUS_FMT_RGB888_1X24>;
+
+		display-timings {
+			native-mode = <&timing0>;
+
+			timing0: timing0 {
+				clock-frequency = <51200000>;
+
+				hactive = <1024>;
+				vactive = <600>;
+
+				hback-porch = <140>;
+				hfront-porch = <160>;
+				hsync-active = <0>;
+				hsync-len = <20>;
+				vback-porch = <20>;
+				vfront-porch = <12>;
+				vsync-active = <0>;
+				vsync-len = <3>;
+
+				de-active = <0>;
+				pixelclk-active = <1>;
+			};
+		};
+
+		port {
+			panel_in_rgb: endpoint {
+				remote-endpoint = <&rgb_out_panel>;
+			};
+		};
+	};
+};
+
+&joysticks {
+	axes = <ABS_RZ ABS_Z ABS_Y ABS_X>;
+	keys = <KEY_B KEY_Y KEY_X KEY_A KEY_DOWN KEY_UP KEY_LEFT KEY_RIGHT>;
+};
+
+&power_supply {
+        discharge_table = <3500 3586 3636 3663 3724 3744 3760 3773 3772 3794 3806 3854 3897 3949 3986 4035 4075 4118 4150>;	// mV
+        charge_table =    <3600 3900 3928 3965 3994 4015 4023 4045 4059 4096 4133 4171 4250>;	// mV, without mA cannot determine charging in CV part
+
+        design_capacity = <4000>;	// mAh, battery "595490"
+};
+
+&pwm0 {
+	status = "okay";
+};
+
+&display_subsystem {
+	status = "okay";
+	logo-memory-region = <&drm_logo>;
+
+	route {
+		route_rgb: route-rgb {
+			connect = <&vop_out_rgb>;
+			status = "okay";
+		};
+
+		route_hdmi: route-hdmi {
+			connect = <&vop_out_hdmi>;
+			status = "okay";
+		};
+	};
+
+};
+
+&rgb {
+	status = "okay";
+
+	ports {
+		port@1 {
+			reg = <1>;
+
+			rgb_out_panel: endpoint {
+				remote-endpoint = <&panel_in_rgb>;
+			};
+		};
+	};
+};
