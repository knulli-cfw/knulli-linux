kbuild: use lz4 instead of lz4c

lz4 1.10 no longer ships lz4c; -9 replaces its -c1, as in mainline.

--- a/scripts/Makefile.lib
+++ b/scripts/Makefile.lib
@@ -367,12 +367,12 @@
 
 quiet_cmd_lz4 = LZ4     $@
 cmd_lz4 = (cat $(filter-out FORCE,$^) | \
-	lz4c -l -c1 stdin stdout && $(call size_append, $(filter-out FORCE,$^))) > $@ || \
+	lz4 -l -9 - - && $(call size_append, $(filter-out FORCE,$^))) > $@ || \
 	(rm -f $@ ; false)
 
 quiet_cmd_lz4c = LZ4C    $@
 cmd_lz4c = (cat $(filter-out FORCE,$^) | \
-	lz4c -c1 stdin stdout && $(call size_append, $(filter-out FORCE,$^))) > $@ || \
+	lz4 -9 - - && $(call size_append, $(filter-out FORCE,$^))) > $@ || \
 	(rm -f $@ ; false)
 
 # U-Boot mkimage
