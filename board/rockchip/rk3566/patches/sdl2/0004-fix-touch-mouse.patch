Touch to mouse under KMSDRM: fall back to the application window

KMSDRM has no focus window for evdev touch, so SDL synthesized no mouse
events at all; send them to the main window.  They keep SDL_TOUCH_MOUSEID:
EmulationStation only takes touch-sourced motion on buildroot, so a drag
reported as a real mouse (id 0) arrived as a click and never scrolled.

diff -rupN SDL2.orig/src/events/SDL_touch.c SDL2-2.28.1/src/events/SDL_touch.c
--- SDL2.orig/src/events/SDL_touch.c	2023-07-01 17:04:05.000000000 +0000
+++ SDL2-2.28.1/src/events/SDL_touch.c	2023-07-26 00:04:30.039436068 +0000
@@ -245,6 +245,11 @@ int SDL_SendTouch(SDL_TouchID id, SDL_Fi
         return -1;
     }
 
+    if (!window) {
+        // Fallback to the main application window.
+        window = SDL_GetWindowFromID(1);
+    }
+
     mouse = SDL_GetMouse();
 
 #if SYNTHESIZE_TOUCH_TO_MOUSE
@@ -374,6 +379,11 @@ int SDL_SendTouchMotion(SDL_TouchID id,
         return -1;
     }
 
+    if (!window) {
+        // Fallback to the main application window.
+        window = SDL_GetWindowFromID(1);
+    }
+
     mouse = SDL_GetMouse();
 
 #if SYNTHESIZE_TOUCH_TO_MOUSE
