#!/bin/bash

# We only want to run the script if the board has no analog stick capability
if knulli-board-capability "analogstick"; then
    exit 1
fi

# rk3566: the D-pad<->virtual-stick toggle is exposed by the singleadc-joypad
# driver (boards that opt in via the "rocknix,dpad-joystick" DT prop, e.g. the
# RG ARC-S). 0 = D-pad (BTN_DPAD_*), 1 = emulated left analog stick (ABS_X/Y).
DPAD_STATE_FILE="/sys/devices/platform/singleadc-joypad/dpad_mode"

# Bail out on boards that don't expose the toggle (no-op safety).
[ -w "$DPAD_STATE_FILE" ] || exit 1

STATE=$(cat "$DPAD_STATE_FILE")

check_ingame() {
    HTTP_STATUS=$(curl -s -o /dev/null -w "%{http_code}" "http://localhost:1234/runningGame")
    test $? != 0                 && return 0
    test "${HTTP_STATUS}" != 201 && return 0 # in game
    return 1  # 201 when not in game
}

do_notification() {
    NOTIFICATION=$1

    # The overlay draws over a running game; ES is only on screen when none is.
    knulli-overlay notification "$NOTIFICATION"
    check_ingame || curl -s http://localhost:1234/notify -d "$NOTIFICATION" >/dev/null
}

if [ "${STATE}" -eq 0 ]; then
    do_notification "Virtual Joystick ON"

    knulli-rumble 0.1
    echo 1 > "$DPAD_STATE_FILE"
else
    do_notification "Virtual Joystick OFF"

    knulli-rumble 0.1
    sleep 0.2
    knulli-rumble 0.1
    echo 0 > "$DPAD_STATE_FILE"
fi

exit 0
