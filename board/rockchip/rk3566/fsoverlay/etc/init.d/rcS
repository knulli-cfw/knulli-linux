#!/bin/sh

# Start all init scripts in /etc/init.d
# executing them in numerical order.
#

# --- Universal RK3566 image: detect the actual device ---------------------
# All RK3566 handhelds now share a single firmware image, so /boot/boot/knulli.board
# ships as the generic "rk3566". The per-board init scripts (S04audioamp, power-led,
# bluetooth, ...) key off knulli.board, so derive the real device name from the
# kernel DT model and rewrite knulli.board before any S?? script runs.
# U-Boot's hwrev profile (board= on the cmdline) wins; the model is the
# fallback for the generic profile and older U-Boot.
NEW_BOARD=""
for ARG in $(cat /proc/cmdline); do
    case "$ARG" in
        board=rk3566|board=) ;;
        board=*) NEW_BOARD="${ARG#board=}" ;;
    esac
done
if [ -z "$NEW_BOARD" ] && [ -r /sys/firmware/devicetree/base/model ]; then
    read -r MODEL < /sys/firmware/devicetree/base/model
    case "$MODEL" in
        "Anbernic RG ARC-S"*) NEW_BOARD="rg-arc-s" ;;
        "Anbernic RG DS Plus"*) NEW_BOARD="rg-ds-plus" ;;
        "Anbernic RG DS"*)    NEW_BOARD="rg-ds" ;;
        "Powkiddy X55"*)      NEW_BOARD="powkiddy-x55" ;;
        "Powkiddy RGB30"*)    NEW_BOARD="powkiddy-rgb30" ;;
        "MIYOO Flip"*)        NEW_BOARD="miyoo-flip" ;;
        "Mangmi Loong"*)      NEW_BOARD="miniloong" ;;
    esac
fi
if [ -n "$NEW_BOARD" ]; then
    CUR_BOARD=""
    [ -r /boot/boot/knulli.board ] && read -r CUR_BOARD < /boot/boot/knulli.board
    if [ "$CUR_BOARD" != "$NEW_BOARD" ]; then
        mount -o remount,rw /boot
        echo "$NEW_BOARD" > /boot/boot/knulli.board
        sync
        mount -o remount,ro /boot
    fi
fi
# --------------------------------------------------------------------------

# Start the boot progress bar. rk3566 uses the /dev/fb0-direct variant
# (progressbar_rk): SDL2 defaults to KMSDRM here, which is not scanned out
# during early boot, so the generic progressbar would show nothing.
#
# Per-board rotation: the RG ARC-S panel/logo combo leaves the programmatic
# overlay (progress bar + text) upside down while the pre-rotated logo BMP is
# upright, so it needs an extra 180 for the overlay. NEW_BOARD is set above.
PB_RK_ARGS=""
case "$NEW_BOARD" in
    rg-arc-s) PB_RK_ARGS="--rotate 180" ;;
esac
/usr/bin/progressbar_rk $PB_RK_ARGS &

for i in /etc/init.d/S??* ; do

    # Ignore dangling symlinks (if any).
    [ ! -f "$i" ] && continue

    # Update status for progress bar
    echo "$i" > /tmp/status.txt

    case "$i" in
        *.sh)
            # Source shell script for speed.
            (
                trap - INT QUIT TSTP
                set start
                . $i
            ) &
            ;;
        *)
            case "$i" in
                *S00bootcustom | *S01dbus | *S02resize | *S03modules | *S04populate | *S05udev | *S06audio | *S06modprobe | *S11share | *S12populateshare) # Don't run these in background
                    $i start
                    ;;
                *)
                    $i start &
                    ;;
            esac
            ;;
    esac

    echo QUIT > /tmp/status.txt
    echo $(date +"%F %T,%3N")": ${i} - started" >> /var/run/boot.log
done

exit 0
