+/*
+ * PMU/VCCIO voltage domains, copied from the 5.x Miyoo DTB. These must match
+ * the board's actual io-rail wiring or pins (incl. the microSD slots and DSI)
+ * sit at the wrong level.
+ */
+&pmu_io_domains {
+	pmuio2-supply = <&vcc3v3_pmu>;
+	vccio1-supply = <&vccio_acodec>;
+	vccio3-supply = <&vccio_sd>;
+	vccio4-supply = <&vcc_3v3>;
+	vccio5-supply = <&vcc_1v8>;
+	vccio6-supply = <&vcc_1v8>;
+	vccio7-supply = <&vcc_3v3>;
+	status = "okay";
+};
+
+&sdhci {
+	bus-width = <8>;
+	max-frequency = <200000000>;
+	non-removable;
+	mmc-hs200-1_8v;
+	cap-mmc-highspeed;
+	no-sd;
+	no-sdio;
+	vmmc-supply = <&vcc_3v3>;
+	vqmmc-supply = <&vcc_1v8>;
+	status = "okay";
+};
+
+/* TF1 microSD slot */
+&sdmmc0 {
+	bus-width = <4>;
+	cap-mmc-highspeed;
+	cap-sd-highspeed;
+	disable-wp;
+	sd-uhs-sdr104;
+	no-sdio;
+	no-mmc;
+	vmmc-supply = <&vcc_sd>;
+	vqmmc-supply = <&vccio_sd>;
+	pinctrl-names = "default";
+	pinctrl-0 = <&sdmmc0_bus4 &sdmmc0_clk &sdmmc0_cmd &sdmmc0_det>;
+	status = "okay";
+};
+
+/* TF2 microSD slot */
+&sdmmc1 {
+	bus-width = <4>;
+	cap-mmc-highspeed;
+	cap-sd-highspeed;
+	disable-wp;
+	sd-uhs-sdr104;
+	no-sdio;
+	no-mmc;
+	vmmc-supply = <&vcc_sd2>;
+	vqmmc-supply = <&vccio_sd>;
+	pinctrl-names = "default";
+	pinctrl-0 = <&sdmmc1_bus4 &sdmmc1_clk &sdmmc1_cmd &sdmmc1_det>;
+	status = "okay";
+};
+
+&uart2 {
+	status = "okay";
+};
+
+/*
+ * uart1 = link to the joypad MCU that reports the analog sticks (rocknix
+ * miyoo-serial-joypad mode). Vendor wires xfer + CTS on uart1m0 (gpio2).
+ */
+&uart1 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&uart1m0_xfer &uart1m0_ctsn>;
+	status = "okay";
+};
+
+&saradc {
+	vref-supply = <&vcca1v8_pmu>;
+	status = "okay";
+};
+
+&i2s1_8ch {
+	rockchip,trcm-sync-tx-only;
+	/*
+	 * Base rk356x.dtsi i2s1_8ch pinctrl OMITS i2s1m0_mclk, so the external
+	 * rk817 codec would get no master clock -> noise/distortion. Re-add MCLK
+	 * plus the standard sclk/lrck/sdi0/sdo0 (playback + capture).
+	 */
+	pinctrl-names = "default";
+	pinctrl-0 = <&i2s1m0_mclk
+		     &i2s1m0_sclktx &i2s1m0_sclkrx
+		     &i2s1m0_lrcktx &i2s1m0_lrckrx
+		     &i2s1m0_sdi0 &i2s1m0_sdo0>;
+	status = "okay";
+};
