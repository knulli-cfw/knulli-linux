+/* ---- Audio: AW883xx smart amps (speakers) ---- */
+&i2c2 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&i2c2m1_xfer>;
+	clock-frequency = <200000>;
+	status = "okay";
+
+	aw883xx_l: aw883xx@34 {
+		compatible = "awinic,aw883xx_smartpa";
+		reg = <0x34>;
+		#sound-dai-cells = <0>;
