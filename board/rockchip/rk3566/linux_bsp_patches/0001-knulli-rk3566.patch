diff --git a/sound/soc/codecs/rk817_codec.c b/sound/soc/codecs/rk817_codec.c
index bb80f84ad..aa684b22d 100644
--- a/sound/soc/codecs/rk817_codec.c
+++ b/sound/soc/codecs/rk817_codec.c
@@ -783,6 +783,38 @@ static int rk817_playback_path_config(struct snd_soc_component *component,
 		return -EINVAL;
 	}
 
+	/*
+	 * Apply the external speaker/headphone amp GPIOs for the new path NOW,
+	 * not only on DAC mute/unmute (rk817_digital_mute_dac). Otherwise, when
+	 * userspace switches "Playback Path" while a stream stays open (e.g. ES
+	 * keeps the PCM busy so no mute/unmute fires), spk-ctl was left stuck and
+	 * the external speaker amp kept playing on headphone insertion. Mirrors
+	 * the unmute logic. (No-op on boards without spk-ctl/hp-ctl gpios.)
+	 */
+	switch (rk817->playback_path) {
+	case SPK_PATH:
+	case RING_SPK:
+		rk817_codec_ctl_gpio(rk817, CODEC_SET_SPK, 1);
+		rk817_codec_ctl_gpio(rk817, CODEC_SET_HP, 0);
+		break;
+	case HP_PATH:
+	case HP_NO_MIC:
+	case RING_HP:
+	case RING_HP_NO_MIC:
+		rk817_codec_ctl_gpio(rk817, CODEC_SET_SPK, 0);
+		rk817_codec_ctl_gpio(rk817, CODEC_SET_HP, 1);
+		break;
+	case SPK_HP:
+	case RING_SPK_HP:
+		rk817_codec_ctl_gpio(rk817, CODEC_SET_SPK, 1);
+		rk817_codec_ctl_gpio(rk817, CODEC_SET_HP, 1);
+		break;
+	default: /* OFF, RCV, BT */
+		rk817_codec_ctl_gpio(rk817, CODEC_SET_SPK, 0);
+		rk817_codec_ctl_gpio(rk817, CODEC_SET_HP, 0);
+		break;
+	}
+
 	return 0;
 }
 
