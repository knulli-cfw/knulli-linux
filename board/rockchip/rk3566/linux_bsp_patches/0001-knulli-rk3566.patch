+			linux,code = <0x13d>;	/* BTN_THUMBL */
+			label = "LEFT JOYSTICK MIDDLE";
+			linux,input-type = <1>;
+		};
+
+		/* DPAD as EV_KEY + BTN_DPAD_* (rocknix uses input-type as raw EV_) */
+		LEFT-key {
+			gpios = <&gpio3 RK_PC7 GPIO_ACTIVE_LOW>;
+			linux,code = <BTN_DPAD_LEFT>;
+			label = "BTN_LEFT";
+			linux,input-type = <1>;
+		};
+		RIGHT-key {
+			gpios = <&gpio3 RK_PD0 GPIO_ACTIVE_LOW>;
+			linux,code = <BTN_DPAD_RIGHT>;
+			label = "BTN_RIGHT";
+			linux,input-type = <1>;
+		};
+		UP-key {
+			gpios = <&gpio3 RK_PD1 GPIO_ACTIVE_LOW>;
+			linux,code = <BTN_DPAD_UP>;
+			label = "BTN_UP";
+			linux,input-type = <1>;
