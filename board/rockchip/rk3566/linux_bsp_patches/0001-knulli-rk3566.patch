+/*
+ * adc-keys (rgxx3.dtsi + the local /adc-keys node merge into one node on saradc
+ * ch0: rgxx3's button-mode = BTN_MODE plus our button-home = KEY_HOME). The
+ * BTN_MODE key sits in udev's BTN_JOYSTICK..BTN_THUMBR range, so the device gets
+ * ID_INPUT_JOYSTICK=1 and shows up as a phantom /dev/input/jsN. Unlike the ARC-S
+ * the DS doesn't need this BTN_MODE hotkey (it has another), so disable the whole
+ * adc-keys node. (This also drops the ADC "Home" KEY_HOME button.)
+ */
+&adc_keys {
+	status = "disabled";
+};
