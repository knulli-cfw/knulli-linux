diff --git a/drivers/input/joystick/input-polldev-compat.h b/drivers/input/joystick/input-polldev-compat.h
new file mode 100644
index 000000000..531a64c8e
--- /dev/null
+++ b/drivers/input/joystick/input-polldev-compat.h
@@ -0,0 +1,77 @@
+/* Minimal compatibility shim for input-polldev API
+ * Provides struct input_polled_dev and small helpers when
+ * <linux/input-polldev.h> is not available in-tree.
+ */
+#ifndef _INPUT_POLLDEV_COMPAT_H
+#define _INPUT_POLLDEV_COMPAT_H
+
+#include <linux/input.h>
+#include <linux/device.h>
+#include <linux/slab.h>
+
+struct input_polled_dev {
+	struct input_dev *input;
+	void *private;
+	void (*poll)(struct input_polled_dev *poll_dev);
+	unsigned int poll_interval;
+	void (*open)(struct input_polled_dev *poll_dev);
+	void (*close)(struct input_polled_dev *poll_dev);
+};
+
+static inline int polled_input_open(struct input_dev *input)
+{
+	struct input_polled_dev *pd = input_get_drvdata(input);
+	if (pd && pd->open)
+		pd->open(pd);
+	return 0;
+}
+
+static inline void polled_input_close(struct input_dev *input)
+{
+	struct input_polled_dev *pd = input_get_drvdata(input);
+	if (pd && pd->close)
+		pd->close(pd);
+}
+
+static inline void polled_input_poll(struct input_dev *input)
+{
+	struct input_polled_dev *pd = input_get_drvdata(input);
+	if (pd && pd->poll)
+		pd->poll(pd);
+}
+
+static inline struct input_polled_dev *devm_input_allocate_polled_device(struct device *dev)
+{
+	struct input_dev *input = devm_input_allocate_device(dev);
+	struct input_polled_dev *pd;
+
+	if (!input)
+		return NULL;
+
+	pd = devm_kzalloc(dev, sizeof(*pd), GFP_KERNEL);
+	if (!pd)
+		return NULL;
+
+	pd->input = input;
+	input_set_drvdata(input, pd);
+	input->open = polled_input_open;
+	input->close = polled_input_close;
+
+	return pd;
+}
+
+static inline int input_register_polled_device(struct input_polled_dev *pd)
+{
+	int err;
+	if (!pd || !pd->input)
+		return -EINVAL;
+
+	err = input_setup_polling(pd->input, polled_input_poll);
+	if (err)
+		return err;
+
+	input_set_poll_interval(pd->input, pd->poll_interval);
+	return input_register_device(pd->input);
+}
+
+#endif /* _INPUT_POLLDEV_COMPAT_H */
