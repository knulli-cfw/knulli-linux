+/* ---- Touch: one Goodix GT9xx on i2c5m0 (no HDMI DDC on this board) ---- */
+&i2c5 {
+	pinctrl-0 = <&i2c5m0_xfer>;
+
+	gt9xx@14 {
+		compatible = "goodix,gt9xx";
+		reg = <0x14>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&touch_gt_gpio>;
+		touch-gpio = <&gpio0 RK_PC6 GPIO_ACTIVE_LOW>;
+		reset-gpio = <&gpio0 RK_PA6 GPIO_ACTIVE_HIGH>;
+		max-x = <1024>;
+		max-y = <768>;
+		tp-size = <911>;
+		/* the panel is landscape like the display: no GT911 swap */
+		gtp-change-x2y = <0>;
+	};
+};
+
+/* ---- Storage: eMMC + two SD slots ---- */
+&sdhci {
+	bus-width = <8>;
+	mmc-hs200-1_8v;
+	non-removable;
+	pinctrl-0 = <&emmc_bus8>, <&emmc_clk>, <&emmc_cmd>, <&emmc_datastrobe>;
+	pinctrl-names = "default";
+	vmmc-supply = <&vcc_3v3>;
+	vqmmc-supply = <&vcc_1v8>;
+	status = "okay";
+};
+
+&sdmmc0 {
+	max-frequency = <50000000>;
+	vmmc-supply = <&vcc_sd0>;
+};
+
+&sdmmc1 {
+	cd-gpios = <&gpio0 RK_PC0 GPIO_ACTIVE_LOW>;
+	card-detect-delay = <1200>;
+	vmmc-supply = <&vcc_sd1>;
