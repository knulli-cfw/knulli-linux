 #include "mac.h"
 #include "pci.h"
@@ -2760,11 +2762,71 @@ static int rtw89_pci_claim_device(struct rtw89_dev *rtwdev,
 				  struct pci_dev *pdev)
 {
 	struct rtw89_pci *rtwpci = (struct rtw89_pci *)rtwdev->priv;
+	struct device_node *wlan_node, *cru_node;
 	int ret;
 
+	/* Try to enable WiFi reference clock from the CRU (Clock & Reset Unit).
+	 * This is needed for proper XTAL initialization on RK3576.
+	 * 
+	 * The clock may be defined in the wireless-wlan platform device node,
+	 * or we may need to get it directly from the CRU by name.
+	 */
+	rtwpci->wifi_clk = NULL;
+	
+	/* First, try to get it from wireless-wlan node if it has a clock defined */
+	wlan_node = of_find_compatible_node(NULL, NULL, "wlan-platdata");
+	if (wlan_node) {
+		rtwpci->wifi_clk = of_clk_get_by_name(wlan_node, "clk_wifi");
+		if (IS_ERR_OR_NULL(rtwpci->wifi_clk)) {
+			rtwpci->wifi_clk = NULL;
+		}
+		of_node_put(wlan_node);
+	}
+	
+	/* If not found in wlan node, try to get it from CRU by name */
+	if (!rtwpci->wifi_clk) {
+		cru_node = of_find_compatible_node(NULL, NULL, "rockchip,rk3576-cru");
+		if (!cru_node)
+			cru_node = of_find_compatible_node(NULL, NULL, "rockchip,rk3426-cru");
+		
+		if (cru_node) {
+			/* Try various possible clock names */
+			const char *clock_names[] = {"clk_wifi", "ref_wifi_clk", "ref_clk"};
+			int i;
+			
+			for (i = 0; i < ARRAY_SIZE(clock_names); i++) {
+				rtwpci->wifi_clk = of_clk_get_by_name(cru_node, clock_names[i]);
+				if (!IS_ERR_OR_NULL(rtwpci->wifi_clk))
+					break;
+				rtwpci->wifi_clk = NULL;
+			}
+			of_node_put(cru_node);
+		}
+	}
+	
+	/* Enable the clock if we found it */
+	if (rtwpci->wifi_clk && !IS_ERR_OR_NULL(rtwpci->wifi_clk)) {
+		ret = clk_prepare_enable(rtwpci->wifi_clk);
+		if (ret) {
+			rtw89_warn(rtwdev, "failed to enable WiFi ref clock: %d\n", ret);
+			clk_put(rtwpci->wifi_clk);
+			rtwpci->wifi_clk = NULL;
+		} else {
+			rtw89_info(rtwdev, "WiFi ref clock enabled for XTAL initialization\n");
+		}
+	} else {
+		rtw89_info(rtwdev, "WiFi ref clock not found in device tree\n");
+		rtwpci->wifi_clk = NULL;
+	}
+
