+/*
+ * HDMI is PARKED for now (revisit later). It must stay fully disabled, not just
+ * routed to VP1: with HDMI enabled on VP1 the rk3566 VOP2 assigned only ONE
+ * active VP here (all 6 planes to VP0), so VP1 got no CRTC ("VP1 plane_mask is
+ * zero, so ignore register crtc") — and because HDMI is wired to that
+ * CRTC-less VP1, the rockchip-drm display-subsystem master never completes its
+ * component bind ("display-subsystem: deferred probe pending" forever) → no
+ * /dev/dri/card0 → white screen, even though the DSI panel itself probes fine.
+ * (The ARC, with the same DSI-VP0/HDMI-VP1 split, counts 2 active VPs and works
+ * — that board-vs-board active_vp_num difference is the thing to investigate
+ * when we re-enable HDMI.) Disabling HDMI leaves DSI alone on VP0: 1 active VP,
+ * all planes to VP0, VP0 CRTC registers, master binds, card0 appears.
+ */
+/*
+ * HDMI on VP0 (shared with the DSI panel) => mutually exclusive with the
+ * internal display: connecting HDMI turns the internal panel off (single CRTC).
+ * RK3566 VOP2's VP1 cannot drive HDMI cleanly (win-close/dsp_hold timeouts +
+ * internal corruption / fb copies when both VPs are live), so HDMI uses the
+ * working VP0. DDC via the base internal pinctrl (hdmitx_scl/sda). Same approach
+ * as rg-arc-s. See [[hdmi-mutual-exclusion]].
+ */
+&hdmi {
+	status = "okay";
+};
+
+&hdmi_in_vp0 {
+	status = "okay";
+};
+
+&hdmi_in_vp1 {
+	status = "disabled";
+};
+
+&route_hdmi {
+	connect = <&vp0_out_hdmi>;
+	status = "okay";
+};
