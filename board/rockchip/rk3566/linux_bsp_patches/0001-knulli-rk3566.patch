+/*----------------------------------------------------------------------------*/
+static int joypad_amux_select(struct analog_mux *amux, int channel)
+{
+	/* Select mux channel via GPIO multiplexer */
+	/* RK3576 hardware has only GPIO 27 (sel_b) available for multiplexer control */
+	
+	if (!amux) {
+		pr_err("amux is NULL!\n");
+		return -1;
+	}
+
+	/* Log which channel we're selecting */
+	pr_info("amux_select ch%d: using GPIO %d\n", channel, amux->sel_b_gpio);
+
+	/* Check if GPIO 27 (sel_b) is available */
+	if (!gpio_is_valid(amux->sel_b_gpio)) {
+		pr_err("amux_select: GPIO %d is not valid - cannot control multiplexer\n", amux->sel_b_gpio);
+		return -EINVAL;
+	}
+
+	/* Single GPIO control pattern:
+	 * GPIO 27 cycles through channels with different pulse patterns or timing
+	 * Since we only have one GPIO, use it to toggle/select between channels
+	 * Pattern: treat channel selection as a binary encoding on the single GPIO
+	 * 
+	 * For 4 channels with single GPIO, possible strategies:
+	 * 1. Cycle with on/off patterns
+	 * 2. Use timing to distinguish channels
+	 * 3. Implementation requires hardware insight
+	 * 
+	 * For now, use simplified approach: set GPIO value based on channel parity
+	 */
+	
+	/* Set GPIO based on channel - binary if only 1 GPIO available */
+	int gpio_value = channel & 0x01;  /* Use least significant bit for GPIO value */
+	gpio_set_value(amux->sel_b_gpio, gpio_value);
+	
+	/* mux switching speed : 35ns(on) / 9ns(off) */
+	usleep_range(10, 20);
+	return 0;
+}
+
+static int joypad_adc_read(struct analog_mux *amux, struct bt_adc *adc)
+{
+	int value = 0;
+	int ret;
+	struct iio_channel *ch;
+	
+	if (!amux || !amux->iio_ch) {
+		return -EINVAL;
+	}
+	
+	/* CRITICAL: Select the multiplexer channel via GPIO BEFORE reading */
+	/* Only perform GPIO mux selection if GPIO 27 is actually available */
+	/* The RK3576 SARADC has 4 direct input channels that may not need GPIO multiplexing */
+	if (gpio_is_valid(amux->sel_b_gpio)) {
+		/* GPIO-based multiplexer - select channel before reading */
+		ret = joypad_adc_mux_select(amux, adc->amux_ch);
+		if (ret < 0) {
+			/* Mux selection failed, but continue anyway - may not be needed */
+			pr_debug("ADC mux selection failed for ch%d\n", adc->amux_ch);
+		}
+		/* Wait for multiplexer to settle and analog signal to stabilize */
+		usleep_range(50, 100);
+	} else {
+		/* No GPIO mux control - read directly from the 4 independent ADC channels */
+		/* The RK3576 SARADC likely has 4 independent input channels */
+		usleep_range(1, 2);
+	}
+	
+	/* Now read from the selected IIO channel */
+	/* For RK3576 with a single ADC + multiplexer, we read from channel 0 after mux selection */
+	/* Or if we have direct channels, use the corresponding channel */
+	if (adc->amux_ch < 0 || adc->amux_ch >= amux->iio_ch_count) {
+		pr_debug("joypad_adc_read: invalid channel %d (count=%d)\n", adc->amux_ch, amux->iio_ch_count);
+		return -EINVAL;
+	}
+	
+	/* Use the specific IIO channel for this ADC channel */
+	ch = &amux->iio_ch[adc->amux_ch];
+	if (!ch || !ch->indio_dev || !ch->channel) {
+		return -EINVAL;
+	}
+	
+	ret = iio_read_channel_raw(ch, &value);
+	if (ret < 0) {
+		pr_debug("iio_read_channel_raw failed for ch%d: ret=%d\n", adc->amux_ch, ret);
+		return -EINVAL;
+	}
+	
+	/* Debug: Log raw ADC values every 100 polls to understand the data */
+	static unsigned long adc_debug_loops;
+	if (adc_debug_loops++ % 250 == 0) {  /* Every ~1 second at 4ms poll */
+		pr_info("ADC ch%d raw=%d\n", adc->amux_ch, value);
+	}
+
+	value *= adc->scale;
+	
+	return value;
+}
