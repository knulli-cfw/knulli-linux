+/* ------------------------------------------------------------------------
+ * WiFi: RTL8733BU is a USB chip; bring-up is just powering it (vcc_wifi on
+ * gpio0 PA0) and enabling the USB host stack above. The wlan-platdata node
+ * carries the chip-type for the vendor wifi helper.
+ * ------------------------------------------------------------------------ */
+/ {
+	wireless_wlan: wireless-wlan {
+		compatible = "wlan-platdata";
+		rockchip,grf = <&grf>;
+		wifi_chip_type = "rtl8733bu";
+		status = "okay";
+	};
+};
+
+&pinctrl {
