+/*
+ * ---- i2c2: external speaker amplifiers (Awinic AW87391 x2) ----
+ * The two AW87391 smart amps (left 0x58, right 0x5b) sit on i2c2 (i2c2m1 pins,
+ * gpio4 PB4/PB5). There is no in-kernel aw87391 driver; userspace (the
+ * S04audioamp init script) initialises them over /dev/i2c-2 via i2cset once the
+ * board is detected as "rg-ds". Just enable the bus here.
+ */
+&i2c2 {
+	status = "okay";
+	pinctrl-names = "default";
+	pinctrl-0 = <&i2c2m1_xfer>;
+	clock-frequency = <200000>;
+};
+
+/*
+ * ---- Touch panels: dual Goodix GT911 ----
+ * The DS has NO HDMI, so i2c5 (inherited from rgxx3.dtsi as the HDMI DDC bus on
+ * i2c5m1) is repurposed to its real function on this board: the touch-panel i2c
+ * bus on i2c5m0 (gpio3 PB3/PB4). i2c3 (i2c3m1 = gpio3 PB5/PB6) is the second
+ * touch bus. Confirmed on HW by i2cdetect + reading the Goodix product-ID reg
+ * (0x8140 -> "911"): one GT911 digitizer per screen. reset/irq are on gpio0.
+ * reg=0x14 (the gt9xx reset sequence forces the 0x14 slave address via INT).
+ */
+&i2c5 {
+	/* override rgxx3.dtsi's HDMI-DDC i2c5m1 mux -> touch bus pins */
+	pinctrl-0 = <&i2c5m0_xfer>;
+
+	gt9xx@14 {
+		compatible = "goodix,gt9xx";
+		reg = <0x14>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&touch_int_lower>;
+		touch-gpio = <&gpio0 RK_PB6 GPIO_ACTIVE_LOW>;
+		reset-gpio = <&gpio0 RK_PB5 GPIO_ACTIVE_HIGH>;
+		max-x = <640>;
+		max-y = <480>;
+		tp-size = <911>;
+		/* lower panel: landscape like the display, no GT911 swap */
+		gtp-change-x2y = <0>;
+	};
+};
+
+&i2c3 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&i2c3m1_xfer>;
+	status = "okay";
+
+	gt9xx@14 {
+		compatible = "goodix,gt9xx";
+		reg = <0x14>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&touch_int_upper>;
+		touch-gpio = <&gpio0 RK_PC0 GPIO_ACTIVE_LOW>;
+		reset-gpio = <&gpio0 RK_PB7 GPIO_ACTIVE_HIGH>;
+		max-x = <640>;
+		max-y = <480>;
+		tp-size = <911>;
+		/* upper panel: mounted rotated 180 degrees */
+		gtp-change-x2y = <0>;
+		gtp-x-reverse = <1>;
+		gtp-y-reverse = <1>;
+	};
+};
