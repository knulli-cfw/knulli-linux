+/* ------------------------------------------------------------------------
+ * Inputs: gamepad via rocknix singleadc-joypad (CONFIG_JOYSTICK_ROCKNIX_
+ * SINGLEADC). Single analog stick on saradc ch3(X)/ch2(Y), ~18 GPIO buttons.
+ * DPAD = EV_KEY + BTN_DPAD_*; stick = amux-count=2 single-stick mapping
+ * (see the rocknix-singleadc-joypad single-stick driver patch). The vendor
+ * camera-flash node that stole gpio4 PA6 (M button) is simply not ported.
+ * ------------------------------------------------------------------------ */
+/ {
+	loong1_joypad: loong1-joypad {
+		compatible = "singleadc-joypad";
+		joypad-name = "Loong Gamepad";
+		joypad-product = <0x2000>;
+		joypad-revision = <0x102>;
+
+		/* single stick, two direct SARADC channels: joy_x=ch3, joy_y=ch2.
+		 * iio_ch[N]=saradc chN via named amux_adc_chN; mapping idx0->ch3
+		 * (ABS_X), idx1->ch2 (ABS_Y); amux-count=2 -> single-stick X/Y. */
+		io-channels = <&saradc 0>, <&saradc 1>, <&saradc 2>, <&saradc 3>;
+		io-channel-names = "amux_adc_ch0", "amux_adc_ch1",
+				   "amux_adc_ch2", "amux_adc_ch3";
+		amux-count = <2>;
+		amux-channel-mapping = <3 2 0 1>;
+		/*
+		 * Per-axis output gain (ADC_DATA_TUNING = val*p/100). The stick only
+		 * swings a fraction of the SARADC range, so the default 180% reaches
+		 * only ~±20k. 300% stretches full deflection to ~±32k so ES detects
+		 * and maps the axes. (button-adc-scale can't help: it scales the
+		 * value AND the declared max together, leaving the ratio unchanged.)
+		 */
+		abs_x-p-tuning = <300>;
+		abs_x-n-tuning = <300>;
+		abs_y-p-tuning = <300>;
+		abs_y-n-tuning = <300>;
+		button-adc-scale = <0x48>;
+		button-adc-deadzone = <0x708>;
+		invert-absx = <1>;
+		invert-absy = <1>;
+		button-adc-x-range = <0x10000>;
+		button-adc-y-range = <0x10000>;
+		button-adc-fuzz = <0x480>;
+		button-adc-flat = <0x480>;
+		poll-interval = <10>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&joy_btns>;
+
+		Joystick-L-Middle-key {
