diff --git a/arch/arm64/boot/dts/rockchip/rk3566-gkd-geek.dts b/arch/arm64/boot/dts/rockchip/rk3566-gkd-geek.dts
new file mode 100644
index 000000000..5c118e723
--- /dev/null
+++ b/arch/arm64/boot/dts/rockchip/rk3566-gkd-geek.dts
@@ -0,0 +1,1212 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * GameKiddy GKD Geek (RK3566 + RK809) — BSP 4.x -> 6.1 port.
+ *
+ * Self-contained in-tree DTS, converted from the vendor 4.x source kept at
+ * repo-root ./gkdbubble/ (rk3566-gkd-geek-bbg.dts + -compute-module.dtsi +
+ * -lcd.dtsi). Structured like the sibling rk3566 handheld ports
+ * (rk3566-powkiddy-x55 / rk3566-miyoo-flip): generic rk3566 + rk809 handheld.
+ *
+ * Key 4.x -> 6.1 conversions:
+ *   - joypad: vendor "gamekiddy-joypad" -> "singleadc-joypad" (rocknix driver);
+ *     4 sticks read straight off saradc ch0-3, gpio buttons unchanged.
+ *   - codec: vendor "avrman-spk-con-gpio" -> "spk-ctl-gpios"; hp-detect (was
+ *     "avrman-hp-det-gpio") is an extcon job layered on later, like the siblings.
+ *   - panel: MIPI_DSI_MODE_EOT_PACKET -> MIPI_DSI_MODE_NO_EOT_PACKET, &dsi0 gets
+ *     #address/#size-cells, single graph port (see rk3566-gkd-geek-lcd.dtsi note).
+ *
+ * Parked (no 6.1 in-tree driver yet; kept as comments so nothing silently drops):
+ *   - bq25892 external charger ("ti,bq2589x-2") — no driver in this tree.
+ *   - gs_sc7a20 accelerometer (rockchip sensor-dev) — no driver in this tree.
+ * Inputs/audio stick calibration + HP-detect + HDMI need HW verification, same
+ * as every other handheld port in this tree.
+ */
+
+/dts-v1/;
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/linux-event-codes.h>
+#include <dt-bindings/pinctrl/rockchip.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+#include <dt-bindings/display/drm_mipi_dsi.h>
+#include "rk3566.dtsi"
+
+/ {
+	model = "GameKiddy GKD Geek";
+	compatible = "GameKiddy,gkd-geek", "rockchip,rk3566";
+
+	aliases {
+		mmc0 = &sdmmc0;
+		mmc1 = &sdmmc1;
+		mmc2 = &sdmmc2;
+	};
+
+	chosen: chosen {
+		stdout-path = "serial2:1500000n8";
+	};
+
+	keys: gpio-keys {
+		compatible = "gpio-keys";
+		pinctrl-names = "default";
+		pinctrl-0 = <&volume_gpio>;
+		autorepeat;
+
+		vol-up-key {
+			gpios = <&gpio3 RK_PD5 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_VOLUMEUP>;
+			label = "volume up";
+		};
+
+		vol-down-key {
+			gpios = <&gpio3 RK_PC7 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_VOLUMEDOWN>;
+			label = "volume down";
+		};
+	};
+
+	joypad: singleadc-joypad {
+		compatible = "singleadc-joypad";
+		joypad-name = "GKD Geek Gamepad";
+		joypad-product = <0x1101>;
+		joypad-revision = <0x0100>;
+		status = "okay";
+		pinctrl-names = "default";
+		pinctrl-0 = <&btn_pins>;
+
+		/*
+		 * Dual analog sticks read straight off saradc ch0-3 (no analog mux
+		 * on this board). Vendor wiring (compute-module io-channels):
+		 *   left  X = ch1, left  Y = ch0,
+		 *   right X = ch2, right Y = ch3.
+		 * The driver's 4-axis layout is (idx0..3) ABS_RZ, ABS_Z, ABS_Y,
+		 * ABS_X; amux-channel-mapping routes each driver axis to its physical
+		 * channel:
+		 *   ABS_RZ(right Y)<-ch3, ABS_Z(right X)<-ch2,
+		 *   ABS_Y (left Y)<-ch0, ABS_X(left X)<-ch1.
+		 * Mapping + invert flags are a best-guess start; tune on HW like the
+		 * sibling ports (evtest).
+		 */
+		io-channels = <&saradc 0>, <&saradc 1>, <&saradc 2>, <&saradc 3>;
+		io-channel-names = "amux_adc_ch0", "amux_adc_ch1",
+				   "amux_adc_ch2", "amux_adc_ch3";
+		amux-count = <4>;
+		amux-channel-mapping = <3 2 0 1>;
+
+		/* Vertical axes typically inverted (mainline abs-range Y = <1023 15>). */
+		invert-absy;
+		invert-absrz;
+
+		button-adc-scale = <2>;
+		button-adc-deadzone = <64>;
+		button-adc-fuzz = <32>;
+		button-adc-flat = <32>;
+		abs_x-p-tuning = <200>;
+		abs_x-n-tuning = <200>;
+		abs_y-p-tuning = <200>;
+		abs_y-n-tuning = <200>;
+		abs_z-p-tuning = <200>;
+		abs_z-n-tuning = <200>;
+		abs_rz-p-tuning = <200>;
+		abs_rz-n-tuning = <200>;
+		poll-interval = <10>;
+
+		sw1 {
+			gpios = <&gpio3 RK_PD6 GPIO_ACTIVE_LOW>;
+			label = "GPIO DPAD-UP";
+			linux,code = <BTN_DPAD_UP>;
+		};
+		sw2 {
+			gpios = <&gpio3 RK_PD7 GPIO_ACTIVE_LOW>;
+			label = "GPIO DPAD-DOWN";
+			linux,code = <BTN_DPAD_DOWN>;
+		};
+		sw3 {
+			gpios = <&gpio4 RK_PA0 GPIO_ACTIVE_LOW>;
+			label = "GPIO DPAD-LEFT";
+			linux,code = <BTN_DPAD_LEFT>;
+		};
+		sw4 {
+			gpios = <&gpio4 RK_PA5 GPIO_ACTIVE_LOW>;
+			label = "GPIO DPAD-RIGHT";
+			linux,code = <BTN_DPAD_RIGHT>;
+		};
+		sw5 {
+			gpios = <&gpio4 RK_PA7 GPIO_ACTIVE_LOW>;
+			label = "GPIO KEY BTN-A";
+			linux,code = <BTN_EAST>;
+		};
+		sw6 {
+			gpios = <&gpio4 RK_PA4 GPIO_ACTIVE_LOW>;
+			label = "GPIO BTN-B";
+			linux,code = <BTN_SOUTH>;
+		};
+		sw7 {
+			gpios = <&gpio4 RK_PA1 GPIO_ACTIVE_LOW>;
+			label = "GPIO BTN-Y";
+			linux,code = <BTN_WEST>;
+		};
+		sw8 {
+			gpios = <&gpio3 RK_PD4 GPIO_ACTIVE_LOW>;
+			label = "GPIO BTN-X";
+			linux,code = <BTN_NORTH>;
+		};
+		sw9 {
+			gpios = <&gpio4 RK_PB0 GPIO_ACTIVE_LOW>;
+			label = "GPIO F1";
+			linux,code = <BTN_TRIGGER_HAPPY1>;
+		};
+		sw10 {
+			gpios = <&gpio4 RK_PB6 GPIO_ACTIVE_LOW>;
+			label = "GPIO BTN_MODE";
+			linux,code = <BTN_MODE>;
+		};
+		sw11 {
+			gpios = <&gpio3 RK_PD3 GPIO_ACTIVE_LOW>;
+			label = "GPIO BTN_SELECT";
+			linux,code = <BTN_SELECT>;
+		};
+		sw12 {
+			gpios = <&gpio4 RK_PA2 GPIO_ACTIVE_LOW>;
+			label = "GPIO BTN_START";
+			linux,code = <BTN_START>;
+		};
+		sw13 {
+			gpios = <&gpio4 RK_PA3 GPIO_ACTIVE_LOW>;
+			label = "GPIO TOP-LEFT";
+			linux,code = <BTN_TL>;
+		};
+		sw14 {
+			gpios = <&gpio4 RK_PC0 GPIO_ACTIVE_LOW>;
+			label = "GPIO TOP-RIGHT";
+			linux,code = <BTN_TR>;
+		};
+		sw15 {
+			gpios = <&gpio4 RK_PA6 GPIO_ACTIVE_LOW>;
+			label = "GPIO TOP-LEFT2";
+			linux,code = <BTN_TL2>;
+		};
+		sw16 {
+			gpios = <&gpio4 RK_PC1 GPIO_ACTIVE_LOW>;
+			label = "GPIO TOP-RIGHT2";
+			linux,code = <BTN_TR2>;
+		};
+		sw17 {
+			gpios = <&gpio4 RK_PB7 GPIO_ACTIVE_LOW>;
+			label = "GPIO BTN_THUMBR";
+			linux,code = <BTN_THUMBR>;
+		};
+		sw18 {
+			gpios = <&gpio3 RK_PD0 GPIO_ACTIVE_LOW>;
+			label = "GPIO BTN_THUMBL";
+			linux,code = <BTN_THUMBL>;
+		};
+	};
+
+	rk809_sound: rk809-sound {
+		status = "okay";
+		compatible = "simple-audio-card";
+		simple-audio-card,format = "i2s";
+		simple-audio-card,name = "rockchip,rk817-codec";
+		simple-audio-card,mclk-fs = <256>;
+
+		simple-audio-card,cpu {
+			sound-dai = <&i2s1_8ch>;
+		};
+		simple-audio-card,codec {
+			sound-dai = <&rk809_codec>;
+		};
+	};
+
+	vcc_sys: vcc-sys {
+		compatible = "regulator-fixed";
+		regulator-name = "vcc_sys";
+		regulator-always-on;
+		regulator-boot-on;
+		regulator-min-microvolt = <3700000>;
+		regulator-max-microvolt = <3700000>;
+	};
+
+	vcc3v3_sys: vcc3v3-sys {
+		compatible = "regulator-fixed";
+		regulator-name = "vcc3v3_sys";
+		regulator-always-on;
+		regulator-boot-on;
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		vin-supply = <&vcc_sys>;
+	};
+
+	vcc3v3: vcc-3v3 {
+		compatible = "regulator-fixed";
+		regulator-name = "vcc3v3";
+		regulator-always-on;
+		regulator-boot-on;
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		vin-supply = <&vcc3v3_sys>;
+		regulator-state-mem {
+			regulator-off-in-suspend;
+		};
+	};
+
+	vcc_mipi_lcd0: vcc-mipi-lcd0 {
+		compatible = "regulator-fixed";
+		regulator-name = "vcc_mipi_lcd0";
+		gpio = <&gpio0 RK_PC7 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		regulator-boot-on;
+		regulator-state-mem {
+			regulator-off-in-suspend;
+		};
+	};
+
+	sdio_pwrseq: sdio-pwrseq {
+		compatible = "mmc-pwrseq-simple";
+		clocks = <&rk809 1>;
+		clock-names = "ext_clock";
+		pinctrl-names = "default";
+		pinctrl-0 = <&wifi_enable_h>;
+		reset-gpios = <&gpio0 RK_PC0 GPIO_ACTIVE_LOW>;
+	};
+
+	/*
+	 * Broadcom BCM43456 / AP6256 SDIO combo (lsusb-equiv SDIO id 02d0:a9a6).
+	 * The rockchip bcmdhd (rockchip_wlan/rkwifi) driver needs this platdata
+	 * node for WL_REG_ON + WL_HOST_WAKE (OOB irq); without it probe aborts
+	 * with "Host OOB irq is not defined". WL_REG_ON shares gpio0 PC0 with the
+	 * mmc-pwrseq reset (same pin, opposite polarity — matches rk3326-evb).
+	 * Firmware present in rootfs: fw_bcm43456c5_ag.bin + nvram_ap6256.txt.
+	 */
+	wireless_wlan: wireless-wlan {
+		compatible = "wlan-platdata";
+		wifi_chip_type = "ap6256";
+		pinctrl-names = "default";
+		pinctrl-0 = <&wifi_host_wake_irq>;
+		WIFI,host_wake_irq = <&gpio0 RK_PC4 GPIO_ACTIVE_HIGH>;
+		WIFI,poweren_gpio = <&gpio0 RK_PC0 GPIO_ACTIVE_HIGH>;
+		status = "okay";
+	};
+
+	vibrator {
+		compatible = "pwm-vibrator";
+		pwms = <&pwm6 0 1000000 0>;
+		pwm-names = "enable";
+		direction-duty-cycle-ns = <1000000>;
+	};
+
+	/*
+	 * Green POWER LED on gpio0 PA5 (active-high). This is the board's only
+	 * SoC-controlled LED — the vendor bq25892 driver called it
+	 * "avrman-charger-led1" and used it only as a <=5% low-battery blink
+	 * (drivers/gamekiddy/led-battery.c), leaving it OFF normally. We instead
+	 * light it steadily as a power-on indicator. HW-confirmed ACTIVE_LOW: the
+	 * green LED lights when gpio0 PA5 is driven LOW (brightness=0 on an
+	 * active-high node lit it), so the node is GPIO_ACTIVE_LOW + default-on.
+	 * The RED charge LED is driven by the bq25892 charger IC's own STAT output
+	 * in hardware (no driver needed).
+	 */
+	gpio_leds: gpio-leds {
+		compatible = "gpio-leds";
+		pinctrl-names = "default";
+		pinctrl-0 = <&led_power_en>;
+
+		power_led: led-power {
+			gpios = <&gpio0 RK_PA5 GPIO_ACTIVE_LOW>;
+			label = "power";
+			default-state = "on";
+		};
+	};
+
+	backlight: backlight {
+		compatible = "pwm-backlight";
+		pwms = <&pwm4 0 25000 0>;
+		brightness-levels = <
+			  0   1   2   3   4   5   6   7
