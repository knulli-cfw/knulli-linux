+++ b/arch/arm64/boot/dts/rockchip/rk3566-miniloong.dts
@@ -0,0 +1,1117 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * Mangmi "Loong" handheld (RK3566 + RK817, LP4x) — KNULLI BSP 6.x port.
+ *
+ * Clean source DTS rebased onto the BSP rk3566.dtsi, converted from the
+ * decompiled vendor DTB (kept at repo-root ./rk3566-miniloong.dts as the
+ * ground-truth reference). Built incrementally: this is the boot scaffold
+ * (PMIC/regulators, eMMC, console, USB); display/inputs/audio/wifi-bt are
+ * layered on top as they are ported and verified on hardware.
+ */
+
+/dts-v1/;
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/linux-event-codes.h>
+#include <dt-bindings/pinctrl/rockchip.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+#include "rk3566.dtsi"
+
+/ {
+	model = "Mangmi Loong (RK3566 RK817 LP4x)";
+	compatible = "mangmi,rk3566-loong", "rockchip,rk3566";
+
+	aliases {
+		mmc0 = &sdhci;
+		/* ALSA card order (soc-core "sound" alias patch): internal first */
+		sound0 = &rk817_sound;	/* rk817 analog MUST stay card 0 */
+		sound1 = &hdmi_sound;	/* HDMI audio = card 1 */
+	};
+
+	chosen {
+		stdout-path = "serial2:1500000n8";
+	};
+
+	fiq-debugger {
+		compatible = "rockchip,fiq-debugger";
+		rockchip,serial-id = <2>;
+		rockchip,wake-irq = <0>;
+		rockchip,irq-mode-enable = <1>;
+		rockchip,baudrate = <1500000>;
+		interrupts = <GIC_SPI 252 IRQ_TYPE_LEVEL_LOW>;
+		status = "okay";
+	};
+
+	vcc3v8_sys: vccsys {
+		compatible = "regulator-fixed";
+		regulator-name = "vcc3v8_sys";
+		regulator-always-on;
+		regulator-boot-on;
+		regulator-min-microvolt = <3800000>;
+		regulator-max-microvolt = <3800000>;
+	};
+
+	vcc_3v3: vcc3v3 {
+		compatible = "regulator-fixed";
+		regulator-name = "vcc_3v3";
+		regulator-always-on;
+		regulator-boot-on;
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		vin-supply = <&vcc3v8_sys>;
+	};
+
+	backlight: backlight {
+		compatible = "pwm-backlight";
+		pwms = <&pwm3 0 25000 0>;
+		enable-gpios = <&gpio0 RK_PB6 GPIO_ACTIVE_HIGH>;
+		brightness-levels = <0 255>;
+		num-interpolated-steps = <255>;
+		default-brightness-level = <128>;
+	};
+
+	/* SD-card slot power switch (gpio0 PC3, enable active-low) */
+	vcc_sd: vcc-sd {
+		compatible = "regulator-gpio";
+		regulator-name = "vcc_sd";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		enable-active-low;
+		enable-gpio = <&gpio0 RK_PC3 GPIO_ACTIVE_LOW>;
+		states = <3300000 0 3300000 1>;
+		vin-supply = <&vcc3v8_sys>;
+	};
+};
+
+&i2c0 {
+	status = "okay";
+
+	vdd_cpu: tcs4525@1c {
+		compatible = "tcs,tcs4525";
+		reg = <0x1c>;
+		vin-supply = <&vcc3v8_sys>;
+		regulator-compatible = "fan53555-reg";
+		regulator-name = "vdd_cpu";
+		regulator-min-microvolt = <712500>;
+		regulator-max-microvolt = <1390000>;
+		regulator-init-microvolt = <900000>;
+		regulator-ramp-delay = <2300>;
+		fcs,suspend-voltage-selector = <1>;
+		regulator-boot-on;
+		regulator-always-on;
+		regulator-state-mem {
+			regulator-off-in-suspend;
+		};
+	};
+
+	rk817: pmic@20 {
+		compatible = "rockchip,rk817";
+		reg = <0x20>;
+		interrupt-parent = <&gpio0>;
+		interrupts = <RK_PA3 IRQ_TYPE_LEVEL_LOW>;
+		rockchip,system-power-controller;
+		wakeup-source;
+		#clock-cells = <1>;
+		clock-output-names = "rk808-clkout1", "rk808-clkout2";
+
+		/*
+		 * Soft power-off. `rockchip,system-power-controller` ALONE is not
+		 * enough: the rk817 has no DEV_OFF path (rk8xx_device_shutdown has no
+		 * RK817 case), it powers off by asserting the SoC PMIC_SLEEP pin
+		 * (gpio0 PA2) via the "pmic-power-off" pinctrl state in
+		 * rk817_shutdown_prepare(). Without this sleep-pin pinctrl,
+		 * pins->power_off stays NULL and `poweroff` only half-powers-down (no
+		 * response to power button or charger until a physical power-cycle).
+		 * rk808.c also REQUIRES a "default" state (gpio0 PA3 = the PMIC int,
+		 * matches `interrupts = <RK_PA3>`) or it bails before wiring power_off.
+		 * Ported from the vendor miniloong dtb (same fix as miyoo-flip/rg-ds).
+		 */
+		pmic-reset-func = <0>;
+		pinctrl-names = "default", "pmic-sleep", "pmic-power-off", "pmic-reset";
+		pinctrl-0 = <&pmic_int>;
+		pinctrl-1 = <&soc_slppin_slp>, <&rk817_slppin_slp>;
+		pinctrl-2 = <&soc_slppin_gpio>, <&rk817_slppin_pwrdn>;
+		pinctrl-3 = <&soc_slppin_gpio>, <&rk817_slppin_rst>;
+		vcc1-supply = <&vcc3v8_sys>;
+		vcc2-supply = <&vcc3v8_sys>;
+		vcc3-supply = <&vcc3v8_sys>;
+		vcc4-supply = <&vcc3v8_sys>;
+		vcc5-supply = <&vcc3v8_sys>;
+		vcc6-supply = <&vcc3v8_sys>;
+		vcc7-supply = <&vcc3v8_sys>;
+		vcc8-supply = <&vcc3v8_sys>;
+		vcc9-supply = <&vcc3v8_sys>;
+
+		pinctrl_rk8xx: pinctrl_rk8xx {
+			gpio-controller;
+			#gpio-cells = <2>;
+
+			rk817_slppin_null: rk817_slppin_null {
+				pins = "gpio_slp";
+				function = "pin_fun0";
+			};
+			rk817_slppin_slp: rk817_slppin_slp {
+				pins = "gpio_slp";
+				function = "pin_fun1";
+			};
+			rk817_slppin_pwrdn: rk817_slppin_pwrdn {
+				pins = "gpio_slp";
+				function = "pin_fun2";
+			};
+			rk817_slppin_rst: rk817_slppin_rst {
+				pins = "gpio_slp";
+				function = "pin_fun3";
+			};
+		};
+
+		pwrkey {
+			status = "okay";
+		};
+
+		regulators {
+			vdd_logic: DCDC_REG1 {
+				regulator-always-on;
+				regulator-boot-on;
+				regulator-min-microvolt = <500000>;
+				regulator-max-microvolt = <1350000>;
+				regulator-init-microvolt = <900000>;
+				regulator-ramp-delay = <6001>;
+				regulator-initial-mode = <0x2>;
+				regulator-name = "vdd_logic";
+				regulator-state-mem {
+					regulator-off-in-suspend;
+					regulator-suspend-microvolt = <900000>;
+				};
+			};
+
+			vdd_gpu: DCDC_REG2 {
+				regulator-always-on;
+				regulator-boot-on;
+				regulator-min-microvolt = <500000>;
+				regulator-max-microvolt = <1350000>;
+				regulator-init-microvolt = <900000>;
+				regulator-ramp-delay = <6001>;
+				regulator-initial-mode = <0x2>;
+				regulator-name = "vdd_gpu";
+				regulator-state-mem {
+					regulator-off-in-suspend;
+				};
+			};
+
+			vcc_ddr: DCDC_REG3 {
+				regulator-always-on;
+				regulator-boot-on;
+				regulator-initial-mode = <0x2>;
+				regulator-name = "vcc_ddr";
+				regulator-state-mem {
+					regulator-on-in-suspend;
+				};
+			};
+
+			vcc_3v3_dcdc: DCDC_REG4 {
+				regulator-always-on;
+				regulator-boot-on;
+				regulator-min-microvolt = <3300000>;
+				regulator-max-microvolt = <3300000>;
+				regulator-initial-mode = <0x2>;
+				regulator-name = "vcc_3v3";
+				regulator-state-mem {
+					regulator-on-in-suspend;
+				};
+			};
+
+			vcca1v8_pmu: LDO_REG1 {
+				regulator-always-on;
+				regulator-boot-on;
+				regulator-min-microvolt = <1800000>;
+				regulator-max-microvolt = <1800000>;
+				regulator-name = "vcca1v8_pmu";
+				regulator-state-mem {
+					regulator-on-in-suspend;
+					regulator-suspend-microvolt = <1800000>;
+				};
+			};
+
+			vdda_0v9: LDO_REG2 {
+				regulator-always-on;
+				regulator-boot-on;
+				regulator-min-microvolt = <900000>;
+				regulator-max-microvolt = <900000>;
+				regulator-name = "vdda_0v9";
+				regulator-state-mem {
+					regulator-off-in-suspend;
+				};
+			};
+
+			vdda0v9_pmu: LDO_REG3 {
+				regulator-always-on;
+				regulator-boot-on;
+				regulator-min-microvolt = <900000>;
+				regulator-max-microvolt = <900000>;
+				regulator-name = "vdda0v9_pmu";
+				regulator-state-mem {
+					regulator-on-in-suspend;
+					regulator-suspend-microvolt = <900000>;
+				};
+			};
+
+			vccio_acodec: LDO_REG4 {
+				regulator-always-on;
+				regulator-boot-on;
+				regulator-min-microvolt = <3300000>;
+				regulator-max-microvolt = <3300000>;
+				regulator-name = "vccio_acodec";
+				regulator-state-mem {
+					regulator-off-in-suspend;
+				};
+			};
+
+			vccio_sd: LDO_REG5 {
+				regulator-always-on;
+				regulator-boot-on;
+				regulator-min-microvolt = <1800000>;
+				regulator-max-microvolt = <3300000>;
+				regulator-name = "vccio_sd";
+				regulator-state-mem {
+					regulator-off-in-suspend;
+				};
+			};
+
+			vcc3v3_pmu: LDO_REG6 {
+				regulator-always-on;
+				regulator-boot-on;
+				regulator-min-microvolt = <3300000>;
+				regulator-max-microvolt = <3300000>;
+				regulator-name = "vcc3v3_pmu";
+				regulator-state-mem {
+					regulator-on-in-suspend;
+					regulator-suspend-microvolt = <3000000>;
+				};
+			};
+
+			vcc_1v8: LDO_REG7 {
+				regulator-always-on;
+				regulator-boot-on;
+				regulator-min-microvolt = <1800000>;
+				regulator-max-microvolt = <1800000>;
+				regulator-name = "vcc_1v8";
+				regulator-state-mem {
+					regulator-off-in-suspend;
+				};
+			};
+
+			vcc1v8_dvp: LDO_REG8 {
+				regulator-always-on;
+				regulator-boot-on;
+				regulator-min-microvolt = <1800000>;
+				regulator-max-microvolt = <1800000>;
+				regulator-name = "vcc1v8_dvp";
+				regulator-state-mem {
+					regulator-off-in-suspend;
+				};
+			};
+
+			vcc2v8_dvp: LDO_REG9 {
+				regulator-always-on;
+				regulator-boot-on;
+				regulator-min-microvolt = <2800000>;
+				regulator-max-microvolt = <2800000>;
+				regulator-name = "vcc2v8_dvp";
+				regulator-state-mem {
+					regulator-off-in-suspend;
+				};
+			};
+
+			vcc_boost: BOOST {
+				regulator-always-on;
+				regulator-boot-on;
+				regulator-min-microvolt = <4700000>;
+				regulator-max-microvolt = <5400000>;
+				regulator-name = "boost";
+				regulator-state-mem {
+					regulator-off-in-suspend;
+				};
+			};
+
+			otg_switch: OTG_SWITCH {
+				regulator-name = "otg_switch";
+				regulator-state-mem {
+					regulator-off-in-suspend;
+				};
+			};
+		};
+	};
+};
+
+/*
+ * Per-bank IO-domain voltages. Without this node the rk3568 PMU IO-voltage
+ * driver never updates the GRF voltage-select bit for the SD bank, so when
+ * the UHS init switches vccio_sd (vccio3) to 1.8V the SoC pad domain stays at
+ * 3.3V -> marginal SDR104 signalling. Robust V30/U3 cards tolerate it; slower
+ * A1/U1 cards (e.g. SanDisk Ultra) fail to enumerate or fail at rootfs mount.
+ * Voltages taken from the miniloong vendor DTB (authoritative for this HW).
+ */
+&pmu_io_domains {
+	pmuio1-supply = <&vcc3v3_pmu>;
+	pmuio2-supply = <&vcc3v3_pmu>;
+	vccio1-supply = <&vccio_acodec>;
+	vccio3-supply = <&vccio_sd>;
+	vccio4-supply = <&vcca1v8_pmu>;
+	vccio5-supply = <&vcc_3v3>;
+	vccio6-supply = <&vcc_3v3>;
+	vccio7-supply = <&vcc_3v3>;
+	status = "okay";
+};
+
+&sdhci {
+	bus-width = <8>;
+	max-frequency = <200000000>;
+	non-removable;
+	mmc-hs200-1_8v;
+	cap-mmc-highspeed;
+	no-sd;
+	no-sdio;
+	vmmc-supply = <&vcc_3v3>;
+	vqmmc-supply = <&vcc_1v8>;
+	status = "okay";
+};
+
+/* microSD slot (KNULLI rootfs lives here) */
+&sdmmc0 {
+	bus-width = <4>;
+	/* vendor caps the SD clock at 150MHz (not the 208MHz SDR104 ceiling) */
+	max-frequency = <150000000>;
+	cap-mmc-highspeed;
+	cap-sd-highspeed;
+	disable-wp;
+	sd-uhs-sdr104;
+	no-sdio;
+	no-mmc;
+	vmmc-supply = <&vcc_sd>;
+	vqmmc-supply = <&vccio_sd>;
+	pinctrl-names = "default";
+	pinctrl-0 = <&sdmmc0_bus4 &sdmmc0_clk &sdmmc0_cmd &sdmmc0_det>;
+	status = "okay";
+};
+
+/*
+ * 2nd (removable) microSD slot on sdmmc2 (dwmmc@fe000000). Config replicated
+ * from the Mangmi vendor DTB: the sdmmc2m1 pinmux group (gpio3 PA1-PA4 bus /
+ * PA5 cmd / PA6 clk / PA7 detect, func5; PA7 det is func4) -- clear of the
+ * joypad (gpio3 PC6-PD7 / gpio2 PC5 / gpio4 PA0-PA3), WiFi (sdmmc1) and BT
+ * (uart1). vmmc = vcc_sd (gpio0 PC3 enable, shared with sdmmc0 per vendor),
+ * vqmmc = vccio_sd (the vccio3 io-domain follows it for the UHS 1.8V switch).
+ * Clock capped at 150MHz like sdmmc0/vendor. Card-detect is the sdmmc2m1_det
+ * pin (no cd-gpios). sdmmc1 = WiFi SDIO; do not confuse the two.
+ */
+&sdmmc2 {
+	bus-width = <4>;
+	max-frequency = <150000000>;
+	cap-mmc-highspeed;
+	cap-sd-highspeed;
+	disable-wp;
+	sd-uhs-sdr104;
+	no-mmc;
+	no-sdio;
+	vmmc-supply = <&vcc_sd>;
+	vqmmc-supply = <&vccio_sd>;
+	pinctrl-names = "default";
+	pinctrl-0 = <&sdmmc2m1_bus4 &sdmmc2m1_clk &sdmmc2m1_cmd &sdmmc2m1_det>;
+	status = "okay";
+};
