+/* ------------------------------------------------------------------------
+ * Audio: RK817 built-in codec on I2S1, BSP-style. Carried from the X55 base
+ * (internal Class-D speaker out-l2spk-r2hp, spk-ctl gpio4 RK_PC2, hp-det gpio4
+ * RK_PC6). UNVERIFIED for RGB30 — cross-check the spk-ctl/hp-det pins against
+ * the 4.x decompile before trusting.
+ * ------------------------------------------------------------------------ */
+&i2s1_8ch {
+	rockchip,trcm-sync-tx-only;
+	/*
+	 * Base rk356x.dtsi i2s1_8ch pinctrl OMITS i2s1m0_mclk, so the external
+	 * rk817 codec would get no master clock -> noise/distortion. Re-add MCLK
+	 * plus the standard sclk/lrck/sdi0/sdo0 (playback + capture).
+	 */
+	pinctrl-names = "default";
+	pinctrl-0 = <&i2s1m0_mclk
+		     &i2s1m0_sclktx &i2s1m0_sclkrx
+		     &i2s1m0_lrcktx &i2s1m0_lrckrx
+		     &i2s1m0_sdi0 &i2s1m0_sdo0>;
+	status = "okay";
+};
+
+&rk817 {
+	rk817_codec: codec {
+		compatible = "rockchip,rk817-codec";
+		#sound-dai-cells = <0>;
+		clocks = <&cru I2S1_MCLKOUT>;
+		clock-names = "mclk";
+		assigned-clocks = <&cru I2S1_MCLKOUT>, <&cru I2S1_MCLK_TX_IOE>;
+		assigned-clock-rates = <12288000>;
+		assigned-clock-parents = <&cru I2S1_MCLKOUT_TX>, <&cru I2S1_MCLKOUT_TX>;
+		hp-volume = <3>;
+		spk-volume = <3>;
+		/* internal Class-D speaker (left) / headphone (right) — carried from X55 */
+		out-l2spk-r2hp;
+		spk-ctl-gpios = <&gpio4 RK_PC2 GPIO_ACTIVE_HIGH>;
+		status = "okay";
+	};
+};
+
+/ {
+	rk817_sound: rk817-sound {
+		compatible = "simple-audio-card";
+		simple-audio-card,format = "i2s";
+		simple-audio-card,name = "rockchip,rk817-codec";
+		simple-audio-card,mclk-fs = <256>;
+		simple-audio-card,hp-det-gpio = <&gpio4 RK_PC6 GPIO_ACTIVE_HIGH>;
+
+		simple-audio-card,cpu {
+			sound-dai = <&i2s1_8ch>;
+		};
+
+		simple-audio-card,codec {
+			sound-dai = <&rk817_codec>;
+		};
+	};
+};
+
+/* ------------------------------------------------------------------------
+ * Power: RK817 fuel gauge + charger MFD children. Calibration values CARRIED
+ * FROM THE X55 base and UNVERIFIED for RGB30 — the RGB30 4.x decompile has its
+ * own OCV curve / design_capacity; swap those in before trusting the gauge.
+ * ------------------------------------------------------------------------ */
+&rk817 {
+	battery {
+		compatible = "rk817,battery";
+		ocv_table = <3400 3553 3621 3688 3735 3768 3801 3826
+			     3843 3857 3878 3904 3934 3972 4006 4020
+			     4030 4044 4059 4083 4138>;
+		design_capacity = <3527>;
+		design_qmax = <3880>;
+		bat_res = <91>;
+		sleep_enter_current = <150>;
+		sleep_exit_current = <180>;
+		sleep_filter_current = <100>;
+		power_off_thresd = <3350>;
+		zero_algorithm_vol = <3300>;
+		max_soc_offset = <60>;
+		monitor_sec = <5>;
+		sample_res = <10>;
+		virtual_power = <0>;
+	};
+
+	charger {
+		compatible = "rk817,charger";
+		min_input_voltage = <4500>;
+		max_input_current = <2000>;
+		max_chrg_current = <2000>;
+		max_chrg_voltage = <4200>;
+		chrg_term_mode = <0>;
+		chrg_finish_cur = <300>;
+		virtual_power = <0>;
+		dc_det_adc = <0>;
+		extcon = <&usb2phy0>;
+	};
+};
+
+/* ------------------------------------------------------------------------
+ * WiFi/BT: RTL8821CS (SDIO wifi on sdmmc1 + BT on uart1). CARRIED FROM THE X55
+ * base and UNVERIFIED for RGB30 — the power/reset/host-wake GPIOs must be
+ * cross-checked against the RGB30 4.x decompile before trusting. Left enabled
+ * so it's staged for that verification step.
+ * ------------------------------------------------------------------------ */
+&pinctrl {
+	sdio-pwrseq {
+		wifi_enable_h: wifi-enable-h {
+			/* WL_REG_ON = gpio4 PA2 (4.x ap6330 sdio-pwrseq reset-gpios) */
+			rockchip,pins = <4 RK_PA2 RK_FUNC_GPIO &pcfg_pull_none>;
+		};
+	};
+
+	vcc-wifi {
+		vcc_wifi_h: vcc-wifi-h {
+			rockchip,pins = <0 RK_PA0 RK_FUNC_GPIO &pcfg_pull_none>;
+		};
+	};
+
+	wireless-wlan {
+		wifi_host_wake_irq: wifi-host-wake-irq {
+			/* WIFI host-wake = gpio4 PA1 (4.x ap6330) */
+			rockchip,pins = <4 RK_PA1 RK_FUNC_GPIO &pcfg_pull_down>;
+		};
+	};
+};
+
+/ {
+	vcc_wifi: regulator-vcc-wifi {
+		compatible = "regulator-fixed";
+		/*
+		 * AP6330 3.3V enable on gpio0 PA0 is ACTIVE-HIGH (4.x vcc-wifi:
+		 * regulator-gpio + enable-active-high). The X55-based port had it
+		 * ACTIVE_LOW, so "enabling" drove PA0 low and the chip stayed dead.
+		 * keep_wifi_power_on in 4.x -> always-on here.
+		 */
+		gpio = <&gpio0 RK_PA0 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		regulator-always-on;
+		regulator-boot-on;
+		pinctrl-names = "default";
+		pinctrl-0 = <&vcc_wifi_h>;
+		regulator-name = "vcc_wifi";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+	};
+
+	sdio_pwrseq: sdio-pwrseq {
+		compatible = "mmc-pwrseq-simple";
+		pinctrl-names = "default";
+		pinctrl-0 = <&wifi_enable_h>;
+		post-power-on-delay-ms = <200>;
+		reset-gpios = <&gpio4 RK_PA2 GPIO_ACTIVE_LOW>;
+		clocks = <&rk817 1>;
+		clock-names = "ext_clock";
+	};
+
+	wireless_wlan: wireless-wlan {
+		compatible = "wlan-platdata";
+		rockchip,grf = <&grf>;
+		/*
+		 * Actual chip is an RTL8821CS (the SDIO CIS binds rtw_8821cs); the
+		 * 4.x vendor DTB's "ap6330" string is wrong/vestigial. Using the
+		 * Broadcom string makes the rockchip dhd infra power-cycle WL_REG_ON
+		 * underneath rtw88 (-110 SDIO timeouts). The 4.x GPIO wiring is still
+		 * the RGB30 hardware truth: WL_REG_ON=gpio4 PA2, host-wake=gpio4 PA1.
+		 */
+		wifi_chip_type = "rtl8821cs";
+		pinctrl-names = "default";
+		pinctrl-0 = <&wifi_host_wake_irq>;
+		WIFI,host_wake_irq = <&gpio4 RK_PA1 GPIO_ACTIVE_HIGH>;
+		status = "okay";
+	};
+};
+
+/*
+ * AP6330 WiFi is on sdmmc2 (fe000000) with the sdmmc2m0 pinmux per the 4.x
+ * vendor DTB, NOT sdmmc1 (fe2c0000). The X55-based port wrongly put it on
+ * sdmmc1, which is actually RGB30's 2nd (removable) microSD slot, so the SDIO
+ * card never enumerated. sdmmc2m0 uses gpio3 PC6/PC7/PD0/PD1 (bus), PD3 (clk),
+ * PD2 (cmd) -- clear of the joypad buttons (gpio3 PA1..PC3).
+ * (sdmmc1 is the 2nd removable microSD slot, enabled above.)
+ */
+&sdmmc2 {
+	bus-width = <4>;
+	disable-wp;
+	cap-sd-highspeed;
+	cap-sdio-irq;
+	keep-power-in-suspend;
+	non-removable;
+	supports-sdio;
+	sd-uhs-sdr104;
+	max-frequency = <100000000>;
+	/*
+	 * Clock sample phase 0x5a (90deg) per the 4.x vendor DTB. Without it the
+	 * dwmmc samples data on the wrong clock edge: the card enumerates at the
+	 * low init clock but bulk transfers (rtw88 firmware download) fail -110.
+	 */
+	rockchip,default-sample-phase = <0x5a>;
+	mmc-pwrseq = <&sdio_pwrseq>;
+	vmmc-supply = <&vcc_wifi>;
+	pinctrl-names = "default";
+	pinctrl-0 = <&sdmmc2m0_bus4 &sdmmc2m0_clk &sdmmc2m0_cmd>;
+	status = "okay";
+};
+
+&uart1 {
+	pinctrl-names = "default";
+	/*
+	 * BT UART is uart1m1 (TX/RX gpio3 PD6/PD7, cts gpio4 PC1, rts gpio4 PB6)
+	 * per the 4.x vendor DTB (serial@fe650000 used uart1m1-xfer) and rgxx3.
+	 * The X55-base port used uart1m0 (gpio2), which put TX/RX on the wrong
+	 * pins -> rtk_hciattach's H5 SYNC got no reply, no hci0. (The 4.x
+	 * uart_rts_gpios=gpio2 PB5 is a separate gpio-RTS, NOT the UART mux.)
+	 *
+	 * NOTE: do NOT add a serdev `bluetooth {}` child here. knulli's
+	 * S32bluetooth brings BT up with userspace `rtk_hciattach ... ttyS1 rtk_h5`
+	 * (same as RG DS/ARC-S); a serdev child makes the kernel own ttyS1 and
+	 * rtk_hciattach then fails with "Can't open serial port". Leave ttyS1 as a
+	 * plain tty; power/reset is handled by the wireless-bluetooth rfkill node.
+	 */
+	pinctrl-0 = <&uart1m1_xfer &uart1m1_ctsn &uart1m1_rtsn>;
+	uart-has-rtscts;
+	status = "okay";
+};
+
+/ {
+	wireless_bluetooth: wireless-bluetooth {
+		compatible = "bluetooth-platdata";
+		clocks = <&rk817 1>;
+		clock-names = "ext_clock";
+		/* RTL8821CS BT control GPIOs, gpio4 PA3/PA4/PA5 (4.x vendor DTB). */
+		BT,reset_gpio    = <&gpio4 RK_PA3 GPIO_ACTIVE_HIGH>;
+		BT,wake_gpio     = <&gpio4 RK_PA4 GPIO_ACTIVE_HIGH>;
+		BT,wake_host_irq = <&gpio4 RK_PA5 GPIO_ACTIVE_HIGH>;
+		status = "okay";
+	};
+};
diff --git a/arch/arm64/boot/dts/rockchip/rk3566-powkiddy-x55-rgb30test.dts b/arch/arm64/boot/dts/rockchip/rk3566-powkiddy-x55-rgb30test.dts
new file mode 100644
index 000000000..22248689b
--- /dev/null
+++ b/arch/arm64/boot/dts/rockchip/rk3566-powkiddy-x55-rgb30test.dts
@@ -0,0 +1,924 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * Powkiddy X55 (RK3566 + RK817) — KNULLI BSP 6.x port.
+ *
+ * Clean in-tree DTS rebased onto the BSP rk3566.dtsi, converted from the
+ * decompiled vendor 4.x DTB (kept at repo-root ./rk3566-powkiddy-x55.dts as
+ * the ground-truth reference). Structured like the working rk3566-miniloong
+ * port (generic rk3566 + rk817 handheld), carrying the RG ARC-S display fixes.
+ *
+ * Brought up incrementally: this revision is the boot scaffold
+ * (PMIC/regulators, eMMC, microSD, console, USB-adb) + the internal MIPI-DSI
+ * panel. Inputs / audio / wifi-bt / HDMI are layered on later as verified.
+ */
+
+/dts-v1/;
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/linux-event-codes.h>
+#include <dt-bindings/pinctrl/rockchip.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+#include "rk3566.dtsi"
+ 
+/ {
+	model = "Powkiddy X55 (RGB30 panel test)";
+	compatible = "powkiddy,x55", "rockchip,rk3566";
+
+	aliases {
+		mmc0 = &sdhci;
+		mmc1 = &sdmmc0;
+		/* deterministic ALSA card order (soc-core "sound" alias patch) */
+		sound0 = &rk817_sound;
+	};
+
+	chosen {
+		stdout-path = "serial2:1500000n8";
+	};
+
+	fiq-debugger {
+		compatible = "rockchip,fiq-debugger";
+		rockchip,serial-id = <2>;
+		rockchip,wake-irq = <0>;
+		rockchip,irq-mode-enable = <1>;
+		rockchip,baudrate = <1500000>;
+		interrupts = <GIC_SPI 252 IRQ_TYPE_LEVEL_LOW>;
+		status = "okay";
+	};
+
+	vcc3v8_sys: vccsys {
+		compatible = "regulator-fixed";
+		regulator-name = "vcc3v8_sys";
+		regulator-always-on;
+		regulator-boot-on;
+		regulator-min-microvolt = <3800000>;
+		regulator-max-microvolt = <3800000>;
+	};
+
+	vcc_3v3: vcc3v3 {
+		compatible = "regulator-fixed";
+		regulator-name = "vcc_3v3";
+		regulator-always-on;
+		regulator-boot-on;
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		vin-supply = <&vcc3v8_sys>;
+	};
+
+	/* microSD slot power switch: gpio0 RK_PA5, enable active-low (4.x vcc_sd) */
+	vcc_sd: vcc-sd {
+		compatible = "regulator-gpio";
+		regulator-name = "vcc_sd";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		enable-active-low;
+		enable-gpio = <&gpio0 RK_PA5 GPIO_ACTIVE_LOW>;
+		states = <3300000 0 3300000 1>;
+		vin-supply = <&vcc3v8_sys>;
+	};
+
+	backlight: backlight {
+		compatible = "pwm-backlight";
+		pwms = <&pwm4 0 25000 0>;
+		brightness-levels = <0 255>;
+		num-interpolated-steps = <255>;
+		default-brightness-level = <200>;
+	};
+};
+
+&i2c0 {
+	status = "okay";
+
+	vdd_cpu: tcs4525@1c {
+		compatible = "tcs,tcs452x";
+		reg = <0x1c>;
+		vin-supply = <&vcc3v8_sys>;
+		regulator-compatible = "fan53555-reg";
+		regulator-name = "vdd_cpu";
+		regulator-min-microvolt = <712500>;
+		regulator-max-microvolt = <1390000>;
+		regulator-init-microvolt = <900000>;
+		regulator-ramp-delay = <2300>;
+		fcs,suspend-voltage-selector = <1>;
+		regulator-boot-on;
+		regulator-always-on;
+		regulator-state-mem {
+			regulator-off-in-suspend;
+		};
+	};
+
+	rk817: pmic@20 {
+		compatible = "rockchip,rk817";
+		reg = <0x20>;
+		interrupt-parent = <&gpio0>;
+		interrupts = <RK_PA3 IRQ_TYPE_LEVEL_LOW>;
+		rockchip,system-power-controller;
+		wakeup-source;
+		#clock-cells = <1>;
+		clock-output-names = "rk808-clkout1", "rk808-clkout2";
+		vcc1-supply = <&vcc3v8_sys>;
+		vcc2-supply = <&vcc3v8_sys>;
+		vcc3-supply = <&vcc3v8_sys>;
+		vcc4-supply = <&vcc3v8_sys>;
+		vcc5-supply = <&vcc3v8_sys>;
+		vcc6-supply = <&vcc3v8_sys>;
+		vcc7-supply = <&vcc3v8_sys>;
+		vcc8-supply = <&vcc3v8_sys>;
+		vcc9-supply = <&vcc3v8_sys>;
+
+		pwrkey {
+			status = "okay";
+		};
+
+		regulators {
+			vdd_logic: DCDC_REG1 {
+				regulator-always-on;
+				regulator-boot-on;
+				regulator-min-microvolt = <500000>;
+				regulator-max-microvolt = <1350000>;
+				regulator-init-microvolt = <900000>;
+				regulator-ramp-delay = <6001>;
+				regulator-initial-mode = <0x2>;
+				regulator-name = "vdd_logic";
+				regulator-state-mem {
+					regulator-off-in-suspend;
+					regulator-suspend-microvolt = <900000>;
+				};
+			};
+
+			vdd_gpu: DCDC_REG2 {
+				regulator-always-on;
+				regulator-boot-on;
+				regulator-min-microvolt = <500000>;
+				regulator-max-microvolt = <1350000>;
+				regulator-init-microvolt = <900000>;
+				regulator-ramp-delay = <6001>;
+				regulator-initial-mode = <0x2>;
+				regulator-name = "vdd_gpu";
+				regulator-state-mem {
+					regulator-off-in-suspend;
+				};
+			};
+
+			vcc_ddr: DCDC_REG3 {
+				regulator-always-on;
+				regulator-boot-on;
+				regulator-initial-mode = <0x2>;
+				regulator-name = "vcc_ddr";
+				regulator-state-mem {
+					regulator-on-in-suspend;
+				};
+			};
+
+			vcc_3v3_dcdc: DCDC_REG4 {
+				regulator-always-on;
+				regulator-boot-on;
+				regulator-min-microvolt = <3300000>;
+				regulator-max-microvolt = <3300000>;
+				regulator-initial-mode = <0x2>;
+				regulator-name = "vcc_3v3";
+				regulator-state-mem {
+					regulator-on-in-suspend;
+				};
+			};
+
+			vcca1v8_pmu: LDO_REG1 {
+				regulator-always-on;
+				regulator-boot-on;
+				regulator-min-microvolt = <1800000>;
+				regulator-max-microvolt = <1800000>;
+				regulator-name = "vcca1v8_pmu";
+				regulator-state-mem {
+					regulator-on-in-suspend;
+					regulator-suspend-microvolt = <1800000>;
+				};
+			};
+
+			vdda_0v9: LDO_REG2 {
+				regulator-always-on;
+				regulator-boot-on;
+				regulator-min-microvolt = <900000>;
+				regulator-max-microvolt = <900000>;
+				regulator-name = "vdda_0v9";
+				regulator-state-mem {
+					regulator-off-in-suspend;
+				};
+			};
+
+			vdda0v9_pmu: LDO_REG3 {
+				regulator-always-on;
+				regulator-boot-on;
+				regulator-min-microvolt = <900000>;
+				regulator-max-microvolt = <900000>;
+				regulator-name = "vdda0v9_pmu";
+				regulator-state-mem {
+					regulator-on-in-suspend;
+					regulator-suspend-microvolt = <900000>;
+				};
+			};
+
+			vccio_acodec: LDO_REG4 {
+				regulator-always-on;
+				regulator-boot-on;
+				regulator-min-microvolt = <3300000>;
+				regulator-max-microvolt = <3300000>;
+				regulator-name = "vccio_acodec";
+				regulator-state-mem {
+					regulator-off-in-suspend;
+				};
+			};
+
+			vccio_sd: LDO_REG5 {
+				regulator-always-on;
+				regulator-boot-on;
+				regulator-min-microvolt = <1800000>;
+				regulator-max-microvolt = <3300000>;
+				regulator-name = "vccio_sd";
+				regulator-state-mem {
+					regulator-off-in-suspend;
+				};
+			};
+
+			vcc3v3_pmu: LDO_REG6 {
+				regulator-always-on;
+				regulator-boot-on;
+				regulator-min-microvolt = <3300000>;
+				regulator-max-microvolt = <3300000>;
+				regulator-name = "vcc3v3_pmu";
+				regulator-state-mem {
+					regulator-on-in-suspend;
+					regulator-suspend-microvolt = <3000000>;
+				};
+			};
+
+			vcc_1v8: LDO_REG7 {
+				regulator-always-on;
+				regulator-boot-on;
+				regulator-min-microvolt = <1800000>;
+				regulator-max-microvolt = <1800000>;
+				regulator-name = "vcc_1v8";
+				regulator-state-mem {
+					regulator-off-in-suspend;
+				};
+			};
+
+			vcc1v8_dvp: LDO_REG8 {
+				regulator-always-on;
+				regulator-boot-on;
+				regulator-min-microvolt = <1800000>;
+				regulator-max-microvolt = <1800000>;
+				regulator-name = "vcc1v8_dvp";
+				regulator-state-mem {
+					regulator-off-in-suspend;
+				};
+			};
+
+			vcc2v8_dvp: LDO_REG9 {
+				regulator-always-on;
+				regulator-boot-on;
+				regulator-min-microvolt = <1800000>;
+				regulator-max-microvolt = <3300000>;
+				regulator-name = "vcc2v8_dvp";
+				regulator-state-mem {
+					regulator-off-in-suspend;
+				};
+			};
+
+			boost: BOOST {
+				regulator-always-on;
+				regulator-boot-on;
+				regulator-min-microvolt = <4700000>;
+				regulator-max-microvolt = <5400000>;
+				regulator-name = "boost";
+			};
+
+			otg_switch: OTG_SWITCH {
+				regulator-name = "otg_switch";
+			};
+		};
+	};
+};
+
+/*
+ * PMU/VCCIO voltage domains, copied from the 4.x X55 DTB. These must match the
+ * board's actual io-rail wiring or pins (incl. the microSD and DSI) sit at the
+ * wrong level. vccio3 = vccio_sd feeds the SD bus.
+ */
+&pmu_io_domains {
+	pmuio1-supply = <&vcc3v3_pmu>;
+	pmuio2-supply = <&vcca1v8_pmu>;
+	vccio1-supply = <&vccio_acodec>;
+	vccio3-supply = <&vccio_sd>;
+	vccio4-supply = <&vcca1v8_pmu>;
+	vccio5-supply = <&vcc2v8_dvp>;
+	vccio6-supply = <&vcc1v8_dvp>;
+	vccio7-supply = <&vcc_3v3>;
+	status = "okay";
+};
+
+&sdhci {
+	bus-width = <8>;
+	max-frequency = <200000000>;
+	non-removable;
+	mmc-hs200-1_8v;
+	cap-mmc-highspeed;
+	no-sd;
+	no-sdio;
+	vmmc-supply = <&vcc_3v3>;
+	vqmmc-supply = <&vcc_1v8>;
+	status = "okay";
+};
+
+/* microSD slot (KNULLI rootfs may live here) */
+&sdmmc0 {
+	bus-width = <4>;
+	cap-mmc-highspeed;
+	cap-sd-highspeed;
+	disable-wp;
+	sd-uhs-sdr104;
+	no-sdio;
+	no-mmc;
+	vmmc-supply = <&vcc_sd>;
+	vqmmc-supply = <&vccio_sd>;
+	pinctrl-names = "default";
+	pinctrl-0 = <&sdmmc0_bus4 &sdmmc0_clk &sdmmc0_cmd &sdmmc0_det>;
+	status = "okay";
+};
+
+&uart2 {
+	status = "okay";
+};
