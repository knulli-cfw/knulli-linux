+&vop {
+	/*
+	 * Parent VP0's pixel clock to HPLL (and VP1's to VPLL). The vop2
+	 * mode_valid only accepts a connector's mode if dclk rounds EXACTLY,
+	 * and rk3568 round_rate returns the exact rate only when the dclk
+	 * parent is HPLL or VPLL. Without this, VP0's dclk uses a generic PLL
+	 * that hits the panel's 47 MHz but not HDMI rates -> all HDMI modes get
+	 * pruned (0 modes). HPLL retunes for both the panel and HDMI, so they
+	 * can share VP0 and be switched (mutually exclusive). Same as rgxx3.
+	 */
+	assigned-clocks = <&cru DCLK_VOP0>, <&cru DCLK_VOP1>;
+	assigned-clock-parents = <&pmucru PLL_HPLL>, <&cru PLL_VPLL>;
+	status = "okay";
