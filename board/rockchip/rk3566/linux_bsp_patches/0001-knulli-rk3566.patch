+/*
+ * ATTRIBUTE:
+ *
+ *   /sys/devices/platform/singleadc-joypad/dpad_mode [rw]
+ *
+ * Toggle the D-pad between button events and an emulated left analog stick:
+ *   0 / "dpad"     -> D-pad reports BTN_DPAD_UP/DOWN/LEFT/RIGHT (default)
+ *   1 / "joystick" -> D-pad drives ABS_X/ABS_Y (full deflection per direction)
+ * Only present when the board opts in via the "rocknix,dpad-joystick" DT prop.
+ */
+static ssize_t joypad_show_dpad_mode(struct device *dev,
+				     struct device_attribute *attr, char *buf)
+{
+	struct platform_device *pdev  = to_platform_device(dev);
+	struct joypad *joypad = platform_get_drvdata(pdev);
+
+	return sprintf(buf, "%d\n", joypad->dpad_as_joystick ? 1 : 0);
+}
+
+static ssize_t joypad_store_dpad_mode(struct device *dev,
+				      struct device_attribute *attr,
+				      const char *buf, size_t count)
+{
+	struct platform_device *pdev  = to_platform_device(dev);
+	struct joypad *joypad = platform_get_drvdata(pdev);
+	bool want;
+
+	if (sysfs_streq(buf, "1") || sysfs_streq(buf, "joystick"))
+		want = true;
+	else if (sysfs_streq(buf, "0") || sysfs_streq(buf, "dpad"))
+		want = false;
+	else
+		return -EINVAL;
+
+	mutex_lock(&joypad->lock);
+	if (want != joypad->dpad_as_joystick) {
+		joypad->dpad_as_joystick = want;
+		joypad->dpad_resync = true;  /* applied in poll context */
+	}
+	mutex_unlock(&joypad->lock);
+
+	return count;
+}
