+		reset-delay-ms = <10>;
+		init-delay-ms = <10>;
+		enable-delay-ms = <10>;
+		disable-delay-ms = <10>;
+		unprepare-delay-ms = <10>;
+		width-mm = <119>;
+		height-mm = <143>;
+		dsi,flags = <0xe03>;
+		dsi,format = <0>;
+		dsi,lanes = <2>;
+		panel-init-sequence = [
+			29 00 02 30 00 29 00 05 f7 49 61 02 00 29 00 02 30 01 29 00 02 04 0c
+			29 00 02 0b 01 29 00 02 20 04 29 00 02 25 19 29 00 02 28 18
+			29 00 02 30 02 29 00 02 00 11 29 00 02 01 26 29 00 02 02 10
+			29 00 02 05 68 29 00 02 06 80
+			29 00 0c 0b 0d 0d 03 0d 03 0d 03 03 15 08 06
+			29 00 0c 0c 1d 1f 25 27 29 2b 16 21 0d 0b 0d
+			29 00 0c 0d 0d 0d 03 0d 03 0d 03 03 15 09 07
+			29 00 0c 0e 1c 1e 24 26 28 2a 0a 20 0d 0b 0d
+			29 00 0c 0f 0d 0d 03 0d 0b 0d 03 03 15 2a 28
+			29 00 0c 10 26 24 1e 1c 07 09 20 0a 0d 03 0d
+			29 00 0c 11 0d 0d 03 0d 0b 0d 03 03 15 2b 29
+			29 00 0c 12 27 25 1f 1d 06 08 21 16 0d 03 0d 29 00 05 13 00 00 41 41
+			29 00 05 14 00 00 41 41 29 00 03 1a 0b 14 29 00 02 30 06
+			29 00 0f 12 3f 24 23 30 26 2d 34 38 3b 32 22 18 12 00
+			29 00 0f 13 3f 24 23 30 26 2c 33 37 3a 31 22 18 12 00 29 00 02 30 07
+			29 00 02 0d 01 29 00 02 30 08 29 00 02 05 01 29 00 02 0c 1a
+			29 00 02 0d 0e 29 00 02 30 0a 29 00 02 02 4f 29 00 02 0b 40
+			29 00 02 30 0d 29 00 02 10 0c 29 00 02 11 0c 29 00 02 12 0c
+			29 00 02 13 0c 29 00 02 30 00 15 ff 02 11 00 15 ff 02 29 00
+		];
+		panel-exit-sequence = [05 40 01 28 05 78 01 10];
+
+		display-timings {
