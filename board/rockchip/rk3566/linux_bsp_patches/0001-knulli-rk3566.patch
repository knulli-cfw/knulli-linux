+/* ------------------------------------------------------------------------
+ * Display: 720x720 square MIPI-DSI panel on DSI0 -> VP0 (DCLK_VOP0 -> HPLL),
+ * 90-degree rotation, 50 MHz pixel clock. ST7703-style init sequence. This is
+ * the configuration CONFIRMED to light the RGB30 panel on hardware (proven via
+ * the X55 board base). Carries the RG ARC-S/miniloong display fixes.
+ * ------------------------------------------------------------------------ */
+/*
+ * RGB30 must NOT take the seamless U-Boot->kernel logo handoff.
+ *
+ * Its panel is a simple-panel-dsi that REQUIRES the kernel to send its
+ * ST7703-style MIPI init (DCS) sequence in panel_simple_prepare() to actually
+ * light the pixels (see the panel@0 init-sequence below). The handoff path
+ * (loader_protect, via init_loader_memory()+setup_initial_state()) inherits
+ * U-Boot's live display and SKIPS panel prepare, so the init sequence is never
+ * sent: the VOP/DSI come up "ACTIVE" with a real fb and backlight on, but the
+ * panel ignores the stream and stays black until a resume does a full
+ * disable->prepare->enable. (HW-confirmed 2026-06-24: dri/0/summary showed
+ * VP0 ACTIVE + win ACTIVE + backlight on, panel still dark.)
+ *
+ * Deleting the drm-logo memory-region makes init_loader_memory() bail so
+ * rockchip_drm_show_logo() returns early (no loader_protect) and the panel
+ * gets a full kernel cold-init -> init sequence sent -> panel lights. The other
+ * RK3566 boards keep the handoff (their panels init identically under U-Boot);
+ * RGB30 has no stripe-corruption to fix, so losing the handoff costs nothing.
+ * The guard-page fix in rockchip_drm_logo.c is irrelevant here (we never reach
+ * it), but harmless.
+ */
+&display_subsystem {
+	/delete-property/ memory-region;
+	/delete-property/ memory-region-names;
+};
+
+/*
+ * Parent DCLK_VOP0 to HPLL so the panel pixel clock (and later HDMI mode
+ * validation) round exactly; vop-supply lets OPP/aclk DVFS init succeed.
+ */
+&vop {
+	assigned-clocks = <&cru DCLK_VOP0>, <&cru DCLK_VOP1>;
+	assigned-clock-parents = <&pmucru PLL_HPLL>, <&cru PLL_VPLL>;
+	vop-supply = <&vdd_logic>;
+	status = "okay";
+};
+
+&vop_mmu {
+	status = "okay";
+};
