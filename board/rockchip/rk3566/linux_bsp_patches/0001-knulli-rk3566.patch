+/* ------------------------------------------------------------------------
+ * Inputs: dual analog sticks (4 direct saradc channels) + 16 game buttons
+ * via the rocknix singleadc-joypad driver (CONFIG_JOYSTICK_ROCKNIX_SINGLEADC),
+ * presented as ONE device so ES maps it cleanly — same approach as the ARC /
+ * miniloong ports. Volume keys go through gpio-keys (system keys).
+ *
+ * The 4.x vendor DTB drove these with a "zed,joystick" driver whose key order
+ * is hardcoded in the driver (not in the DT) and which this kernel does not
+ * have. The authoritative GPIO->button map + stick channels are taken from the
+ * mainline upstream rk3566-powkiddy-x55.dts (adc-joystick + gpio-keys); the
+ * pins match the 4.x key-gpios list 1:1.
+ * ------------------------------------------------------------------------ */
+&pinctrl {
+	joypad {
+		joypad_btns: joypad-btns {
+			rockchip,pins =
+				<3 RK_PC6 RK_FUNC_GPIO &pcfg_pull_up>,
+				<3 RK_PC7 RK_FUNC_GPIO &pcfg_pull_up>,
+				<3 RK_PD0 RK_FUNC_GPIO &pcfg_pull_up>,
+				<3 RK_PD1 RK_FUNC_GPIO &pcfg_pull_up>,
+				<3 RK_PD2 RK_FUNC_GPIO &pcfg_pull_up>,
+				<3 RK_PD3 RK_FUNC_GPIO &pcfg_pull_up>,
+				<3 RK_PD4 RK_FUNC_GPIO &pcfg_pull_up>,
+				<3 RK_PD5 RK_FUNC_GPIO &pcfg_pull_up>,
+				<3 RK_PD6 RK_FUNC_GPIO &pcfg_pull_up>,
+				<3 RK_PD7 RK_FUNC_GPIO &pcfg_pull_up>,
+				<4 RK_PA0 RK_FUNC_GPIO &pcfg_pull_up>,
+				<4 RK_PA1 RK_FUNC_GPIO &pcfg_pull_up>,
+				<4 RK_PA2 RK_FUNC_GPIO &pcfg_pull_up>,
+				<4 RK_PA4 RK_FUNC_GPIO &pcfg_pull_up>,
+				<4 RK_PA7 RK_FUNC_GPIO &pcfg_pull_up>,
+				<4 RK_PB0 RK_FUNC_GPIO &pcfg_pull_up>;
+		};
+	};
+
+	gpio-keys-vol {
+		vol_btns: vol-btns {
+			rockchip,pins =
+				<4 RK_PA3 RK_FUNC_GPIO &pcfg_pull_up>,
+				<4 RK_PA5 RK_FUNC_GPIO &pcfg_pull_up>;
+		};
+	};
+};
+
+/ {
+	joypad: singleadc-joypad {
+		compatible = "singleadc-joypad";
+		joypad-name = "Powkiddy X55 Gamepad";
+		joypad-product = <0x0055>;
+		joypad-revision = <0x0100>;
+		status = "okay";
+		pinctrl-names = "default";
+		pinctrl-0 = <&joypad_btns>;
+
+		/*
+		 * Dual analog sticks read straight off saradc ch0-3 (no analog mux
+		 * on this board). io-channel order = physical channels:
+		 *   ch0 = left X, ch1 = left Y, ch2 = right X, ch3 = right Y.
+		 * The driver's 4-axis layout is (idx0..3) ABS_RZ, ABS_Z, ABS_Y,
+		 * ABS_X; amux-channel-mapping routes each to its physical channel:
+		 *   ABS_RZ(right Y)<-ch3, ABS_Z(right X)<-ch2,
+		 *   ABS_Y (left Y)<-ch1, ABS_X(left X)<-ch0.
+		 */
+		io-channels = <&saradc 0>, <&saradc 1>, <&saradc 2>, <&saradc 3>;
+		io-channel-names = "amux_adc_ch0", "amux_adc_ch1",
+				   "amux_adc_ch2", "amux_adc_ch3";
+		amux-count = <4>;
+		amux-channel-mapping = <3 2 1 0>;
+
+		/* Vertical axes are inverted (mainline abs-range Y = <1023 15>). */
+		invert-absy;
+		invert-absrz;
+
+		button-adc-scale = <2>;
+		button-adc-deadzone = <64>;
+		button-adc-fuzz = <32>;
+		button-adc-flat = <32>;
+		abs_x-p-tuning = <200>;
+		abs_x-n-tuning = <200>;
+		abs_y-p-tuning = <200>;
+		abs_y-n-tuning = <200>;
+		abs_z-p-tuning = <200>;
+		abs_z-n-tuning = <200>;
+		abs_rz-p-tuning = <200>;
+		abs_rz-n-tuning = <200>;
+		poll-interval = <10>;
+
+		sw1 {
+			gpios = <&gpio3 RK_PD3 GPIO_ACTIVE_LOW>;
+			label = "GPIO BTN-A";
+			linux,code = <BTN_EAST>;
+		};
+		sw2 {
+			gpios = <&gpio3 RK_PD2 GPIO_ACTIVE_LOW>;
+			label = "GPIO BTN-B";
+			linux,code = <BTN_SOUTH>;
+		};
+		sw3 {
+			gpios = <&gpio3 RK_PD5 GPIO_ACTIVE_LOW>;
+			label = "GPIO BTN-X";
+			linux,code = <BTN_NORTH>;
+		};
+		sw4 {
+			gpios = <&gpio3 RK_PD4 GPIO_ACTIVE_LOW>;
+			label = "GPIO BTN-Y";
+			linux,code = <BTN_WEST>;
+		};
+		sw5 {
+			gpios = <&gpio4 RK_PA0 GPIO_ACTIVE_LOW>;
+			label = "GPIO DPAD-UP";
+			linux,code = <BTN_DPAD_UP>;
+		};
+		sw6 {
+			gpios = <&gpio4 RK_PA1 GPIO_ACTIVE_LOW>;
+			label = "GPIO DPAD-DOWN";
+			linux,code = <BTN_DPAD_DOWN>;
+		};
+		sw7 {
+			gpios = <&gpio3 RK_PD6 GPIO_ACTIVE_LOW>;
+			label = "GPIO DPAD-LEFT";
+			linux,code = <BTN_DPAD_LEFT>;
+		};
+		sw8 {
+			gpios = <&gpio3 RK_PD7 GPIO_ACTIVE_LOW>;
+			label = "GPIO DPAD-RIGHT";
+			linux,code = <BTN_DPAD_RIGHT>;
+		};
+		sw9 {
+			gpios = <&gpio3 RK_PD0 GPIO_ACTIVE_LOW>;
+			label = "GPIO BTN-TL";
+			linux,code = <BTN_TL>;
+		};
+		sw10 {
+			gpios = <&gpio3 RK_PD1 GPIO_ACTIVE_LOW>;
+			label = "GPIO BTN-TL2";
+			linux,code = <BTN_TL2>;
+		};
+		sw11 {
+			gpios = <&gpio3 RK_PC6 GPIO_ACTIVE_LOW>;
+			label = "GPIO BTN-TR";
+			linux,code = <BTN_TR>;
+		};
+		sw12 {
+			gpios = <&gpio3 RK_PC7 GPIO_ACTIVE_LOW>;
+			label = "GPIO BTN-TR2";
+			linux,code = <BTN_TR2>;
+		};
+		sw13 {
+			gpios = <&gpio4 RK_PA4 GPIO_ACTIVE_LOW>;
+			label = "GPIO BTN-SELECT";
+			linux,code = <BTN_SELECT>;
+		};
+		sw14 {
+			gpios = <&gpio4 RK_PA2 GPIO_ACTIVE_LOW>;
+			label = "GPIO BTN-START";
+			linux,code = <BTN_START>;
+		};
+		sw15 {
+			gpios = <&gpio4 RK_PA7 GPIO_ACTIVE_LOW>;
+			label = "GPIO BTN-THUMBL";
+			linux,code = <BTN_THUMBL>;
+		};
+		sw16 {
+			gpios = <&gpio4 RK_PB0 GPIO_ACTIVE_LOW>;
+			label = "GPIO BTN-THUMBR";
+			linux,code = <BTN_THUMBR>;
+		};
+	};
+
+	gpio_keys_vol: gpio-keys-vol {
+		compatible = "gpio-keys";
+		autorepeat;
+		pinctrl-names = "default";
+		pinctrl-0 = <&vol_btns>;
+
+		button-volup {
+			gpios = <&gpio4 RK_PA5 GPIO_ACTIVE_LOW>;
+			label = "VOLUMEUP";
+			linux,code = <KEY_VOLUMEUP>;
+		};
+		button-voldown {
+			gpios = <&gpio4 RK_PA3 GPIO_ACTIVE_LOW>;
+			label = "VOLUMEDOWN";
+			linux,code = <KEY_VOLUMEDOWN>;
+		};
+	};
+};
+
+/* ------------------------------------------------------------------------
+ * Audio: RK817 built-in codec on I2S1, BSP-style (rk817 codec MFD child +
+ * plain simple-audio-card), same pattern as the ARC/miniloong ports. The X55
+ * (per its 4.x DTB) drives the speaker via the rk817 INTERNAL Class-D
+ * (out-l2spk-r2hp), gated by spk-ctl gpio4 RK_PC2 (ACTIVE_HIGH); headphone
+ * detect on gpio4 RK_PC6.
+ * ------------------------------------------------------------------------ */
+&i2s1_8ch {
+	rockchip,trcm-sync-tx-only;
+	/*
+	 * Base rk356x.dtsi i2s1_8ch pinctrl OMITS i2s1m0_mclk, so the external
+	 * rk817 codec would get no master clock -> noise/distortion. Re-add MCLK
+	 * plus the standard sclk/lrck/sdi0/sdo0 (playback + capture).
+	 */
+	pinctrl-names = "default";
+	pinctrl-0 = <&i2s1m0_mclk
+		     &i2s1m0_sclktx &i2s1m0_sclkrx
+		     &i2s1m0_lrcktx &i2s1m0_lrckrx
+		     &i2s1m0_sdi0 &i2s1m0_sdo0>;
+	status = "okay";
+};
+
+&rk817 {
+	rk817_codec: codec {
+		compatible = "rockchip,rk817-codec";
+		#sound-dai-cells = <0>;
+		clocks = <&cru I2S1_MCLKOUT>;
+		clock-names = "mclk";
+		assigned-clocks = <&cru I2S1_MCLKOUT>, <&cru I2S1_MCLK_TX_IOE>;
+		assigned-clock-rates = <12288000>;
+		assigned-clock-parents = <&cru I2S1_MCLKOUT_TX>, <&cru I2S1_MCLKOUT_TX>;
+		hp-volume = <3>;
+		spk-volume = <3>;
+		/* internal Class-D speaker (left) / headphone (right) — X55 4.x */
+		out-l2spk-r2hp;
+		spk-ctl-gpios = <&gpio4 RK_PC2 GPIO_ACTIVE_HIGH>;
+		status = "okay";
+	};
+};
+
+/ {
+	rk817_sound: rk817-sound {
+		compatible = "simple-audio-card";
+		simple-audio-card,format = "i2s";
+		simple-audio-card,name = "rockchip,rk817-codec";
+		simple-audio-card,mclk-fs = <256>;
+		simple-audio-card,hp-det-gpio = <&gpio4 RK_PC6 GPIO_ACTIVE_HIGH>;
+
+		simple-audio-card,cpu {
+			sound-dai = <&i2s1_8ch>;
+		};
+
+		simple-audio-card,codec {
+			sound-dai = <&rk817_codec>;
+		};
+	};
+};
+
+/* ------------------------------------------------------------------------
+ * Power: RK817 fuel gauge (rk817,battery) + charger (rk817,charger) MFD
+ * children — rk808.c registers these cells; without the child nodes
+ * /sys/class/power_supply stays empty. Calibration values from the X55 4.x
+ * DTB (the OCV curve matches the mainline X55 battery). Charge-source detect
+ * via usb2phy0 (already enabled for OTG/adb). The kernel's rk817_battery
+ * STATUS patch (PLUG_IN_STS) gives correct Charging/Discharging on OTG.
+ * ------------------------------------------------------------------------ */
+&rk817 {
+	battery {
+		compatible = "rk817,battery";
+		ocv_table = <3400 3553 3621 3688 3735 3768 3801 3826
+			     3843 3857 3878 3904 3934 3972 4006 4020
+			     4030 4044 4059 4083 4138>;
+		design_capacity = <3527>;
+		design_qmax = <3880>;
+		bat_res = <91>;
+		sleep_enter_current = <150>;
+		sleep_exit_current = <180>;
+		sleep_filter_current = <100>;
+		power_off_thresd = <3350>;
+		zero_algorithm_vol = <3300>;
+		max_soc_offset = <60>;
+		monitor_sec = <5>;
+		sample_res = <10>;
+		virtual_power = <0>;
+	};
+
+	charger {
+		compatible = "rk817,charger";
+		min_input_voltage = <4500>;
+		max_input_current = <2000>;
+		max_chrg_current = <2000>;
+		/* 4.x DTB had a bogus 0x3ed (=1005mV); use the standard LiPo 4.2V */
+		max_chrg_voltage = <4200>;
+		chrg_term_mode = <0>;
+		chrg_finish_cur = <300>;
+		virtual_power = <0>;
+		dc_det_adc = <0>;
+		extcon = <&usb2phy0>;
+	};
+};
+
+/* ------------------------------------------------------------------------
+ * WiFi: SDIO on sdmmc1. Chip = Realtek RTL8821CS (both the 4.x DTB and the
+ * mainline upstream X55 dts agree — same combo chip as the RG ARC-S). Config
+ * follows the mainline X55:
+ *   - vcc_wifi: the chip's MAIN 3V3 power (GPIO regulator, enable gpio0 PA0
+ *     ACTIVE_LOW). This was the missing piece — without it the chip has no
+ *     power and never answers on SDIO. (I had wrongly folded PA0 into the
+ *     pwrseq as a second reset.)
+ *   - sdio_pwrseq: single reset gpio0 PC0 (WL_REG_ON) + rk817 clkout2 32k LPO.
+ *   - sdmmc1: vmmc = vcc_wifi.
+ * rtw88_8821cs binds the enumerated SDIO device (like the ARC).
+ * ------------------------------------------------------------------------ */
+&pinctrl {
+	sdio-pwrseq {
+		wifi_enable_h: wifi-enable-h {
+			rockchip,pins = <0 RK_PC0 RK_FUNC_GPIO &pcfg_pull_none>;
+		};
+	};
+
+	vcc-wifi {
+		vcc_wifi_h: vcc-wifi-h {
+			rockchip,pins = <0 RK_PA0 RK_FUNC_GPIO &pcfg_pull_none>;
+		};
+	};
+
+	wireless-wlan {
+		wifi_host_wake_irq: wifi-host-wake-irq {
+			rockchip,pins = <0 RK_PC4 RK_FUNC_GPIO &pcfg_pull_down>;
+		};
+	};
+};
+
+/ {
+	vcc_wifi: regulator-vcc-wifi {
+		compatible = "regulator-fixed";
+		gpio = <&gpio0 RK_PA0 GPIO_ACTIVE_LOW>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&vcc_wifi_h>;
+		regulator-name = "vcc_wifi";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+	};
+
+	sdio_pwrseq: sdio-pwrseq {
+		compatible = "mmc-pwrseq-simple";
+		pinctrl-names = "default";
+		pinctrl-0 = <&wifi_enable_h>;
+		post-power-on-delay-ms = <200>;
+		reset-gpios = <&gpio0 RK_PC0 GPIO_ACTIVE_LOW>;
+		clocks = <&rk817 1>;
+		clock-names = "ext_clock";
+	};
+
+	wireless_wlan: wireless-wlan {
+		compatible = "wlan-platdata";
+		rockchip,grf = <&grf>;
+		wifi_chip_type = "rtl8821cs";
+		pinctrl-names = "default";
+		pinctrl-0 = <&wifi_host_wake_irq>;
+		WIFI,host_wake_irq = <&gpio0 RK_PC4 GPIO_ACTIVE_HIGH>;
+		status = "okay";
+	};
+};
+
+&sdmmc1 {
+	bus-width = <4>;
+	cap-sd-highspeed;
+	cap-sdio-irq;
+	keep-power-in-suspend;
+	non-removable;
+	supports-sdio;
+	mmc-pwrseq = <&sdio_pwrseq>;
+	vmmc-supply = <&vcc_wifi>;
+	pinctrl-names = "default";
+	pinctrl-0 = <&sdmmc1_bus4 &sdmmc1_clk &sdmmc1_cmd>;
+	status = "okay";
+};
+
+/* ------------------------------------------------------------------------
+ * Bluetooth: RTL8821CS BT core on uart1 (/dev/ttyS1). Same combo chip + same
+ * approach as the RG ARC-S: the KNULLI rootfs brings it up with rtk_hciattach
+ * (S32bluetooth: `rfkill unblock bluetooth` then
+ * `rtk_hciattach -n -s 115200 ttyS1 rtk_h5`), NOT the mainline serdev/btrtl
+ * path (which needed btrtl IC-table patching on this BSP kernel). BT power +
+ * the rfkill "bluetooth" device come from the wireless-bluetooth platdata node.
+ *
+ * NB (firmware, rootfs side): rtk_hciattach must use a BT config blob with HW
+ * flow control CLEARED — this board's uart1 RTS/CTS isn't usefully wired to the
+ * BT chip, so leaving it on makes the firmware download / HCI reset corrupt.
+ * Reuse the ARC's patched rtl8821cs_config (byte 21 0x5f -> 0x5b) at
+ * /lib/firmware/rtl_bt/rtl8821cs_config. uart-has-rtscts below is then unused
+ * but harmless (kept to match the mainline X55 / ARC).
+ * ------------------------------------------------------------------------ */
+&uart1 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&uart1m0_xfer &uart1m0_ctsn &uart1m0_rtsn>;
+	uart-has-rtscts;
+	status = "okay";
+};
+
+/ {
+	wireless_bluetooth: wireless-bluetooth {
+		compatible = "bluetooth-platdata";
+		clocks = <&rk817 1>;
+		clock-names = "ext_clock";
+		BT,reset_gpio    = <&gpio0 RK_PC1 GPIO_ACTIVE_HIGH>;
+		BT,wake_gpio     = <&gpio0 RK_PB6 GPIO_ACTIVE_HIGH>;
+		BT,wake_host_irq = <&gpio0 RK_PB5 GPIO_ACTIVE_HIGH>;
+		status = "okay";
+	};
+};
diff --git a/arch/arm64/boot/dts/rockchip/rk3566-powkiddy-x55.dts b/arch/arm64/boot/dts/rockchip/rk3566-powkiddy-x55.dts
new file mode 100644
index 000000000..a08340a2e
--- /dev/null
+++ b/arch/arm64/boot/dts/rockchip/rk3566-powkiddy-x55.dts
@@ -0,0 +1,1031 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * Powkiddy X55 (RK3566 + RK817) — KNULLI BSP 6.x port.
+ *
+ * Clean in-tree DTS rebased onto the BSP rk3566.dtsi, converted from the
+ * decompiled vendor 4.x DTB (kept at repo-root ./rk3566-powkiddy-x55.dts as
+ * the ground-truth reference). Structured like the working rk3566-miniloong
+ * port (generic rk3566 + rk817 handheld), carrying the RG ARC-S display fixes.
+ *
+ * Brought up incrementally: this revision is the boot scaffold
+ * (PMIC/regulators, eMMC, microSD, console, USB-adb) + the internal MIPI-DSI
+ * panel. Inputs / audio / wifi-bt / HDMI are layered on later as verified.
+ */
+
+/dts-v1/;
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/linux-event-codes.h>
+#include <dt-bindings/pinctrl/rockchip.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+#include "rk3566.dtsi"
+
+/ {
+	model = "Powkiddy X55";
+	compatible = "powkiddy,x55", "rockchip,rk3566";
+
+	aliases {
+		mmc0 = &sdhci;
+		mmc1 = &sdmmc0;
+		/* deterministic ALSA card order (soc-core "sound" alias patch):
+		 * rk817 analog MUST stay card 0; HDMI audio is card 1. */
+		sound0 = &rk817_sound;
+		sound1 = &hdmi_sound;
+	};
+
+	chosen {
+		stdout-path = "serial2:1500000n8";
+	};
+
+	fiq-debugger {
+		compatible = "rockchip,fiq-debugger";
+		rockchip,serial-id = <2>;
+		rockchip,wake-irq = <0>;
+		rockchip,irq-mode-enable = <1>;
+		rockchip,baudrate = <1500000>;
+		interrupts = <GIC_SPI 252 IRQ_TYPE_LEVEL_LOW>;
+		status = "okay";
+	};
+
+	vcc3v8_sys: vccsys {
+		compatible = "regulator-fixed";
+		regulator-name = "vcc3v8_sys";
+		regulator-always-on;
+		regulator-boot-on;
+		regulator-min-microvolt = <3800000>;
+		regulator-max-microvolt = <3800000>;
+	};
+
+	vcc_3v3: vcc3v3 {
+		compatible = "regulator-fixed";
+		regulator-name = "vcc_3v3";
+		regulator-always-on;
+		regulator-boot-on;
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		vin-supply = <&vcc3v8_sys>;
+	};
+
+	/* microSD slot power switch: gpio0 RK_PA5, enable active-low (4.x vcc_sd) */
+	vcc_sd: vcc-sd {
+		compatible = "regulator-gpio";
+		regulator-name = "vcc_sd";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		enable-active-low;
+		enable-gpio = <&gpio0 RK_PA5 GPIO_ACTIVE_LOW>;
+		states = <3300000 0 3300000 1>;
+		vin-supply = <&vcc3v8_sys>;
+	};
+
+	backlight: backlight {
+		compatible = "pwm-backlight";
+		pwms = <&pwm4 0 25000 0>;
+		brightness-levels = <0 255>;
+		num-interpolated-steps = <255>;
+		default-brightness-level = <200>;
+	};
+};
+
+&i2c0 {
+	status = "okay";
+
+	vdd_cpu: tcs4525@1c {
+		compatible = "tcs,tcs452x";
+		reg = <0x1c>;
+		vin-supply = <&vcc3v8_sys>;
+		regulator-compatible = "fan53555-reg";
+		regulator-name = "vdd_cpu";
+		regulator-min-microvolt = <712500>;
+		regulator-max-microvolt = <1390000>;
+		regulator-init-microvolt = <900000>;
+		regulator-ramp-delay = <2300>;
+		fcs,suspend-voltage-selector = <1>;
+		regulator-boot-on;
+		regulator-always-on;
+		regulator-state-mem {
+			regulator-off-in-suspend;
+		};
+	};
+
+	rk817: pmic@20 {
+		compatible = "rockchip,rk817";
+		reg = <0x20>;
+		interrupt-parent = <&gpio0>;
+		interrupts = <RK_PA3 IRQ_TYPE_LEVEL_LOW>;
+		rockchip,system-power-controller;
+		wakeup-source;
+		#clock-cells = <1>;
+		clock-output-names = "rk808-clkout1", "rk808-clkout2";
+
+		/*
+		 * Soft power-off. `rockchip,system-power-controller` ALONE is not
+		 * enough: the rk817 has no DEV_OFF path, it powers off by asserting the
+		 * SoC PMIC_SLEEP pin (gpio0 PA2) via the "pmic-power-off" pinctrl state
+		 * in rk817_shutdown_prepare(). Without this sleep-pin pinctrl,
+		 * pins->power_off stays NULL and `poweroff` only half-powers-down (no
+		 * response to power button or charger until a physical power-cycle).
+		 * rk808.c also REQUIRES a "default" state (gpio0 PA3 = the PMIC int,
+		 * matches `interrupts = <RK_PA3>`) or it bails before wiring power_off.
+		 * Same fix as miniloong / miyoo-flip / rg-ds.
+		 */
+		pmic-reset-func = <0>;
+		pinctrl-names = "default", "pmic-sleep", "pmic-power-off", "pmic-reset";
+		pinctrl-0 = <&pmic_int>;
+		pinctrl-1 = <&soc_slppin_slp>, <&rk817_slppin_slp>;
+		pinctrl-2 = <&soc_slppin_gpio>, <&rk817_slppin_pwrdn>;
+		pinctrl-3 = <&soc_slppin_gpio>, <&rk817_slppin_rst>;
+		vcc1-supply = <&vcc3v8_sys>;
+		vcc2-supply = <&vcc3v8_sys>;
+		vcc3-supply = <&vcc3v8_sys>;
+		vcc4-supply = <&vcc3v8_sys>;
+		vcc5-supply = <&vcc3v8_sys>;
+		vcc6-supply = <&vcc3v8_sys>;
+		vcc7-supply = <&vcc3v8_sys>;
+		vcc8-supply = <&vcc3v8_sys>;
+		vcc9-supply = <&vcc3v8_sys>;
+
+		pinctrl_rk8xx: pinctrl_rk8xx {
+			gpio-controller;
+			#gpio-cells = <2>;
+
+			rk817_slppin_null: rk817_slppin_null {
+				pins = "gpio_slp";
+				function = "pin_fun0";
+			};
+			rk817_slppin_slp: rk817_slppin_slp {
+				pins = "gpio_slp";
+				function = "pin_fun1";
+			};
+			rk817_slppin_pwrdn: rk817_slppin_pwrdn {
+				pins = "gpio_slp";
+				function = "pin_fun2";
+			};
+			rk817_slppin_rst: rk817_slppin_rst {
+				pins = "gpio_slp";
+				function = "pin_fun3";
+			};
+		};
+
+		pwrkey {
+			status = "okay";
+		};
+
+		regulators {
+			vdd_logic: DCDC_REG1 {
+				regulator-always-on;
+				regulator-boot-on;
+				regulator-min-microvolt = <500000>;
+				regulator-max-microvolt = <1350000>;
+				regulator-init-microvolt = <900000>;
+				regulator-ramp-delay = <6001>;
+				regulator-initial-mode = <0x2>;
+				regulator-name = "vdd_logic";
+				regulator-state-mem {
+					regulator-off-in-suspend;
+					regulator-suspend-microvolt = <900000>;
+				};
+			};
+
+			vdd_gpu: DCDC_REG2 {
+				regulator-always-on;
+				regulator-boot-on;
+				regulator-min-microvolt = <500000>;
+				regulator-max-microvolt = <1350000>;
+				regulator-init-microvolt = <900000>;
+				regulator-ramp-delay = <6001>;
+				regulator-initial-mode = <0x2>;
+				regulator-name = "vdd_gpu";
+				regulator-state-mem {
+					regulator-off-in-suspend;
+				};
+			};
+
+			vcc_ddr: DCDC_REG3 {
+				regulator-always-on;
+				regulator-boot-on;
+				regulator-initial-mode = <0x2>;
+				regulator-name = "vcc_ddr";
+				regulator-state-mem {
+					regulator-on-in-suspend;
+				};
+			};
+
+			vcc_3v3_dcdc: DCDC_REG4 {
+				regulator-always-on;
+				regulator-boot-on;
+				regulator-min-microvolt = <3300000>;
+				regulator-max-microvolt = <3300000>;
+				regulator-initial-mode = <0x2>;
+				regulator-name = "vcc_3v3";
+				regulator-state-mem {
+					regulator-on-in-suspend;
+				};
+			};
+
+			vcca1v8_pmu: LDO_REG1 {
+				regulator-always-on;
+				regulator-boot-on;
+				regulator-min-microvolt = <1800000>;
+				regulator-max-microvolt = <1800000>;
+				regulator-name = "vcca1v8_pmu";
+				regulator-state-mem {
+					regulator-on-in-suspend;
+					regulator-suspend-microvolt = <1800000>;
+				};
+			};
+
+			vdda_0v9: LDO_REG2 {
+				regulator-always-on;
+				regulator-boot-on;
+				regulator-min-microvolt = <900000>;
+				regulator-max-microvolt = <900000>;
+				regulator-name = "vdda_0v9";
+				regulator-state-mem {
+					regulator-off-in-suspend;
+				};
+			};
+
+			vdda0v9_pmu: LDO_REG3 {
+				regulator-always-on;
+				regulator-boot-on;
+				regulator-min-microvolt = <900000>;
+				regulator-max-microvolt = <900000>;
+				regulator-name = "vdda0v9_pmu";
+				regulator-state-mem {
+					regulator-on-in-suspend;
+					regulator-suspend-microvolt = <900000>;
+				};
+			};
+
+			vccio_acodec: LDO_REG4 {
+				regulator-always-on;
+				regulator-boot-on;
+				regulator-min-microvolt = <3300000>;
+				regulator-max-microvolt = <3300000>;
+				regulator-name = "vccio_acodec";
+				regulator-state-mem {
+					regulator-off-in-suspend;
+				};
+			};
+
+			vccio_sd: LDO_REG5 {
+				regulator-always-on;
+				regulator-boot-on;
+				regulator-min-microvolt = <1800000>;
+				regulator-max-microvolt = <3300000>;
+				regulator-name = "vccio_sd";
+				regulator-state-mem {
+					regulator-off-in-suspend;
+				};
+			};
+
+			vcc3v3_pmu: LDO_REG6 {
+				regulator-always-on;
+				regulator-boot-on;
+				regulator-min-microvolt = <3300000>;
+				regulator-max-microvolt = <3300000>;
+				regulator-name = "vcc3v3_pmu";
+				regulator-state-mem {
+					regulator-on-in-suspend;
+					regulator-suspend-microvolt = <3000000>;
+				};
+			};
+
+			vcc_1v8: LDO_REG7 {
+				regulator-always-on;
+				regulator-boot-on;
+				regulator-min-microvolt = <1800000>;
+				regulator-max-microvolt = <1800000>;
+				regulator-name = "vcc_1v8";
+				regulator-state-mem {
+					regulator-off-in-suspend;
+				};
+			};
+
+			vcc1v8_dvp: LDO_REG8 {
+				regulator-always-on;
+				regulator-boot-on;
+				regulator-min-microvolt = <1800000>;
+				regulator-max-microvolt = <1800000>;
+				regulator-name = "vcc1v8_dvp";
+				regulator-state-mem {
+					regulator-off-in-suspend;
+				};
+			};
+
+			vcc2v8_dvp: LDO_REG9 {
+				regulator-always-on;
+				regulator-boot-on;
+				regulator-min-microvolt = <1800000>;
+				regulator-max-microvolt = <3300000>;
+				regulator-name = "vcc2v8_dvp";
+				regulator-state-mem {
+					regulator-off-in-suspend;
+				};
+			};
+
+			boost: BOOST {
+				regulator-always-on;
+				regulator-boot-on;
+				regulator-min-microvolt = <4700000>;
+				regulator-max-microvolt = <5400000>;
+				regulator-name = "boost";
+			};
+
+			otg_switch: OTG_SWITCH {
+				regulator-name = "otg_switch";
+			};
+		};
+	};
+};
+
+/*
+ * PMU/VCCIO voltage domains, copied from the 4.x X55 DTB. These must match the
+ * board's actual io-rail wiring or pins (incl. the microSD and DSI) sit at the
+ * wrong level. vccio3 = vccio_sd feeds the SD bus.
+ */
+&pmu_io_domains {
+	pmuio1-supply = <&vcc3v3_pmu>;
+	pmuio2-supply = <&vcca1v8_pmu>;
+	vccio1-supply = <&vccio_acodec>;
+	vccio3-supply = <&vccio_sd>;
+	vccio4-supply = <&vcca1v8_pmu>;
+	vccio5-supply = <&vcc2v8_dvp>;
+	vccio6-supply = <&vcc1v8_dvp>;
+	vccio7-supply = <&vcc_3v3>;
+	status = "okay";
+};
+
+&sdhci {
+	bus-width = <8>;
+	max-frequency = <200000000>;
+	non-removable;
+	mmc-hs200-1_8v;
+	cap-mmc-highspeed;
+	no-sd;
+	no-sdio;
+	vmmc-supply = <&vcc_3v3>;
+	vqmmc-supply = <&vcc_1v8>;
+	status = "okay";
+};
+
+/* microSD slot (KNULLI rootfs may live here) */
+&sdmmc0 {
+	bus-width = <4>;
+	cap-mmc-highspeed;
+	cap-sd-highspeed;
+	disable-wp;
+	sd-uhs-sdr104;
+	no-sdio;
+	no-mmc;
+	vmmc-supply = <&vcc_sd>;
+	vqmmc-supply = <&vccio_sd>;
+	pinctrl-names = "default";
+	pinctrl-0 = <&sdmmc0_bus4 &sdmmc0_clk &sdmmc0_cmd &sdmmc0_det>;
+	status = "okay";
+};
+
+/*
+ * 2nd (removable) microSD slot on sdmmc2 (dwmmc@fe000000). Config agrees between
+ * the 4.x vendor DTB and the mainline upstream X55: sdmmc2m1 pinmux (gpio3
+ * PA1-PA4 bus / PA5 cmd / PA6 clk / PA7 detect) -- clear of the joypad and the
+ * WiFi (sdmmc1) / BT (uart1) pins. vqmmc = vcc2v8_dvp, which is ALSO the vccio5
+ * io-domain supply for this pad bank, so the domain tracks the UHS 1.8V switch
+ * automatically (vcc2v8_dvp is a 1.8-3.3V switchable rail despite its name). No
+ * vmmc (card power is a board rail, matching vendor/mainline). 150MHz cap like
+ * sdmmc0/vendor. Card-detect is the sdmmc2m1_det pin. sdmmc1 = WiFi SDIO.
+ */
+&sdmmc2 {
+	bus-width = <4>;
+	max-frequency = <150000000>;
+	cap-mmc-highspeed;
+	cap-sd-highspeed;
+	disable-wp;
+	sd-uhs-sdr104;
+	no-mmc;
+	no-sdio;
+	vqmmc-supply = <&vcc2v8_dvp>;
+	pinctrl-names = "default";
+	pinctrl-0 = <&sdmmc2m1_bus4 &sdmmc2m1_clk &sdmmc2m1_cmd &sdmmc2m1_det>;
+	status = "okay";
+};
+
+&uart2 {
+	status = "okay";
+};
+
+&saradc {
+	vref-supply = <&vcca1v8_pmu>;
+	status = "okay";
+};
+
+/* USB OTG (adb) — inner dwc3 + glue wrapper + phy */
+&usb2phy0 {
+	status = "okay";
+};
+
+&usb2phy0_otg {
+	status = "okay";
+};
+
+&usbdrd30 {
+	status = "okay";
+};
+
+&usbdrd_dwc3 {
+	dr_mode = "otg";
+	extcon = <&usb2phy0>;
+	status = "okay";
+};
+
+/* ------------------------------------------------------------------------
+ * Display: single MIPI-DSI panel (HX8399-style, 720x1280p60, portrait,
+ * rotation 90) on DSI0 -> VP0. Carries the RG ARC-S/miniloong display fixes.
+ * ------------------------------------------------------------------------ */
+/*
+ * KEEP the U-Boot drm-logo memory-region (inherited from the base dtsi) so the
+ * kernel inherits the live logo via the seamless handoff. The IOMMU fault that
+ * once motivated dropping it is fixed in rockchip_drm_logo.c (the +1 guard page
+ * in init_loader_memory()). Opting out here instead reverts to cold-init, which
+ * produces the fine-stripe corruption on the uboot->kernel transition. Matches
+ * rg-ds. Do NOT re-add the /delete-property/ memory-region opt-out.
+ */
+
+/*
+ * Parent DCLK_VOP0 to HPLL so the panel pixel clock (and later HDMI mode
+ * validation) round exactly; vop-supply lets OPP/aclk DVFS init succeed.
+ */
+&vop {
+	assigned-clocks = <&cru DCLK_VOP0>, <&cru DCLK_VOP1>;
+	assigned-clock-parents = <&pmucru PLL_HPLL>, <&cru PLL_VPLL>;
+	vop-supply = <&vdd_logic>;
+	status = "okay";
+};
+
+&vop_mmu {
+	status = "okay";
+};
+
+&gpu {
+	mali-supply = <&vdd_gpu>;
+	status = "okay";
+};
+
+&pwm4 {
+	status = "okay";
+};
+
+&rk_rga {
+	status = "okay";
+};
+
+&video_phy0 {
+	status = "okay";
+};
+
+&dsi0 {
+	status = "okay";
+	#address-cells = <1>;
+	#size-cells = <0>;
+
+	dsi0_panel: panel@0 {
+		status = "okay";
+		compatible = "simple-panel-dsi";
+		reg = <0>;
+		backlight = <&backlight>;
+
+		/* Panel power + reset (gpio0), from the 4.x X55 DTB. */
+		enable-gpios = <&gpio0 RK_PC7 GPIO_ACTIVE_HIGH>;
+		reset-gpios = <&gpio0 RK_PD5 GPIO_ACTIVE_LOW>;
+
+		reset-delay-ms = <60>;
+		enable-delay-ms = <120>;
+		prepare-delay-ms = <60>;
+		init-delay-ms = <60>;
+		unprepare-delay-ms = <60>;
+		disable-delay-ms = <60>;
+
+		rotation = <90>;
+
+		dsi,flags = <0xa03>;
+		dsi,format = <0>;
+		dsi,lanes = <4>;
+
+		panel-init-sequence = <0x390004b9 0xff839439 0x7ba63 0x3686bb2 0xc039000b 0xb1481272 0x9325471 0x71574739 0x7b200 0x80640c0d 0x2f390016 0xb4737473 0x74737401 0xc867500 0x3f737473 0x74737401 0xc863900 0x3b66e6e 0x390022d3 0x707 0x40070c00 0x8100800 0x854150a 0x50a0215 0x6050647 0x440a0a4b 0x1007070c 0x4039002d 0xd51c1c1d 0x1d000102 0x3040506 0x708090a 0xb242518 0x18262718 0x18181818 0x18181818 0x18181818 0x18181820 0x21181818 0x1839002d 0xd61c1c1d 0x1d070605 0x4030201 0xb0a09 0x8212018 0x18272618 0x18181818 0x18181818 0x18181818 0x18181825 0x24181818 0x1839003b 0xe0000a15 0x1b1e2124 0x22475665 0x666e8288 0x8b9a9d98 0xa8b95d5c 0x61666a6f 0x7f7f000a 0x151b1e21 0x24224756 0x65656e81 0x878b989d 0x99a8ba5d 0x5d62676b 0x727f7f39 0x3c01f 0x31150002 0xcc0b1500 0x2d40215 0x2bd02 0x39000dd8 0xffffffff 0xffffffff 0xffffffff 0x150002bd 0x150002 0xbd011500 0x2b10015 0x2bd00 0x390008bf 0x40815000 0x1afc0115 0x2c6ed 0x5780111 0x5140129>;
+		panel-exit-sequence = <0x5000128 0x5000110>;
+
+		display-timings {
+			native-mode = <&timing0>;
+
+			timing0: timing0 {
+				clock-frequency = <60000000>;
+				hactive = <720>;
+				vactive = <1280>;
+				hback-porch = <20>;
+				hfront-porch = <24>;
+				hsync-len = <4>;
+				vback-porch = <8>;
+				vfront-porch = <8>;
+				vsync-len = <4>;
+				hsync-active = <0>;
+				vsync-active = <0>;
+				de-active = <0>;
+				pixelclk-active = <0>;
+			};
+		};
+
+		port {
+			panel_in_dsi: endpoint {
+				remote-endpoint = <&dsi0_out_panel>;
+			};
+		};
+	};
+
+	ports {
+		port@1 {
+			reg = <1>;
+
+			dsi0_out_panel: endpoint {
+				remote-endpoint = <&panel_in_dsi>;
+			};
+		};
+	};
+};
+
+&dsi0_in_vp0 {
+	status = "okay";
+};
+
+&dsi0_in_vp1 {
+	status = "disabled";
+};
+
+&route_dsi0 {
+	connect = <&vp0_out_dsi0>;
+	status = "okay";
+};
+
+/*
+ * HDMI is PARKED for now — disabled entirely. (On the miniloong, enabling HDMI
+ * on VP1 made the rk3566 VOP2 count only 1 active VP, leaving VP1 without a
+ * CRTC and hanging the whole DRM bind. Revisit HDMI after the panel is solid.)
+ */
+/*
+ * HDMI on VP0 (shared with the DSI panel) => mutually exclusive with the
+ * internal display: connecting HDMI turns the internal panel off (single CRTC).
+ * RK3566 VOP2's VP1 cannot drive HDMI cleanly (win-close/dsp_hold timeouts +
+ * internal corruption / fb copies when both VPs are live), so HDMI uses the
+ * working VP0. DDC via the base internal pinctrl (hdmitx_scl/sda). Same approach
+ * as rg-arc-s. See [[hdmi-mutual-exclusion]].
+ */
+&hdmi {
+	status = "okay";
+};
+
+&hdmi_in_vp0 {
+	status = "okay";
+};
+
+&hdmi_in_vp1 {
+	status = "disabled";
+};
+
+&route_hdmi {
+	connect = <&vp0_out_hdmi>;
+	status = "okay";
+};
+
+/*
+ * HDMI audio: base hdmi-sound simple-audio-card links i2s0 (CPU) -> hdmi
+ * (codec); both default disabled. Enable so the "HDMI" ALSA card (card 1)
+ * appears and knulli-audio "auto" can route to it. i2s0->HDMI is internal.
+ */
+&hdmi_sound {
+	status = "okay";
+};
+
+&i2s0_8ch {
+	status = "okay";
+};
+
+/* ------------------------------------------------------------------------
+ * Inputs: dual analog sticks (4 direct saradc channels) + 16 game buttons
+ * via the rocknix singleadc-joypad driver (CONFIG_JOYSTICK_ROCKNIX_SINGLEADC),
+ * presented as ONE device so ES maps it cleanly — same approach as the ARC /
+ * miniloong ports. Volume keys go through gpio-keys (system keys).
+ *
+ * The 4.x vendor DTB drove these with a "zed,joystick" driver whose key order
+ * is hardcoded in the driver (not in the DT) and which this kernel does not
+ * have. The authoritative GPIO->button map + stick channels are taken from the
+ * mainline upstream rk3566-powkiddy-x55.dts (adc-joystick + gpio-keys); the
+ * pins match the 4.x key-gpios list 1:1.
+ * ------------------------------------------------------------------------ */
+&pinctrl {
+	pmic {
+		/* rk817 IRQ default (gpio0 PA3, matches interrupts = <RK_PA3>). */
+		pmic_int: pmic_int {
+			rockchip,pins = <0 RK_PA3 RK_FUNC_GPIO &pcfg_pull_up>;
+		};
+		/*
+		 * SoC PMIC_SLEEP pin (gpio0 PA2). Driven low (GPIO) for power-off so
+		 * rk817_shutdown_prepare() can cut the rails. pull_up = sleep,
+		 * pull_none = reset. PA2 is the silicon PMIC_SLEEP pin, free here.
+		 */
+		soc_slppin_gpio: soc_slppin_gpio {
+			rockchip,pins = <0 RK_PA2 RK_FUNC_GPIO &pcfg_output_low_pull_down>;
+		};
+		soc_slppin_slp: soc_slppin_slp {
+			rockchip,pins = <0 RK_PA2 RK_FUNC_GPIO &pcfg_pull_up>;
+		};
+		soc_slppin_rst: soc_slppin_rst {
+			rockchip,pins = <0 RK_PA2 RK_FUNC_GPIO &pcfg_pull_none>;
+		};
+	};
+	joypad {
+		joypad_btns: joypad-btns {
+			rockchip,pins =
+				<3 RK_PC6 RK_FUNC_GPIO &pcfg_pull_up>,
+				<3 RK_PC7 RK_FUNC_GPIO &pcfg_pull_up>,
+				<3 RK_PD0 RK_FUNC_GPIO &pcfg_pull_up>,
+				<3 RK_PD1 RK_FUNC_GPIO &pcfg_pull_up>,
+				<3 RK_PD2 RK_FUNC_GPIO &pcfg_pull_up>,
+				<3 RK_PD3 RK_FUNC_GPIO &pcfg_pull_up>,
+				<3 RK_PD4 RK_FUNC_GPIO &pcfg_pull_up>,
+				<3 RK_PD5 RK_FUNC_GPIO &pcfg_pull_up>,
+				<3 RK_PD6 RK_FUNC_GPIO &pcfg_pull_up>,
+				<3 RK_PD7 RK_FUNC_GPIO &pcfg_pull_up>,
+				<4 RK_PA0 RK_FUNC_GPIO &pcfg_pull_up>,
+				<4 RK_PA1 RK_FUNC_GPIO &pcfg_pull_up>,
+				<4 RK_PA2 RK_FUNC_GPIO &pcfg_pull_up>,
+				<4 RK_PA4 RK_FUNC_GPIO &pcfg_pull_up>,
+				<4 RK_PA7 RK_FUNC_GPIO &pcfg_pull_up>,
+				<4 RK_PB0 RK_FUNC_GPIO &pcfg_pull_up>;
+		};
+	};
+
+	gpio-keys-vol {
+		vol_btns: vol-btns {
+			rockchip,pins =
+				<4 RK_PA3 RK_FUNC_GPIO &pcfg_pull_up>,
+				<4 RK_PA5 RK_FUNC_GPIO &pcfg_pull_up>;
+		};
+	};
+};
+
+/ {
+	joypad: singleadc-joypad {
+		compatible = "singleadc-joypad";
+		joypad-name = "Powkiddy X55 Gamepad";
+		joypad-product = <0x0055>;
+		joypad-revision = <0x0100>;
+		status = "okay";
+		pinctrl-names = "default";
+		pinctrl-0 = <&joypad_btns>;
+
+		/*
+		 * Dual analog sticks read straight off saradc ch0-3 (no analog mux
+		 * on this board). io-channel order = physical channels:
+		 *   ch0 = left X, ch1 = left Y, ch2 = right X, ch3 = right Y.
+		 * The driver's 4-axis layout is (idx0..3) ABS_RZ, ABS_Z, ABS_Y,
+		 * ABS_X; amux-channel-mapping routes each to its physical channel:
+		 *   ABS_RZ(right Y)<-ch3, ABS_Z(right X)<-ch2,
+		 *   ABS_Y (left Y)<-ch1, ABS_X(left X)<-ch0.
+		 */
+		io-channels = <&saradc 0>, <&saradc 1>, <&saradc 2>, <&saradc 3>;
+		io-channel-names = "amux_adc_ch0", "amux_adc_ch1",
+				   "amux_adc_ch2", "amux_adc_ch3";
+		amux-count = <4>;
+		amux-channel-mapping = <3 2 1 0>;
+
+		/* Vertical axes are inverted (mainline abs-range Y = <1023 15>). */
+		invert-absy;
+		invert-absrz;
+
+		button-adc-scale = <2>;
+		button-adc-deadzone = <64>;
+		button-adc-fuzz = <32>;
+		button-adc-flat = <32>;
+		abs_x-p-tuning = <200>;
+		abs_x-n-tuning = <200>;
+		abs_y-p-tuning = <200>;
+		abs_y-n-tuning = <200>;
+		abs_z-p-tuning = <200>;
+		abs_z-n-tuning = <200>;
+		abs_rz-p-tuning = <200>;
+		abs_rz-n-tuning = <200>;
+		poll-interval = <10>;
+
+		sw1 {
+			gpios = <&gpio3 RK_PD3 GPIO_ACTIVE_LOW>;
+			label = "GPIO BTN-A";
+			linux,code = <BTN_EAST>;
+		};
+		sw2 {
+			gpios = <&gpio3 RK_PD2 GPIO_ACTIVE_LOW>;
+			label = "GPIO BTN-B";
+			linux,code = <BTN_SOUTH>;
+		};
+		sw3 {
+			gpios = <&gpio3 RK_PD5 GPIO_ACTIVE_LOW>;
+			label = "GPIO BTN-X";
+			linux,code = <BTN_NORTH>;
+		};
+		sw4 {
+			gpios = <&gpio3 RK_PD4 GPIO_ACTIVE_LOW>;
+			label = "GPIO BTN-Y";
+			linux,code = <BTN_WEST>;
+		};
+		sw5 {
+			gpios = <&gpio4 RK_PA0 GPIO_ACTIVE_LOW>;
+			label = "GPIO DPAD-UP";
+			linux,code = <BTN_DPAD_UP>;
+		};
+		sw6 {
+			gpios = <&gpio4 RK_PA1 GPIO_ACTIVE_LOW>;
+			label = "GPIO DPAD-DOWN";
+			linux,code = <BTN_DPAD_DOWN>;
+		};
+		sw7 {
+			gpios = <&gpio3 RK_PD6 GPIO_ACTIVE_LOW>;
+			label = "GPIO DPAD-LEFT";
+			linux,code = <BTN_DPAD_LEFT>;
+		};
+		sw8 {
+			gpios = <&gpio3 RK_PD7 GPIO_ACTIVE_LOW>;
+			label = "GPIO DPAD-RIGHT";
+			linux,code = <BTN_DPAD_RIGHT>;
+		};
+		sw9 {
+			gpios = <&gpio3 RK_PD0 GPIO_ACTIVE_LOW>;
+			label = "GPIO BTN-TL";
+			linux,code = <BTN_TL>;
+		};
+		sw10 {
+			gpios = <&gpio3 RK_PD1 GPIO_ACTIVE_LOW>;
+			label = "GPIO BTN-TL2";
+			linux,code = <BTN_TL2>;
+		};
+		sw11 {
+			gpios = <&gpio3 RK_PC6 GPIO_ACTIVE_LOW>;
+			label = "GPIO BTN-TR";
+			linux,code = <BTN_TR>;
+		};
+		sw12 {
+			gpios = <&gpio3 RK_PC7 GPIO_ACTIVE_LOW>;
+			label = "GPIO BTN-TR2";
+			linux,code = <BTN_TR2>;
+		};
+		sw13 {
+			gpios = <&gpio4 RK_PA4 GPIO_ACTIVE_LOW>;
+			label = "GPIO BTN-SELECT";
+			linux,code = <BTN_SELECT>;
+		};
+		sw14 {
+			gpios = <&gpio4 RK_PA2 GPIO_ACTIVE_LOW>;
+			label = "GPIO BTN-START";
+			linux,code = <BTN_START>;
+		};
+		sw15 {
+			gpios = <&gpio4 RK_PA7 GPIO_ACTIVE_LOW>;
+			label = "GPIO BTN-THUMBL";
+			linux,code = <BTN_THUMBL>;
+		};
+		sw16 {
+			gpios = <&gpio4 RK_PB0 GPIO_ACTIVE_LOW>;
+			label = "GPIO BTN-THUMBR";
+			linux,code = <BTN_THUMBR>;
+		};
+	};
+
+	gpio_keys_vol: gpio-keys-vol {
+		compatible = "gpio-keys";
+		autorepeat;
+		pinctrl-names = "default";
+		pinctrl-0 = <&vol_btns>;
+
+		button-volup {
+			gpios = <&gpio4 RK_PA5 GPIO_ACTIVE_LOW>;
+			label = "VOLUMEUP";
+			linux,code = <KEY_VOLUMEUP>;
+		};
+		button-voldown {
+			gpios = <&gpio4 RK_PA3 GPIO_ACTIVE_LOW>;
+			label = "VOLUMEDOWN";
+			linux,code = <KEY_VOLUMEDOWN>;
+		};
+	};
+};
+
+/* ------------------------------------------------------------------------
+ * Audio: RK817 built-in codec on I2S1, BSP-style (rk817 codec MFD child +
+ * plain simple-audio-card), same pattern as the ARC/miniloong ports. The X55
+ * (per its 4.x DTB) drives the speaker via the rk817 INTERNAL Class-D
+ * (out-l2spk-r2hp), gated by spk-ctl gpio4 RK_PC2 (ACTIVE_HIGH); headphone
+ * detect on gpio4 RK_PC6.
+ * ------------------------------------------------------------------------ */
+&i2s1_8ch {
+	rockchip,trcm-sync-tx-only;
+	/*
+	 * Base rk356x.dtsi i2s1_8ch pinctrl OMITS i2s1m0_mclk, so the external
+	 * rk817 codec would get no master clock -> noise/distortion. Re-add MCLK
+	 * plus the standard sclk/lrck/sdi0/sdo0 (playback + capture).
+	 */
+	pinctrl-names = "default";
+	pinctrl-0 = <&i2s1m0_mclk
+		     &i2s1m0_sclktx &i2s1m0_sclkrx
+		     &i2s1m0_lrcktx &i2s1m0_lrckrx
+		     &i2s1m0_sdi0 &i2s1m0_sdo0>;
+	status = "okay";
+};
+
+&rk817 {
+	rk817_codec: codec {
+		compatible = "rockchip,rk817-codec";
+		#sound-dai-cells = <0>;
+		clocks = <&cru I2S1_MCLKOUT>;
+		clock-names = "mclk";
+		assigned-clocks = <&cru I2S1_MCLKOUT>, <&cru I2S1_MCLK_TX_IOE>;
+		assigned-clock-rates = <12288000>;
+		assigned-clock-parents = <&cru I2S1_MCLKOUT_TX>, <&cru I2S1_MCLKOUT_TX>;
+		hp-volume = <3>;
+		spk-volume = <3>;
+		/* internal Class-D speaker (left) / headphone (right) — X55 4.x */
+		out-l2spk-r2hp;
+		spk-ctl-gpios = <&gpio4 RK_PC2 GPIO_ACTIVE_HIGH>;
+		status = "okay";
+	};
+};
+
+/ {
+	rk817_sound: rk817-sound {
+		compatible = "simple-audio-card";
+		simple-audio-card,format = "i2s";
+		simple-audio-card,name = "rockchip,rk817-codec";
+		simple-audio-card,mclk-fs = <256>;
+		simple-audio-card,hp-det-gpio = <&gpio4 RK_PC6 GPIO_ACTIVE_HIGH>;
+
+		simple-audio-card,cpu {
+			sound-dai = <&i2s1_8ch>;
+		};
+
+		simple-audio-card,codec {
+			sound-dai = <&rk817_codec>;
+		};
+	};
+};
+
+/* ------------------------------------------------------------------------
+ * Power: RK817 fuel gauge (rk817,battery) + charger (rk817,charger) MFD
+ * children — rk808.c registers these cells; without the child nodes
+ * /sys/class/power_supply stays empty. Calibration values from the X55 4.x
+ * DTB (the OCV curve matches the mainline X55 battery). Charge-source detect
+ * via usb2phy0 (already enabled for OTG/adb). The kernel's rk817_battery
+ * STATUS patch (PLUG_IN_STS) gives correct Charging/Discharging on OTG.
+ * ------------------------------------------------------------------------ */
+&rk817 {
+	battery {
+		compatible = "rk817,battery";
+		ocv_table = <3400 3553 3621 3688 3735 3768 3801 3826
+			     3843 3857 3878 3904 3934 3972 4006 4020
+			     4030 4044 4059 4083 4138>;
+		design_capacity = <3527>;
+		design_qmax = <3880>;
+		bat_res = <91>;
+		sleep_enter_current = <150>;
+		sleep_exit_current = <180>;
+		sleep_filter_current = <100>;
+		power_off_thresd = <3350>;
+		zero_algorithm_vol = <3300>;
+		max_soc_offset = <60>;
+		monitor_sec = <5>;
+		sample_res = <10>;
+		virtual_power = <0>;
+	};
+
+	charger {
+		compatible = "rk817,charger";
+		min_input_voltage = <4500>;
+		max_input_current = <2000>;
+		max_chrg_current = <2000>;
+		/* 4.x DTB had a bogus 0x3ed (=1005mV); use the standard LiPo 4.2V */
+		max_chrg_voltage = <4200>;
+		chrg_term_mode = <0>;
+		chrg_finish_cur = <300>;
+		virtual_power = <0>;
+		dc_det_adc = <0>;
+		extcon = <&usb2phy0>;
+	};
+};
+
+/* ------------------------------------------------------------------------
+ * WiFi: SDIO on sdmmc1. Chip = Realtek RTL8821CS (both the 4.x DTB and the
+ * mainline upstream X55 dts agree — same combo chip as the RG ARC-S). Config
+ * follows the mainline X55:
+ *   - vcc_wifi: the chip's MAIN 3V3 power (GPIO regulator, enable gpio0 PA0
+ *     ACTIVE_LOW). This was the missing piece — without it the chip has no
+ *     power and never answers on SDIO. (I had wrongly folded PA0 into the
+ *     pwrseq as a second reset.)
+ *   - sdio_pwrseq: single reset gpio0 PC0 (WL_REG_ON) + rk817 clkout2 32k LPO.
+ *   - sdmmc1: vmmc = vcc_wifi.
+ * rtw88_8821cs binds the enumerated SDIO device (like the ARC).
+ * ------------------------------------------------------------------------ */
+&pinctrl {
+	sdio-pwrseq {
+		wifi_enable_h: wifi-enable-h {
+			rockchip,pins = <0 RK_PC0 RK_FUNC_GPIO &pcfg_pull_none>;
+		};
+	};
+
+	vcc-wifi {
+		vcc_wifi_h: vcc-wifi-h {
+			rockchip,pins = <0 RK_PA0 RK_FUNC_GPIO &pcfg_pull_none>;
+		};
+	};
+
+	wireless-wlan {
+		wifi_host_wake_irq: wifi-host-wake-irq {
+			rockchip,pins = <0 RK_PC4 RK_FUNC_GPIO &pcfg_pull_down>;
+		};
+	};
+};
+
+/ {
+	vcc_wifi: regulator-vcc-wifi {
+		compatible = "regulator-fixed";
+		gpio = <&gpio0 RK_PA0 GPIO_ACTIVE_LOW>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&vcc_wifi_h>;
+		regulator-name = "vcc_wifi";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+	};
+
+	sdio_pwrseq: sdio-pwrseq {
+		compatible = "mmc-pwrseq-simple";
+		pinctrl-names = "default";
+		pinctrl-0 = <&wifi_enable_h>;
+		post-power-on-delay-ms = <200>;
+		reset-gpios = <&gpio0 RK_PC0 GPIO_ACTIVE_LOW>;
+		clocks = <&rk817 1>;
+		clock-names = "ext_clock";
+	};
+
+	wireless_wlan: wireless-wlan {
+		compatible = "wlan-platdata";
+		rockchip,grf = <&grf>;
+		wifi_chip_type = "rtl8821cs";
+		pinctrl-names = "default";
+		pinctrl-0 = <&wifi_host_wake_irq>;
+		WIFI,host_wake_irq = <&gpio0 RK_PC4 GPIO_ACTIVE_HIGH>;
+		status = "okay";
+	};
+};
+
+&sdmmc1 {
+	bus-width = <4>;
+	cap-sd-highspeed;
+	cap-sdio-irq;
+	keep-power-in-suspend;
+	non-removable;
+	supports-sdio;
+	mmc-pwrseq = <&sdio_pwrseq>;
+	vmmc-supply = <&vcc_wifi>;
+	pinctrl-names = "default";
+	pinctrl-0 = <&sdmmc1_bus4 &sdmmc1_clk &sdmmc1_cmd>;
+	status = "okay";
+};
+
+/* ------------------------------------------------------------------------
+ * Bluetooth: RTL8821CS BT core on uart1 (/dev/ttyS1). Same combo chip + same
+ * approach as the RG ARC-S: the KNULLI rootfs brings it up with rtk_hciattach
+ * (S32bluetooth: `rfkill unblock bluetooth` then
+ * `rtk_hciattach -n -s 115200 ttyS1 rtk_h5`), NOT the mainline serdev/btrtl
+ * path (which needed btrtl IC-table patching on this BSP kernel). BT power +
+ * the rfkill "bluetooth" device come from the wireless-bluetooth platdata node.
+ *
+ * NB (firmware, rootfs side): rtk_hciattach must use a BT config blob with HW
+ * flow control CLEARED — this board's uart1 RTS/CTS isn't usefully wired to the
+ * BT chip, so leaving it on makes the firmware download / HCI reset corrupt.
+ * Reuse the ARC's patched rtl8821cs_config (byte 21 0x5f -> 0x5b) at
+ * /lib/firmware/rtl_bt/rtl8821cs_config. uart-has-rtscts below is then unused
+ * but harmless (kept to match the mainline X55 / ARC).
+ * ------------------------------------------------------------------------ */
+&uart1 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&uart1m0_xfer &uart1m0_ctsn &uart1m0_rtsn>;
+	uart-has-rtscts;
+	status = "okay";
+};
+
+/ {
+	wireless_bluetooth: wireless-bluetooth {
+		compatible = "bluetooth-platdata";
+		clocks = <&rk817 1>;
+		clock-names = "ext_clock";
+		BT,reset_gpio    = <&gpio0 RK_PC1 GPIO_ACTIVE_HIGH>;
+		BT,wake_gpio     = <&gpio0 RK_PB6 GPIO_ACTIVE_HIGH>;
+		BT,wake_host_irq = <&gpio0 RK_PB5 GPIO_ACTIVE_HIGH>;
+		status = "okay";
+	};
+};
