+/* HDMI parked (disabled) until the panel is solid — same as the X55. */
+/*
+ * HDMI on VP0 (shared with the DSI panel) => mutually exclusive with the
+ * internal display: connecting HDMI turns the internal panel off (single CRTC).
+ * RK3566 VOP2's VP1 cannot drive HDMI cleanly (win-close/dsp_hold timeouts +
+ * internal corruption / fb copies when both VPs are live), so HDMI uses the
+ * working VP0. Unlike the other boards, RGB30 wires HDMI DDC to i2c5 (m1), so
+ * use ddc-i2c-bus + cec-only pinctrl (matches the vendor dtb). See
+ * [[hdmi-mutual-exclusion]].
+ */
+&hdmi {
+	pinctrl-names = "default";
+	pinctrl-0 = <&hdmitxm0_cec>;
+	ddc-i2c-bus = <&i2c5>;
+	status = "okay";
+};
