+/* ---- RK817: codec (external speaker amp) + battery + charger ---- */
+
+&rk817 {
+	/*
+	 * Make the rk817 the system power controller AND wire up the PMIC
+	 * sleep-pin power-off, so a soft `poweroff` actually cuts power. Without
+	 * this (rgxx3.dtsi has neither) poweroff only half-powers-down and the
+	 * device won't respond to the power button/charger until it's physically
+	 * power-cycled. rk817_shutdown_prepare() drives the SoC PMIC_SLEEP pin
+	 * (gpio0 PA2) via the "pmic-power-off" pinctrl state to trigger the rk817
+	 * power-down. Ported from rk3566-radxa-zero3.dtsi (matches BSP orig_ds).
+	 */
+	rockchip,system-power-controller;
+	pmic-reset-func = <0>;
+
+	pinctrl-names = "default", "pmic-sleep", "pmic-power-off", "pmic-reset";
+	pinctrl-0 = <&i2s1m0_mclk>, <&pmic_int_l>;
+	pinctrl-1 = <&soc_slppin_slp>, <&rk817_slppin_slp>;
+	pinctrl-2 = <&soc_slppin_gpio>, <&rk817_slppin_pwrdn>;
+	pinctrl-3 = <&soc_slppin_gpio>, <&rk817_slppin_rst>;
+
+	pinctrl_rk8xx: pinctrl_rk8xx {
+		gpio-controller;
+		#gpio-cells = <2>;
+
+		rk817_slppin_null: rk817_slppin_null {
+			pins = "gpio_slp";
+			function = "pin_fun0";
+		};
+		rk817_slppin_slp: rk817_slppin_slp {
+			pins = "gpio_slp";
+			function = "pin_fun1";
+		};
+		rk817_slppin_pwrdn: rk817_slppin_pwrdn {
+			pins = "gpio_slp";
+			function = "pin_fun2";
+		};
+		rk817_slppin_rst: rk817_slppin_rst {
+			pins = "gpio_slp";
+			function = "pin_fun3";
+		};
+	};
+
+	rk817_codec: codec {
+		compatible = "rockchip,rk817-codec";
+		#sound-dai-cells = <0>;
+		clocks = <&cru I2S1_MCLKOUT>;
+		clock-names = "mclk";
+		assigned-clocks = <&cru I2S1_MCLKOUT>, <&cru I2S1_MCLK_TX_IOE>;
+		assigned-clock-rates = <12288000>;
+		assigned-clock-parents = <&cru I2S1_MCLKOUT_TX>, <&cru I2S1_MCLKOUT_TX>;
+		hp-volume = <23>;
+		spk-volume = <10>;
+		mic-in-differential;
+		/*
+		 * RG DS drives an EXTERNAL speaker amp: in use-ext-amplifier mode
+		 * the rk817 feeds the amp from the HP/line-out path and gates it
+		 * with spk-ctl (gpio4 RK_PC3, active high). From orig_ds.dts.
+		 */
+		use-ext-amplifier;
+		spk-ctl-gpios = <&gpio4 RK_PC3 GPIO_ACTIVE_HIGH>;
+		status = "okay";
+	};
+
+	battery {
+		compatible = "rk817,battery";
+		ocv_table = <3400 3663 3677 3707 3731 3749 3761 3772 3786 3826
+			     3861 3908 3947 3978 4039 4083 4136 4191 4251 4338>;
+		design_capacity = <4247>;
+		design_qmax = <4247>;
+		bat_res = <69>;
+		sleep_enter_current = <150>;
+		sleep_exit_current = <180>;
+		sleep_filter_current = <100>;
+		power_off_thresd = <3500>;
+		zero_algorithm_vol = <3850>;
+		max_soc_offset = <60>;
+		monitor_sec = <5>;
+		sample_res = <10>;
+		virtual_power = <0>;
+		status = "okay";
+	};
+
+	charger {
+		compatible = "rk817,charger";
+		min_input_voltage = <4500>;
+		max_input_current = <1500>;
+		max_chrg_current = <2000>;
+		max_chrg_voltage = <4350>;
+		chrg_term_mode = <2>;
+		chrg_finish_cur = <200>;
+		virtual_power = <0>;
+		dc_det_adc = <0>;
+		extcon = <&usb2phy0>;
+		status = "okay";
+	};
+};
+
+/* ---- USB-C OTG / charger detection (matches rg-arc-s / rg-ds BSP) ---- */
+
+&usbdrd30 {
+	status = "okay";
+};
+
+&usbdrd_dwc3 {
+	dr_mode = "otg";
+	extcon = <&usb2phy0>;
+};
+
+/* ---- WiFi: BSP rfkill-wlan (RTL8821CS over SDIO, mmc-pwrseq in rgxx3.dtsi) ---- */
+
+/ {
+	wireless_wlan: wireless-wlan {
+		compatible = "wlan-platdata";
+		rockchip,grf = <&grf>;
+		wifi_chip_type = "rtl8821cs";
+		pinctrl-names = "default";
+		pinctrl-0 = <&wifi_host_wake_irq>;
+		WIFI,host_wake_irq = <&gpio4 RK_PA1 GPIO_ACTIVE_HIGH>;
+		keep_wifi_power_on;
+		status = "okay";
+	};
+
+	/*
+	 * BT: rfkill-bt powers/resets the RTL8821CS BT core (gpio0 PD5 reset,
+	 * PD3 wake, PD4 wake-host-irq; from orig_ds.dts) on `rfkill unblock
+	 * bluetooth`; userspace rtk_hciattach then attaches it on /dev/ttyS1.
+	 * NOTE: the stock rtl8821cs_config requests 1.5 Mbps + HW flow control;
+	 * if the SoC<->BT RTS/CTS lines are not wired, clear the flow-control bit
+	 * in /lib/firmware/rtl_bt/rtl8821cs_config (see the rg-arc-s notes).
+	 */
+	wireless_bluetooth: wireless-bluetooth {
+		compatible = "bluetooth-platdata";
+		clocks = <&rk817 1>;
+		clock-names = "ext_clock";
+		/*
+		 * No uart_rts_gpios / RTS-as-GPIO management: the RTL8821CS BT runs
+		 * H5 (software flow control) and the SoC<->BT RTS/CTS lines aren't
+		 * usefully wired. The ported node also claimed uart1m1_rtsn (gpio4
+		 * PB6) which uart1 already owns (uart-has-rtscts) -> rfkill_bt probe
+		 * failed "-22 / pin already requested". Just power/reset the chip.
+		 */
+		BT,reset_gpio    = <&gpio0 RK_PD5 GPIO_ACTIVE_HIGH>;
+		BT,wake_gpio     = <&gpio0 RK_PD3 GPIO_ACTIVE_HIGH>;
+		BT,wake_host_irq = <&gpio0 RK_PD4 GPIO_ACTIVE_HIGH>;
+		status = "okay";
+	};
+};
+
+&pinctrl {
+	/*
+	 * Touch INT pull-ups: GPIO0_C0 defaults to pull-down, so the upper
+	 * panel's active-low INT idled low and it never interrupted again.
+	 */
+	touch {
+		touch_int_upper: touch-int-upper {
+			rockchip,pins = <0 RK_PC0 RK_FUNC_GPIO &pcfg_pull_up>;
+		};
+
+		touch_int_lower: touch-int-lower {
+			rockchip,pins = <0 RK_PB6 RK_FUNC_GPIO &pcfg_pull_up>;
+		};
+	};
+
+	/* screen-swap key (sw18): GPIO3_A0 idles low without the pull-up */
+	btns {
+		btn_swap: btn-swap {
+			rockchip,pins = <3 RK_PA0 RK_FUNC_GPIO &pcfg_pull_up>;
+		};
+	};
+
+	headphone {
+		/*
+		 * hp-det (gpio4 PC2) must be pull-none so the headphone jack switch
+		 * can drive the pin; without an explicit pinctrl the pin kept a
+		 * default pull that held it stuck-low -> the gpio never toggled on
+		 * insert and detection never fired. Matches the vendor DS dtb
+		 * (pcfg-pull-none / bias-disable).
+		 */
+		hp_det: hp-det {
+			rockchip,pins = <4 RK_PC2 RK_FUNC_GPIO &pcfg_pull_none>;
+		};
+	};
+
+	wireless-wlan {
+		/* GPIO4_A1: OOB host-wake IRQ from WiFi chip to AP */
+		wifi_host_wake_irq: wifi-host-wake-irq {
+			rockchip,pins = <4 RK_PA1 RK_FUNC_GPIO &pcfg_pull_up>;
+		};
+	};
+
+	wireless-bluetooth {
+		/* uart1 RTS driven as GPIO during BT firmware download/reset */
+		bt_uart1_gpios: bt-uart1-gpios {
+			rockchip,pins = <2 RK_PB5 RK_FUNC_GPIO &pcfg_pull_none>;
+		};
+	};
+
+	/*
+	 * SoC PMIC_SLEEP pin (gpio0 PA2) states used by the rk817 power-off
+	 * path (&rk817 pinctrl-1/2/3). Ported from rk3566-radxa-zero3.dtsi.
+	 */
+	soc_slppin {
+		soc_slppin_gpio: soc_slppin_gpio {
+			rockchip,pins = <0 RK_PA2 RK_FUNC_GPIO &pcfg_output_low_pull_down>;
+		};
+		soc_slppin_slp: soc_slppin_slp {
+			rockchip,pins = <0 RK_PA2 RK_FUNC_GPIO &pcfg_pull_up>;
+		};
+		soc_slppin_rst: soc_slppin_rst {
+			rockchip,pins = <0 RK_PA2 RK_FUNC_GPIO &pcfg_pull_none>;
+		};
+	};
+};
