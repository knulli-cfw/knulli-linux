diff --git a/drivers/input/joystick/rocknix-singleadc-joypad.c b/drivers/input/joystick/rocknix-singleadc-joypad.c
new file mode 100644
index 000000000..7587088a7
--- /dev/null
+++ b/drivers/input/joystick/rocknix-singleadc-joypad.c
@@ -0,0 +1,2374 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/*
+ * ROCKNIX singleadc joypad driver
+ *
+ * Copyright (C) 2024 ROCKNIX (https://github.com/ROCKNIX)
+ */
+
+/*----------------------------------------------------------------------------*/
+#include <linux/module.h>
+#include <linux/input.h>
+#include <linux/platform_device.h>
+#include <linux/iio/consumer.h>
+#include <linux/iio/iio.h>
+#include <linux/of_platform.h>
+#include <linux/version.h>
+#if (LINUX_VERSION_CODE < KERNEL_VERSION(6, 3, 0))
+#include <linux/of_gpio.h>
+#else
+#include <linux/of_gpio_legacy.h>
+#endif
+#include <linux/delay.h>
+#include <linux/pwm.h>
+#include "rocknix-joypad.h"
+
+#include <linux/kthread.h>
+#include <linux/tty.h>
+#include <linux/tty_driver.h>
+#include <linux/fs.h>
+#include <linux/termios.h>
+#include <linux/uaccess.h>
+#include <linux/workqueue.h>
+#include <linux/jiffies.h>
+
+/*----------------------------------------------------------------------------*/
+#define DRV_NAME "singleadc-joypad"
+/*----------------------------------------------------------------------------*/
+#define	ADC_MAX_VOLTAGE		1800
+#define	ADC_DATA_TUNING(x, p)	((x * p) / 100)
+#define	ADC_TUNING_DEFAULT	180
+#define	CLAMP(x, low, high)  (((x) > (high)) ? (high) : (((x) < (low)) ? (low) : (x)))
+
+/* We add a 5s inactivity timeout for re-opening ttyS1 */
+#define MIYOO_SERIAL_INACTIVITY_TIMEOUT (5 * HZ)
+
+struct bt_adc {
+	/* report value (mV) */
+	int value;
+	/* report type */
+	int report_type;
+	/* input device init value (mV) */
+	int max, min;
+	/* calibrated adc value */
+	int cal;
+	/*  adc scale value */
+	int scale;
+	/* invert report */
+	bool invert;
+	/* amux channel */
+	int amux_ch;
+	/* adc data tuning value([percent), p = positive, n = negative */
+	int tuning_p, tuning_n;
+};
+
+#define FILTER_SAMPLES 4
+
+struct analog_mux {
+	/* IIO ADC Channels : one per axis (4 channels total) */
+	struct iio_channel *iio_ch[4];
+	/* analog mux select(a,b) gpio */
+	int sel_a_gpio, sel_b_gpio;
+	/* analog mux enable gpio */
+	int en_gpio;
+	/* Moving average filter for noise reduction */
+	int filter_buf[4][FILTER_SAMPLES];
+	int filter_idx[4];
+};
+
+struct bt_gpio {
+	/* GPIO Request label */
+	const char *label;
+	/* GPIO Number */
+	int num;
+	/* report type */
+	int report_type;
+	/* report linux code */
+	int linux_code;
+	/* prev button value */
+	bool old_value;
+	/* button press level */
+	bool active_level;
+	/* abs value for HAT axes (e.g., -1, 0, 1) */
+	int abs_value;
+};
+
+/* Replicate the calibration and constants from the userland code. */
+#define MIYOO_FRAME_SIZE        6
+#define MIYOO_MAGIC_START       0xFF
+#define MIYOO_MAGIC_END         0xFE
+
+/* For calibrating final ranges to [-32760..32760] */
+#define MIYOO_AXIS_MIN          (-32760)
+#define MIYOO_AXIS_MAX          ( 32760)
+
+/* We'll gather 50 frames for auto-cal */
+#define MIYOO_CALIBRATION_FRAMES    50
+
+/* We'll use a default 10% radial deadzone ratio for example */
+static float miyoo_deadzone_ratio = 0.10f;
+
+struct miyoo_cal {
+	int x_min;
+	int x_max;
+	int x_zero;
+	int y_min;
+	int y_max;
+	int y_zero;
+};
+
+/*
+ * We'll store the "left stick" and "right stick" calibrations
+ * plus live data for the Miyoo serial approach
+ */
+struct miyoo_serial_stick {
+	struct miyoo_cal left_cal;
+	struct miyoo_cal right_cal;
+
+	/* We keep the last parsed values for x,y each stick */
+	int left_x;
+	int left_y;
+	int right_x;
+	int right_y;
+};
+
+/* A forward-declare for our kernel thread function */
+static int miyoo_serial_threadfn(void *data);
+
+struct joypad {
+	struct device *dev;
+	int poll_interval;
+
+	/* report enable/disable */
+	bool enable;
+
+	/* analog mux & joystick control */
+	struct analog_mux *amux;
+	/* analog mux max count */
+	int amux_count;
+	/* analog button */
+	struct bt_adc *adcs;
+
+	/*
+	 * Optional dedicated ADC key: a button (e.g. MODE/hotkey) wired to its own
+	 * saradc channel rather than a GPIO or the analog mux. Reported as a key on
+	 * THIS input device so hotkey combos share the gamepad's node.
+	 */
+	struct iio_channel *adckey_ch;
+	int adckey_code;      /* linux keycode, default BTN_MODE */
+	int adckey_press_mv;  /* pressed when the channel reads below this (mV) */
+	bool adckey_state;    /* last reported state (false = released) */
+
+	/*
+	 * Optional D-pad -> emulated left-stick toggle. When enabled (DT opt-in),
+	 * the 4 BTN_DPAD_* GPIOs can be switched at runtime (sysfs "dpad_mode")
+	 * between reporting BTN_DPAD_* events and driving an emulated ABS_X/ABS_Y
+	 * left analog stick.
+	 */
+	bool has_dpad_joystick;  /* feature enabled for this board (DT opt-in) */
+	bool dpad_as_joystick;   /* true = emit ABS_X/Y, false = emit BTN_DPAD_* */
+	bool dpad_resync;        /* set by sysfs store; applied in poll context */
+	int  dpad_axis_max;      /* full-deflection value / declared abs range */
+	bool dpad_up, dpad_down, dpad_left, dpad_right;  /* live pressed state */
+
+	/* report reference point */
+	bool invert_absx;
+	bool invert_absy;
+	bool invert_absz;
+	bool invert_absrz;
+
+	/* report interval (ms) */
+	int bt_gpio_count;
+	struct bt_gpio *gpios;
+
+	/* button auto repeat */
+	int auto_repeat;
+
+	/* report threshold (mV) */
+	int bt_adc_fuzz, bt_adc_flat;
+	/* adc read value scale */
+	int bt_adc_scale;
+	/* joystick deadzone control */
+	int bt_adc_deadzone;
+
+	struct mutex lock;
+
+	/* pwm device for rumble*/
+	struct input_dev *input;
+	struct pwm_device *pwm;
+	struct work_struct play_work;
+	u16 level;
+	u16 boost_weak;
+	u16 boost_strong;
+	u16 has_rumble;
+
+
+	/* New property to override logic with Miyoo serial approach */
+	bool use_miyoo_serial;
+	/*
+	 * We store everything for the Miyoo logic:
+	 *   - calibration data
+	 *   - kernel thread
+	 *   - file pointer, etc.
+	 */
+	struct miyoo_serial_stick miyoo;
+	struct task_struct *miyoo_thread;
+	struct file *miyoo_filp;
+	loff_t miyoo_filp_pos;  /* File position for kernel_read */
+
+	/*
+	 * We'll do a delayed work item to do the TTY initialization
+	 * after the driver has finished loading. This ensures we
+	 * don't block the kernel boot.
+	 */
+	struct delayed_work miyoo_init_work;
+
+	/* For detecting inactivity on the Miyoo TTY */
+	unsigned long last_data_jiffies;
+
+};
+
+/*----------------------------------------------------------------------------*/
+static bool has_rumble(struct device *dev)
+{
+	if (device_property_present(dev, "rumble-boost-weak") ||
+	    device_property_present(dev, "rumble-boost-strong"))
+		return true;
+
+	return false;
+}
+
+/*----------------------------------------------------------------------------*/
+static int pwm_vibrator_start(struct joypad *joypad)
+{
+	struct device *pdev = joypad->input->dev.parent;
+	struct pwm_state state;
+	int err;
+
+	pwm_get_state(joypad->pwm, &state);
+	pwm_set_relative_duty_cycle(&state, joypad->level, 0xffff);
+	state.enabled = true;
+
+#if (LINUX_VERSION_CODE < KERNEL_VERSION(6, 11, 0))
+	err = pwm_apply_state(joypad->pwm, &state);
+#else
+	err = pwm_apply_might_sleep(joypad->pwm, &state);
+#endif
+	if (err) {
+		 dev_err(pdev, "failed to apply pwm state: %d", err);
+		 return err;
+	}
+
+	return 0;
+}
+
+static void pwm_vibrator_stop(struct joypad *joypad)
+{
+	pwm_disable(joypad->pwm);
+}
+
+static void pwm_vibrator_play_work(struct work_struct *work)
+{
+	struct joypad *joypad = container_of(work,
+					    struct joypad, play_work);
+
+	if (joypad->level)
+		 pwm_vibrator_start(joypad);
+	else
+		 pwm_vibrator_stop(joypad);
+}
+
+/*----------------------------------------------------------------------------*/
+/*
+ * Drive an external analog multiplexer, for boards (e.g. Anbernic RG DS/ARC,
+ * Powkiddy RGB30) whose joystick axes are all routed through ONE saradc input
+ * via a 4:1 mux selected by sel-a/sel-b. Returns 0 (no-op) on boards that wire
+ * separate ADC channels per axis (no sel gpios) so they read directly.
+ */
+static int joypad_amux_select(struct analog_mux *amux, int channel)
+{
+	if (!amux)
+		return -EINVAL;
+
+	/* No mux on this board (separate per-axis ADC channels) -> nothing to do. */
+	if (!gpio_is_valid(amux->sel_a_gpio) && !gpio_is_valid(amux->sel_b_gpio))
+		return 0;
+
+	/* enable mux */
+	if (gpio_is_valid(amux->en_gpio))
+		gpio_set_value(amux->en_gpio, 0);
+
+	switch (channel) {
+		case 0:
+			if (gpio_is_valid(amux->sel_a_gpio)) gpio_set_value(amux->sel_a_gpio, 0);
+			if (gpio_is_valid(amux->sel_b_gpio)) gpio_set_value(amux->sel_b_gpio, 0);
+			break;
+		case 1:
+			if (gpio_is_valid(amux->sel_a_gpio)) gpio_set_value(amux->sel_a_gpio, 0);
+			if (gpio_is_valid(amux->sel_b_gpio)) gpio_set_value(amux->sel_b_gpio, 1);
+			break;
+		case 2:
+			if (gpio_is_valid(amux->sel_a_gpio)) gpio_set_value(amux->sel_a_gpio, 1);
+			if (gpio_is_valid(amux->sel_b_gpio)) gpio_set_value(amux->sel_b_gpio, 0);
+			break;
+		case 3:
+			if (gpio_is_valid(amux->sel_a_gpio)) gpio_set_value(amux->sel_a_gpio, 1);
+			if (gpio_is_valid(amux->sel_b_gpio)) gpio_set_value(amux->sel_b_gpio, 1);
+			break;
+		default:
+			/* out of range -> disable mux */
+			if (gpio_is_valid(amux->en_gpio))
+				gpio_set_value(amux->en_gpio, 1);
+			return -1;
+	}
+	/* mux switching settle time (datasheet: ~35ns on / 9ns off) */
+	usleep_range(10, 20);
+	return 0;
+}
+
+/*----------------------------------------------------------------------------*/
+static int joypad_adc_read(struct analog_mux *amux, struct bt_adc *adc)
+{
+	int value = 0;
+	int ret;
+	static int first_read_count = 0;
+	int ch_idx = adc->amux_ch;
+
+	/* If IIO channel not available, return 0 */
+	if (!amux || ch_idx < 0 || ch_idx >= 4 || !amux->iio_ch[ch_idx])
+		return 0;
+
+	/*
+	 * On boards with an external analog mux, route this axis to the shared
+	 * saradc input before reading. No-op on boards with per-axis channels.
+	 */
+	joypad_amux_select(amux, ch_idx);
+
+	/* Read directly from the channel assigned to this axis */
+	ret = iio_read_channel_processed(amux->iio_ch[ch_idx], &value);
+	if (ret < 0) {
+		if (first_read_count < 5) {
+			pr_err("[joypad_adc_read] iio_read_channel_raw failed: %d (amux_ch=%d)\n", ret, adc->amux_ch);
+			first_read_count++;
+		}
+		return 0;
+	}
+
+	if (first_read_count < 10) {
+		pr_info("[joypad_adc_read] Read success: raw=%d, amux_ch=%d, scale=%d\n", value, adc->amux_ch, adc->scale);
+		first_read_count++;
+	}
+
+	value *= adc->scale;
+
+	return value;
+}
