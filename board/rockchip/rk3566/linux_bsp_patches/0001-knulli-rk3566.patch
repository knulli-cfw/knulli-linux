+/* ------------------------------------------------------------------------
+ * Display: 640x480 (4:3) MIPI-DSI panel on DSI0 -> VP0. Carries the RG
+ * ARC-S/miniloong display fixes. The vendor DTB has the panel on the DSI0
+ * controller + DSI0 D-PHY with VP0 as the active input endpoint.
+ * ------------------------------------------------------------------------ */
+/*
+ * Skip the U-Boot logo handoff (drm-logo memory-region): U-Boot fills it with
+ * a page-unaligned size so the kernel's 1:1 logo IOMMU map under-covers the
+ * framebuffer the VOP is still scanning -> rk_iommu fault storm. Dropping it
+ * makes init_loader_memory() bail and the VOP comes up fresh.
+ */
+&display_subsystem {
+	/delete-property/ memory-region;
+	/delete-property/ memory-region-names;
+};
