 	if (ret) {
 		rtw89_err(rtwdev, "failed to enable pci device\n");
+		if (rtwpci->wifi_clk) {
+			clk_disable_unprepare(rtwpci->wifi_clk);
+			clk_put(rtwpci->wifi_clk);
+			rtwpci->wifi_clk = NULL;
+		}
 		return ret;
 	}
 
