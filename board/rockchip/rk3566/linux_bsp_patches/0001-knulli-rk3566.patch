+			29 00 0f 12 3f 24 23 30 26 2d 34 38 3b 32 22 18 12 00
+			29 00 0f 13 3f 24 23 30 26 2c 33 37 3a 31 22 18 12 00 29 00 02 30 07
+			29 00 02 0d 01 29 00 02 30 08 29 00 02 05 01 29 00 02 0c 1a
+			29 00 02 0d 0e 29 00 02 30 0a 29 00 02 02 4f 29 00 02 0b 40
+			29 00 02 30 0d 29 00 02 10 0c 29 00 02 11 0c 29 00 02 12 0c
+			29 00 02 13 0c 29 00 02 30 00 15 ff 02 11 00 15 00 02 36 03
+			15 ff 02 29 00
+		];
+		panel-exit-sequence = [05 40 01 28 05 78 01 10];
