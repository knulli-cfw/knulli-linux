Subject: [PATCH] arm64: dts: rg-ds(-plus): vdd_cpu is a Silergy SYR83x

fan53555 rejects chip ID 9 under fcs,fan53555; no vdd_cpu, no cpufreq.

diff --git a/arch/arm64/boot/dts/rockchip/rk3566-anbernic-rg-ds.dts b/arch/arm64/boot/dts/rockchip/rk3566-anbernic-rg-ds.dts
--- a/arch/arm64/boot/dts/rockchip/rk3566-anbernic-rg-ds.dts
+++ b/arch/arm64/boot/dts/rockchip/rk3566-anbernic-rg-ds.dts
@@ -942,3 +942,8 @@
 		};
 	};
 };
+
+/* vdd_cpu is a Silergy SYR83x (chip ID 9), not a FAN53555 */
+&vdd_cpu {
+	compatible = "silergy,syr827";
+};
diff --git a/arch/arm64/boot/dts/rockchip/rk3566-anbernic-rg-ds-plus.dts b/arch/arm64/boot/dts/rockchip/rk3566-anbernic-rg-ds-plus.dts
--- a/arch/arm64/boot/dts/rockchip/rk3566-anbernic-rg-ds-plus.dts
+++ b/arch/arm64/boot/dts/rockchip/rk3566-anbernic-rg-ds-plus.dts
@@ -874,3 +874,8 @@
 		};
 	};
 };
+
+/* vdd_cpu is a Silergy SYR83x (chip ID 9), not a FAN53555 */
+&vdd_cpu {
+	compatible = "silergy,syr827";
+};
