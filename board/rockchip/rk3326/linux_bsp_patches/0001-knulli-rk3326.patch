+
+		/*
+		 * MyMini has 4 independent SARADC channels (no physical amux).
+		 * The driver's direct-channel path is selected when all 4
+		 * "adc0".."adc3" named channels are present.
+		 */
+		io-channel-names = "adc0", "adc1", "adc2", "adc3";
+		io-channels = <&saradc 0>, <&saradc 1>, <&saradc 2>, <&saradc 3>;
+		amux-count = <4>;
