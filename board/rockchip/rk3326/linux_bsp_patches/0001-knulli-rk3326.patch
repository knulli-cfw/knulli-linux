+	};
+
+	pmic {
+		/* PMIC interrupt line + DC-detect on adjacent GPIO */
+		pmic_int: pmic-int {
+			rockchip,pins =
+				<0 RK_PB2 RK_FUNC_GPIO &pcfg_pull_up>,
+				<0 RK_PB3 RK_FUNC_GPIO &pcfg_pull_none>;
