+		/* DSI flags: MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_BURST |
+		 *            MIPI_DSI_MODE_LPM | MIPI_DSI_CLOCK_NON_CONTINUOUS
+		 * dsi,flags = <0xa03> from BSP */
+		dsi,flags = <0xa03>;
