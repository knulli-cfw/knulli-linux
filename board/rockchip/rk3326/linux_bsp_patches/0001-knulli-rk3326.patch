+&dsi {
+	status = "okay";
+	/*
+	 * Lock to 336 Mbps to match the auto-calculated value seen in dmesg
+	 * ("final DSI-Link bandwidth: 336 x 2 Mbps") with stock uboot.
+	 * Explicit locking improves LP-mode command reliability during panel
+	 * initialization when starting cold from OGA uboot.
+	 */
+	rockchip,lane-rate = <336>;
+
+	ports {
+		mipi_out: port@1 {
+			reg = <1>;
+			mipi_out_panel: endpoint {
+				remote-endpoint = <&mipi_in_panel>;
+			};
+		};
+	};
+
+	/*
+	 * Sitronix ST7703 panel (compatible "simple-panel-dsi").
+	 * Resolution: 480×640, 2-lane MIPI DSI.
+	 * Physical rotation: 90° (portrait panel mounted landscape).
+	 * enable-gpios:  gpio0 PC1 (active-high, LCD EN)
+	 * reset-gpios:   gpio0 PB4 (active-low,  LCD RST)
+	 */
+	panel@0 {
+		compatible = "sitronix,st7703", "simple-panel-dsi";
+		reg = <0>;
+		backlight = <&backlight>;
+		power-supply = <&vcc_mipi>;
+		/*
+		 * PC1 (LCD EN) is kept HIGH by a gpio-hog in &gpio0 so it is
+		 * driven before vcc_mipi powers the panel.  Do NOT add
+		 * enable-gpios here — panel_simple_unprepare() would drive the
+		 * pin inactive and re-prepare does not reliably restore it.
+		 */
+		reset-gpios = <&gpio0 RK_PB4 GPIO_ACTIVE_LOW>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&lcd_pins>;
+		bpc = <8>;
+		prepare-delay-ms = <200>;
+		reset-delay-ms = <10>;
+		init-delay-ms = <100>;
+		enable-delay-ms = <120>;
+		disable-delay-ms = <50>;
+		unprepare-delay-ms = <20>;
+		width-mm = <68>;
+		height-mm = <121>;
+
+		dsi,flags = <(MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_BURST |
+			      MIPI_DSI_MODE_NO_EOT_PACKET | MIPI_DSI_MODE_LPM)>;
+		dsi,format = <MIPI_DSI_FMT_RGB888>;
+		dsi,lanes = <2>;
+
+		panel-init-sequence = [
+			39 00 06 ff 77 01 00 00 13
+			15 00 02 ef 08
+			39 00 06 ff 77 01 00 00 10
+			39 00 03 c0 4f 00
+			39 00 03 c1 10 0c
+			39 00 03 c2 01 14
+			15 00 02 cc 10
+			39 00 11 b0 00 0b 13 0d 10 07 02 08 07 1f 04 11 0f 28 2f 1f
+			39 00 11 b1 00 0c 13 0c 10 05 02 08 08 1e 05 13 11 27 30 1f
+			39 00 06 ff 77 01 00 00 11
+			15 00 02 b0 4d
+			15 00 02 b1 4d
+			15 00 02 b2 87
+			15 00 02 b3 80
+			15 00 02 b5 45
+			15 00 02 b7 85
+			15 00 02 b8 20
+			15 00 02 c0 09
+			15 00 02 c1 78
+			15 00 02 c2 78
+			15 64 02 d0 88
+			39 00 04 e0 00 00 02
+			39 00 0c e1 04 b0 06 b0 05 b0 07 b0 00 44 44
+			39 00 0d e2 20 20 44 44 96 a0 00 00 96 a0 00 00
+			39 00 05 e3 00 00 22 22
+			39 00 03 e4 44 44
+			39 00 11 e5 0c 90 b0 a0 0e 92 b0 a0 08 8c b0 a0 0a 8e b0 a0
+			39 00 05 e6 00 00 22 22
+			39 00 03 e7 44 44
+			39 00 11 e8 0d 91 b0 a0 0f 93 b0 a0 09 8d b0 a0 0b 8f b0 a0
+			39 00 03 e9 36 00
+			39 00 08 eb 00 00 e4 e4 44 88 40
+			39 00 11 ed c1 a2 bf 0f 67 45 ff ff ff ff 54 76 f0 fb 2a 1c
+			39 00 07 ef 10 0d 04 08 3f 1f
+			39 00 06 ff 77 01 00 00 13
+			39 00 03 e8 00 0e
+			39 00 06 ff 77 01 00 00 00
+			05 78 01 11
+			39 00 06 ff 77 01 00 00 13
+			39 0a 03 e8 00 0c
+			39 00 03 e8 00 00
+			39 00 06 ff 77 01 00 00 00
+			05 32 01 29
+		];
+
+		panel-exit-sequence = [
+			05 10 01 28
+			05 78 01 10
+		];
+
+		port {
+			mipi_in_panel: endpoint {
+				remote-endpoint = <&mipi_out_panel>;
+			};
+		};
