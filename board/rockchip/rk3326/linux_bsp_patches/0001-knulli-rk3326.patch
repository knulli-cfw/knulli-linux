+/* Enable display with DSI route */
+&display_subsystem {
+	status = "okay";
+
+	route {
+		route_dsi: route-dsi {
+			status = "okay";
+			logo,uboot = "logo.bmp";
+			logo,kernel = "logo_kernel.bmp";
+			logo,mode = "center";
+			charge_logo,mode = "center";
+			connect = <&vopb_out_dsi>;
+		};
+	};
+};
+
+&dsi {
+	status = "okay";
+	/*
+	 * Lock lane rate to 462 Mbps to match the stock 4.4 kernel
+	 * ("dw-mipi-dsi: 462 x 2 Mbps").  Without this override the 5.x
+	 * driver calculates 468 Mbps; both are valid for 720x720@63 Hz but
+	 * using the identical PLL configuration as stock improves LP-mode
+	 * command reliability during panel initialization.
+	 */
+	rockchip,lane-rate = <462>;
+
+	ports {
+		mipi_out: port@1 {
+			reg = <1>;
+			mipi_out_panel: endpoint {
+				remote-endpoint = <&mipi_in_panel>;
+			};
+		};
+	};
+
+	/*
+	 * The rppocket uses a 720x720 panel with init sequence sourced from
+	 * the BSP DTS.  The upstream kd35t133 driver targets a different
+	 * 320x480 variant, so use simple-panel-dsi to apply the DTS-provided
+	 * init sequence and timings directly.
+	 *
+	 * Panel power rails:
+	 *   vdd-supply  → lcd2v8_supply (LDO_REG7, 2.8 V)
+	 *   iovcc-supply → vcc_lcd      (LDO_REG8, 1.8 V)
+	 */
+	panel@0 {
+		compatible = "simple-panel-dsi";
+		reg = <0>;
+		backlight = <&backlight>;
+		/*
+		 * panel-simple.c only uses the single "power" regulator.
+		 * Map it to the 2.8V VDD rail so the driver enables it.
+		 * The 1.8V IOVCC rail (vcc_lcd) is made always-on below
+		 * so it is up before the VDD rail is enabled.
+		 */
+		power-supply = <&lcd2v8_supply>;
+		reset-gpios = <&gpio3 RK_PC0 GPIO_ACTIVE_LOW>;
+		/*
+		 * vspn-en (gpio0 RK_PA2) is held by a GPIO hog in &gpio0 so it
+		 * is never deasserted across panel_unprepare()/panel_prepare()
+		 * cycles.  Do NOT add enable-gpios here — panel_simple_unprepare()
+		 * would drive the pin inactive (HIGH = AVEE off) and the re-prepare
+		 * path does not reliably restore it, leaving a dim+ghosting display.
+		 */
+		prepare-delay-ms = <20>;
+		reset-delay-ms = <10>;
+		init-delay-ms = <50>;
+		enable-delay-ms = <120>;
+		disable-delay-ms = <70>;
+		unprepare-delay-ms = <20>;
+		width-mm = <51>;
+		height-mm = <51>;
+
+		dsi,flags = <(MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_BURST |
+			      MIPI_DSI_MODE_NO_EOT_PACKET | MIPI_DSI_MODE_LPM)>;
+		dsi,format = <MIPI_DSI_FMT_RGB888>;
+		dsi,lanes = <2>;
+
+		panel-init-sequence = [
+			05 05 01 01
+			15 05 02 b0 00
+			39 00 06 e4 00 00 00 00 08
+			39 00 04 d0 45 45 71
+			15 78 02 6f 01
+			05 78 01 11
+			39 00 04 d0 52 4a 71
+			39 00 09 be ff 0f 00 18 04 04 00 5d
+			15 00 02 bb 2f
+			15 14 02 b0 2f
+			05 78 01 29
+		];
+
+		panel-exit-sequence = [
+			05 20 01 01
+			05 20 01 10
+			05 78 01 28
+		];
+
+		port {
+			mipi_in_panel: endpoint {
+				remote-endpoint = <&mipi_out_panel>;
+			};
+		};
+
+		display-timings {
+			native-mode = <&timing0>;
+
+			timing0: timing0 {
+				clock-frequency = <35000000>;
+				hactive = <720>;
+				vactive = <720>;
+				hfront-porch = <21>;
+				hsync-len = <2>;
+				hback-porch = <24>;
+				vfront-porch = <0>;
+				vsync-len = <5>;
+				vback-porch = <0>;
+				hsync-active = <0>;
+				vsync-active = <0>;
+				de-active = <0>;
+				pixelclk-active = <0>;
+			};
+		};
+	};
+};
+
+/*
+ * BSP custom panel GPIOs — upstream panel-simple ignores them, so GPIO hogs
+ * assert them at bank probe time, before any driver runs.
+ *
+ * All four are ACTIVE_HIGH (stock BSP panel driver: "active = 0"):
+ *   vcc_en_gpio:   gpio0 RK_PB4 — panel AVDD supply gate (driven LOW = off by
+ *                  BSP, left LOW here to match; stock shows "in lo")
+ *   vspn_en:       gpio0 RK_PA2 — AVEE/VSN charge pump enable; HIGH = on.
+ *                  Kept as a hog so panel_unprepare() never deasserts it;
+ *                  losing AVEE mid-session causes dim+ghosting to return.
+ *   back_vcc_en:   gpio3 RK_PC2 — backlight VCC rail gate; LOW in stock
+ *                  (driven via sysfs, not the panel driver).
+ *   vcc5v_en_gpio: gpio3 RK_PC3 — 5 V boost converter enable for the LED
+ *                  backlight driver; HIGH = boost on = LEDs lit.
+ */
+&gpio0 {
+	vcc-en-hog {
+		gpio-hog;
+		gpios = <RK_PB4 0>;
+		output-low;
+		line-name = "vcc_en";
+	};
+
+	vspn-en-hog {
+		gpio-hog;
+		gpios = <RK_PA2 0>;
+		output-high;
+		line-name = "vspn_en";
+	};
+};
+
+&gpio3 {
+	back-vcc-hog {
+		gpio-hog;
+		gpios = <RK_PC2 0>;
+		output-low;
+		line-name = "back_vcc_en";
+	};
+
+	vcc5v-en-hog {
+		gpio-hog;
+		gpios = <RK_PC3 0>;
+		output-high;
+		line-name = "vcc5v_en";
+	};
+};
+
+&dsi_dphy {
+	status = "okay";
+};
+
+/*
+ * GPU OPP voltages: with vdd_logic at the 950/975 mV the 200 and 300 MHz
+ * entries request, the I2S clock (and every other GPLL child) runs about
+ * 2.7 percent fast and wanders -- measured 49.3 kHz for a 48 kHz stream,
+ * audible as tape-like pitch wobble whenever the GPU idles down.  At the
+ * 400 MHz entry's voltage (1025 mV on the rail) it is exact.  Hold those two
+ * entries at the 400 MHz voltage.
+ */
+&gpu_opp_table {
+	opp-200000000 {
+		opp-microvolt = <1050000 1050000 1175000>;
+		opp-microvolt-L0 = <1050000 1050000 1175000>;
+		opp-microvolt-L1 = <1025000 1025000 1175000>;
+		opp-microvolt-L2 = <975000 975000 1175000>;
+		opp-microvolt-L3 = <950000 950000 1175000>;
+	};
+
+	opp-300000000 {
+		opp-microvolt = <1050000 1050000 1175000>;
+		opp-microvolt-L0 = <1050000 1050000 1175000>;
+		opp-microvolt-L1 = <1025000 1025000 1175000>;
+		opp-microvolt-L2 = <975000 975000 1175000>;
+		opp-microvolt-L3 = <950000 950000 1175000>;
+	};
+};
+
+&gpu {
+	mali-supply = <&vdd_logic>;
+	status = "okay";
+};
+
+&i2c0 {
+	clock-frequency = <400000>;
+	i2c-scl-rising-time-ns = <280>;
+	i2c-scl-falling-time-ns = <16>;
+	status = "okay";
+
+	rk817: pmic@20 {
+		compatible = "rockchip,rk817";
+		reg = <0x20>;
+		interrupt-parent = <&gpio0>;
+		interrupts = <RK_PB2 IRQ_TYPE_LEVEL_LOW>;
+		pinctrl-names = "default", "pmic-sleep",
+				"pmic-power-off", "pmic-reset";
+		pinctrl-0 = <&pmic_int>;
+		pinctrl-1 = <&soc_slppin_slp>, <&rk817_slppin_slp>;
+		pinctrl-2 = <&soc_slppin_gpio>, <&rk817_slppin_pwrdn>;
+		pinctrl-3 = <&soc_slppin_rst>, <&rk817_slppin_rst>;
+		rockchip,system-power-controller;
+		wakeup-source;
+		#clock-cells = <1>;
+		clock-output-names = "rk808-clkout1", "rk808-clkout2";
+		pmic-reset-func = <1>;
+
+		vcc1-supply = <&vccsys>;
+		vcc2-supply = <&vccsys>;
+		vcc3-supply = <&vccsys>;
+		vcc4-supply = <&vccsys>;
+		vcc5-supply = <&vccsys>;
+		vcc6-supply = <&vccsys>;
+		vcc7-supply = <&vccsys>;
+		vcc8-supply = <&vccsys>;
+		vcc9-supply = <&dcdc_boost>;
+
+		pwrkey {
+			status = "okay";
+		};
+
+		pinctrl_rk8xx: pinctrl_rk8xx {
+			gpio-controller;
+			#gpio-cells = <2>;
+
+			rk817_slppin_null: rk817_slppin_null {
+				pins = "gpio_slp";
+				function = "pin_fun0";
+			};
+			rk817_slppin_slp: rk817_slppin_slp {
+				pins = "gpio_slp";
+				function = "pin_fun1";
+			};
+			rk817_slppin_pwrdn: rk817_slppin_pwrdn {
+				pins = "gpio_slp";
+				function = "pin_fun2";
+			};
+			rk817_slppin_rst: rk817_slppin_rst {
+				pins = "gpio_slp";
+				function = "pin_fun3";
+			};
+		};
+
+		regulators {
+			vdd_logic: DCDC_REG1 {
+				regulator-name = "vdd_logic";
+				regulator-min-microvolt = <950000>;
+				regulator-max-microvolt = <1150000>;
+				regulator-ramp-delay = <6001>;
+				regulator-initial-mode = <0x2>;
+				regulator-always-on;
+				regulator-boot-on;
+
+				regulator-state-mem {
+					regulator-on-in-suspend;
+					regulator-suspend-microvolt = <950000>;
+				};
+			};
+
+			vdd_arm: DCDC_REG2 {
+				regulator-name = "vdd_arm";
+				regulator-min-microvolt = <950000>;
+				regulator-max-microvolt = <1350000>;
+				regulator-ramp-delay = <6001>;
+				regulator-initial-mode = <0x2>;
+				regulator-always-on;
+				regulator-boot-on;
+
+				regulator-state-mem {
+					regulator-off-in-suspend;
+					regulator-suspend-microvolt = <950000>;
+				};
+			};
+
+			vcc_ddr: DCDC_REG3 {
+				regulator-name = "vcc_ddr";
+				regulator-initial-mode = <0x2>;
+				regulator-always-on;
+				regulator-boot-on;
+
+				regulator-state-mem {
+					regulator-on-in-suspend;
+				};
+			};
+
+			vcc_3v3: DCDC_REG4 {
+				regulator-name = "vcc_3v3";
+				regulator-min-microvolt = <3300000>;
+				regulator-max-microvolt = <3300000>;
+				regulator-initial-mode = <0x2>;
+				regulator-always-on;
+				regulator-boot-on;
+
+				regulator-state-mem {
+					regulator-off-in-suspend;
+					regulator-suspend-microvolt = <3300000>;
+				};
+			};
+
+			/*
+			 * LDO_REG1: 2.8 V backlight power supply.
+			 * Referenced by the backlight node as power-supply.
+			 */
+			vcc_backlight: LDO_REG1 {
+				regulator-name = "vcc_backlight";
+				regulator-min-microvolt = <2800000>;
+				regulator-max-microvolt = <2800000>;
+				regulator-boot-on;
+
+				regulator-state-mem {
+					regulator-off-in-suspend;
+					regulator-suspend-microvolt = <2800000>;
+				};
+			};
+
+			vcc1v8_soc: LDO_REG2 {
+				regulator-name = "vcc1v8_soc";
+				regulator-min-microvolt = <1800000>;
+				regulator-max-microvolt = <1800000>;
+				regulator-always-on;
+				regulator-boot-on;
+
+				regulator-state-mem {
+					regulator-on-in-suspend;
+					regulator-suspend-microvolt = <1800000>;
+				};
+			};
+
+			vcc1v0_soc: LDO_REG3 {
+				regulator-name = "vcc1v0_soc";
+				regulator-min-microvolt = <1000000>;
+				regulator-max-microvolt = <1000000>;
+				regulator-always-on;
+				regulator-boot-on;
+
+				regulator-state-mem {
+					regulator-on-in-suspend;
+					regulator-suspend-microvolt = <1000000>;
+				};
+			};
+
+			vcc3v3_pmu: LDO_REG4 {
+				regulator-name = "vcc3v3_pmu";
+				regulator-min-microvolt = <3300000>;
+				regulator-max-microvolt = <3300000>;
+				regulator-always-on;
+				regulator-boot-on;
+
+				regulator-state-mem {
+					regulator-on-in-suspend;
+					regulator-suspend-microvolt = <3300000>;
+				};
+			};
+
+			/*
+			 * rppocket locks vccio_sd at 1.8 V (fixed); cards are
+			 * operated in UHS mode only.
+			 */
+			vccio_sd: LDO_REG5 {
+				regulator-name = "vccio_sd";
+				regulator-min-microvolt = <1800000>;
+				regulator-max-microvolt = <1800000>;
+				regulator-always-on;
+				regulator-boot-on;
+
+				regulator-state-mem {
+					regulator-on-in-suspend;
+					regulator-suspend-microvolt = <1800000>;
+				};
+			};
+
+			vcc_sd: LDO_REG6 {
+				regulator-name = "vcc_sd";
+				regulator-min-microvolt = <3300000>;
+				regulator-max-microvolt = <3300000>;
+				regulator-boot-on;
+
+				regulator-state-mem {
+					regulator-on-in-suspend;
+					regulator-suspend-microvolt = <3300000>;
+				};
+			};
+
+			/* LDO_REG7: 2.8 V panel VDD (vdd-supply for DSI panel)
+			 *
+			 * Do NOT add regulator-boot-on here. With boot-on the
+			 * regulator core holds a reference that prevents
+			 * lcd2v8 from ever physically powering off between
+			 * panel_simple_unprepare() and panel_simple_prepare().
+			 * The panel IC then fails to reinitialize on re-prepare
+			 * (display goes dim after userspace takes over the DRM
+			 * pipeline) because it never sees a clean AVDD power
+			 * cycle.  Without boot-on, use_count reaches 0 on
+			 * unprepare, the supply powers off, and the subsequent
+			 * prepare brings it back on cleanly.
+			 */
+			lcd2v8_supply: LDO_REG7 {
+				regulator-name = "lcd2v8_supply";
+				regulator-min-microvolt = <2800000>;
+				regulator-max-microvolt = <2800000>;
+
+				regulator-state-mem {
+					regulator-off-in-suspend;
+					regulator-suspend-microvolt = <2800000>;
+				};
+			};
+
+			/* LDO_REG8: 1.8 V panel IOVCC — must be up before VDD (LDO_REG7) */
+			vcc_lcd: LDO_REG8 {
+				regulator-name = "vcc_lcd";
+				regulator-min-microvolt = <1800000>;
+				regulator-max-microvolt = <1800000>;
+				regulator-boot-on;
+				regulator-always-on;
+
+				regulator-state-mem {
+					regulator-off-in-suspend;
+					regulator-suspend-microvolt = <1800000>;
+				};
+			};
+
+			/* LDO_REG9: 3.3 V WiFi power (always on) */
+			vcc_wifi: LDO_REG9 {
+				regulator-name = "vcc_wifi";
+				regulator-min-microvolt = <3300000>;
+				regulator-max-microvolt = <3300000>;
+				regulator-always-on;
+				regulator-boot-on;
+
+				regulator-state-mem {
+					regulator-off-in-suspend;
+					regulator-suspend-microvolt = <3300000>;
+				};
+			};
+
+			dcdc_boost: BOOST {
+				regulator-name = "boost";
+				regulator-min-microvolt = <5000000>;
+				regulator-max-microvolt = <5400000>;
+				regulator-always-on;
+				regulator-boot-on;
+			};
+
+			otg_switch: OTG_SWITCH {
+				regulator-name = "otg_switch";
+			};
+		};
+
+		battery {
+			compatible = "rk817,battery";
+			ocv_table = <3400 3599 3671 3701 3728 3746 3762
+				     3772 3781 3792 3816 3836 3866 3910
+				     3942 3971 4002 4050 4088 4132 4183>;
+			design_capacity = <3000>;
+			design_qmax = <3300>;
+			bat_res = <100>;
+			sleep_enter_current = <300>;
+			sleep_exit_current = <300>;
+			sleep_filter_current = <100>;
+			power_off_thresd = <3400>;
+			zero_algorithm_vol = <3850>;
+			max_soc_offset = <60>;
+			monitor_sec = <5>;
+			virtual_power = <0>;
+			sample_res = <10>;
+		};
+
+		charger {
+			compatible = "rk817,charger";
+			min_input_voltage = <4500>;
+			max_input_current = <1500>;
+			max_chrg_current = <2000>;
+			max_chrg_voltage = <4200>;
+			chrg_term_mode = <0>;
+			chrg_finish_cur = <52>;
+			virtual_power = <0>;
+			sample_res = <10>;
+			power_dc2otg = <0>;
+			otg5v_suspend_enable = <0>;
+			gate_function_disable = <0>;
+			dc_det_gpio  = <&gpio0 RK_PB3 GPIO_ACTIVE_HIGH>;
+			bat_low_gpio = <&gpio2 RK_PC0 GPIO_ACTIVE_HIGH>;
+			/*
+			 * No extcon: BC1.2 charger detection only runs with the otg
+			 * port in peripheral mode, and this board must stay in host
+			 * mode (S28usbmode forces "peripheral" when idle).  With extcon absent the
+			 * driver falls back to the PMIC PLUG_IN_STS bit, which does
+			 * work here.  dc_det_gpio is kept but does not assert on
+			 * this board either.
+			 */
+		};
+
+		rk817_codec: codec {
+			#sound-dai-cells = <0>;
+			compatible = "rockchip,rk817-codec";
+			clocks = <&cru SCLK_I2S1_OUT>;
+			clock-names = "mclk";
+			pinctrl-names = "default";
+			pinctrl-0 = <&i2s1_2ch_mclk>;
+			hp-volume = <20>;
+			spk-volume = <3>;
+			/*
+			 * GPIO3_PC5 enables the speaker amplifier (amp_en in BSP).
+			 * This is a simple-audio-card board, so only the codec driver
+			 * can drive it, and rk817_codec looks the line up as
+			 * spk-ctl-gpios; the multicodecs spelling spk-con-gpio used
+			 * here before was never read, leaving the amp off.
+			 */
+			spk-ctl-gpios = <&gpio3 RK_PC5 GPIO_ACTIVE_LOW>;
+			status = "okay";
+		};
+	};
+};
