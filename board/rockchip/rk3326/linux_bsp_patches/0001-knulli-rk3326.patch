+/*----------------------------------------------------------------------------*/
+static int joypad_amux_select(struct analog_mux *amux, int channel)
+{
+	/* select mux channel */
+	gpio_set_value(amux->en_gpio, 0);
+
+	switch(channel) {
+		case 0:	/* EVENT (ABS_RZ) */
+			gpio_set_value(amux->sel_a_gpio, 0);
+			gpio_set_value(amux->sel_b_gpio, 0);
+			break;
+		case 1:	/* EVENT (ABS_Z) */
+			gpio_set_value(amux->sel_a_gpio, 0);
+			gpio_set_value(amux->sel_b_gpio, 1);
+			break;
+		case 2:	/* EVENT (ABS_Y) */
+			gpio_set_value(amux->sel_a_gpio, 1);
+			gpio_set_value(amux->sel_b_gpio, 0);
+			break;
+		case 3:	/* EVENT (ABS_X) */
+			gpio_set_value(amux->sel_a_gpio, 1);
+			gpio_set_value(amux->sel_b_gpio, 1);
+			break;
+		default:
+			/* amux disanle */
+			gpio_set_value(amux->en_gpio, 1);
+			return -1;
+	}
+	/* mux swtiching speed : 35ns(on) / 9ns(off) */
+	usleep_range(10, 20);
+	return 0;
+}
+
+/*----------------------------------------------------------------------------*/
+static int joypad_adc_read(struct analog_mux *amux, struct bt_adc *adc)
+{
+	int value = 0;
+	int ret;
+
+	if (amux->num_direct_chs > 0) {
+		if (adc->amux_ch >= amux->num_direct_chs)
+			return 0;
+		ret = iio_read_channel_raw(amux->iio_chs[adc->amux_ch], &value);
+		if (ret < 0)
+			return 0;
+		value *= adc->scale;
+		return value;
+	}
+
+	if (joypad_amux_select(amux, adc->amux_ch))
+		return 0;
+
+	ret = iio_read_channel_raw(amux->iio_ch, &value);
+	if (ret < 0)
+		return 0;
+
+	value *= adc->scale;
+
+	return value;
+}
