+/*
+ * GPU OPP voltages: with vdd_logic at the 950/975 mV the 200 and 300 MHz
+ * entries request, the I2S clock (and every other GPLL child) runs about
+ * 2.7 percent fast and wanders -- measured 49.3 kHz for a 48 kHz stream,
+ * audible as tape-like pitch wobble whenever the GPU idles down.  At the
+ * 400 MHz entry's voltage (1025 mV on the rail) it is exact.  Hold those two
+ * entries at the 400 MHz voltage.
+ */
+&gpu_opp_table {
+	opp-200000000 {
+		opp-microvolt = <1050000 1050000 1175000>;
+		opp-microvolt-L0 = <1050000 1050000 1175000>;
+		opp-microvolt-L1 = <1025000 1025000 1175000>;
+		opp-microvolt-L2 = <975000 975000 1175000>;
+		opp-microvolt-L3 = <950000 950000 1175000>;
+	};
+
+	opp-300000000 {
+		opp-microvolt = <1050000 1050000 1175000>;
+		opp-microvolt-L0 = <1050000 1050000 1175000>;
+		opp-microvolt-L1 = <1025000 1025000 1175000>;
+		opp-microvolt-L2 = <975000 975000 1175000>;
+		opp-microvolt-L3 = <950000 950000 1175000>;
+	};
+};
