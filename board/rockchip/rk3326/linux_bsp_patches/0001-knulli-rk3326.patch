+/ {
+	model = "XiFan MyMini";
+	compatible = "rockchip,rk3326-mymini-linux", "rockchip,rk3326";
+
+	/*
+	 * MyMini uses UART5 (GPIO3_PA1/PA2) for the FIQ debug console at
+	 * 1500000 baud.  irq-mode-enable = 1 uses an interrupt rather than
+	 * FIQ so it works without a custom ATF build.
+	 */
+	fiq-debugger {
+		pinctrl-0 = <&uart5_xfer>;
+		rockchip,serial-id = <5>;
+		rockchip,irq-mode-enable = <1>;
+		rockchip,baudrate = <1500000>;
