+	sd-uhs-sdr104;
+	vmmc-supply  = <&vcc_sd>;
+	vqmmc-supply = <&vccio_sd>;
+	status = "okay";
+};
+
+/*
+ * Secondary SD card slot wired to the SDIO controller.
+ * The R36S has no WiFi module; this port is exposed as a second card reader.
