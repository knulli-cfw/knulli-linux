+/* video_phy is already enabled by rk3326-linux.dtsi */
+
+/* ----------------------------------------------------------------
+ * GPU
+ * ---------------------------------------------------------------- */
+
+/*
+ * GPU OPP voltages: with vdd_logic at the 950/975 mV the 200 and 300 MHz
+ * entries request, the I2S clock (and every other GPLL child) runs about
+ * 2.7 percent fast and wanders -- measured 49.3 kHz for a 48 kHz stream,
+ * audible as tape-like pitch wobble whenever the GPU idles down.  At the
+ * 400 MHz entry's voltage (1025 mV on the rail) it is exact.  Hold those two
+ * entries at the 400 MHz voltage.
+ */
+&gpu_opp_table {
+	opp-200000000 {
+		opp-microvolt = <1050000 1050000 1175000>;
+		opp-microvolt-L0 = <1050000 1050000 1175000>;
+		opp-microvolt-L1 = <1025000 1025000 1175000>;
+		opp-microvolt-L2 = <975000 975000 1175000>;
+		opp-microvolt-L3 = <950000 950000 1175000>;
+	};
+
+	opp-300000000 {
+		opp-microvolt = <1050000 1050000 1175000>;
+		opp-microvolt-L0 = <1050000 1050000 1175000>;
+		opp-microvolt-L1 = <1025000 1025000 1175000>;
+		opp-microvolt-L2 = <975000 975000 1175000>;
+		opp-microvolt-L3 = <950000 950000 1175000>;
+	};
+};
+
+&gpu {
+	mali-supply = <&vdd_logic>;
+	status = "okay";
+};
+
+/* ----------------------------------------------------------------
+ * I2C0 — PMIC (RK817)
+ * ---------------------------------------------------------------- */
+
+&i2c0 {
+	status = "okay";
+	clock-frequency = <400000>;
+	i2c-scl-rising-time-ns = <280>;
+	i2c-scl-falling-time-ns = <16>;
+
+	rk817: pmic@20 {
+		compatible = "rockchip,rk817";
+		reg = <0x20>;
+		interrupt-parent = <&gpio0>;
+		interrupts = <RK_PB2 IRQ_TYPE_LEVEL_LOW>;
+		pinctrl-names = "default", "pmic-sleep", "pmic-power-off", "pmic-reset";
+		pinctrl-0 = <&pmic_int>;
+		pinctrl-1 = <&soc_slppin_slp>;
+		pinctrl-2 = <&soc_slppin_gpio>;
+		pinctrl-3 = <&soc_slppin_rst>;
+		rockchip,system-power-controller;
+		wakeup-source;
+		#clock-cells = <1>;
+		clock-output-names = "rk808-clkout1", "rk808-clkout2";
+		pmic-reset-func = <1>;
+
+		vcc1-supply = <&vccsys>;
+		vcc2-supply = <&vccsys>;
+		vcc3-supply = <&vccsys>;
+		vcc4-supply = <&vccsys>;
+		vcc5-supply = <&vccsys>;
+		vcc6-supply = <&vccsys>;
+		vcc7-supply = <&vcc_3v0>;
+		vcc8-supply = <&vccsys>;
+		vcc9-supply = <&dcdc_boost>;
+
+		pwrkey {
+			status = "okay";
+		};
+
+		pinctrl_rk8xx: pinctrl-rk8xx {
+			gpio-controller;
+			#gpio-cells = <2>;
+
+			rk817_slppin_slp: rk817-slppin-slp {
+				pins = "gpio_slp";
+				function = "pin_fun1";
+			};
+
+			rk817_slppin_pwrdn: rk817-slppin-pwrdn {
+				pins = "gpio_slp";
+				function = "pin_fun2";
+			};
+
+			rk817_slppin_rst: rk817-slppin-rst {
+				pins = "gpio_slp";
+				function = "pin_fun3";
+			};
+		};
+
+		regulators {
+			vdd_logic: DCDC_REG1 {
+				regulator-name = "vdd_logic";
+				regulator-always-on;
+				regulator-boot-on;
+				regulator-min-microvolt = <950000>;
+				regulator-max-microvolt = <1350000>;
+				regulator-init-microvolt = <1150000>;
+				regulator-ramp-delay = <6001>;
+				regulator-initial-mode = <2>;
+
+				regulator-state-mem {
+					regulator-on-in-suspend;
+					regulator-suspend-microvolt = <950000>;
+				};
+			};
+
+			vdd_arm: DCDC_REG2 {
+				regulator-name = "vdd_arm";
+				regulator-always-on;
+				regulator-boot-on;
+				regulator-min-microvolt = <950000>;
+				regulator-max-microvolt = <1350000>;
+				regulator-init-microvolt = <1250000>;
+				regulator-ramp-delay = <6001>;
+				regulator-initial-mode = <2>;
+
+				regulator-state-mem {
+					regulator-off-in-suspend;
+					regulator-suspend-microvolt = <950000>;
+				};
+			};
+
+			vcc_ddr: DCDC_REG3 {
+				regulator-name = "vcc_ddr";
+				regulator-always-on;
+				regulator-boot-on;
+				regulator-initial-mode = <2>;
+
+				regulator-state-mem {
+					regulator-on-in-suspend;
+				};
+			};
+
+			vcc_3v0: DCDC_REG4 {
+				regulator-name = "vcc_3v0";
+				regulator-always-on;
+				regulator-boot-on;
+				regulator-min-microvolt = <3000000>;
+				regulator-max-microvolt = <3000000>;
+				regulator-initial-mode = <2>;
+
+				regulator-state-mem {
+					regulator-off-in-suspend;
+					regulator-suspend-microvolt = <3000000>;
+				};
+			};
+
+			vcc_1v0: LDO_REG1 {
+				regulator-name = "vcc_1v0";
+				regulator-always-on;
+				regulator-boot-on;
+				regulator-min-microvolt = <1000000>;
+				regulator-max-microvolt = <1000000>;
+
+				regulator-state-mem {
+					regulator-on-in-suspend;
+					regulator-suspend-microvolt = <1000000>;
+				};
+			};
+
+			vcc1v8_soc: LDO_REG2 {
+				regulator-name = "vcc1v8_soc";
+				regulator-always-on;
+				regulator-boot-on;
+				regulator-min-microvolt = <1800000>;
+				regulator-max-microvolt = <1800000>;
+
+				regulator-state-mem {
+					regulator-on-in-suspend;
+					regulator-suspend-microvolt = <1800000>;
+				};
+			};
+
+			vdd1v0_soc: LDO_REG3 {
+				regulator-name = "vcc1v0_soc";
+				regulator-always-on;
+				regulator-boot-on;
+				regulator-min-microvolt = <1000000>;
+				regulator-max-microvolt = <1000000>;
+
+				regulator-state-mem {
+					regulator-on-in-suspend;
+					regulator-suspend-microvolt = <1000000>;
+				};
+			};
+
+			vcc3v0_pmu: LDO_REG4 {
+				regulator-name = "vcc3v0_pmu";
+				regulator-always-on;
+				regulator-boot-on;
+				regulator-min-microvolt = <3000000>;
+				regulator-max-microvolt = <3000000>;
+
+				regulator-state-mem {
+					regulator-on-in-suspend;
+					regulator-suspend-microvolt = <3000000>;
+				};
+			};
+
+			vccio_sd: LDO_REG5 {
+				regulator-name = "vccio_sd";
+				regulator-always-on;
+				regulator-boot-on;
+				regulator-min-microvolt = <1800000>;
+				regulator-max-microvolt = <3300000>;
+
+				regulator-state-mem {
+					regulator-on-in-suspend;
+					regulator-suspend-microvolt = <3300000>;
+				};
+			};
+
+			vcc_sd: LDO_REG6 {
+				regulator-name = "vcc_sd";
+				regulator-min-microvolt = <3300000>;
+				regulator-max-microvolt = <3300000>;
+
+				regulator-state-mem {
+					regulator-on-in-suspend;
+					regulator-suspend-microvolt = <3300000>;
+				};
+			};
+
+			vcc2v8_dvp: LDO_REG7 {
+				regulator-name = "vcc2v8_dvp";
+				regulator-always-on;
+				regulator-boot-on;
+				regulator-min-microvolt = <1800000>;
+				regulator-max-microvolt = <3300000>;
+
+				regulator-state-mem {
+					regulator-on-in-suspend;
+					regulator-suspend-microvolt = <3300000>;
+				};
+			};
+
+			vcc1v8_dvp: LDO_REG8 {
+				regulator-name = "vcc1v8_dvp";
+				regulator-always-on;
+				regulator-boot-on;
+				regulator-min-microvolt = <3300000>;
+				regulator-max-microvolt = <3300000>;
+
+				regulator-state-mem {
+					regulator-on-in-suspend;
+					regulator-suspend-microvolt = <3300000>;
+				};
+			};
+
+			vdd1v5_dvp: LDO_REG9 {
+				regulator-name = "vdd1v5_dvp";
+				regulator-always-on;
+				regulator-boot-on;
+				regulator-min-microvolt = <1500000>;
+				regulator-max-microvolt = <1500000>;
+
+				regulator-state-mem {
+					regulator-off-in-suspend;
+					regulator-suspend-microvolt = <1500000>;
+				};
+			};
+
+			dcdc_boost: BOOST {
+				regulator-name = "boost";
+				regulator-always-on;
+				regulator-boot-on;
+				regulator-min-microvolt = <5000000>;
+				regulator-max-microvolt = <5400000>;
+			};
+
+			/*
+			 * Do NOT add regulator-always-on here.  The rk817 charger
+			 * driver owns this boost -- rk817_charge_set_otg_state()
+			 * enables and disables it from rk817_charge_host_evt_worker
+			 * when the OTG port enters or leaves host mode.  Forcing it
+			 * on gives "unbalanced disables for otg_switch" and the
+			 * driver's disable wins anyway.  It powers the OTG
+			 * connector's VBUS, so it only comes up when that port
+			 * actually goes host -- which it cannot while the adb gadget
+			 * is bound to it.
+			 */
+			otg_switch: OTG_SWITCH {
+				regulator-name = "otg_switch";
+			};
+		};
+
+		rk817_battery: battery {
+			compatible = "rk817,battery";
+			/*
+			 * OCV table (mV) at 20°C, 21 points (0..100%)
+			 * Converted from raw BSP values (in 0.1mV units):
+			 *   0xd48=3400, 0xd6a=3434, ..., 0x1055=4181
+			 */
+			ocv_table = <3400 3434 3483 3522 3553 3575 3592
+				     3606 3622 3642 3674 3720 3764 3809
+				     3849 3883 3919 3975 4018 4071 4181>;
+			design_capacity = <3228>;
+			design_qmax = <3550>;
+			bat_res = <115>;
+			sleep_enter_current = <300>;
+			sleep_exit_current = <300>;
+			sleep_filter_current = <100>;
+			power_off_thresd = <3500>;
+			zero_algorithm_vol = <3850>;
+			max_soc_offset = <60>;
+			monitor_sec = <5>;
+			sample_res = <10>;
+			virtual_power = <0>;
+			dc_det_gpio = <&gpio3 RK_PA5 GPIO_ACTIVE_HIGH>;
+		};
+
+		rk817_charger: charger {
+			compatible = "rk817,charger";
+			min_input_voltage = <4500>;
+			max_input_current = <800>;
+			max_chrg_current = <800>;
+			max_chrg_voltage = <4200>;
+			chrg_term_mode = <0>;
+			chrg_finish_cur = <300>;
+			virtual_power = <0>;
+			pinctrl-names = "default";
+			pinctrl-0 = <&charge_led_gpio>;
+			
+			/*
+			 * This node was disabled, so rk817-charger never probed: no charger
+			 * power supply was registered, and rk817_battery derives STATUS from
+			 * power_supply_is_system_supplied(), which needs a non-battery supply
+			 * online -- so the battery read "Discharging" while physically
+			 * charging.  Two inputs: the OTG connector, detected by the usb2 phy
+			 * (extcon, USB_SDP_CHARGER), and the DC connector, which has its own
+			 * detect line on gpio3 A5 (ArkOS's "rk817_dc_det", read high with
+			 * the charger on it) -- without dc_det_gpio the DC side was invisible.
+			 */
+			dc_det_gpio = <&gpio3 RK_PA5 GPIO_ACTIVE_HIGH>;
+			extcon = <&u2phy>;
+		};
+
+		rk817_codec: codec {
+			#sound-dai-cells = <0>;
+			compatible = "rockchip,rk817-codec";
+			clocks = <&cru SCLK_I2S1_OUT>;
+			clock-names = "mclk";
+			pinctrl-names = "default";
+			pinctrl-0 = <&i2s1_2ch_mclk>;
+			use-ext-amplifier;
+			hp-volume = <20>;
+			spk-volume = <44>;
+			status = "okay";
+		};
+	};
+};
+
+/* ----------------------------------------------------------------
+ * I2C1 — Touchscreen (GSL X680) + LED controller (keros lite)
+ * ---------------------------------------------------------------- */
+
+&i2c1 {
+	status = "okay";
+	clock-frequency = <400000>;
+	i2c-scl-rising-time-ns = <275>;
+	i2c-scl-falling-time-ns = <16>;
+
+	ts@40 {
+		compatible = "gslX680-d708";
+		reg = <0x40>;
+		touch-gpio = <&gpio0 RK_PB3 IRQ_TYPE_EDGE_FALLING>;
+		wake-gpio  = <&gpio0 RK_PB4 GPIO_ACTIVE_HIGH>;
+		screen_max_x = <800>;
+		screen_max_y = <1280>;
+		status = "okay";
+	};
+
+	fb_keros@1c {
+		compatible = "keros,lite";
+		reg = <0x1c>;
+		led-gpio = <&gpio0 RK_PB6 GPIO_ACTIVE_HIGH>;
+		status = "okay";
+	};
+};
+
+/* ----------------------------------------------------------------
+ * I2S1 (2ch) — used for RK817 codec
+ * ---------------------------------------------------------------- */
+
+&i2s1_2ch {
+	status = "okay";
+	/*
+	 * No rockchip,always-on: with it the link ran with a 65-bclk frame and
+	 * playback wobbled in pitch even straight from ALSA; the boards that
+	 * play cleanly (R36S, Pixel2) do without it.
+	 */
+};
+
+/* ----------------------------------------------------------------
+ * IO voltage domains
+ * ---------------------------------------------------------------- */
+
+&io_domains {
+	status = "okay";
+	vccio1-supply = <&vcc2v8_dvp>;
+	vccio2-supply = <&vccio_sd>;
+	vccio3-supply = <&vcc1v8_soc>;
+	vccio4-supply = <&vcc_3v0>;
+	vccio5-supply = <&vcc_3v0>;
+	vccio6-supply = <&vcc1v8_soc>;
+};
+
+&pmu_io_domains {
+	status = "okay";
+	pmuio1-supply = <&vcc3v0_pmu>;
+	pmuio2-supply = <&vcc3v0_pmu>;
+};
+
+/* ----------------------------------------------------------------
+ * PWM1 — backlight
+ * ---------------------------------------------------------------- */
+
+&pwm1 {
+	status = "okay";
+};
+
+/* ----------------------------------------------------------------
+ * SARADC — joystick axes + ADC keys + hp detect
+ * ---------------------------------------------------------------- */
+
+&saradc {
+	status = "okay";
+	vref-supply = <&vcc1v8_soc>;
+};
+
+/* ----------------------------------------------------------------
+ * SDMMC — micro SD card
+ * ---------------------------------------------------------------- */
+
+&sdmmc {
+	status = "okay";
+	cap-sd-highspeed;
+	supports-sd;
+	card-detect-delay = <800>;
+	ignore-pm-notify;
+	cd-gpios = <&gpio0 RK_PA3 GPIO_ACTIVE_LOW>;
+	sd-uhs-sdr12;
+	sd-uhs-sdr25;
+	sd-uhs-sdr50;
+	sd-uhs-sdr104;
+	vqmmc-supply = <&vccio_sd>;
+	vmmc-supply = <&vcc_sd>;
+	/*
+	 * Drop sdmmc_det from pinctrl: px30.dtsi sets GPIO0_A3 to SDMMC
+	 * function 1 for hardware CD, but this board uses cd-gpios on the
+	 * same pin as a regular GPIO — the two mux settings conflict.
+	 */
+	pinctrl-names = "default", "normal", "idle";
+	pinctrl-0 = <&sdmmc_clk &sdmmc_cmd &sdmmc_bus4>;
+	pinctrl-1 = <&sdmmc_clk &sdmmc_cmd &sdmmc_bus4>;
+	pinctrl-2 = <&sdmmc_idle>;
+};
+
+/* ----------------------------------------------------------------
+ * SDIO — WiFi (Seekwave SV6160 / rk915)
+ * ---------------------------------------------------------------- */
+
+&sdio {
+	status = "okay";
+	cap-sd-highspeed;
+	no-sd;
+	no-mmc;
+	supports-sdio;
+	supports-rk915;
+	ignore-pm-notify;
+	keep-power-in-suspend;
+	mmc-pwrseq = <&sdio_pwrseq>;
+	pinctrl-names = "default", "normal", "idle";
+	pinctrl-0 = <&sdio_bus4 &sdio_cmd &sdio_clk>;
+	pinctrl-1 = <&sdio_bus4 &sdio_cmd &sdio_clk>;
+	pinctrl-2 = <&sdio_idle>;
+};
+
+/* ----------------------------------------------------------------
+ * eMMC / NAND (dwmmc@ff390000)
+ * ---------------------------------------------------------------- */
+
+&emmc {
+	status = "okay";
+	cap-mmc-highspeed;
+	no-sdio;
+	no-sd;
+	disable-wp;
+	non-removable;
+	num-slots = <1>;
+	pinctrl-names = "default", "normal", "idle";
+	pinctrl-0 = <&emmc_clk &emmc_cmd &emmc_bus8>;
+	pinctrl-1 = <&emmc_clk &emmc_cmd &emmc_bus8>;
+	pinctrl-2 = <&emmc_idle>;
+};
+
+/* ----------------------------------------------------------------
+ * SCMI — disable: px30 BL31 does not implement the SCMI protocol.
+ * The scmi_clk protocol@14 defined in px30.dtsi has no consumers on
+ * rk3326; leaving it enabled causes a shmem_tx_prepare timeout warning
+ * on every boot because the channel is never marked CHANNEL_FREE.
+ * ---------------------------------------------------------------- */
+
+&scmi {
+	status = "disabled";
+};
+
+/* ----------------------------------------------------------------
+ * Thermal
+ * ---------------------------------------------------------------- */
+
+&tsadc {
+	status = "okay";
+};
+
+/* ----------------------------------------------------------------
+ * FIQ debugger (console) on UART5
+ * ---------------------------------------------------------------- */
+
+/*
+ * uart5 is the debug port, but it must stay disabled: the fiq-debugger claims
+ * the hardware itself (it carries its own pinctrl-0 = <&uart5_xfer>) and
+ * refuses to probe if the 8250 driver has it -- "uart5 is enabled, please
+ * disable it", then -EINVAL.  With that probe failed there is no /dev/ttyFIQ0
+ * for console=ttyFIQ0 to attach to, and the board is silent on every port.
+ */
+&uart5 {
+	status = "disabled";
+};
+
+/* ----------------------------------------------------------------
+ * USB
+ * ---------------------------------------------------------------- */
+
+&u2phy {
+	status = "okay";
+
+	u2phy_otg: otg-port {
+		vbus-supply = <&vcc5v0_otg>;
+		status = "okay";
+	};
+
+	u2phy_host: host-port {
+		status = "okay";
+	};
+};
+
+&usb20_otg {
+	/*
+	 * px30.dtsi default dr_mode = "otg".  The ID pin reads low on this board,
+	 * so the phy and dwc2 settle in host mode by themselves; forcing "host"
+	 * changes nothing and only costs adb.  Host never worked because the
+	 * rk817 boost feeds the connector through a load switch on gpio3 A4
+	 * (ArkOS's "otg_gpio") -- see vcc5v0_otg.
+	 */
+	status = "okay";
+};
+
+/*
+ * Second USB connector.  u2phy_host was enabled on its own, but px30.dtsi
+ * leaves both host controllers disabled, so the host phy port was powered up
+ * with nothing bound to it and that connector could never enumerate anything.
+ */
+&usb_host0_ehci {
+	status = "okay";
+};
+
+&usb_host0_ohci {
+	status = "okay";
+};
+
+/* ----------------------------------------------------------------
+ * VOP (display controller)
+ * ---------------------------------------------------------------- */
+
+&vopb {
+	status = "okay";
+};
+
+&vopb_mmu {
+	status = "okay";
+};
+
+/* ----------------------------------------------------------------
+ * Pinctrl — board-specific groups
+ * ---------------------------------------------------------------- */
+
+&pinctrl {
+
+	headphone {
+		hp_det: hp-det {
+			rockchip,pins = <2 RK_PC6 RK_FUNC_GPIO &pcfg_pull_up>;
+		};
+	};
+
+	pmic {
+		pmic_int: pmic-int {
+			rockchip,pins = <0 RK_PB2 RK_FUNC_GPIO &pcfg_pull_up>;
+		};
+
+		soc_slppin_gpio: soc-slppin-gpio {
+			rockchip,pins = <0 RK_PA4 RK_FUNC_GPIO &pcfg_output_low>;
+		};
+
+		soc_slppin_slp: soc-slppin-slp {
+			rockchip,pins = <0 RK_PA4 1 &pcfg_pull_none>;
+		};
+
+		soc_slppin_rst: soc-slppin-rst {
+			rockchip,pins = <0 RK_PA4 2 &pcfg_pull_none>;
+		};
+	};
+
+	led {
+		/*
+		 * charge_red  = GPIO0_PC1 (gpio0 bit 0x11 = 17 = PC1)
+		 * charge_blue = GPIO0_PA0 (gpio0 bit 0x00 =  0 = PA0)
+		 * work_red    = GPIO0_PB4 (gpio0 bit 0x0c = 12 = PB4)
+		 * work_blue   = GPIO0_PB3 (gpio0 bit 0x0b = 11 = PB3)
+		 */
+		charge_led_gpio: charge-led-gpio {
+			rockchip,pins =
+				<0 RK_PC1 RK_FUNC_GPIO &pcfg_pull_none>,
+				<0 RK_PA0 RK_FUNC_GPIO &pcfg_pull_none>,
+				<0 RK_PB4 RK_FUNC_GPIO &pcfg_pull_none>,
+				<0 RK_PB3 RK_FUNC_GPIO &pcfg_pull_none>;
+		};
+	};
+
+	moto {
+		moto_gpio: moto-gpio {
+			/* GPIO3_PA6, drive-open-drain */
+			rockchip,pins = <3 RK_PA6 RK_FUNC_GPIO &pcfg_pull_none>;
+		};
+	};
+
+	buttons {
+		/*
+		 * 19 button GPIOs on gpio3/gpio2.
+		 * gpio3: PB3..PB6, PC0..PC7, PD0..PD3, PC2..PC3 (raw bit indices
+		 *   0x0b,0x0c,0x0d,0x0e,0x10..0x1b from BSP)
+		 * gpio2: PD5=0x0d, PD6=0x0e
+		 * gpio3: PB2=0x0a
+		 */
+		gpio_key_pin: gpio-key-pin {
+			/* the 19 key-gpios from the BSP; the mux lines are not here */
+			rockchip,pins =
+				/* D-pad */
+				<3 RK_PB3 RK_FUNC_GPIO &pcfg_pull_up>,
+				<3 RK_PB4 RK_FUNC_GPIO &pcfg_pull_up>,
+				<3 RK_PB5 RK_FUNC_GPIO &pcfg_pull_up>,
+				<3 RK_PB6 RK_FUNC_GPIO &pcfg_pull_up>,
+				/* Face buttons A/B/X/Y */
+				<3 RK_PC0 RK_FUNC_GPIO &pcfg_pull_up>,
+				<3 RK_PC1 RK_FUNC_GPIO &pcfg_pull_up>,
+				<3 RK_PC2 RK_FUNC_GPIO &pcfg_pull_up>,
+				<3 RK_PC3 RK_FUNC_GPIO &pcfg_pull_up>,
+				/* Shoulder L1/R1/L2/R2 */
+				<3 RK_PC4 RK_FUNC_GPIO &pcfg_pull_up>,
+				<3 RK_PC5 RK_FUNC_GPIO &pcfg_pull_up>,
+				<3 RK_PC6 RK_FUNC_GPIO &pcfg_pull_up>,
+				<3 RK_PC7 RK_FUNC_GPIO &pcfg_pull_up>,
+				/* Start/Select/F1/F2 */
+				<3 RK_PD0 RK_FUNC_GPIO &pcfg_pull_up>,
+				<3 RK_PD1 RK_FUNC_GPIO &pcfg_pull_up>,
+				<3 RK_PD2 RK_FUNC_GPIO &pcfg_pull_up>,
+				<3 RK_PD3 RK_FUNC_GPIO &pcfg_pull_up>,
+				/* Vol-up/down on gpio2 PB5/PB6 (BSP 0x0d/0x0e) */
+				<2 RK_PB5 RK_FUNC_GPIO &pcfg_pull_up>,
+				<2 RK_PB6 RK_FUNC_GPIO &pcfg_pull_up>,
+				/* Mode/Home */
+				<3 RK_PB2 RK_FUNC_GPIO &pcfg_pull_up>;
+				/*
+				 * gpio2 PB4/PB7/PC0 are deliberately absent: they are the
+				 * analog mux select/enable lines, driven as outputs by the
+				 * joypad node.  A pull-up here would fight them.  Stock's
+				 * gpio-key-pin lists only these 19 button pins too.
+				 */
+		};
+	};
+
+	sdio_pwrseq {
+		wifi_enable_h: wifi-enable-h {
+			rockchip,pins = <0 RK_PA2 RK_FUNC_GPIO &pcfg_pull_none>;
+		};
+	};
+
+	vcc_led {
+		ledvcc_en_gpio: ledvcc-en-gpio {
+			rockchip,pins = <2 RK_PA1 RK_FUNC_GPIO &pcfg_pull_none>;
+		};
+	};
+
+	/*
+	 * Low-power idle states for the three dwmmc controllers.
+	 * The dw_mmc driver looks for "normal" and "idle" pinctrl states for
+	 * card power management; without them it only logs harmless warnings,
+	 * but defining them avoids the noise and enables proper pin idling.
+	 *
+	 * Idle policy: data/cmd lines pulled up (bus held high), clock
+	 * floated (pull-none) so the oscillator is not fighting a pull.
+	 */
+	sdmmc-idle {
+		/* GPIO1: PD6=clk, PD7=cmd, PD2..PD5=data0..3 */
+		sdmmc_idle: sdmmc-idle {
+			rockchip,pins =
+				<1 RK_PD6 RK_FUNC_GPIO &pcfg_pull_none>,
+				<1 RK_PD7 RK_FUNC_GPIO &pcfg_pull_up>,
+				<1 RK_PD2 RK_FUNC_GPIO &pcfg_pull_up>,
+				<1 RK_PD3 RK_FUNC_GPIO &pcfg_pull_up>,
+				<1 RK_PD4 RK_FUNC_GPIO &pcfg_pull_up>,
+				<1 RK_PD5 RK_FUNC_GPIO &pcfg_pull_up>;
+		};
+	};
+
+	sdio-idle {
+		/* GPIO1: PC5=clk, PC4=cmd, PC6..PC7+PD0..PD1=data0..3 */
+		sdio_idle: sdio-idle {
+			rockchip,pins =
+				<1 RK_PC5 RK_FUNC_GPIO &pcfg_pull_none>,
+				<1 RK_PC4 RK_FUNC_GPIO &pcfg_pull_up>,
+				<1 RK_PC6 RK_FUNC_GPIO &pcfg_pull_up>,
+				<1 RK_PC7 RK_FUNC_GPIO &pcfg_pull_up>,
+				<1 RK_PD0 RK_FUNC_GPIO &pcfg_pull_up>,
+				<1 RK_PD1 RK_FUNC_GPIO &pcfg_pull_up>;
+		};
+	};
+
+	emmc-idle {
+		/* GPIO1: PB1=clk, PB2=cmd, PA0..PA7=data0..7 */
+		emmc_idle: emmc-idle {
+			rockchip,pins =
+				<1 RK_PB1 RK_FUNC_GPIO &pcfg_pull_none>,
+				<1 RK_PB2 RK_FUNC_GPIO &pcfg_pull_up>,
+				<1 RK_PA0 RK_FUNC_GPIO &pcfg_pull_up>,
+				<1 RK_PA1 RK_FUNC_GPIO &pcfg_pull_up>,
+				<1 RK_PA2 RK_FUNC_GPIO &pcfg_pull_up>,
+				<1 RK_PA3 RK_FUNC_GPIO &pcfg_pull_up>,
+				<1 RK_PA4 RK_FUNC_GPIO &pcfg_pull_up>,
+				<1 RK_PA5 RK_FUNC_GPIO &pcfg_pull_up>,
+				<1 RK_PA6 RK_FUNC_GPIO &pcfg_pull_up>,
+				<1 RK_PA7 RK_FUNC_GPIO &pcfg_pull_up>;
+		};
+	};
+};
+
+&rk_rga {
+	status = "okay";
+};
