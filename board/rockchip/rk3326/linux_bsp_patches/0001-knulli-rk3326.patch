+	    stride != BASE_JD_ATOM_V2_LEGACY_STRIDE) {
 		dev_err(kbdev->dev,
 			"Stride %u passed to job_submit isn't supported by the kernel\n", stride);
 		return -EINVAL;
@@ -1037,8 +1048,10 @@ int kbase_jd_submit(struct kbase_context *kctx, void __user *user_addr, u32 nr_a
