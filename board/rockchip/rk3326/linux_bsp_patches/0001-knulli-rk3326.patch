+		reset-gpios = <&gpio3 RK_PB7 GPIO_ACTIVE_LOW>;
+		/* moto-gpio and dcDet-gpio are board-specific GPIOs on gpio3 */
+		/* moto-gpios  = <&gpio3 RK_PA6 GPIO_ACTIVE_HIGH>; */
+		/* dcDet-gpios = <&gpio3 RK_PA5 GPIO_ACTIVE_HIGH>; */
+
+		panel-init-sequence = [
+			39 00 04 b9 f1 12 83
+			39 00 06 b1 00 00 00 da 80
+			39 00 04 b2 3c 12 30
+			39 00 0b b3 10 10 28 28 03 ff 00 00 00 00
