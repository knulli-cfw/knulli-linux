+				vactive = <720>;
+				hfront-porch = <140>;
+				hsync-len = <80>;
+				hback-porch = <140>;
+				vfront-porch = <20>;
+				vsync-len = <4>;
+				vback-porch = <20>;
+				hsync-active = <0>;
+				vsync-active = <0>;
