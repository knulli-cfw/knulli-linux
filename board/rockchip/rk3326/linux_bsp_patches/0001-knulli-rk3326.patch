-					   sizeof(struct base_jd_atom_v2)) != 0) {
+			/* Copy only as many bytes as the userspace atom carries.
+			 * For legacy 48-byte atoms the trailing padding[8] of the
+			 * kernel's base_jd_atom_v2 stays zero (zero-initialised above). */
+			if (copy_from_user(&user_atom.jc, user_addr, stride) != 0) {
 				dev_dbg(kbdev->dev,
 					"Invalid atom address %pK passed to job_submit\n",
 					user_addr);
