+	vccsys: vccsys {
+		compatible = "regulator-fixed";
+		regulator-name = "vcc3v8_sys";
+		regulator-always-on;
+		regulator-boot-on;
+		regulator-min-microvolt = <3800000>;
+		regulator-max-microvolt = <3800000>;
+	};
+
+	/*
+	 * GPIO-controlled panel power supply (gpio0 PB5, active-low).
+	 *
+	 * Do NOT add regulator-boot-on or regulator-always-on here.
+	 *
+	 * OGA uboot runs its DRM driver (330 Mbps HS) but fails to reserve
+	 * this GPIO, so vcc_mipi starts at SoC default (PB5 input/pull-up =
+	 * panel OFF).  If the kernel enables VCC at regulator-fixed probe time
+	 * (boot-on / always-on), the panel IC powers on while OGA uboot's HS
+	 * DSI signals are still on the data lanes — corrupting the ICNA3311's
+	 * LP receiver state and preventing it from responding to init commands.
+	 *
+	 * Without boot-on/always-on, the first regulator_enable() call comes
+	 * from panel_simple_prepare(), which runs after dw_mipi_dsi_pre_enable()
+	 * has reset the DSI+PHY and put all lanes in LP-11 stop state.  The
+	 * panel therefore powers on into a clean LP-11 environment.
+	 */
+	vcc_mipi: vcc-mipi-lcd0 {
+		compatible = "regulator-fixed";
+		regulator-name = "vcc_mipi_lcd0";
+		gpio = <&gpio0 RK_PB5 GPIO_ACTIVE_LOW>;
+
+		regulator-state-mem {
+			regulator-off-in-suspend;
+		};
+	};
+
