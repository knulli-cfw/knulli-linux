+/* Read fbcon=rotate:X from kernel command line (/proc/cmdline).
+   Returns -1 if not found, otherwise the rotation value (0-3). */
+static int KMSDRM_GetFbconRotation(void)
+{
+    FILE *fp;
+    char cmdline[4096];
+    char *p;
+    int rotation = -1;
+
+    fp = fopen("/proc/cmdline", "r");
+    if (!fp) {
+        return -1;
+    }
+
+    if (fgets(cmdline, sizeof(cmdline), fp)) {
+        /* Look for fbcon=rotate:X pattern */
+        p = SDL_strstr(cmdline, "fbcon=rotate:");
+        if (p) {
+            p += SDL_strlen("fbcon=rotate:");
+            rotation = SDL_atoi(p);
+            rotation = SDL_clamp(rotation, 0, 3);
+        }
+    }
+
+    fclose(fp);
+    return rotation;
+}
