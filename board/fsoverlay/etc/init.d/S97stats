#!/bin/sh

if test "$1" != "start"
then
	  exit 0
fi

stats=$(/usr/bin/knulli-settings-get system.telemetry)
if [ "$stats" = "0" ]; then
	echo "Telemetry disabled"
	exit 0
fi

# knulli-report-stats waits up to 5 x 60s for the network; don't hold up init
echo "Collecting device stats in the background"
knulli-report-stats >/dev/null 2>&1 &

