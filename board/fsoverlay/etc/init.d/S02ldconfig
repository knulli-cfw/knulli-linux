#!/bin/sh

case "$1" in
  start)
    # post-build ships the cache; rebuild only if missing or stale
    if [ -f /etc/ld.so.cache ] && ! [ /etc/ld.so.conf -nt /etc/ld.so.cache ]; then
      exit 0
    fi

    echo "Updating dynamic linker cache..."
    /sbin/ldconfig
    ;;
  *)
    echo "Usage: $0 {start}"
    exit 1
esac

exit 0
