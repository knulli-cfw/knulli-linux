#!/bin/bash

if [ "$1" != "start" ]; then
    exit 0
fi

CAPABILITIES_FILE="/boot/boot/knulli.board.capability"
BOARD_FILE="/boot/boot/knulli.board"
ARCH_FILE="/usr/share/knulli/knulli.arch"

# Get board and arch
read -r BOARD < "$BOARD_FILE" 2>/dev/null
read -r ARCH < "$ARCH_FILE" 2>/dev/null

# rk3326 ships one image for all its devices, so knulli.board holds the SoC.
# Its U-Boot detects the device from the SARADC and passes board=<hwrev> on the
# command line; prefer that when it is there.
CMDLINE_BOARD=$(sed -n 's/.*\bboard=\([^ ]*\).*/\1/p' /proc/cmdline 2>/dev/null)
if [ -n "$CMDLINE_BOARD" ]; then
    BOARD="$CMDLINE_BOARD"
fi

# Skip if already generated and board has not changed
if [ -f "$CAPABILITIES_FILE" ]; then
    STORED_BOARD=$(cut -d' ' -f1 "$CAPABILITIES_FILE")
    if [ "$BOARD" = "$STORED_BOARD" ]; then
        echo "Current board: "$BOARD". Capabilities already generated."
        exit 0
    fi
fi

# Define capabilities
declare -A BOARD_CAPABILITIES

case "$ARCH" in
    h700)
        BOARD_CAPABILITIES[rgb]="rg40xx-h rg40xx-v rg-cubexx"
        BOARD_CAPABILITIES[hdmi]="rg35xx-plus rg35xx-h rg35xx-2024 rg35xx-sp rg34xx-sp rg28xx rg40xx-h rg40xx-v rg-cubexx rg34xx rg35xx-pro"
        BOARD_CAPABILITIES[lid]="rg35xx-sp rg34xx-sp"
        BOARD_CAPABILITIES[wifi]="rg35xx-plus rg35xx-h rg35xx-sp rg34xx-sp rg40xx-h rg40xx-v rg-cubexx rg34xx rg35xx-pro"
        BOARD_CAPABILITIES[bluetooth]="rg35xx-plus rg35xx-h rg35xx-sp rg34xx-sp rg40xx-h rg40xx-v rg-cubexx rg34xx rg35xx-pro"
        BOARD_CAPABILITIES[analogstick]="rg35xx-h rg40xx-h rg40xx-v rg-cubexx rg34xx-sp rg35xx-pro"
        BOARD_CAPABILITIES[rumble]="rg35xx-plus rg35xx-h rg35xx-2024 rg35xx-sp rg34xx-sp rg28xx rg40xx-h rg40xx-v rg-cubexx rg34xx rg35xx-pro"
        BOARD_CAPABILITIES[adb]="rg35xx-plus rg35xx-h rg35xx-2024 rg35xx-sp rg34xx-sp rg28xx rg40xx-h rg40xx-v rg-cubexx rg34xx rg35xx-pro"
        BOARD_CAPABILITIES[hud]="rg35xx-plus rg35xx-h rg35xx-2024 rg35xx-sp rg34xx-sp rg28xx rg40xx-h rg40xx-v rg-cubexx rg34xx rg35xx-pro"
        BOARD_CAPABILITIES[pwrled]="rg35xx-plus rg35xx-h rg35xx-2024 rg35xx-sp rg34xx-sp rg28xx rg40xx-h rg40xx-v rg-cubexx rg34xx rg35xx-pro"
        ;;
    a133)
        BOARD_CAPABILITIES[rgb]="trimui-smart-pro trimui-brick trimui-brick-pro"
        BOARD_CAPABILITIES[lid]="powkiddy-v90s"
        BOARD_CAPABILITIES[wifi]="trimui-smart-pro trimui-brick trimui-brick-pro powkiddy-v90s powkiddy-v20 magicx-zero-28 magicx-zero-40"
        BOARD_CAPABILITIES[bluetooth]="trimui-smart-pro trimui-brick trimui-brick-pro powkiddy-v90s powkiddy-v20 magicx-zero-28 magicx-zero-40"
        BOARD_CAPABILITIES[analogstick]="trimui-smart-pro trimui-brick-pro magicx-zero-28"
        BOARD_CAPABILITIES[rumble]="trimui-smart-pro trimui-brick trimui-brick-pro powkiddy-v90s powkiddy-v20 magicx-zero-28 magicx-zero-40"
        BOARD_CAPABILITIES[adb]="trimui-smart-pro trimui-brick trimui-brick-pro powkiddy-v90s powkiddy-v20 magicx-zero-28 magicx-zero-40"
        BOARD_CAPABILITIES[hud]="trimui-smart-pro trimui-brick trimui-brick-pro powkiddy-v90s powkiddy-v20 magicx-zero-28 magicx-zero-40"
        BOARD_CAPABILITIES[toggleswitch]="trimui-smart-pro trimui-brick trimui-brick-pro"
        ;;
    rk3128)
        BOARD_CAPABILITIES[analogstick]="ps5000 ps7000"
        BOARD_CAPABILITIES[rumble]="ps5000 ps7000"
        BOARD_CAPABILITIES[adb]="powkiddy_a13 ps5000 ps7000"
        BOARD_CAPABILITIES[hud]="powkiddy_a13 ps5000 ps7000"
        ;;
    rk3326)
        # Names are hwrev values from the U-Boot SARADC table, not image names.
        BOARD_CAPABILITIES[analogstick]="r36s r36max batlexp-g350 gkd-pixel2 rppocket xf40h rg351v v10 v11 v10-go3"
        BOARD_CAPABILITIES[rumble]="r36s r36max batlexp-g350 gkd-pixel2 rppocket xf40h rg351v v10 v11 v10-go3"
        BOARD_CAPABILITIES[adb]="r36s r36max batlexp-g350 gkd-pixel2 rppocket xf40h rg351v v10 v11 v10-go3"
        BOARD_CAPABILITIES[hud]="r36s r36max batlexp-g350 gkd-pixel2 rppocket xf40h rg351v v10 v11 v10-go3"
        # Boards with a USB port separate from the charge input (G350, RPPocket and Pixel2 have one port)
        BOARD_CAPABILITIES[usbhost]="r36max xf40h r36s mymini magicx-mini-m"
        BOARD_CAPABILITIES[wifi]="xf40h r36max"
        ;;
    rk3568)
        # miyoo-flip lid hall now emits KEY_F12 via a gpio-keys node (decoupled from
        # the power button), so the lid works independently like rg-ds.
        BOARD_CAPABILITIES[lid]="rg-ds miyoo-flip"
        BOARD_CAPABILITIES[rgb]="miniloong"
        BOARD_CAPABILITIES[hdmi]="rg-arc-s powkiddy-x55 powkiddy-rgb30 miyoo-flip miniloong"
        BOARD_CAPABILITIES[wifi]="rg-arc-s powkiddy-x55 powkiddy-rgb30 miyoo-flip rg-ds miniloong"
        BOARD_CAPABILITIES[bluetooth]="rg-arc-s powkiddy-x55 powkiddy-rgb30 miyoo-flip rg-ds miniloong"
        BOARD_CAPABILITIES[analogstick]="powkiddy-x55 powkiddy-rgb30 rg-ds miniloong"
        BOARD_CAPABILITIES[rumble]="rg-arc-s powkiddy-x55 powkiddy-rgb30 rg-ds miniloong"
        BOARD_CAPABILITIES[adb]="rg-arc-s powkiddy-x55 powkiddy-rgb30 miyoo-flip rg-ds miniloong"
        BOARD_CAPABILITIES[hud]="rg-arc-s powkiddy-x55 powkiddy-rgb30 miyoo-flip rg-ds miniloong"
        BOARD_CAPABILITIES[rotatedpanel]="miniloong powkiddy-x55 rg-arc-s"
	BOARD_CAPABILITIES[pwrled]="rg-arc-s powkiddy-x55 powkiddy-rgb30 miyoo-flip rg-ds"
        ;;
    rk3576)
        BOARD_CAPABILITIES[rgb]="rg-vita-pro"
        BOARD_CAPABILITIES[hdmi]="rg-vita-pro"
        BOARD_CAPABILITIES[wifi]="rg-vita-pro"
        BOARD_CAPABILITIES[bluetooth]="rg-vita-pro"
        BOARD_CAPABILITIES[analogstick]="rg-vita-pro"
        BOARD_CAPABILITIES[rumble]="rg-vita-pro"
        BOARD_CAPABILITIES[adb]="rg-vita-pro"
        BOARD_CAPABILITIES[hud]="rg-vita-pro"
        BOARD_CAPABILITIES[fan]="rg-vita-pro"
        ;;
    sm8550)
        # knulli.board holds KNULLI_SUBTARGET, and sm8550 ships one image for all
        # its devices (unlike sm8250, which builds per device), so the board name
        # is the SoC itself.  Split this list per device if that ever changes.
        BOARD_CAPABILITIES[hdmi]="sm8550"
        BOARD_CAPABILITIES[wifi]="sm8550"
        BOARD_CAPABILITIES[bluetooth]="sm8550"
        BOARD_CAPABILITIES[analogstick]="sm8550"
        BOARD_CAPABILITIES[rumble]="sm8550"
        BOARD_CAPABILITIES[adb]="sm8550"
        BOARD_CAPABILITIES[hud]="sm8550"
        BOARD_CAPABILITIES[fan]="sm8550"
        ;;
    sm8250)
        BOARD_CAPABILITIES[rgb]="rp5 rpflip2 rpmini rpminiv2"
        BOARD_CAPABILITIES[hdmi]="rp5 rpflip2 rpmini rpminiv2"
        BOARD_CAPABILITIES[wifi]="rp5 rpflip2 rpmini rpminiv2"
        BOARD_CAPABILITIES[bluetooth]="rp5 rpflip2 rpmini rpminiv2"
        BOARD_CAPABILITIES[analogstick]="rp5 rpflip2 rpmini rpminiv2"
        BOARD_CAPABILITIES[rumble]="rp5 rpflip2 rpmini rpminiv2"
        BOARD_CAPABILITIES[adb]="rp5 rpflip2 rpmini rpminiv2"
        BOARD_CAPABILITIES[hud]="rp5 rpflip2 rpmini rpminiv2"
        BOARD_CAPABILITIES[fan]="rp5 rpflip2 rpmini rpminiv2"
        ;;
    a527)
        BOARD_CAPABILITIES[rgb]="trimui-smart-pro-s"
        BOARD_CAPABILITIES[wifi]="trimui-smart-pro-s"
        BOARD_CAPABILITIES[bluetooth]="trimui-smart-pro-s"
        BOARD_CAPABILITIES[analogstick]="trimui-smart-pro-s"
        BOARD_CAPABILITIES[rumble]="trimui-smart-pro-s"
        BOARD_CAPABILITIES[adb]="trimui-smart-pro-s"
        BOARD_CAPABILITIES[hud]="trimui-smart-pro-s"
        BOARD_CAPABILITIES[fan]="trimui-smart-pro-s"
        BOARD_CAPABILITIES[toggleswitch]="trimui-smart-pro-s"
        ;;
    t618)
        BOARD_CAPABILITIES[wifi]="t618"
        BOARD_CAPABILITIES[bluetooth]="t618"
        BOARD_CAPABILITIES[rumble]="t618"
        BOARD_CAPABILITIES[adb]="t618"
        BOARD_CAPABILITIES[hud]="t618"
	;;
    *)
        echo "Unknown ARCH: $ARCH — skipping."
        exit 0
        ;;
esac

# Parse associative array for matching capabilities
CAPS=()
for CAP in "${!BOARD_CAPABILITIES[@]}"; do
    for B in ${BOARD_CAPABILITIES[$CAP]}; do
        if [ "$BOARD" = "$B" ]; then
            CAPS+=("$CAP")
            break
        fi
    done
done

if [ ${#CAPS[@]} -eq 0 ]; then
    echo "No known capabilities for board "$BOARD". Skipping generation."
    exit 0
fi

# mount /boot rw to write
mount -o remount,rw /boot

echo "Generating capabilities for: "$BOARD""
echo "$BOARD ${CAPS[*]}" > "$CAPABILITIES_FILE"
sync
echo "Done."

# mount back to read only
mount -o remount,ro /boot
