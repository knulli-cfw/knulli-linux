#!/bin/sh

if test "$1" != "start"
then
  exit 0
fi

printf "Starting securepasswd: "

# /etc/shadow is dynamically generated from the password found in /boot/knulli-boot.conf
# the password is visible only in the es interface
# or to people having already a ssh password via the command : knulli-config setRootPassword xyz
MASTERPASSWD=$(knulli-config getRootPassword)
if test -z "${MASTERPASSWD}"
then
    # generate a new one
    # hum, in case of error, what to do ? nothing.
    knulli-config setRootPassword
    MASTERPASSWD=$(knulli-config getRootPassword)
fi

# secure ssh
enabled="$(/usr/bin/knulli-settings-get system.security.enabled)"
if [ "$enabled" != "1" ];then
    MASTERPASSWD="linux"
fi
  
# write the /etc/shadow file
SHADOWPASSWD=$(openssl passwd -1 "${MASTERPASSWD}")
echo "root:${SHADOWPASSWD}:::::::" > /run/knulli.shadow
echo "knulli::::::::" >> /run/knulli.shadow # required for su for flatpak/knulli user

# secure samba
mkdir -p "/var/lib/samba/private"
printf "$MASTERPASSWD\n$MASTERPASSWD\n" | nice -n 19 smbpasswd -a -s root > /dev/null

echo "done."
