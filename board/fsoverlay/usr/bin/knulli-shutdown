#!/bin/sh

SHUTDOWN_FLAG="/var/run/shutdown.flag"
REBOOT_FLAG="/boot/restart.flag"

check_ingame() {
    HTTP_STATUS=$(curl -s -o /dev/null -w "%{http_code}" "http://localhost:1234/runningGame")
    test $? != 0                 && return 0
    test "${HTTP_STATUS}" != 201 && return 0 # in game
    return 1  # 201 when not in game
}

do_poweroff() {
    POWEROFF=$1

    touch "$SHUTDOWN_FLAG" # So the system or any scripts can tell if the shutdown sequence has started

    # If ES is paused things will stall during shutdown
    /etc/init.d/S31emulationstation resume

    # Lets hide what happens from the user during shutdown/reboot to make for a more seemless experience
    knulli-brightness dispoff
    knulli-audio setSystemVolume mute

    if check_ingame; then
        knulli-es-swissknife --emukill >/dev/null 2>&1
    fi

    # Gets the fan daemon to exit early and set fan to max speed during shutdown process as an extra safety measure
    if knulli-board-capability "fan" && [ -f /etc/init.d/S06fan-control-daemon ]; then
        /etc/init.d/S06fan-control-daemon stop
    fi

    if knulli-board-capability "rgb"; then
        led_enabled=$(knulli-settings-get "led.enabled")
        if [ "$led_enabled" = "1" ]; then
            curl -fsS --connect-timeout 1 --max-time 1 "http://127.0.0.1:1235/kill" >/dev/null 2>&1
        fi
    fi

    if [ "$POWEROFF" = "reboot" ]; then
        mount -o remount,rw /boot
        touch "$REBOOT_FLAG" # So the system knows if it's restart or cold boot for the charging binary in rcS
        sync
        mount -o remount,ro /boot
        shutdown -r now
    else
        sync

        # Start a background process that waits for a timeout duration before forcing shutdown
        ( sleep 20 && reboot -f -p ) &

        # Try a clean shutdown
        shutdown -Ph now

        # If we reach this point, the shutdown was successful and we can kill the background job
        kill $!
    fi
}

case "$1" in
    -s|--shutdown)
        echo "Shutting down the system..."
        do_poweroff
        ;;
    -r|--reboot)
        echo "Rebooting the system..."
        do_poweroff reboot
        ;;
    *)
        echo "Invalid option."
        echo "Usage:"
        echo "  -s, --shutdown"
        echo "  -r, --reboot"
        exit 1
        ;;
esac

exit 0
