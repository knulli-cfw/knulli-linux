#!/bin/sh

CAPABILITIES_FILE="/boot/boot/knulli.board.capability"
CAPABILITY="$1"

[ -z "$CAPABILITY" ] && {
    echo "Usage: $0 <rgb|lid|hdmi|wifi|bluetooth|analogstick|rumble|adb|bezelproject|rotatedpanel|usbhost>"
    exit 1
}

if [ -f "$CAPABILITIES_FILE" ] && grep -qw "$CAPABILITY" "$CAPABILITIES_FILE"; then
    echo "true"
    exit 0
fi

echo "false"
exit 1
