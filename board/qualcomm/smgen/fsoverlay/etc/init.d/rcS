#!/bin/sh

# Start all init scripts in /etc/init.d
# executing them in numerical order.
#
# One image serves every Qualcomm SM device: knulli.board holds the device
# name derived from the device tree model, not the arch.  Re-derive it on
# every boot -- a card moved to another device keeps the old name otherwise.
# Everything per-device downstream keys on that name.
read -r BOARD < /boot/boot/knulli.board
NEW_BOARD="$(/usr/bin/knulli-qcom-board)"
if [ -n "$NEW_BOARD" ] && [ "$NEW_BOARD" != "$BOARD" ]; then
    mount -o remount,rw /boot
    echo "$NEW_BOARD" > /boot/boot/knulli.board
    sync
    mount -o remount,ro /boot
fi

# Boot progress bar straight to /dev/fb0 (args per model in /etc/progressbar_rk.conf)
if [ -f /etc/progressbar_rk.conf ] && [ -x /usr/bin/progressbar_rk ]; then
    PB_RK_ARGS=""
    . /etc/progressbar_rk.conf
    /usr/bin/progressbar_rk $PB_RK_ARGS &
fi

for i in /etc/init.d/S??* ; do

    # Ignore dangling symlinks (if any).
    [ ! -f "$i" ] && continue

    # Update status for progress bar
    echo "$i" > /tmp/status.txt

    case "$i" in
        *.sh)
            # Source shell script for speed.
            (
                trap - INT QUIT TSTP
                set start
                . $i
            ) &
            ;;
        *)
            case "$i" in
                # S11qcom-audio restarts PipeWire once the (possibly late) sound
                # card is up; ES at S31 must not start before that or it keeps a
                # dead connection to the old server (no sound, no volume popup).
                *S00bootcustom | *S01dbus | *S02resize | *S03modules | *S04populate | *S05udev | *S06audio | *S06modprobe | *S11qcom-audio | *S11share | *S12populateshare) # Don't run these in background
                    $i start
                    ;;
                *)
                    $i start &
                    ;;
            esac
            ;;
    esac

    echo QUIT > /tmp/status.txt
    echo $(date +"%F %T,%3N")": ${i} - started" >> /var/run/boot.log
done

exit 0
