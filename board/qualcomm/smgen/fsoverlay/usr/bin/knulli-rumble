#!/bin/sh

# We only want to run the script if the board has rumble capability
if ! knulli-board-capability "rumble"; then
    exit 1
fi

# Ensure correct number of arguments
if [ $# -lt 1 ] || ! printf '%s\n' "$1" | grep -Eq '^[0-9]*\.?[0-9]+$' || \
   ! awk "BEGIN{exit !($1 > 0)}" >/dev/null 2>&1; then
  echo "Usage: $0 <duration>"
  echo "Duration must be a positive integer or floating point number greater than 0."
  exit 1
fi

RUMBLE_FILE="/usr/bin/ff-rumble"
DURATION="$1"
MAG=""
DEVICE_NAME=""

BOARD_FILE="/boot/boot/knulli.board"
read -r BOARD < "$BOARD_FILE" 2>/dev/null

case "$BOARD" in
  rpnova|rp6|odin2|odin2mini|odin2portal|thor|pocketace|pocketdmg|pocketds|pocketevo|pockets1k|pockets2k|pocketsmini)
    # sm8550: the PMIC haptics block, driven through force-feedback
    DEVICE_NAME="qcom-hv-haptics"
    MAG=100
    awk -v d="$DURATION" 'BEGIN{ exit (d+0 < 0.2) ? 0 : 1 }' >/dev/null 2>&1 && DURATION="0.2"
    ;;
  rp5)
    DEVICE_NAME="spmi_haptics"
    MAG=100
    # Clamp to at least 0.2s so the pulse is felt
    awk -v d="$DURATION" 'BEGIN{ exit (d+0 < 0.2) ? 0 : 1 }' >/dev/null 2>&1 && DURATION="0.2"
    ;;
  rg55g1|rpclassic)
    # pm7250b vibrator, qcom pm8xxx-vibrator driver (name unverified on hardware)
    DEVICE_NAME="pm8xxx_vib_ffmemless"
    MAG=100
    awk -v d="$DURATION" 'BEGIN{ exit (d+0 < 0.2) ? 0 : 1 }' >/dev/null 2>&1 && DURATION="0.2"
    ;;
  *)
    ;;
esac

# Find the matching /dev/input/eventX node
EVENT_NODE=$(
  awk -v RS= -v name="$DEVICE_NAME" '
    $0 ~ "N: Name=\""name"\"" && $0 ~ /FF=/ {
      if (match($0, /H: Handlers=.*(event[0-9]+)/, m)) { print m[1]; exit }
    }' /proc/bus/input/devices
)

[ -n "$EVENT_NODE" ] || { echo "No rumble device found for $DEVICE_NAME" >&2; exit 1; }

exec "$RUMBLE_FILE" "$EVENT_NODE" "$DURATION" ${MAG:+$MAG}

exit 0
