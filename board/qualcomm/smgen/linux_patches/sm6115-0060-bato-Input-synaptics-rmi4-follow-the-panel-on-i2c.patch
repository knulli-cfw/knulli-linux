MERGE NOTE (knulli unified series): merged with sm8550 0030 (rmi4 reset gpio): the optional reset pulse now lives in rmi_i2c_power_up() after the startup delay so both the direct and the panel-follower bring-up paths run it; syna,reset-delay-ms is read in probe.

Subject: [PATCH] Input: synaptics-rmi4 - follow the panel on i2c
From: Daniel Martin <dmanlfc@gmail.com>
Date: Thu, 24 Sep 2026 19:45:18 +1000

On a TDDI such as the Synaptics TD4310 the touch controller and the LCD
driver are one chip that the panel driver holds in reset until prepare
and hard resets on every prepare. Probing the touch before that fails,
and the soft reset the RMI4 core sends at probe or any time after the
panel is up wipes the display initialisation.

When the touchscreen node carries a panel phandle, make the i2c transport
a panel follower: bring the sensor up from a work item once the panel is
prepared, skip the redundant soft reset, treat every later prepare as a
device reset so the functions get reconfigured, and suspend it before the
panel is unprepared. System sleep is then handled by the panel sequence.

Signed-off-by: Daniel Martin <dmanlfc@gmail.com>
---
 drivers/input/rmi4/Kconfig   |   1 +
 drivers/input/rmi4/rmi_i2c.c | 152 +++++++++++++++++++++++++++++++++++-------
 2 files changed, 128 insertions(+), 25 deletions(-)
diff --git a/drivers/input/rmi4/Kconfig b/drivers/input/rmi4/Kconfig
index 5db58fc9e..15f7534d6 100644
--- a/drivers/input/rmi4/Kconfig
+++ b/drivers/input/rmi4/Kconfig
@@ -16,6 +16,7 @@ if RMI4_CORE
 config RMI4_I2C
 	tristate "RMI4 I2C Support"
 	depends on I2C
+	depends on DRM || !DRM
 	help
 	  Say Y here if you want to support RMI4 devices connected to an I2C
 	  bus.
diff --git a/drivers/input/rmi4/rmi_i2c.c b/drivers/input/rmi4/rmi_i2c.c
index 2028fb09a..9a4470464 100644
--- a/drivers/input/rmi4/rmi_i2c.c
+++ b/drivers/input/rmi4/rmi_i2c.c
@@ -10,6 +10,8 @@
 #include <linux/of.h>
 #include <linux/delay.h>
 #include <linux/regulator/consumer.h>
+#include <linux/workqueue.h>
+#include <drm/drm_panel.h>
 #include "rmi_driver.h"
 
 #define BUFFER_SIZE_INCREMENT 32
@@ -44,6 +46,10 @@ struct rmi_i2c_xport {
 	struct gpio_desc *reset_gpio;
 	u32 startup_delay;
 	u32 reset_delay;
+	bool powered;
+
+	struct drm_panel_follower panel_follower;
+	struct work_struct panel_work;
 };
 
 #define RMI_PAGE_SELECT_REGISTER 0xff
@@ -179,6 +185,21 @@ static const struct rmi_transport_ops rmi_i2c_ops = {
 	.read_block	= rmi_i2c_read_block,
 };
 
+/*
+ * A panel follower is brought up right after the panel driver has hard
+ * reset the shared TDDI, so the soft reset would only wipe the display.
+ */
+static int rmi_i2c_panel_reset(struct rmi_transport_dev *xport, u16 reset_addr)
+{
+	return 0;
+}
+
+static const struct rmi_transport_ops rmi_i2c_panel_ops = {
+	.write_block	= rmi_i2c_write_block,
+	.read_block	= rmi_i2c_read_block,
+	.reset		= rmi_i2c_panel_reset,
+};
+
 #ifdef CONFIG_OF
 static const struct of_device_id rmi_i2c_of_match[] = {
 	{ .compatible = "syna,rmi4-i2c" },
@@ -187,12 +208,44 @@ static const struct of_device_id rmi_i2c_of_match[] = {
 MODULE_DEVICE_TABLE(of, rmi_i2c_of_match);
 #endif
 
-static void rmi_i2c_regulator_bulk_disable(void *data)
+static int rmi_i2c_power_up(struct rmi_i2c_xport *rmi_i2c)
 {
-	struct rmi_i2c_xport *rmi_i2c = data;
+	int error;
+
+	if (rmi_i2c->powered)
+		return 0;
+
+	error = regulator_bulk_enable(ARRAY_SIZE(rmi_i2c->supplies),
+				      rmi_i2c->supplies);
+	if (error)
+		return error;
+
+	rmi_i2c->powered = true;
+	msleep(rmi_i2c->startup_delay);
+
+	if (rmi_i2c->reset_gpio) {
+		gpiod_set_value_cansleep(rmi_i2c->reset_gpio, 0);
+		usleep_range(10000, 20000);
+		gpiod_set_value_cansleep(rmi_i2c->reset_gpio, 1);
+		msleep(rmi_i2c->reset_delay ?: DEFAULT_RESET_DELAY_MS);
+	}
+
+	return 0;
+}
+
+static void rmi_i2c_power_down(struct rmi_i2c_xport *rmi_i2c)
+{
+	if (!rmi_i2c->powered)
+		return;
 
 	regulator_bulk_disable(ARRAY_SIZE(rmi_i2c->supplies),
 			       rmi_i2c->supplies);
+	rmi_i2c->powered = false;
+}
+
+static void rmi_i2c_regulator_bulk_disable(void *data)
+{
+	rmi_i2c_power_down(data);
 }
 
 static void rmi_i2c_unregister_transport(void *data)
@@ -200,8 +253,98 @@ static void rmi_i2c_unregister_transport(void *data)
 	struct rmi_i2c_xport *rmi_i2c = data;
 
 	rmi_unregister_transport_device(&rmi_i2c->xport);
+	rmi_i2c->xport.rmi_dev = NULL;
+}
+
+static int rmi_i2c_register(struct rmi_i2c_xport *rmi_i2c)
+{
+	struct i2c_client *client = rmi_i2c->client;
+	int error;
+
+	/*
+	 * Setting the page to zero will (a) make sure the PSR is in a
+	 * known state, and (b) make sure we can talk to the device.
+	 */
+	error = rmi_set_page(rmi_i2c, 0);
+	if (error) {
+		dev_err(&client->dev, "Failed to set page select to 0\n");
+		return error;
+	}
+
+	dev_info(&client->dev, "registering I2C-connected sensor\n");
+
+	error = rmi_register_transport_device(&rmi_i2c->xport);
+	if (error) {
+		dev_err(&client->dev, "failed to register sensor: %d\n", error);
+		return error;
+	}
+
+	return devm_add_action_or_reset(&client->dev,
+					rmi_i2c_unregister_transport, rmi_i2c);
 }
 
+static void rmi_i2c_panel_work(struct work_struct *work)
+{
+	struct rmi_i2c_xport *rmi_i2c =
+		container_of(work, struct rmi_i2c_xport, panel_work);
+	struct device *dev = &rmi_i2c->client->dev;
+	int error;
+
+	error = rmi_i2c_power_up(rmi_i2c);
+	if (error) {
+		dev_warn(dev, "Failed to power up: %d\n", error);
+		return;
+	}
+
+	if (rmi_i2c->xport.rmi_dev) {
+		struct rmi_device *rmi_dev = rmi_i2c->xport.rmi_dev;
+
+		/* the panel driver hard reset the chip, so treat it as a reset */
+		error = rmi_driver_resume(rmi_dev, false);
+		if (!error)
+			error = rmi_dev->driver->reset_handler(rmi_dev);
+	} else {
+		error = rmi_i2c_register(rmi_i2c);
+	}
+	if (error)
+		dev_warn(dev, "Failed to bring up sensor: %d\n", error);
+}
+
+static int rmi_i2c_panel_prepared(struct drm_panel_follower *follower)
+{
+	struct rmi_i2c_xport *rmi_i2c =
+		container_of(follower, struct rmi_i2c_xport, panel_follower);
+
+	schedule_work(&rmi_i2c->panel_work);
+
+	return 0;
+}
+
+static int rmi_i2c_panel_unpreparing(struct drm_panel_follower *follower)
+{
+	struct rmi_i2c_xport *rmi_i2c =
+		container_of(follower, struct rmi_i2c_xport, panel_follower);
+	int error;
+
+	cancel_work_sync(&rmi_i2c->panel_work);
+
+	if (rmi_i2c->xport.rmi_dev) {
+		error = rmi_driver_suspend(rmi_i2c->xport.rmi_dev, false);
+		if (error)
+			dev_warn(&rmi_i2c->client->dev,
+				 "Failed to suspend device: %d\n", error);
+	}
+
+	rmi_i2c_power_down(rmi_i2c);
+
+	return 0;
+}
+
+static const struct drm_panel_follower_funcs rmi_i2c_panel_follower_funcs = {
+	.panel_prepared		= rmi_i2c_panel_prepared,
+	.panel_unpreparing	= rmi_i2c_panel_unpreparing,
+};
+
 static int rmi_i2c_probe(struct i2c_client *client)
 {
 	struct rmi_device_platform_data *pdata;
@@ -248,11 +391,6 @@ static int rmi_i2c_probe(struct i2c_client *client)
 	if (error < 0)
 		return error;
 
-	error = regulator_bulk_enable(ARRAY_SIZE(rmi_i2c->supplies),
-				       rmi_i2c->supplies);
-	if (error < 0)
-		return error;
-
 	error = devm_add_action_or_reset(&client->dev,
 					  rmi_i2c_regulator_bulk_disable,
 					  rmi_i2c);
@@ -261,17 +399,8 @@ static int rmi_i2c_probe(struct i2c_client *client)
 
 	of_property_read_u32(client->dev.of_node, "syna,startup-delay-ms",
 			     &rmi_i2c->startup_delay);
-
-	msleep(rmi_i2c->startup_delay);
-
-	if (rmi_i2c->reset_gpio) {
-		of_property_read_u32(client->dev.of_node, "syna,reset-delay-ms",
-				     &rmi_i2c->reset_delay);
-		gpiod_set_value_cansleep(rmi_i2c->reset_gpio, 0);
-		usleep_range(10000, 20000);
-		gpiod_set_value_cansleep(rmi_i2c->reset_gpio, 1);
-		msleep(rmi_i2c->reset_delay ?: DEFAULT_RESET_DELAY_MS);
-	}
+	of_property_read_u32(client->dev.of_node, "syna,reset-delay-ms",
+			     &rmi_i2c->reset_delay);
 
 	rmi_i2c->client = client;
 	mutex_init(&rmi_i2c->page_mutex);
@@ -282,31 +411,19 @@ static int rmi_i2c_probe(struct i2c_client *client)
 
 	i2c_set_clientdata(client, rmi_i2c);
 
-	/*
-	 * Setting the page to zero will (a) make sure the PSR is in a
-	 * known state, and (b) make sure we can talk to the device.
-	 */
-	error = rmi_set_page(rmi_i2c, 0);
-	if (error) {
-		dev_err(&client->dev, "Failed to set page select to 0\n");
-		return error;
-	}
-
-	dev_info(&client->dev, "registering I2C-connected sensor\n");
-
-	error = rmi_register_transport_device(&rmi_i2c->xport);
-	if (error) {
-		dev_err(&client->dev, "failed to register sensor: %d\n", error);
-		return error;
+	if (drm_is_panel_follower(&client->dev)) {
+		rmi_i2c->xport.ops = &rmi_i2c_panel_ops;
+		INIT_WORK(&rmi_i2c->panel_work, rmi_i2c_panel_work);
+		rmi_i2c->panel_follower.funcs = &rmi_i2c_panel_follower_funcs;
+		return devm_drm_panel_add_follower(&client->dev,
+						   &rmi_i2c->panel_follower);
 	}
 
-	error = devm_add_action_or_reset(&client->dev,
-					  rmi_i2c_unregister_transport,
-					  rmi_i2c);
+	error = rmi_i2c_power_up(rmi_i2c);
 	if (error)
 		return error;
 
-	return 0;
+	return rmi_i2c_register(rmi_i2c);
 }
 
 static int rmi_i2c_suspend(struct device *dev)
@@ -315,6 +432,9 @@ static int rmi_i2c_suspend(struct device *dev)
 	struct rmi_i2c_xport *rmi_i2c = i2c_get_clientdata(client);
 	int ret;
 
+	if (drm_is_panel_follower(dev))
+		return 0;
+
 	ret = rmi_driver_suspend(rmi_i2c->xport.rmi_dev, true);
 	if (ret)
 		dev_warn(dev, "Failed to resume device: %d\n", ret);
@@ -331,6 +451,9 @@ static int rmi_i2c_resume(struct device *dev)
 	struct rmi_i2c_xport *rmi_i2c = i2c_get_clientdata(client);
 	int ret;
 
+	if (drm_is_panel_follower(dev))
+		return 0;
+
 	ret = regulator_bulk_enable(ARRAY_SIZE(rmi_i2c->supplies),
 				    rmi_i2c->supplies);
 	if (ret)
@@ -351,6 +474,9 @@ static int rmi_i2c_runtime_suspend(struct device *dev)
 	struct rmi_i2c_xport *rmi_i2c = i2c_get_clientdata(client);
 	int ret;
 
+	if (drm_is_panel_follower(dev))
+		return 0;
+
 	ret = rmi_driver_suspend(rmi_i2c->xport.rmi_dev, false);
 	if (ret)
 		dev_warn(dev, "Failed to resume device: %d\n", ret);
@@ -367,6 +493,9 @@ static int rmi_i2c_runtime_resume(struct device *dev)
 	struct rmi_i2c_xport *rmi_i2c = i2c_get_clientdata(client);
 	int ret;
 
+	if (drm_is_panel_follower(dev))
+		return 0;
+
 	ret = regulator_bulk_enable(ARRAY_SIZE(rmi_i2c->supplies),
 				    rmi_i2c->supplies);
 	if (ret)
