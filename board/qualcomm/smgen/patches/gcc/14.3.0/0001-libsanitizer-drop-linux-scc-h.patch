libsanitizer: drop the linux/scc.h dependency

linux/scc.h is the AX.25 SCC driver's UAPI header.  It is gone from the 7.1
kernel headers this board builds against, so host-gcc-final stops at:

  sanitizer_platform_limits_posix.cpp:154:10: fatal error: linux/scc.h:
                                              No such file or directory

Nothing consumes what it provided: struct_scc_modem_sz and struct_scc_stat_sz
are defined in the .cpp, declared in the .h, and referenced from neither the
ioctl tables nor anywhere else in libsanitizer.  Remove the include and both
sizes, which is what upstream did when the header was retired.

Scoped to this board's BR2_GLOBAL_PATCH_DIR and to gcc 14.3.0: it is only
needed where the kernel headers are new enough to have dropped scc.h, and
sm8550 is the only knulli target on 7.1 today.

--- a/libsanitizer/sanitizer_common/sanitizer_platform_limits_posix.cpp
+++ b/libsanitizer/sanitizer_common/sanitizer_platform_limits_posix.cpp
@@ -151,7 +151,6 @@
 #include <linux/lp.h>
 #include <linux/mroute.h>
 #include <linux/mroute6.h>
-#include <linux/scc.h>
 #include <linux/serial.h>
 #include <sys/msg.h>
 #include <sys/ipc.h>
@@ -517,8 +516,6 @@
   unsigned struct_kbsentry_sz = sizeof(struct kbsentry);
   unsigned struct_mtconfiginfo_sz = sizeof(struct mtconfiginfo);
   unsigned struct_nr_parms_struct_sz = sizeof(struct nr_parms_struct);
-  unsigned struct_scc_modem_sz = sizeof(struct scc_modem);
-  unsigned struct_scc_stat_sz = sizeof(struct scc_stat);
   unsigned struct_serial_multiport_struct_sz
       = sizeof(struct serial_multiport_struct);
   unsigned struct_serial_struct_sz = sizeof(struct serial_struct);
--- a/libsanitizer/sanitizer_common/sanitizer_platform_limits_posix.h
+++ b/libsanitizer/sanitizer_common/sanitizer_platform_limits_posix.h
@@ -1041,8 +1041,6 @@
 extern unsigned struct_kbsentry_sz;
 extern unsigned struct_mtconfiginfo_sz;
 extern unsigned struct_nr_parms_struct_sz;
-extern unsigned struct_scc_modem_sz;
-extern unsigned struct_scc_stat_sz;
 extern unsigned struct_serial_multiport_struct_sz;
 extern unsigned struct_serial_struct_sz;
 extern unsigned struct_sockaddr_ax25_sz;
