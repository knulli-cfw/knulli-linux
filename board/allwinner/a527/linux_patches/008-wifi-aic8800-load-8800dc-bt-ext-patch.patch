Subject: [PATCH] wifi: aic8800: support newer 8800dc firmware

The Nov 2024 8800dc bt patch table has two more info pairs (ext patch
count and its id/address): the old unpack overflowed the stack struct
(stack-protector panic in aicbsp_8800dc_fw_init), the ext patch was never
loaded (no hci0) and the table loader wrote the ext pairs as registers.
Unpack and load them as the radxa-pkg driver does. The 8800dc/dw
firmware also clears the wakeup bit rather than setting sleep bit 4.
---
--- a/bsp/drivers/net/wireless/aic8800/aic8800_bsp/aic_bsp_driver.c
+++ b/bsp/drivers/net/wireless/aic8800/aic8800_bsp/aic_bsp_driver.c
@@ -641,9 +641,21 @@
 
 	for (p = head; p != NULL; p = p->next) {
 		if (AICBT_PT_INF == p->type) {
-			patch_info->info_len = p->len;
-			if (patch_info->info_len > 0) {
-				memcpy(&patch_info->adid_addrinf, p->data, patch_info->info_len * sizeof(uint32_t) * 2);
+			/* base pairs, then ext patch count and one (id, addr) pair per ext patch */
+			int base = (offsetof(struct aicbt_patch_info_t, ext_patch_nb_addr) -
+				    offsetof(struct aicbt_patch_info_t, adid_addrinf)) / 8;
+			int len = min_t(int, p->len, base + 1);
+
+			patch_info->info_len = min_t(int, p->len, base);
+			if (len > 0) {
+				memcpy(&patch_info->adid_addrinf, p->data, len * 8);
+				if (p->len > base + 1)
+					patch_info->ext_patch_nb = min_t(u32, patch_info->ext_patch_nb, p->len - base - 1);
+				else
+					patch_info->ext_patch_nb = 0;
+				patch_info->ext_patch_param = p->data + len * 2;
+				/* keep the table loader from writing the ext pairs as registers */
+				p->len = patch_info->info_len;
 				ret = 0;
 			}
 		}
@@ -691,7 +703,7 @@
 			data += 2;
 		}
 		if (p->type == AICBT_PT_PWRON)
-			udelay(500);
+			mdelay(100);
 	}
 	return 0;
 }
--- a/bsp/drivers/net/wireless/aic8800/aic8800_bsp/aic_bsp_driver.h
+++ b/bsp/drivers/net/wireless/aic8800/aic8800_bsp/aic_bsp_driver.h
@@ -413,6 +413,10 @@
 	uint32_t reset_val;
 	uint32_t adid_flag_addr;
 	uint32_t adid_flag;
+	/* newer patch tables: extra bt patch files */
+	uint32_t ext_patch_nb_addr;
+	uint32_t ext_patch_nb;
+	uint32_t *ext_patch_param;
 };
 
 struct aicbsp_firmware {
--- a/bsp/drivers/net/wireless/aic8800/aic8800_bsp/aic_bsp_8800dc.c
+++ b/bsp/drivers/net/wireless/aic8800/aic8800_bsp/aic_bsp_8800dc.c
@@ -860,6 +860,8 @@
 		.adid_flag_addr    = 0,
 		.adid_flag         = 0,
 	};
+	char ext_name[64];
+	int i;
 
 	struct aicbt_info_t aicbt_info = {
 		.btmode        = AICBT_BTMODE_BT_WIFI_COMBO,
@@ -906,6 +908,21 @@
 	if (ret)
 		goto err;
 
+	if (patch_info.ext_patch_nb) {
+		rwnx_send_dbg_mem_write_req(aicdev, 0x40506004, 0x04318000);
+		rwnx_send_dbg_mem_write_req(aicdev, 0x40506004, 0x04338000);
+	}
+	for (i = 0; i < patch_info.ext_patch_nb; i++) {
+		const char *bt_patch = aicbsp_firmware_list[aicbsp_info.cpmode].bt_patch;
+
+		/* <bt_patch>_ext<id>.bin, loaded at the table's address */
+		snprintf(ext_name, sizeof(ext_name), "%.*s_ext%u.bin",
+			 (int)(strlen(bt_patch) - 4), bt_patch, patch_info.ext_patch_param[i * 2]);
+		ret = rwnx_plat_bin_fw_upload_android(aicdev, patch_info.ext_patch_param[i * 2 + 1], ext_name);
+		if (ret)
+			goto err;
+	}
+
 	ret = aicbt_patch_table_load(aicdev, &aicbt_info, head);
 	if (ret)
 		printk("aicbt_patch_table_load fail\n");
--- a/bsp/drivers/net/wireless/aic8800/aic8800_fdrv/aicwf_sdio.c
+++ b/bsp/drivers/net/wireless/aic8800/aic8800_fdrv/aicwf_sdio.c
@@ -541,6 +541,12 @@
 	}
 
 	if (sdiodev->state == SDIO_SLEEP_ST) {
+		/* 8800dc/dw firmware clears the wakeup bit instead of setting sleep bit 4 */
+		bool dc = sdiodev->rwnx_hw->chipid == PRODUCT_ID_AIC8800DC ||
+			  sdiodev->rwnx_hw->chipid == PRODUCT_ID_AIC8800DW;
+
+		if (dc)
+			write_retry = 1;
 		sdio_info("w\n");
 		while (write_retry) {
 			ret = aicwf_sdio_writeb(sdiodev, sdiodev->sdio_reg.wakeup_reg, wakeup_reg_val);
@@ -548,13 +554,14 @@
 				txrx_err("sdio wakeup fail\n");
 				ret = -1;
 			} else {
-				read_retry = 10;
+				read_retry = dc ? 50 : 10;
 				while (read_retry) {
 					u8 val;
-					ret = aicwf_sdio_readb(sdiodev, sdiodev->sdio_reg.sleep_reg, &val);
+					ret = aicwf_sdio_readb(sdiodev, dc ? sdiodev->sdio_reg.wakeup_reg :
+							       sdiodev->sdio_reg.sleep_reg, &val);
 					if (ret < 0)
 						txrx_err("sdio wakeup read fail\n");
-					else if (val & 0x10) {
+					else if (dc ? !(val & 0x1) : (val & 0x10)) {
 						break;
 					}
 					read_retry--;
