#!/bin/sh

# We need to load the mali driver before progressbar can work
insmod /lib/modules/5.15.147/mali_kbase.ko

# Start the progress bar; the TSP-S panel is portrait (fb 720x1280), which
# progressbar_rk turns, with the landscape splash logo turned along
read -r BOARD < /boot/boot/knulli.board
case "$BOARD" in
    trimui-smart-pro-s)
        /usr/bin/progressbar_rk --pan --logo /usr/share/knulli/splash/boot-logo-1280x720.png & ;;
    *)                  /usr/bin/progressbar & ;;
esac

# Start all init scripts in /etc/init.d
# executing them in numerical order.
#
for i in /etc/init.d/S??* ; do

    # Ignore dangling symlinks (if any).
    [ ! -f "$i" ] && continue

    # Update status for progress bar
    echo "$i" > /tmp/status.txt

    case "$i" in
        *.sh)
            # Source shell script for speed.
            (
                trap - INT QUIT TSTP
                set start
                . $i
            ) &
            ;;
        *)
            case "$i" in
                *S00bootcustom | *S01dbus | *S02resize | *S03modules | *S04populate | *S05udev | *S06audio | *S06modprobe | *S11share | *S12populateshare) # Don't run these in background
                    $i start
                    ;;
                *)
                    $i start &
                    ;;
            esac
            ;;
    esac

    echo $(date +"%F %T,%3N")": ${i} - started" >> /var/run/boot.log
done

echo QUIT > /tmp/status.txt

exit 0
