diff -urN base/drivers/video/fbdev/sunxi/disp2/disp/lcd/fog_fj035fhd05_v1.c new/drivers/video/fbdev/sunxi/disp2/disp/lcd/fog_fj035fhd05_v1.c
--- a/drivers/video/fbdev/sunxi/disp2/disp/lcd/fog_fj035fhd05_v1.c	1970-01-01 00:00:00.000000000 +0000
+++ b/drivers/video/fbdev/sunxi/disp2/disp/lcd/fog_fj035fhd05_v1.c	2026-09-24 18:24:57.935430618 +0000
@@ -0,0 +1,349 @@
+/*
+ * disp2 panel driver for the Anbernic H700 handhelds (lcd_driver_name
+ * "fog_fj035fhd05_v1", "rg34xx_v1" and "rg34xxsp_v1" in the vendor device
+ * trees).
+ *
+ * The panels are RGB (DPI) panels configured over a bit-banged 3-wire SPI
+ * bus (9-bit words, D/C bit first) on lcd_gpio_0..4:
+ *   lcd_gpio_0  SCK        lcd_gpio_3  reset, active low
+ *   lcd_gpio_1  MOSI       lcd_gpio_4  panel power enable
+ *   lcd_gpio_2  CS, active low
+ *
+ * The init sequences are the ones in the vendor U-Boot binaries
+ * (board/allwinner/h700/panels/<name>.txt, turned into anbernic_panels.h by
+ * board/allwinner/h700/scripts/panel2c.py); the rocknix tables differ in the
+ * RGB interface setup and leave the panel dark with the vendor TCON timing.
+ * The device tree names the table(s) with lcd_panel_init = "<old>", "<boe>".
+ * Boards that ship two panel generations tell them apart on a gpio: the
+ * vendor reads PE6 with a pull-up and uses the second ("boe") table when it
+ * is low; lcd_id_gpio names that pin.  Without lcd_panel_init the driver
+ * name selects the rg35xx-plus, rg34xx or rg34xx-sp "old" table.
+ *
+ * This file is licensed under the terms of the GNU General Public
+ * License version 2.  This program is licensed "as is" without any
+ * warranty of any kind, whether express or implied.
+ */
+
+#include <linux/gpio.h>
+#include <linux/moduleparam.h>
+#include <linux/of.h>
+#include "fog_fj035fhd05_v1.h"
+#include "anbernic_panels.h"
+
+#define GPIO_SCK	0
+#define GPIO_MOSI	1
+#define GPIO_CS		2
+#define GPIO_RESET	3
+#define GPIO_POWER	4
+
+#define DCS_ENTER_SLEEP_MODE	0x10
+
+/* fog_fj035fhd05_v1.panel=<table> on the kernel command line forces a table */
+static char *panel_override;
+module_param_named(panel, panel_override, charp, 0444);
+MODULE_PARM_DESC(panel, "panel init table to use instead of the device tree's");
+
+static void LCD_power_on(u32 sel);
+static void LCD_power_off(u32 sel);
+static void LCD_bl_open(u32 sel);
+static void LCD_bl_close(u32 sel);
+
+static void LCD_panel_init(u32 sel);
+static void LCD_panel_exit(u32 sel);
+
+/* 0: first table, 1: second table (vendor "boe", lcd_id gpio low) */
+static int anbernic_panel_type(void)
+{
+	struct disp_gpio_info id;
+	int ret, level, type;
+
+	if (disp_sys_script_get_item("lcd0", "lcd_id_gpio", (int *)&id, 3))
+		return 0;
+	/*
+	 * The pio node hogs this pin (that is what sets the pull the vendor
+	 * uses), so the request fails with -EBUSY; the level can still be read,
+	 * the hog has already made it an input.
+	 */
+	ret = gpio_request(id.gpio, "lcd_id");
+	if (ret == 0)
+		gpio_direction_input(id.gpio);
+	level = gpio_get_value(id.gpio);
+	if (ret == 0)
+		gpio_free(id.gpio);
+	type = level ? 0 : 1;
+	pr_info("fog_fj035fhd05_v1: lcd_id gpio %d reads %s (request %d) -> panel type %d\n",
+		id.gpio, level ? "high" : "low", ret, type);
+	return type;
+}
+
+static const struct anbernic_panel *anbernic_panel_lookup(u32 sel)
+{
+	static const struct anbernic_panel *cached;
+	char names[64] = "";
+	const char *want;
+	unsigned int i;
+
+	if (cached)
+		return cached;
+
+	if (panel_override && *panel_override) {
+		want = panel_override;
+	} else if (disp_sys_script_get_item("lcd0", "lcd_panel_init", (int *)names,
+				     2) == 2) {
+		struct device_node *np = of_find_compatible_node(NULL, NULL,
+						"allwinner,sunxi-lcd0");
+		int n = np ? of_property_count_strings(np, "lcd_panel_init") : 0;
+		int type = n > 1 ? anbernic_panel_type() : 0;
+
+		if (type >= n)
+			type = 0;
+		if (!np || of_property_read_string_index(np, "lcd_panel_init",
+							 type, &want))
+			want = names;
+		of_node_put(np);
+	} else {
+		char drv[32] = "";
+
+		disp_sys_script_get_item("lcd0", "lcd_driver_name", (int *)drv,
+					 2);
+		if (!strcmp(drv, "rg34xx_v1"))
+			want = "rg34xx-old";
+		else if (!strcmp(drv, "rg34xxsp_v1"))
+			want = "rg34xx-sp-old";
+		else
+			want = "rg35xx-plus-old";
+	}
+
+	for (i = 0; i < ARRAY_SIZE(anbernic_panels); i++)
+		if (!strcmp(anbernic_panels[i].name, want))
+			break;
+	if (i == ARRAY_SIZE(anbernic_panels)) {
+		pr_warn("fog_fj035fhd05_v1: unknown panel init '%s', using %s\n",
+			want, anbernic_panels[0].name);
+		i = 0;
+	}
+	pr_info("fog_fj035fhd05_v1: panel init table %s\n",
+		anbernic_panels[i].name);
+	cached = &anbernic_panels[i];
+	return cached;
+}
+
+/* one 9-bit word: D/C bit first, then the byte MSB first; SPI mode 0 */
+static void spi3_write_word(u32 sel, bool data, u8 byte)
+{
+	u32 word = (data ? 0x100 : 0) | byte;
+	int bit;
+
+	sunxi_lcd_gpio_set_value(sel, GPIO_CS, 0);
+	sunxi_lcd_delay_us(1);
+	for (bit = 8; bit >= 0; bit--) {
+		sunxi_lcd_gpio_set_value(sel, GPIO_MOSI, (word >> bit) & 1);
+		sunxi_lcd_delay_us(1);
+		sunxi_lcd_gpio_set_value(sel, GPIO_SCK, 1);
+		sunxi_lcd_delay_us(1);
+		sunxi_lcd_gpio_set_value(sel, GPIO_SCK, 0);
+	}
+	sunxi_lcd_delay_us(1);
+	sunxi_lcd_gpio_set_value(sel, GPIO_CS, 1);
+	sunxi_lcd_delay_us(1);
+}
+
+static void spi3_write_cmd(u32 sel, const u8 *buf, u32 len)
+{
+	u32 i;
+
+	spi3_write_word(sel, false, buf[0]);
+	for (i = 1; i < len; i++)
+		spi3_write_word(sel, true, buf[i]);
+}
+
+/*
+ * Table: a length byte then that many bytes (command, parameters); length 0
+ * is followed by a delay in ms.
+ */
+static void anbernic_run_cmds(u32 sel, const u8 *cmds, u32 len)
+{
+	u32 i = 0;
+
+	while (i + 1 < len) {
+		u8 n = cmds[i];
+
+		if (n == 0) {
+			sunxi_lcd_delay_ms(cmds[i + 1]);
+			i += 2;
+			continue;
+		}
+		if (i + 1 + n > len)
+			break;
+		spi3_write_cmd(sel, &cmds[i + 1], n);
+		i += 1 + n;
+	}
+}
+
+static void LCD_cfg_panel_info(struct panel_extend_para *info)
+{
+	u32 i = 0, j = 0;
+	u32 items;
+	u8 lcd_gamma_tbl[][2] = {
+		/* {input value, corrected value} */
+		{0, 0},
+		{15, 15},
+		{30, 30},
+		{45, 45},
+		{60, 60},
+		{75, 75},
+		{90, 90},
+		{105, 105},
+		{120, 120},
+		{135, 135},
+		{150, 150},
+		{165, 165},
+		{180, 180},
+		{195, 195},
+		{210, 210},
+		{225, 225},
+		{240, 240},
+		{255, 255},
+	};
+
+	u32 lcd_cmap_tbl[2][3][4] = {
+		{
+		 {LCD_CMAP_G0, LCD_CMAP_B1, LCD_CMAP_G2, LCD_CMAP_B3},
+		 {LCD_CMAP_B0, LCD_CMAP_R1, LCD_CMAP_B2, LCD_CMAP_R3},
+		 {LCD_CMAP_R0, LCD_CMAP_G1, LCD_CMAP_R2, LCD_CMAP_G3},
+		 },
+		{
+		 {LCD_CMAP_B3, LCD_CMAP_G2, LCD_CMAP_B1, LCD_CMAP_G0},
+		 {LCD_CMAP_R3, LCD_CMAP_B2, LCD_CMAP_R1, LCD_CMAP_B0},
+		 {LCD_CMAP_G3, LCD_CMAP_R2, LCD_CMAP_G1, LCD_CMAP_R0},
+		 },
+	};
+
+	items = sizeof(lcd_gamma_tbl) / 2;
+	for (i = 0; i < items - 1; i++) {
+		u32 num = lcd_gamma_tbl[i + 1][0] - lcd_gamma_tbl[i][0];
+
+		for (j = 0; j < num; j++) {
+			u32 value = 0;
+
+			value =
+			    lcd_gamma_tbl[i][1] +
+			    ((lcd_gamma_tbl[i + 1][1] -
+			      lcd_gamma_tbl[i][1]) * j) / num;
+			info->lcd_gamma_tbl[lcd_gamma_tbl[i][0] + j] =
+			    (value << 16) + (value << 8) + value;
+		}
+	}
+	info->lcd_gamma_tbl[255] =
+	    (lcd_gamma_tbl[items - 1][1] << 16) +
+	    (lcd_gamma_tbl[items - 1][1] << 8) + lcd_gamma_tbl[items - 1][1];
+
+	memcpy(info->lcd_cmap_tbl, lcd_cmap_tbl, sizeof(lcd_cmap_tbl));
+}
+
+static s32 LCD_open_flow(u32 sel)
+{
+	LCD_OPEN_FUNC(sel, LCD_power_on, 20);
+	LCD_OPEN_FUNC(sel, LCD_panel_init, 10);
+	/* enables the tcon and its vblank irq */
+	LCD_OPEN_FUNC(sel, sunxi_lcd_tcon_enable, 100);
+	LCD_OPEN_FUNC(sel, LCD_bl_open, 0);
+
+	return 0;
+}
+
+static s32 LCD_close_flow(u32 sel)
+{
+	LCD_CLOSE_FUNC(sel, LCD_bl_close, 0);
+	LCD_CLOSE_FUNC(sel, sunxi_lcd_tcon_disable, 0);
+	LCD_CLOSE_FUNC(sel, LCD_panel_exit, 10);
+	LCD_CLOSE_FUNC(sel, LCD_power_off, 100);
+
+	return 0;
+}
+
+static void LCD_power_on(u32 sel)
+{
+	sunxi_lcd_power_enable(sel, 0);
+	sunxi_lcd_pin_cfg(sel, 1);
+	/* bus idle: SCK low, CS high */
+	sunxi_lcd_gpio_set_value(sel, GPIO_SCK, 0);
+	sunxi_lcd_gpio_set_value(sel, GPIO_MOSI, 0);
+	sunxi_lcd_gpio_set_value(sel, GPIO_CS, 1);
+	sunxi_lcd_gpio_set_value(sel, GPIO_RESET, 1);
+	sunxi_lcd_gpio_set_value(sel, GPIO_POWER, 1);
+}
+
+static void LCD_power_off(u32 sel)
+{
+	sunxi_lcd_gpio_set_value(sel, GPIO_POWER, 0);
+	sunxi_lcd_pin_cfg(sel, 0);
+	sunxi_lcd_power_disable(sel, 0);
+}
+
+static void LCD_bl_open(u32 sel)
+{
+	sunxi_lcd_pwm_enable(sel);
+	sunxi_lcd_backlight_enable(sel);
+}
+
+static void LCD_bl_close(u32 sel)
+{
+	sunxi_lcd_backlight_disable(sel);
+	sunxi_lcd_pwm_disable(sel);
+}
+
+static void LCD_panel_init(u32 sel)
+{
+	const struct anbernic_panel *p = anbernic_panel_lookup(sel);
+
+	/* the vendor's reset pulse */
+	sunxi_lcd_gpio_set_value(sel, GPIO_RESET, 1);
+	sunxi_lcd_delay_ms(15);
+	sunxi_lcd_gpio_set_value(sel, GPIO_RESET, 0);
+	sunxi_lcd_delay_ms(50);
+	sunxi_lcd_gpio_set_value(sel, GPIO_RESET, 1);
+	sunxi_lcd_delay_ms(100);
+
+	/* the table ends with exit sleep, its delay and display on */
+	anbernic_run_cmds(sel, p->cmds, p->cmds_len);
+	sunxi_lcd_delay_ms(20);
+}
+
+static void LCD_panel_exit(u32 sel)
+{
+	u8 cmd = DCS_ENTER_SLEEP_MODE;
+
+	spi3_write_cmd(sel, &cmd, 1);
+	sunxi_lcd_delay_ms(120);
+	sunxi_lcd_gpio_set_value(sel, GPIO_RESET, 0);
+}
+
+/* sel: 0:lcd0; 1:lcd1 */
+static s32 LCD_user_defined_func(u32 sel, u32 para1, u32 para2, u32 para3)
+{
+	return 0;
+}
+
+#define ANBERNIC_PANEL_FUNCS {					\
+	.cfg_panel_info = LCD_cfg_panel_info,			\
+	.cfg_open_flow = LCD_open_flow,				\
+	.cfg_close_flow = LCD_close_flow,			\
+	.lcd_user_defined_func = LCD_user_defined_func,		\
+}
+
+/* panel driver names must match lcd_driver_name in the device tree */
+struct __lcd_panel fog_fj035fhd05_v1_panel = {
+	.name = "fog_fj035fhd05_v1",
+	.func = ANBERNIC_PANEL_FUNCS,
+};
+
+struct __lcd_panel rg34xx_v1_panel = {
+	.name = "rg34xx_v1",
+	.func = ANBERNIC_PANEL_FUNCS,
+};
+
+struct __lcd_panel rg34xxsp_v1_panel = {
+	.name = "rg34xxsp_v1",
+	.func = ANBERNIC_PANEL_FUNCS,
+};
