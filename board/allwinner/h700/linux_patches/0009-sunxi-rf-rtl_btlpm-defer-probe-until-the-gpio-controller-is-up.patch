sunxi-rf, rtl_btlpm: defer probe until the gpio controller is up

diff --git a/drivers/bluetooth/rtl_btlpm.c b/drivers/bluetooth/rtl_btlpm.c
index 393d37f06..51dffdf4e 100644
--- a/drivers/bluetooth/rtl_btlpm.c
+++ b/drivers/bluetooth/rtl_btlpm.c
@@ -396,7 +396,7 @@
 	return of_find_device_by_node(np);
 }
 
-static int __init bluesleep_probe(struct platform_device *pdev)
+static int bluesleep_probe(struct platform_device *pdev)
 {
 	struct device_node *np = pdev->dev.of_node;
 	struct device *dev = &pdev->dev;
@@ -410,6 +410,8 @@ static int bluesleep_probe(struct platform_device *pdev)
 		return -ENOMEM;
 
 	bsi->host_wake = of_get_named_gpio_flags(np, "bt_hostwake", 0, &config);
+	if (bsi->host_wake == -EPROBE_DEFER)
+		return -EPROBE_DEFER;
 	if (!gpio_is_valid(bsi->host_wake)) {
 		BT_ERR("get gpio bt_hostwake failed\n");
 		return -EINVAL;
@@ -553,6 +555,7 @@ static const struct of_device_id sunxi_btlpm_ids[] = {
 };
 
 static struct platform_driver bluesleep_driver = {
+	.probe	= bluesleep_probe,
 	.remove	= bluesleep_remove,
 	.suspend = bluesleep_suspend,
 	.resume = bluesleep_resume,
@@ -575,7 +578,7 @@ static int __init bluesleep_init(void)
 
 	BT_DBG("BlueSleep Mode Driver Ver %s", VERSION);
 
-	retval = platform_driver_probe(&bluesleep_driver, bluesleep_probe);
+	retval = platform_driver_register(&bluesleep_driver);
 	if (retval)
 		return retval;
 
