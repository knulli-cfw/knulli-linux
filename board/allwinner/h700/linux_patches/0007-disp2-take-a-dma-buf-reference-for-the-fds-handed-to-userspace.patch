disp2: take a dma-buf reference for the fds handed to userspace

diff --git a/drivers/video/fbdev/sunxi/disp2/disp/dev_disp.c b/drivers/video/fbdev/sunxi/disp2/disp/dev_disp.c
index df5f42e4f..d83a759bf 100644
--- a/drivers/video/fbdev/sunxi/disp2/disp/dev_disp.c
+++ b/drivers/video/fbdev/sunxi/disp2/disp/dev_disp.c
@@ -1652,7 +1652,20 @@ err_hdl:
 
 int disp_get_ion_fd(struct disp_ion_mem *mem)
 {
-	return dma_buf_fd(mem->p_item->dmabuf, O_CLOEXEC);
+	struct dma_buf *dmabuf;
+	int fd;
+
+	if (!mem || !mem->p_item)
+		return -ENODEV;
+
+	/* the fd takes over a reference, so take one for it */
+	dmabuf = mem->p_item->dmabuf;
+	get_dma_buf(dmabuf);
+	fd = dma_buf_fd(dmabuf, O_CLOEXEC);
+	if (fd < 0)
+		dma_buf_put(dmabuf);
+
+	return fd;
 }
 
 void *disp_get_phy_addr(struct disp_ion_mem *mem)
