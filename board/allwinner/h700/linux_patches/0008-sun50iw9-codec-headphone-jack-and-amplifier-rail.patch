+/*
+ * Speaker amplifier: on while LINEOUT is powered and no headphone is in.
+ * The enable GPIO(s) come from pa_pin_N, the rail from an optional
+ * pa-supply, the jack from an optional hp-det-gpios.
+ */
+static void sunxi_pa_update(struct sunxi_codec_info *codec_info)
+{
+	bool on;
+
+	mutex_lock(&codec_info->pa_mutex);
+	on = codec_info->lineout_on && !codec_info->hp_in;
+	if (on != codec_info->pa_on) {
+		if (on) {
+			if (codec_info->pa_supply &&
+			    regulator_enable(codec_info->pa_supply))
+				SND_LOG_ERR(HLOG, "pa supply enable failed\n");
+			snd_sunxi_pa_pin_enable(codec_info->pa_cfg,
+						codec_info->pa_pin_max);
+		} else {
+			snd_sunxi_pa_pin_disable(codec_info->pa_cfg,
+						 codec_info->pa_pin_max);
+			if (codec_info->pa_supply)
+				regulator_disable(codec_info->pa_supply);
+		}
+		codec_info->pa_on = on;
+	}
+	mutex_unlock(&codec_info->pa_mutex);
+}
+
+static void sunxi_lineout_set(struct sunxi_codec_info *codec_info, bool on)
+{
+	codec_info->lineout_on = on;
+	sunxi_pa_update(codec_info);
+}
+
+static int sunxi_hp_jack_status_check(void *data)
+{
+	struct sunxi_codec_info *codec_info = data;
+
+	codec_info->hp_in =
+		gpiod_get_value_cansleep(codec_info->hp_jack_gpio.desc);
+	sunxi_pa_update(codec_info);
+
+	return codec_info->hp_in ? SND_JACK_HEADPHONE : 0;
+}
+
 static int sunxi_lineout_event(struct snd_soc_dapm_widget *w,
 			       struct snd_kcontrol *k, int event)
 {
