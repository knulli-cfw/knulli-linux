 				    0x1 << RDEN, 0x1 << RDEN);
 
-		snd_sunxi_pa_pin_enable(pa_cfg, codec_info->pa_pin_max);
+		sunxi_lineout_set(codec_info, true);
 
 		break;
 
@@ -399,7 +446,7 @@ static int sunxi_lineout_event(struct snd_soc_dapm_widget *w,
 				   (0x1 << LINEOUTL_EN) | (0x1 << LINEOUTR_EN),
 				   (0x0 << LINEOUTL_EN) | (0x0 << LINEOUTR_EN));
 
-		snd_sunxi_pa_pin_disable(pa_cfg, codec_info->pa_pin_max);
+		sunxi_lineout_set(codec_info, false);
 
 		break;
 
@@ -546,9 +593,45 @@ static int sunxi_internal_codec_probe(struct snd_soc_component *component)
 
 	sunxi_internal_codec_init(component);
 
+	/* headphone jack, optional */
+	if (of_find_property(component->dev->of_node, "hp-det-gpios", NULL)) {
+		struct snd_soc_jack_gpio *jack_gpio = &codec_info->hp_jack_gpio;
+
+		jack_gpio->name = "hp-det";
+		jack_gpio->report = SND_JACK_HEADPHONE;
+		jack_gpio->debounce_time = 150;
+		jack_gpio->gpiod_dev = component->dev;
+		jack_gpio->data = codec_info;
+		jack_gpio->jack_status_check = sunxi_hp_jack_status_check;
+
+		ret = snd_soc_card_jack_new(component->card, "Headphone",
+					    SND_JACK_HEADPHONE,
+					    &codec_info->hp_jack, NULL, 0);
+		if (ret) {
+			SND_LOG_ERR(HLOG, "headphone jack new failed\n");
+			return 0;
+		}
+		ret = snd_soc_jack_add_gpios(&codec_info->hp_jack, 1, jack_gpio);
+		if (ret)
+			SND_LOG_ERR(HLOG, "headphone jack gpio failed\n");
+		else
+			codec_info->hp_jack_added = true;
+	}
+
 	return 0;
 }
 
+static void sunxi_internal_codec_remove(struct snd_soc_component *component)
+{
+	struct sunxi_codec_info *codec_info = snd_soc_component_get_drvdata(component);
+
+	if (codec_info->hp_jack_added) {
+		snd_soc_jack_free_gpios(&codec_info->hp_jack, 1,
+					&codec_info->hp_jack_gpio);
+		codec_info->hp_jack_added = false;
+	}
+}
