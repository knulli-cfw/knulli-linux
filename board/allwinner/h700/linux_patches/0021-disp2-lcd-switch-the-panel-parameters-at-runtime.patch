disp2: lcd: switch the panel parameters at runtime

/sys/class/disp/disp/attr/lcd_panel <name> re-reads the lcd0 parameters
(timings, dot clock, init table) from the device tree node with compatible
"knulli,panel-<name>" and re-inits the panel; "default" goes back to lcd0.
One device tree can then carry every Anbernic panel and the first boot can
try them without a reboot per candidate.

--- a/drivers/video/fbdev/sunxi/disp2/disp/disp_sys_intf.c
+++ b/drivers/video/fbdev/sunxi/disp2/disp/disp_sys_intf.c
@@ -182,16 +182,42 @@
 }
 
 /* type: 0:invalid, 1: int; 2:str, 3: gpio */
+/* knulli: the lcd0 panel parameters can be taken from another node at
+ * runtime (compatible "knulli,panel-<name>") so one device tree can carry
+ * every panel and the first boot can try them without rebooting */
+static char lcd0_compat_override[64];
+
+void disp_sys_set_lcd0_compat(const char *compat)
+{
+	if (compat && *compat)
+		strlcpy(lcd0_compat_override, compat,
+			sizeof(lcd0_compat_override));
+	else
+		lcd0_compat_override[0] = 0;
+}
+EXPORT_SYMBOL(disp_sys_set_lcd0_compat);
+
+struct device_node *disp_sys_lcd0_node(void)
+{
+	return of_find_compatible_node(NULL, NULL, lcd0_compat_override[0] ?
+				       lcd0_compat_override :
+				       "allwinner,sunxi-lcd0");
+}
+EXPORT_SYMBOL(disp_sys_lcd0_node);
