 static DEVICE_ATTR(runtime_enable, 0660,
 		   disp_runtime_enable_show, disp_runtime_enable_store);
+
+/* knulli: switch lcd0 to the panel node "knulli,panel-<name>" of the
+ * device tree ("default" = the lcd0 node) and re-init the panel */
+static char disp_lcd_panel_name[32] = "default";
+
+static ssize_t disp_lcd_panel_show(struct device *dev,
+				   struct device_attribute *attr, char *buf)
+{
+	return sprintf(buf, "%s\n", disp_lcd_panel_name);
+}
+
+static ssize_t disp_lcd_panel_store(struct device *dev,
+				    struct device_attribute *attr,
+				    const char *buf, size_t count)
+{
+	char name[32], compat[64];
+	struct device_node *np;
+	size_t n = strcspn(buf, " \t\r\n");
+
+	if (n == 0 || n >= sizeof(name))
+		return -EINVAL;
+	memcpy(name, buf, n);
+	name[n] = 0;
+	if (!strcmp(name, "default")) {
+		compat[0] = 0;
+	} else {
+		snprintf(compat, sizeof(compat), "knulli,panel-%s", name);
+		np = of_find_compatible_node(NULL, NULL, compat);
+		if (!np) {
+			pr_warn("disp: no panel node %s\n", compat);
+			return -ENOENT;
+		}
+		of_node_put(np);
+	}
+	disp_sys_set_lcd0_compat(compat);
+	strlcpy(disp_lcd_panel_name, name, sizeof(disp_lcd_panel_name));
+	pr_info("disp: lcd0 panel -> %s\n", name);
+	if (bsp_disp_lcd_reload_panel(0))
+		return -EIO;
+	return count;
+}
+
+static DEVICE_ATTR(lcd_panel, 0660, disp_lcd_panel_show, disp_lcd_panel_store);
