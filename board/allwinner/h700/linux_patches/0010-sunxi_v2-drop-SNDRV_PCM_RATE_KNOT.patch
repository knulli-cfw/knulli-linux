+++ b/sound/soc/sunxi_v2/snd_sunxi_aaudio.c
@@ -62,8 +62,7 @@ static struct snd_soc_dai_driver sunxi_aaudio_dai = {
 		.stream_name	= "Playback",
 		.channels_min	= 1,
 		.channels_max	= 2,
-		.rates		= SNDRV_PCM_RATE_8000_192000
-				| SNDRV_PCM_RATE_KNOT,
+		.rates		= SNDRV_PCM_RATE_8000_192000,
 		.formats	= SNDRV_PCM_FMTBIT_S16_LE
 				| SNDRV_PCM_FMTBIT_S24_LE
 				| SNDRV_PCM_FMTBIT_S32_LE,
@@ -72,8 +71,7 @@ static struct snd_soc_dai_driver sunxi_aaudio_dai = {
 		.stream_name	= "Capture",
 		.channels_min	= 1,
 		.channels_max	= 3,
-		.rates		= SNDRV_PCM_RATE_8000_192000
-				| SNDRV_PCM_RATE_KNOT,
+		.rates		= SNDRV_PCM_RATE_8000_192000,
