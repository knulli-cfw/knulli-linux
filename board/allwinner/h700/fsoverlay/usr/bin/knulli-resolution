#!/bin/sh

DISPLAY="/sys/kernel/debug/dispdbg"
# soc on the vendor 4.9 kernel, soc@3000000 on 5.4
HDMI_STATE=$(ls /sys/devices/platform/soc*/6000000.hdmi/extcon/*/state 2>/dev/null | head -n 1)
read -r BOARD < "/boot/boot/knulli.board"

f_usage() {
    echo "$0 listOutputs" >&2
    echo "$0 currentResolution" >&2
    echo "$0 setOutput" >&2
}

if [ $# -eq 0 ]; then
    f_usage
    exit 1
fi

set_fb() {
    # check wanted geometry against current geometry, only change if needed.
    want_x="$1"; want_y="$2"; want_vx="$3"; want_vy="$4"; want_bpp="$5"

    set -- $(fbset | awk '/geometry/ {print $2, $3, $4, $5, $6}')
    cur_x="$1"; cur_y="$2"; cur_vx="$3"; cur_vy="$4"; cur_bpp="$5"

    if [ "$cur_x" = "$want_x" ] && [ "$cur_y" = "$want_y" ] && \
       [ "$cur_vx" = "$want_vx" ] && [ "$cur_vy" = "$want_vy" ] && \
       [ "$cur_bpp" = "$want_bpp" ]; then
        return 0
    fi

    fbset -g "$want_x" "$want_y" "$want_vx" "$want_vy" "$want_bpp"
}

set_output() {
    OUTPUT=$1
    case "$OUTPUT" in
        hdmi)
            VIDEO=$(knulli-settings-get global.videooutput)
            echo "disp0" > "$DISPLAY/name"
            echo "switch1" > "$DISPLAY/command"
            case "$VIDEO" in
                hdmi-480p)
                    echo "4 2 0 0 0x4 0x201 0 1 0 8" > "$DISPLAY/param"
                    echo 1 > "$DISPLAY/start"
                    set_fb 640 480 640 960 32
                    ;;
                hdmi-720p)
                    echo "4 5 0 0 0x4 0x201 0 1 0 8" > "$DISPLAY/param"
                    echo 1 > "$DISPLAY/start"
                    set_fb 1280 720 1280 1440 32
                    ;;
                ""|hdmi-1080p)
                    echo "4 10 0 0 0x4 0x201 0 1 0 8" > "$DISPLAY/param"
                    echo 1 > "$DISPLAY/start"
                    set_fb 1280 720 1280 1440 32
                    ;;
            esac
            ;;
        internal)
            # switching tears the lcd down and brings it back up; skip it when
            # the panel is already the active output
            if ! grep -q "lcd output" /sys/class/disp/disp/attr/sys 2>/dev/null; then
                { date; echo "switch to lcd by pid $$ (parent $(cat /proc/$PPID/comm 2>/dev/null))"; cat /sys/class/disp/disp/attr/sys; } >> /tmp/knulli-resolution.log 2>&1
                echo "disp0" > "$DISPLAY/name"
                echo "switch" > "$DISPLAY/command"
                echo "1 0" > "$DISPLAY/param"
                echo 1 > "$DISPLAY/start"
            fi

            case "$BOARD" in
                rg28xx)
                    set_fb 480 640 480 1280 32
                    ;;
                rg-cubexx)
                    set_fb 720 720 720 1440 32
                    ;;
                rg34xx|rg34xx-sp)
                    set_fb 720 480 720 960 32
                    ;;
                *)
                    set_fb 640 480 640 960 32
                    ;;
            esac
            ;;
        *)
            f_usage
            ;;
    esac
}

ACTION=$1

case "${ACTION}" in
    "listOutputs")
        echo "hdmi-1080p"
        echo "hdmi-720p"
        echo "hdmi-480p"
        ;;
    "listModes")
        ;;
    "setOutput")
        STATE=
        [ -n "$HDMI_STATE" ] && read -r STATE < "$HDMI_STATE"
        if [ "$STATE" = "HDMI=1" ]; then
            set_output hdmi
        else
            set_output internal
        fi
        ;;
    "currentResolution")
        if [ "$BOARD" = "rg28xx" ]; then
            fbset | grep "geometry" | awk '{print $3"x"$2}'
        else
            fbset | grep "geometry" | awk '{print $2"x"$3}'
        fi
        ;;
    "currentOutput")
        ;;
    "currentMode")
        ;;
    "minTomaxResolution" | "minTomaxResolution-secure")
        ;;
    "supportSystemReflection")
        ;;
    "supportSystemRotation")
        ;;
    *)
        echo "error: invalid command ${ACTION}" >&2
        f_usage
        exit 1
        ;;
esac

exit 0
