#!/bin/sh
#
# Mali devfreq policy: scale with load
#
G=/sys/class/devfreq/1800000.gpu

case "$1" in
    start)
        [ -d "$G" ] || exit 0
        grep -q simple_ondemand "$G/available_governors" && echo simple_ondemand > "$G/governor"
        [ -w "$G/device/pm_poweroff" ] && echo "400000 125 0" > "$G/device/pm_poweroff"
        ;;
    stop|restart|reload)
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
esac
exit 0
