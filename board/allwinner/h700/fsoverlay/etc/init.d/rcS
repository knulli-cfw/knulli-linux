#!/bin/sh

# We need the graphics module in order to use SDL since we are
# using the sdl-compat/SDL2 for rendering
insmod /lib/modules/mali_kbase.ko
# buttons and sticks: needed before udev for the first-boot device menu
modprobe rocknix-singleadc-joypad 2>/dev/null

# One image for every board: the device tree says which one booted
BOARD=$(tr -d '\0' < /proc/device-tree/knulli,device 2>/dev/null)
[ -n "$BOARD" ] || BOARD=$(cat /boot/boot/knulli.board)

# Rotate screen for the rg28xx
if [ "$BOARD" = "rg28xx" ]; then
    fbset -g 480 640 480 1280 32
fi

# First boot: which device is this?  Blocks, and reboots when the choice (or
# the next screen class to try) needs another device tree.
/usr/bin/knulli-device

# This is needed so that on a restart charger binary is not run while plugged in
RESTART_FLAG="/boot/restart.flag"

if [ -f "$RESTART_FLAG" ]; then
    # Reset the flag to 0 for the next boot
    mount -o remount,rw /boot
    rm -f "$RESTART_FLAG"
    sync
    mount -o remount,ro /boot
else
    # Call the charger process
    /usr/bin/charger
fi

# Start the progress bar
/usr/bin/progressbar &

# Start all init scripts in /etc/init.d
# executing them in numerical order.
#
for i in /etc/init.d/S??* ; do

    [ ! -f "$i" ] && continue

    echo "$i" > /tmp/status.txt

    case "$i" in
        *.sh)
            (
                trap - INT QUIT TSTP
                set start
                . $i
            ) &
            ;;
        *)
            case "$i" in
                *S00bootcustom | *S01dbus | *S02resize | *S03modules | *S04populate | *S05udev | *S06audio | *S06modprobe | *S11share | *S12populateshare)
                    $i start
                    ;;
                *)
                    $i start &
                    ;;
            esac
            ;;
    esac

    echo $(date +"%F %T,%3N")": ${i} - started" >> /var/run/boot.log
done

# No QUIT needed - progressbar exits naturally when it sees S31emulationstation
exit 0
