/* Bank G (wifi SDIO, bt uart, 32k out) runs at 1.8 V from aldo4; the 5.4
 * pinctrl sets a bank's pad voltage mode from its supply, nothing else. */
&pio {
	vcc-pg-supply = <&v_aldo4>;
	/* panel generation id, read by the disp2 panel driver (lcd_id_gpio) */
	pinctrl-names = "default";
	pinctrl-0 = <&lcd_id_pin>;

	lcd_id_pin: lcd-id-pin {
		allwinner,pins = "PE6";
		allwinner,function = "gpio_in";
		allwinner,muxsel = <0>;
		allwinner,drive = <0>;
		allwinner,pull = <1>;
	};

		v_card0_boot_para_0: v-card0-boot-para-0 {
			allwinner,pins = "PF0", "PF1", "PF2", "PF3", "PF4", "PF5";
			allwinner,function = "card0_boot_para";
			allwinner,pname = "sdc_d1", "sdc_d0", "sdc_clk", "sdc_cmd", "sdc_d3", "sdc_d2";
			allwinner,muxsel = <0x02>;
			allwinner,pull = <0x01>;
			allwinner,drive = <0x03>;
			allwinner,data = <0xffffffff>;
			function = "gpio_in";
		};
		v_card2_boot_para_0: v-card2-boot-para-0 {
			allwinner,pins = "PC5", "PC6", "PC10", "PC13", "PC15", "PC8", "PC9", "PC11", "PC14", "PC16", "PC1";
			allwinner,function = "card2_boot_para";
			allwinner,pname = "sdc_clk", "sdc_cmd", "sdc_d0", "sdc_d1", "sdc_d2", "sdc_d3", "sdc_d4", "sdc_d5", "sdc_d6", "sdc_d7", "sdc_emmc_rst";
			allwinner,muxsel = <0x03>;
			allwinner,pull = <0x01>;
			allwinner,drive = <0x03>;
			allwinner,data = <0xffffffff>;
			function = "gpio_in";
		};
		v_card2_boot_para_1: v-card2-boot-para-1 {
			allwinner,pins = "PC0";
			allwinner,function = "card2_boot_para";
			allwinner,pname = "sdc_ds";
			allwinner,muxsel = <0x03>;
			allwinner,pull = <0x02>;
			allwinner,drive = <0x03>;
			allwinner,data = <0xffffffff>;
			function = "gpio_in";
		};
		v_twi_para_0: v-twi-para-0 {
			allwinner,pins = "PH14", "PH15";
			allwinner,function = "twi_para";
			allwinner,pname = "twi_scl", "twi_sda";
			allwinner,muxsel = <0x02>;
			allwinner,pull = <0xffffffff>;
			allwinner,drive = <0xffffffff>;
			allwinner,data = <0xffffffff>;
			drive-strength = <10>;
			function = "gpio_in";
		};
		v_uart_para_0: v-uart-para-0 {
			allwinner,pins = "PH0", "PH1";
			allwinner,function = "uart_para";
			allwinner,pname = "uart_debug_tx", "uart_debug_rx";
			allwinner,muxsel = <0x02>;
			allwinner,pull = <0x01>;
			allwinner,drive = <0xffffffff>;
			allwinner,data = <0xffffffff>;
			drive-strength = <10>;
			function = "gpio_in";
		};
		v_jtag_para_0: v-jtag-para-0 {
			allwinner,pins = "PH9", "PH10", "PH11", "PH12";
			allwinner,function = "jtag_para";
			allwinner,pname = "jtag_ms", "jtag_ck", "jtag_do", "jtag_di";
			allwinner,muxsel = <0x03>;
			allwinner,pull = <0xffffffff>;
			allwinner,drive = <0xffffffff>;
			allwinner,data = <0xffffffff>;
			drive-strength = <10>;
			function = "gpio_in";
		};
		v_rgb24_0: v-rgb24-0 {
			allwinner,pins = "PD0", "PD1", "PD2", "PD3", "PD4", "PD5", "PD6", "PD7", "PD8", "PD9", "PD10", "PD11", "PD12", "PD13", "PD14", "PD15", "PD16", "PD17", "PD18", "PD19", "PD20", "PD21", "PD22", "PD23", "PD24", "PD25", "PD26", "PD27";
			allwinner,pname = "PD0", "PD1", "PD2", "PD3", "PD4", "PD5", "PD6", "PD7", "PD8", "PD9", "PD10", "PD11", "PD12", "PD13", "PD14", "PD15", "PD16", "PD17", "PD18", "PD19", "PD20", "PD21", "PD22", "PD23", "PD24", "PD25", "PD26", "PD27";
			allwinner,function = "lcd0";
			allwinner,muxsel = <0x02>;
			allwinner,drive = <0x03>;
			allwinner,pull = <0x00>;
		};
		v_rgb24_1: v-rgb24-1 {
			allwinner,pins = "PD0", "PD1", "PD2", "PD3", "PD4", "PD5", "PD6", "PD7", "PD8", "PD9", "PD10", "PD11", "PD12", "PD13", "PD14", "PD15", "PD16", "PD17", "PD18", "PD19", "PD20", "PD21", "PD22", "PD23", "PD24", "PD25", "PD26", "PD27";
			allwinner,pname = "PD0", "PD1", "PD2", "PD3", "PD4", "PD5", "PD6", "PD7", "PD8", "PD9", "PD10", "PD11", "PD12", "PD13", "PD14", "PD15", "PD16", "PD17", "PD18", "PD19", "PD20", "PD21", "PD22", "PD23", "PD24", "PD25", "PD26", "PD27";
			allwinner,function = "lcd0_suspend";
			allwinner,muxsel = <0x07>;
			allwinner,drive = <0x03>;
			allwinner,pull = <0x00>;
			function = "gpio_in";
		};
		v_pwm0_0: v-pwm0-0 {
			allwinner,pins = "PD28";
			allwinner,function = "pwm0";
			allwinner,muxsel = <0x02>;
			allwinner,drive = <0xffffffff>;
			allwinner,pull = <0x00>;
			allwinner,data = <0xffffffff>;
			drive-strength = <10>;
		};
		v_pwm0_1: v-pwm0-1 {
			allwinner,pins = "PD28";
			allwinner,function = "io_disabled";
			allwinner,muxsel = <0x07>;
			allwinner,drive = <0xffffffff>;
			allwinner,pull = <0x00>;
			allwinner,data = <0xffffffff>;
			drive-strength = <10>;
			function = "gpio_in";
		};
		v_pwm2_0: v-pwm2-0 {
			allwinner,pins = "PH2";
			allwinner,function = "pwm2";
			allwinner,muxsel = <0x04>;
			allwinner,drive = <0xffffffff>;
			allwinner,pull = <0x00>;
			allwinner,data = <0xffffffff>;
			drive-strength = <10>;
		};
		v_pwm2_1: v-pwm2-1 {
			allwinner,pins = "PH2";
			allwinner,function = "io_disabled";
			allwinner,muxsel = <0x07>;
			allwinner,drive = <0xffffffff>;
			allwinner,pull = <0x00>;
			allwinner,data = <0xffffffff>;
			drive-strength = <10>;
			function = "gpio_in";
		};
		v_uart0_1: v-uart0-1 {
			allwinner,pins = "PH0", "PH1";
			allwinner,function = "uart0";
			allwinner,muxsel = <0x07>;
			allwinner,drive = <0x01>;
			allwinner,pull = <0x00>;
		};
		v_sdc0_0: v-sdc0-0 {
			allwinner,pins = "PF0", "PF1", "PF2", "PF3", "PF4", "PF5";
			allwinner,function = "sdc0";
			allwinner,muxsel = <0x02>;
			allwinner,drive = <0x03>;
			allwinner,pull = <0x01>;
		};
		v_sdc2_0: v-sdc2-0 {
			allwinner,pins = "PC1", "PC5", "PC6", "PC8", "PC9", "PC10", "PC11", "PC13", "PC14", "PC15", "PC16";
			allwinner,function = "sdc2";
			allwinner,muxsel = <0x03>;
			allwinner,drive = <0x02>;
			allwinner,pull = <0x01>;
		};
		v_sdc2_2: v-sdc2-2 {
			allwinner,pins = "PC0";
			allwinner,function = "sdc2";
			allwinner,muxsel = <0x03>;
			allwinner,drive = <0x02>;
			allwinner,pull = <0x02>;
		};
		v_sdc2_1: v-sdc2-1 {
			allwinner,pins = "PC0", "PC1", "PC5", "PC6", "PC8", "PC9", "PC10", "PC11", "PC13", "PC14", "PC15", "PC16";
			allwinner,function = "io_disabled";
			allwinner,muxsel = <0x07>;
			allwinner,drive = <0x01>;
			allwinner,pull = <0x01>;
			function = "gpio_in";
		};
		v_uart1_0: v-uart1-0 {
			allwinner,pins = "PG6", "PG7", "PG8", "PG9";
			allwinner,pname = "uart1_tx", "uart1_rx", "uart1_rts", "uart1_cts";
			allwinner,function = "uart1";
			allwinner,muxsel = <0x02>;
			allwinner,drive = <0x01>;
			allwinner,pull = <0x01>;
		};
		v_uart1_1: v-uart1-1 {
			allwinner,pins = "PG6", "PG7", "PG8", "PG9";
			allwinner,function = "io_disabled";
			allwinner,muxsel = <0x07>;
			allwinner,drive = <0x01>;
			allwinner,pull = <0x00>;
			function = "gpio_in";
		};
		v_sdc1_0: v-sdc1-0 {
			allwinner,pins = "PG0", "PG1", "PG2", "PG3", "PG4", "PG5";
			allwinner,function = "sdc1";
			allwinner,muxsel = <0x02>;
			allwinner,drive = <0x03>;
			allwinner,pull = <0x01>;
		};
		v_sdc1_1: v-sdc1-1 {
			allwinner,pins = "PG0", "PG1", "PG2", "PG3", "PG4", "PG5";
			allwinner,function = "io_disabled";
			allwinner,muxsel = <0x07>;
			allwinner,drive = <0x01>;
			allwinner,pull = <0x01>;
			function = "gpio_in";
		};
		v_clk_losc_0: v-clk-losc-0 {
			allwinner,pins = "PG10";
			allwinner,function = "x32kfout";
			allwinner,muxsel = <0x03>;
			allwinner,drive = <0x02>;
			allwinner,pull = <0x01>;
		};
};

&r_pio {
		v_s_twi0_0: v-s-twi0-0 {
			allwinner,pins = "PL0", "PL1";
			allwinner,pname = "s_twi0_scl", "s_twi0_sda";
			allwinner,function = "s_twi0";
			allwinner,muxsel = <0x03>;
			allwinner,drive = <0x01>;
			allwinner,pull = <0x00>;
		};
};

&uart0 {
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&v_uart0_1>;
	pinctrl-1 = <&uart0_ph_sleep>;
	status = "okay";
};

&twi5 {
	clock-frequency = <200000>;
	pinctrl-names = "default";
	pinctrl-0 = <&v_s_twi0_0>;
	no_suspend = <1>;
	status = "okay";

		v_pmu: pmu {
			compatible = "x-powers,axp2202";
			reg = <0x34>;
			status = "okay";
			interrupts = <0x00 0x08>;
			interrupt-parent = <&nmi_intc>;
			x-powers,drive-vbus-en;
			pmu_reset = <0x00>;
			pmu_irq_wakeup = <0x01>;
			pmu_hot_shutdown = <0x01>;
			wakeup-source;

			v_usb_power_supply: usb_power_supply {
				compatible = "x-powers,axp2202-usb-power-supply";
				status = "okay";
				pmu_usbpc_vol = <0x11f8>;
				pmu_usbpc_cur = <0x1f4>;
				pmu_usbad_vol = <0x1068>;
				pmu_usbad_cur = <0x9c4>;
				pmu_usb_typec_used = <0x01>;
				wakeup_usb_in;
				wakeup_usb_out;
				det_acin_supply = <&v_gpio_power_supply>;
				pmu_acin_usbid_drv = <&pio 0x07 0x0c 0x01>;
				pmu_vbus_det_gpio = <&pio 0x07 0x0d 0x01>;
				allen_usb_id_det = <&pio 0x08 0x04 0x01 0x00 0xffffffff 0x00>;
			};

			v_gpio_power_supply: gpio_power_supply {
				compatible = "x-powers,gpio-supply";
				status = "disabled";
				pmu_acin_det_gpio = <&pio 0x07 0x0e 0x01>;
				det_usb_supply = <&v_usb_power_supply>;
			};

			v_bat_power_supply: bat-power-supply {
				compatible = "x-powers,axp2202-bat-power-supply";
				param = <&v_axp2202_parameter>;
				status = "okay";
				pmu_chg_ic_temp = <0x00>;
				pmu_battery_rdc = <0xaa>;
				pmu_battery_cap = <0xbb8>;
				pmu_runtime_chgcur = <0x5dc>;
				pmu_suspend_chgcur = <0x5dc>;
				pmu_shutdown_chgcur = <0x5dc>;
				pmu_init_chgvol = <0x1004>;
				pmu_battery_warning_level1 = <0x0f>;
				pmu_battery_warning_level2 = <0x00>;
				pmu_chgled_func = <0x00>;
				pmu_chgled_type = <0x00>;
				pmu_bat_para1 = <0x00>;
				pmu_bat_para2 = <0x00>;
				pmu_bat_para3 = <0x00>;
				pmu_bat_para4 = <0x00>;
				pmu_bat_para5 = <0x00>;
				pmu_bat_para6 = <0x00>;
				pmu_bat_para7 = <0x02>;
				pmu_bat_para8 = <0x03>;
				pmu_bat_para9 = <0x04>;
				pmu_bat_para10 = <0x06>;
				pmu_bat_para11 = <0x09>;
				pmu_bat_para12 = <0x0e>;
				pmu_bat_para13 = <0x1a>;
				pmu_bat_para14 = <0x26>;
				pmu_bat_para15 = <0x31>;
				pmu_bat_para16 = <0x34>;
				pmu_bat_para17 = <0x38>;
				pmu_bat_para18 = <0x3c>;
				pmu_bat_para19 = <0x40>;
				pmu_bat_para20 = <0x46>;
				pmu_bat_para21 = <0x4d>;
				pmu_bat_para22 = <0x53>;
				pmu_bat_para23 = <0x57>;
				pmu_bat_para24 = <0x5a>;
				pmu_bat_para25 = <0x5f>;
				pmu_bat_para26 = <0x63>;
				pmu_bat_para27 = <0x63>;
				pmu_bat_para28 = <0x64>;
				pmu_bat_para29 = <0x64>;
				pmu_bat_para30 = <0x64>;
				pmu_bat_para31 = <0x64>;
				pmu_bat_para32 = <0x64>;
				pmu_bat_temp_enable = <0x00>;
				pmu_jetia_en = <0x00>;
				pmu_bat_charge_ltf = <0x69f>;
				pmu_bat_charge_htf = <0x97>;
				pmu_bat_shutdown_ltf = <0x84d>;
				pmu_bat_shutdown_htf = <0x83>;
				pmu_jetia_cool = <0x551>;
				pmu_jetia_warm = <0xd0>;
				pmu_jcool_ifall = <0x00>;
				pmu_jwarm_ifall = <0x00>;
				pmu_bat_temp_para1 = <0x111a>;
				pmu_bat_temp_para2 = <0xa7a>;
				pmu_bat_temp_para3 = <0x84d>;
				pmu_bat_temp_para4 = <0x69f>;
				pmu_bat_temp_para5 = <0x551>;
				pmu_bat_temp_para6 = <0x44d>;
				pmu_bat_temp_para7 = <0x380>;
				pmu_bat_temp_para8 = <0x25c>;
				pmu_bat_temp_para9 = <0x1a0>;
				pmu_bat_temp_para10 = <0x124>;
				pmu_bat_temp_para11 = <0xf6>;
				pmu_bat_temp_para12 = <0xd0>;
				pmu_bat_temp_para13 = <0xb1>;
				pmu_bat_temp_para14 = <0x97>;
				pmu_bat_temp_para15 = <0x6f>;
				pmu_bat_temp_para16 = <0x53>;
				work_led = <&pio 0x08 0x0c 0x01 0x01 0xffffffff 0x00>;
				low_pwr_led = <&pio 0x08 0x0b 0x01 0x01 0xffffffff 0x00>;
				moto_pwm_gpio = <&pio 0x07 0x02 0x01 0x01 0xffffffff 0x00>;
			};

			v_powerkey_0: powerkey@0 {
				status = "okay";
				compatible = "x-powers,axp2101-pek";
				pmu_powkey_off_time = <0x1770>;
				pmu_powkey_off_func = <0x00>;
				pmu_powkey_off_en = <0x01>;
				pmu_powkey_long_time = <0x5dc>;
				pmu_powkey_on_time = <0x200>;
				wakeup_rising;
				wakeup_falling;
				hall_key = <&pio 0x04 0x07 0x00 0x01 0xffffffff 0x00>;
			};

			v_regulators_0: regulators@0 {

				v_dcdc1: dcdc1 {
					regulator-name = "axp2202-dcdc1";
					regulator-min-microvolt = <0x7a120>;
					regulator-max-microvolt = <0x177fa0>;
					regulator-ramp-delay = <0xfa>;
					regulator-enable-ramp-delay = <0x3e8>;
					regulator-boot-on;
					regulator-always-on;
				};

				v_dcdc2: dcdc2 {
					regulator-name = "axp2202-dcdc2";
					regulator-min-microvolt = <0x7a120>;
					regulator-max-microvolt = <0x33e140>;
					regulator-ramp-delay = <0xfa>;
					regulator-enable-ramp-delay = <0x3e8>;
					regulator-boot-on;
					regulator-always-on;
				};

				v_dcdc3: dcdc3 {
					regulator-name = "axp2202-dcdc3";
					regulator-min-microvolt = <0x7a120>;
					regulator-max-microvolt = <0x1c1380>;
					regulator-ramp-delay = <0xfa>;
					regulator-enable-ramp-delay = <0x3e8>;
					regulator-always-on;
				};

				v_dcdc4: dcdc4 {
					regulator-name = "axp2202-dcdc4";
					regulator-min-microvolt = <0xf4240>;
					regulator-max-microvolt = <0x387520>;
					regulator-ramp-delay = <0xfa>;
					regulator-enable-ramp-delay = <0x3e8>;
				};

				v_rtcldo: rtcldo {
					regulator-name = "axp2202-rtcldo";
					regulator-min-microvolt = <0x1b7740>;
					regulator-max-microvolt = <0x1b7740>;
					regulator-boot-on;
					regulator-always-on;
				};

				v_aldo1: aldo1 {
					regulator-name = "axp2202-aldo1";
					regulator-min-microvolt = <0x7a120>;
					regulator-max-microvolt = <0x3567e0>;
					regulator-enable-ramp-delay = <0x3e8>;
				};

				v_aldo2: aldo2 {
					regulator-name = "axp2202-aldo2";
					regulator-min-microvolt = <0x7a120>;
					regulator-max-microvolt = <0x3567e0>;
					regulator-enable-ramp-delay = <0x3e8>;
				};

				v_aldo3: aldo3 {
					regulator-name = "axp2202-aldo3";
					regulator-min-microvolt = <0x7a120>;
					regulator-max-microvolt = <0x3567e0>;
					regulator-enable-ramp-delay = <0x3e8>;
					regulator-always-on;
					regulator-boot-on;
				};

				v_aldo4: aldo4 {
					regulator-name = "axp2202-aldo4";
					regulator-min-microvolt = <0x7a120>;
					regulator-max-microvolt = <0x3567e0>;
					regulator-enable-ramp-delay = <0x3e8>;
					regulator-always-on;
					regulator-boot-on;
				};

				v_bldo1: bldo1 {
					regulator-name = "axp2202-bldo1";
					regulator-min-microvolt = <0x7a120>;
					regulator-max-microvolt = <0x3567e0>;
					regulator-enable-ramp-delay = <0x3e8>;
				};

				v_bldo2: bldo2 {
					regulator-name = "axp2202-bldo2";
					regulator-min-microvolt = <0x7a120>;
					regulator-max-microvolt = <0x3567e0>;
					regulator-enable-ramp-delay = <0x3e8>;
					regulator-boot-on;
					regulator-always-on;
				};

				v_bldo3: bldo3 {
					regulator-name = "axp2202-bldo3";
					regulator-min-microvolt = <0x7a120>;
					regulator-max-microvolt = <0x3567e0>;
					regulator-enable-ramp-delay = <0x3e8>;
				};

				v_bldo4: bldo4 {
					regulator-name = "axp2202-bldo4";
					regulator-min-microvolt = <0x7a120>;
					regulator-max-microvolt = <0x3567e0>;
					regulator-enable-ramp-delay = <0x3e8>;
				};

				v_cldo1: cldo1 {
					regulator-name = "axp2202-cldo1";
					regulator-min-microvolt = <0x7a120>;
					regulator-max-microvolt = <0x3567e0>;
					regulator-enable-ramp-delay = <0x3e8>;
				};

				v_cldo2: cldo2 {
					regulator-name = "axp2202-cldo2";
					regulator-min-microvolt = <0x7a120>;
					regulator-max-microvolt = <0x3567e0>;
					regulator-enable-ramp-delay = <0x3e8>;
				};

				v_cldo3: cldo3 {
					regulator-name = "axp2202-cldo3";
					regulator-min-microvolt = <0x7a120>;
					regulator-max-microvolt = <0x3567e0>;
					regulator-ramp-delay = <0x9c4>;
					regulator-enable-ramp-delay = <0x3e8>;
					regulator-boot-on;
					regulator-always-on;
				};

				v_cldo4: cldo4 {
					regulator-name = "axp2202-cldo4";
					regulator-min-microvolt = <0x7a120>;
					regulator-max-microvolt = <0x3567e0>;
					regulator-enable-ramp-delay = <0x3e8>;
				};

				v_cpusldo: cpusldo {
					regulator-name = "axp2202-cpusldo";
					regulator-min-microvolt = <0x7a120>;
					regulator-max-microvolt = <0x155cc0>;
					regulator-boot-on;
					regulator-always-on;
				};

				v_vmid: vmid {
					regulator-name = "axp2202-vmid";
					regulator-enable-ramp-delay = <0x3e8>;
					regulator-always-on;
				};

				v_drivevbus: drivevbus {
					regulator-name = "axp2202-drivevbus";
					regulator-enable-ramp-delay = <0x3e8>;
					drivevbusin-supply = <&v_vmid>;
				};
			};

			virtual-dcdc1 {
				compatible = "xpower-vregulator,dcdc1";
				dcdc1-supply = <&v_dcdc1>;
			};

			virtual-dcdc2 {
				compatible = "xpower-vregulator,dcdc2";
				dcdc2-supply = <&v_dcdc2>;
			};

			virtual-dcdc3 {
				compatible = "xpower-vregulator,dcdc3";
				dcdc3-supply = <&v_dcdc3>;
			};

			virtual-dcdc4 {
				compatible = "xpower-vregulator,dcdc4";
				dcdc4-supply = <&v_dcdc4>;
			};

			virtual-rtcldo {
				compatible = "xpower-vregulator,rtcldo";
				rtcldo-supply = <&v_rtcldo>;
			};

			virtual-aldo1 {
				compatible = "xpower-vregulator,aldo1";
				aldo1-supply = <&v_aldo1>;
			};

			virtual-aldo2 {
				compatible = "xpower-vregulator,aldo2";
				aldo2-supply = <&v_aldo2>;
			};

			virtual-aldo3 {
				compatible = "xpower-vregulator,aldo3";
				aldo3-supply = <&v_aldo3>;
			};

			virtual-aldo4 {
				compatible = "xpower-vregulator,aldo4";
				aldo4-supply = <&v_aldo4>;
			};

			virtual-bldo1 {
				compatible = "xpower-vregulator,bldo1";
				bldo1-supply = <&v_bldo1>;
			};

			virtual-bldo2 {
				compatible = "xpower-vregulator,bldo2";
				bldo2-supply = <&v_bldo2>;
			};

			virtual-bldo3 {
				compatible = "xpower-vregulator,bldo3";
				bldo3-supply = <&v_bldo3>;
			};

			virtual-bldo4 {
				compatible = "xpower-vregulator,bldo4";
				bldo4-supply = <&v_bldo4>;
			};

			virtual-cldo1 {
				compatible = "xpower-vregulator,cldo1";
				cldo1-supply = <&v_cldo1>;
			};

			virtual-cldo2 {
				compatible = "xpower-vregulator,cldo2";
				cldo2-supply = <&v_cldo2>;
			};

			virtual-cldo3 {
				compatible = "xpower-vregulator,cldo3";
				cldo3-supply = <&v_cldo3>;
			};

			virtual-cldo4 {
				compatible = "xpower-vregulator,cldo4";
				cldo4-supply = <&v_cldo4>;
			};

			virtual-cpusldo {
				compatible = "xpower-vregulator,cpusldo";
				cpusldo-supply = <&v_cpusldo>;
			};

			virtual-drivevbus {
				compatible = "xpower-vregulator,drivevbus";
				drivevbus-supply = <&v_drivevbus>;
			};

			v_axp_gpio_0: axp_gpio@0 {
				gpio-controller;
				#size-cells = <0x00>;
				#gpio-cells = <0x06>;
				status = "okay";
			};
		};
};

/* Rails the vendor tree leaves at "whatever U-Boot set" (0.5-3.5 V range):
 * pin them like mainline does, so enabling them lands on the right voltage.
 * aldo4: codec AVCC and the 1.8 V PG bank; cldo1: speaker amp; cldo4: wifi. */
&v_aldo4 {
	regulator-min-microvolt = <1800000>;
	regulator-max-microvolt = <1800000>;
};

&v_cldo1 {
	regulator-min-microvolt = <3300000>;
	regulator-max-microvolt = <3300000>;
};

&v_cldo4 {
	regulator-min-microvolt = <3300000>;
	regulator-max-microvolt = <3300000>;
};

&sdc0 {
	pinctrl-0 = <&v_sdc0_0>;
	cd-gpios = <&pio 5 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; /* PF6 */
	cd-used-24M;
	sunxi-dis-signal-vol-sw;
	ctl-spec-caps = <0x608>;
	max-busy-timeout = <0x1388>;
	status = "okay";
};

/* TF2 slot: SMHC2 wired to the PC pins as a 4-bit SD port. */
&sdc2 {
	pinctrl-0 = <&v_sdc2_0 &v_sdc2_2>;
	pinctrl-1 = <&v_sdc2_1>;
	bus-width = <4>;
	/delete-property/ non-removable;
	/delete-property/ no-sd;
	no-mmc;
	cap-sd-highspeed;
	broken-cd;
	cd-gpios = <&pio 4 22 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; /* PE22 */
	card-pwr-gpios = <&pio 4 4 GPIO_ACTIVE_HIGH>; /* PE4 */
	cd-used-24M;
	sunxi-dis-signal-vol-sw;
	sunxi-power-save-mode;
	ctl-spec-caps = <0x608>;
	max-busy-timeout = <0x1388>;
	vqmmc-supply = <&v_aldo1>;
	status = "okay";
};

/* U-Boot uses the vendor copies under /soc instead. */
/delete-node/ &uboot_disp;
/delete-node/ &uboot_hdmi;

/* pll-video0-4x is the PLL's VCO and cannot go below 288 MHz; disp2 sets the
 * TCON parent to lcd_dclk_freq * 6 (144 MHz here), so feed tcon-lcd0 from the
 * /4 output instead or the panel is clocked at twice its dot clock. */
&disp {
	assigned-clocks = <&ccu CLK_TCON_TV0>, <&ccu CLK_TCON_LCD0>;
	assigned-clock-parents = <&ccu CLK_PLL_VIDEO2>, <&ccu CLK_PLL_VIDEO0>;
	assigned-clock-rates = <0>, <0>;
	disp_init_enable = <0x01>;
	disp_mode = <0x00>;
	screen0_output_type = <0x01>;
	screen0_output_mode = <0x00>;
	screen0_output_format = <0x00>;
	screen0_output_bits = <0x00>;
	screen0_output_eotf = <0x04>;
	screen0_output_cs = <0x101>;
	screen0_output_dvi_hdmi = <0x02>;
	screen0_output_range = <0x02>;
	screen0_output_scan = <0x00>;
	screen0_output_aspect_ratio = <0x08>;
	screen1_output_type = <0x02>;
	screen1_output_mode = <0x0b>;
	screen1_output_format = <0x01>;
	screen1_output_bits = <0x00>;
	screen1_output_eotf = <0x04>;
	screen1_output_cs = <0x104>;
	screen1_output_dvi_hdmi = <0x00>;
	screen1_output_range = <0x02>;
	screen1_output_scan = <0x00>;
	screen1_output_aspect_ratio = <0x08>;
	dev0_output_type = <0x01>;
	dev0_output_mode = <0x00>;
	dev0_screen_id = <0x00>;
	dev0_do_hpd = <0x00>;
	dev1_output_type = <0x02>;
	dev1_output_mode = <0x0b>;
	dev1_screen_id = <0x01>;
	dev1_do_hpd = <0x01>;
	dev2_output_type = <0x00>;
	def_output_dev = <0x00>;
	hdmi_mode_check = <0x01>;
	fb0_format = <0x00>;
	fb0_width = <0x00>;
	fb0_height = <0x00>;
	fb1_format = <0x00>;
	fb1_width = <0x00>;
	fb1_height = <0x00>;
	chn_cfg_mode = <0x01>;
	disp_para_zone = <0x01>;
	/* fb0 is sized at boot: room for a double-buffered 1280x720 HDMI fb */
	fb0_buffer_num = <6>;
};

&lcd0 {
	pinctrl-names = "active", "sleep";
	lcd_used = <0x01>;
	lcd_driver_name = "rg34xxsp_v1";
	lcd_backlight = <0x32>;
	lcd_if = <0x00>;
	lcd_hv_if = <0x00>;
	lcd_x = <0x2d0>;
	lcd_y = <0x1e0>;
	lcd_width = <0x96>;
	lcd_height = <0x5e>;
	lcd_dclk_freq = <0x1a>;
	lcd_pwm_used = <0x01>;
	lcd_pwm_ch = <0x00>;
	lcd_pwm_freq = <0xc350>;
	lcd_pwm_pol = <0x01>;
	lcd_pwm_max_limit = <0xff>;
	lcd_hbp = <0x2e>;
	lcd_ht = <0x334>;
	lcd_hspw = <0x02>;
	lcd_vbp = <0x14>;
	lcd_vt = <0x218>;
	lcd_vspw = <0x05>;
	lcd_lvds_if = <0x00>;
	lcd_lvds_colordepth = <0x00>;
	lcd_lvds_mode = <0x00>;
	lcd_frm = <0x00>;
	lcd_hv_clk_phase = <0x01>;
	lcd_hv_sync_polarity = <0x03>;
	lcd_gamma_en = <0x00>;
	lcd_bright_curve_en = <0x00>;
	lcd_cmap_en = <0x00>;
	deu_mode = <0x00>;
	lcdgamma4iep = <0x16>;
	smart_color = <0x5a>;
	lcd_pin_power;
	lcd_power;
	lcd_bl_en;
	lcd_gpio_0 = <&pio 0x08 0x09 0x01 0xffffffff 0xffffffff 0x01>;
	lcd_gpio_1 = <&pio 0x08 0x0a 0x01 0xffffffff 0xffffffff 0x01>;
	lcd_gpio_2 = <&pio 0x08 0x08 0x01 0xffffffff 0xffffffff 0x01>;
	lcd_gpio_3 = <&pio 0x08 0x0e 0x01 0xffffffff 0xffffffff 0x01>;
	lcd_gpio_4 = <&pio 0x08 0x0f 0x01 0xffffffff 0xffffffff 0x01>;
	pinctrl-0 = <&v_rgb24_0>;
	pinctrl-1 = <&v_rgb24_1>;
	/* init tables in the disp2 panel driver: PE6 high (pull-up) / low */
	lcd_panel_init = "rg34xx-sp-old", "rg34xx-sp-boe";
	lcd_id_gpio = <&pio 4 6 0 1 0xffffffff 0>;
};

&pwm0 {
	pinctrl-names = "active", "sleep";
	pinctrl-0 = <&v_pwm0_0>;
	pinctrl-1 = <&v_pwm0_1>;
	status = "okay";
};

&usbc0 {
	compatible = "allwinner,sunxi-otg-manager";
	usb_port_type = <0x02>;
	usb_detect_type = <0x02>;
	usb_id_gpio;
	usb_det_vbus_gpio = "axp_ctrl";
	usb_drv_vbus_gpio = <&pio 0x08 0x10 0x00 0x01 0xffffffff 0xffffffff>;
	usb_host_init_state = <0x00>;
	usb_regulator_io = "nocare";
	usb_wakeup_suspend = <0x00>;
	usb_luns = <0x03>;
	usb_serial_unique = <0x00>;
	usb_serial_number = "20080411";
	rndis_wceis = <0x01>;
	status = "okay";
	usb_detect_mode = <0x00>;
	det_vbus_supply = <&v_usb_power_supply>;
};

&sdc1 {
	pinctrl-0 = <&v_sdc1_0>;
	pinctrl-1 = <&v_sdc1_1>;
	max-frequency = <0x8f0d180>;
	sunxi-dly-104M = <0x01 0x00 0x00 0x00 0x01>;
	sunxi-dly-208M = <0x01 0x00 0x00 0x00 0x01>;
	no-mmc;
	no-sd;
	cap-sd-highspeed;
	sunxi-dis-signal-vol-sw;
	sdio-used-1v8;
	cap-sdio-irq;
	ignore-pm-notify;
	status = "okay";
};


/* bluetooth side of the RTL8821CS */
&uart1 {
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&v_uart1_0>;
	pinctrl-1 = <&v_uart1_1>;
	status = "okay";
};

/* RTL8821CS: PG18 wifi enable, PG19 bt reset, PG15/PG16 host wake, PG17
 * bt wake, cldo4 the module rail, and the 32 kHz fanout on PG10.  bt_rst_n
 * is active low for sunxi-bt: probe drives the assert level, on releases it. */
&rfkill {
	pinctrl-names = "default";
	pinctrl-0 = <&v_clk_losc_0>;
	status = "okay";

	wlan {
		compatible = "allwinner,sunxi-wlan";
		clocks = <&rtc_ccu CLK_OSC32K_OUT>;
		clock-names = "32k-fanout";
		assigned-clocks = <&rtc_ccu CLK_OSC32K_OUT>;
		assigned-clock-parents = <&rtc_ccu CLK_DCXO_32K_OUT>;
		wlan_busnum = <1>;
		wlan_power = "axp2202-cldo4";
		wlan_regon = <&pio 6 18 GPIO_ACTIVE_HIGH>; /* PG18 */
		wlan_hostwake = <&pio 6 15 GPIO_ACTIVE_HIGH>; /* PG15 */
	};

	bt {
		compatible = "allwinner,sunxi-bt";
		clocks = <&rtc_ccu CLK_OSC32K_OUT>;
		clock-names = "32k-fanout";
		bt_rst_n = <&pio 6 19 GPIO_ACTIVE_LOW>; /* PG19 */
	};
};

&btlpm {
	uart_index = <1>;
	bt_wake = <&pio 6 17 GPIO_ACTIVE_HIGH>; /* PG17 */
	bt_hostwake = <&pio 6 16 GPIO_ACTIVE_HIGH>; /* PG16 */
	status = "okay";
};

/* Internal codec, card "audiocodec".  PI5 enables the speaker amplifier on
 * cldo1; PI3 is the headphone jack, high when a plug is in (kernel patch
 * 0008 mutes the amplifier while it is). */
&codec {
	lineout_vol = <0x1f>;
	tx_hub_en;
	pa_pin_max = <1>;
	pa_pin_0 = <&pio 8 5 GPIO_ACTIVE_HIGH>; /* PI5 */
	pa_pin_level_0 = <1>;
	pa_pin_msleep_0 = <100>;
	pa-supply = <&v_cldo1>;
	hp-det-gpios = <&pio 8 3 GPIO_ACTIVE_HIGH>; /* PI3 */
	status = "okay";
};

&codec_plat {
	status = "okay";
};

&codec_mach {
	status = "okay";
};

/* third reg: the EHCI0 PMU block, whose PHY0 SIDDQ the udc clears (0011) */
&udc {
	reg = <0x0 0x05100000 0x0 0x1000>,
	      <0x0 0x00000000 0x0 0x100>,
	      <0x0 0x05310800 0x0 0x100>;
	clocks = <&ccu CLK_BUS_OTG>, <&ccu CLK_USB_PHY0>, <&ccu CLK_USB_PHY2>, <&ccu CLK_BUS_EHCI2>;
	clock-names = "bus_otg", "phy", "phy2", "bus_ehci2";
	resets = <&ccu RST_BUS_OTG>, <&ccu RST_USB_PHY0>, <&ccu RST_USB_PHY2>, <&ccu RST_BUS_EHCI2>;
	reset-names = "otg", "phy", "phy2", "ehci2";
	det_vbus_supply = <&v_usb_power_supply>;
	status = "okay";
};

&ehci0 {
	drvvbus-supply = <&v_drivevbus>;
	status = "okay";
};

&ohci0 {
	drvvbus-supply = <&v_drivevbus>;
	status = "okay";
};
