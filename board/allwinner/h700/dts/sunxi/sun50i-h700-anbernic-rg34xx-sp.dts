/*
 * Anbernic RG34XX-SP, on the orangepi 5.4 sun50iw9 BSP.
 *
 * Generated from the vendor 4.9 device tree by
 * board/allwinner/h700/scripts/build_dts.py.  The vendor U-Boot 2018
 * shares this DTB with the kernel: it wants the legacy /clocks tree, the
 * sys_config nodes under /soc and allwinner,* pin properties, which the 5.4
 * kernel either ignores or understands as a fallback.
 */

/dts-v1/;

#include "sun50iw9.dtsi"
#include <dt-bindings/input/input.h>
#include <dt-bindings/input/gpio-keys.h>

/ {
	model = "Anbernic RG34XX-SP";
	/* the extlinux entry this tree belongs to (S01knulli-device) */
	knulli,device = "rg34xx-sp";
	compatible = "allwinner,h616", "arm,sun50iw9p1";

	aliases {
		disp = &v_disp_01000000;
		hdmi = &v_hdmi_06000000;
		lcd0 = &v_lcd0_01c0c000;
		lcd1 = &v_lcd1_01c0c001;
		tv0 = &v_tv0_01c94000;
		pwm = &v_pwm_0300a000;
		pwm0 = &v_pwm0_0300a000;
		pwm1 = &v_pwm1_0300a000;
		pwm2 = &v_pwm2_0300a000;
		pwm3 = &v_pwm3_0300a000;
		pwm4 = &v_pwm4_0300a000;
		pwm5 = &v_pwm5_0300a000;
		pmu0 = &v_pmu;
		standby_param = &v_standby_param;
		twi5 = &twi5;
		mmc0 = &sdc0;
		mmc2 = &sdc2;
		sdc0 = &sdc0;
		sdc2 = &sdc2;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	memory@40000000 {
		device_type = "memory";
		reg = <0x00 0x40000000 0x00 0x20000000>;
	};

	clocks {
		compatible = "allwinner,clk-init";
		device_type = "clocks";
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
		reg = <0x00 0x3001000 0x00 0x1000 0x00 0x7010000 0x00 0x400 0x00 0x7000000 0x00 0x04>;

		clk_losc: losc {
			#clock-cells = <0x00>;
			compatible = "allwinner,fixed-clock";
			clock-frequency = <0x8000>;
			clock-output-names = "losc";
		};

		clk_iosc: iosc {
			#clock-cells = <0x00>;
			compatible = "allwinner,fixed-clock";
			clock-frequency = <0xf42400>;
			clock-output-names = "iosc";
		};

		clk_hosc: hosc {
			#clock-cells = <0x00>;
			compatible = "allwinner,fixed-clock";
			clock-frequency = <0x16e3600>;
			clock-output-names = "hosc";
		};

		clk_osc48m: osc48m {
			#clock-cells = <0x00>;
			compatible = "allwinner,fixed-clock";
			clock-frequency = <0x2dc6c00>;
			clock-output-names = "osc48m";
		};

		clk_hoscdiv32k: hoscdiv32k {
			#clock-cells = <0x00>;
			compatible = "allwinner,fixed-clock";
			clock-frequency = <0x8000>;
			clock-output-names = "hoscdiv32k";
		};

		clk_pll_periph0div25m: pll_periph0div25m {
			#clock-cells = <0x00>;
			compatible = "allwinner,fixed-clock";
			clock-frequency = <0x17d7840>;
			clock-output-names = "pll_periph0div25m";
		};

		clk_pll_cpu: pll_cpu {
			#clock-cells = <0x00>;
			compatible = "allwinner,pll-clock";
			lock-mode = "new";
			clock-output-names = "pll_cpu";
		};

		clk_pll_ddr0: pll_ddr0 {
			#clock-cells = <0x00>;
			compatible = "allwinner,pll-clock";
			lock-mode = "new";
			clock-output-names = "pll_ddr0";
		};

		clk_pll_ddr1: pll_ddr1 {
			#clock-cells = <0x00>;
			compatible = "allwinner,pll-clock";
			lock-mode = "new";
			clock-output-names = "pll_ddr1";
		};

		clk_pll_periph0: pll_periph0 {
			#clock-cells = <0x00>;
			compatible = "allwinner,pll-clock";
			assigned-clocks = <&clk_pll_periph0>;
			assigned-clock-rates = <0x23c34600>;
			lock-mode = "new";
			clock-output-names = "pll_periph0";
		};

		clk_pll_periph1: pll_periph1 {
			#clock-cells = <0x00>;
			compatible = "allwinner,pll-clock";
			assigned-clocks = <&clk_pll_periph1>;
			assigned-clock-rates = <0x23c34600>;
			lock-mode = "new";
			clock-output-names = "pll_periph1";
		};

		clk_pll_gpu: pll_gpu {
			#clock-cells = <0x00>;
			compatible = "allwinner,pll-clock";
			lock-mode = "new";
			clock-output-names = "pll_gpu";
		};

		clk_pll_video0x4: pll_video0x4 {
			#clock-cells = <0x00>;
			compatible = "allwinner,pll-clock";
			lock-mode = "new";
			clock-output-names = "pll_video0x4";
		};

		clk_pll_video1: pll_video1 {
			#clock-cells = <0x00>;
			compatible = "allwinner,pll-clock";
			lock-mode = "new";
			assigned-clocks = <&clk_pll_video1>;
			assigned-clock-rates = <0x19bfcc00>;
			clock-output-names = "pll_video1";
		};

		clk_pll_video2: pll_video2 {
			#clock-cells = <0x00>;
			compatible = "allwinner,pll-clock";
			lock-mode = "new";
			assigned-clocks = <&clk_pll_video2>;
			clock-output-names = "pll_video2";
		};

		clk_pll_ve: pll_ve {
			#clock-cells = <0x00>;
			compatible = "allwinner,pll-clock";
			device_type = "clk_pll_ve";
			lock-mode = "new";
			clock-output-names = "pll_ve";
		};

		clk_pll_de: pll_de {
			#clock-cells = <0x00>;
