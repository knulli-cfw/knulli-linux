	v_standby_param: standby_param {
		universal-standby = <0x01>;
		vdd-cpua = <0x01>;
		vdd-sys = <0x02>;
		vcc-io = <0x4000>;
		vcc-pll = <0x00>;
		vcc-dram = <0x00>;
	};

	v_axp2202_parameter: axp2202-parameter {
		select = "battery-model";

		battery-model {
			parameter = <0x1f54000 0x1b1e280f 0xc1e3202 0x14050a04 0x74fbe10d 0x431036fb 0x4b01ea0a 0x88063606 0xd0ad50f 0x670f0e09 0xb80e5b0e 0x54044604 0x39092e0e 0x1e0e1809 0xa0ded0d 0xe403ce03 0xb408990d 0x830d6a07 0xed743d34 0x28151b0e 0xc5987e66 0x4e44381a 0x120af600 0xf600f6 0xfb0000 0xfb0000fb 0xf600 0xf600f6 0xfb0000 0xfb0000fb 0xf600 0xf600f6>;
		};
	};

	joypad: rocknix-singleadc-joypad {
		compatible = "rocknix-singleadc-joypad";
		joypad-name = "Anbernic RG34XX-SP Controller";
		/* same ids as the gpio-keys device had: the es_input.cfg entries
		 * match GUID 19000000010000000100000000010000 */
		joypad-vendor = <0x0001>;
		joypad-product = <0x0001>;
		joypad-revision = <0x0100>;
		poll-interval = <20>;

		/* sticks: 4 axes through the analog mux into gpadc channel 0 */
		io-channel-names = "amux_adc";
		io-channels = <&gpadc 0>;
		amux-count = <4>;
		/* ABS_RY ABS_RX ABS_Y ABS_X */
		amux-channel-mapping = <0 2 1 3>;
		amux-en-gpios = <&pio 8 0 GPIO_ACTIVE_HIGH>; /* PI0 */
		amux-a-gpios = <&pio 8 1 GPIO_ACTIVE_LOW>;   /* PI1 */
		amux-b-gpios = <&pio 8 2 GPIO_ACTIVE_LOW>;   /* PI2 */
		button-adc-scale = <2>;
		button-adc-deadzone = <128>;
		button-adc-fuzz = <32>;
		button-adc-flat = <32>;
		abs_x-p-tuning = <70>;
		abs_x-n-tuning = <70>;
		invert-absx;
		abs_y-p-tuning = <70>;
		abs_y-n-tuning = <70>;
		invert-absy;
		abs_rx-p-tuning = <70>;
		abs_rx-n-tuning = <70>;
		invert-absrx;
		abs_ry-p-tuning = <70>;
		abs_ry-n-tuning = <70>;
		invert-absry;

		keyup {
			label = "GPIO Key Up";
			gpios = <&pio 0 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; /* PA6 */
			linux,code = <0x11>;
			linux,input-type = <0x03>;
			linux,input-value = <0xffffffff>;
		};
		keydown {
			label = "GPIO Key Down";
			gpios = <&pio 4 0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; /* PE0 */
			linux,code = <0x11>;
			linux,input-type = <0x03>;
			linux,input-value = <0x01>;
		};
		keyleft {
			label = "GPIO Key left";
			gpios = <&pio 0 8 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; /* PA8 */
			linux,code = <0x10>;
			linux,input-type = <0x03>;
			linux,input-value = <0xffffffff>;
		};
		keyright {
			label = "GPIO Key right";
			gpios = <&pio 0 9 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; /* PA9 */
			linux,code = <0x10>;
			linux,input-type = <0x03>;
			linux,input-value = <0x01>;
		};
		keya {
			label = "GPIO Key a";
			gpios = <&pio 0 0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; /* PA0 */
			linux,code = <BTN_EAST>;
		};
		keyb {
			label = "GPIO Key b";
			gpios = <&pio 0 1 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; /* PA1 */
			linux,code = <BTN_SOUTH>;
		};
		keyx {
			label = "GPIO Key x";
			gpios = <&pio 0 3 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; /* PA3 */
			linux,code = <BTN_WEST>;
		};
		keyy {
			label = "GPIO Key y";
			gpios = <&pio 0 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; /* PA2 */
			linux,code = <BTN_NORTH>;
		};
		keystart {
			label = "GPIO Key start";
			gpios = <&pio 0 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; /* PA4 */
			linux,code = <BTN_START>;
		};
		keysel {
			label = "GPIO Key select";
			gpios = <&pio 0 5 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; /* PA5 */
			linux,code = <BTN_SELECT>;
		};
		keyl1 {
			label = "GPIO Key L1";
			gpios = <&pio 0 10 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; /* PA10 */
			linux,code = <BTN_TL>;
		};
		keyl2 {
			label = "GPIO Key L2";
			gpios = <&pio 0 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; /* PA11 */
			linux,code = <BTN_TL2>;
		};
		keyr1 {
			label = "GPIO Key R1";
			gpios = <&pio 0 12 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; /* PA12 */
			linux,code = <BTN_TR>;
		};
		keyr2 {
			label = "GPIO Key R2";
			gpios = <&pio 0 7 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; /* PA7 */
			linux,code = <BTN_TR2>;
		};
		keyl3 {
			label = "GPIO Key L3";
			gpios = <&pio 4 8 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; /* PE8 */
			linux,code = <BTN_THUMBL>;
		};
		keyr3 {
			label = "GPIO Key R3";
			gpios = <&pio 4 9 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; /* PE9 */
			linux,code = <BTN_THUMBR>;
		};
		keymenu {
			label = "GPIO Key Menu";
			gpios = <&pio 4 3 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; /* PE3 */
			linux,code = <BTN_MODE>;
		};
		keyvol-up {
			label = "GPIO Key Vol up";
			gpios = <&pio 4 1 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; /* PE1 */
			linux,code = <KEY_VOLUMEUP>;
		};
		keyvol-down {
			label = "GPIO Key vol down";
			gpios = <&pio 4 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; /* PE2 */
			linux,code = <KEY_VOLUMEDOWN>;
		};
	};

	gpio-keys-lid {
		compatible = "gpio-keys";

		lid-switch {
			label = "Lid Switch";
			gpios = <&pio 4 7 GPIO_ACTIVE_LOW>; /* PE7 */
			linux,input-type = <EV_SW>;
			linux,code = <SW_LID>;
			linux,can-disable;
			debounce-interval = <20>;
			wakeup-source;
			wakeup-event-action = <EV_ACT_DEASSERTED>;
		};
	};
};

/* the sunxi GPADC through the mainline IIO driver (kernel patch 0018) */
&gpadc {
	compatible = "allwinner,sun50i-h616-gpadc";
	#address-cells = <1>;
	#size-cells = <0>;
	#io-channel-cells = <1>;
	status = "okay";

	channel@0 {
		reg = <0>;
	};
};

/* No OP-TEE in this boot package. */
&{/firmware/optee} {
	status = "disabled";
};

&cpu0 {
	cpu-supply = <&v_dcdc1>;
};

/* The H700 fuses speed bin 0x6c00, which the 5.4 cpufreq-nvmem driver maps
 * to "a5" (kernel patch 0012); the dtsi table only knows a0-a4.  Voltages
 * are mainline's speed5 set (rocknix), which runs this device at 1.5 GHz. */
&cpu_opp_table {
	opp@480000000 {
		opp-microvolt-a5 = <900000>;
		opp-supported-hw = <0x3f>;
	};
	opp@720000000 {
		opp-microvolt-a5 = <900000>;
		opp-supported-hw = <0x2d>;
	};
	opp@1008000000 {
		opp-microvolt-a5 = <900000>;
		opp-supported-hw = <0x3f>;
	};
	opp@1104000000 {
		opp-microvolt-a5 = <950000>;
		opp-supported-hw = <0x2d>;
	};
	opp@1200000000 {
		opp-microvolt-a5 = <1020000>;
		opp-supported-hw = <0x3f>;
	};
	opp@1416000000 {
		opp-microvolt-a5 = <1100000>;
		opp-supported-hw = <0x2d>;
	};
	opp@1512000000 {
		opp-microvolt-a5 = <1160000>;
		opp-supported-hw = <0x2a>;
	};
};

/* Mali OPPs and dvfs knobs from the vendor tree (legacy operating-points),
 * minus the 696 MHz @ 0.96 V point: the GPU rail (dcdc2) is a fixed 0.94 V. */
&gpu {
	gpu_idle = <0x01>;
	dvfs_status = <0x01>;
	operating-points = <240000 900000  336000 900000  420000 900000
			    504000 900000  600000 900000>;
};

&dram {
	dram_clk = <0x2a0>;
	dram_type = <0x08>;
	dram_zq = <0x3f3fdd>;
	dram_odt_en = <0x7887bbbb>;
	dram_para1 = <0x310a>;
	dram_para2 = <0x00>;
	dram_mr0 = <0x00>;
	dram_mr1 = <0x34>;
	dram_mr2 = <0x1b>;
	dram_mr3 = <0x33>;
	dram_tpr0 = <0x00>;
	dram_tpr1 = <0x00>;
	dram_tpr2 = <0x01>;
	dram_tpr3 = <0x00>;
	dram_tpr4 = <0x00>;
	dram_tpr5 = <0x00>;
	dram_tpr6 = <0x40808080>;
	dram_tpr7 = <0x00>;
	dram_tpr8 = <0x00>;
	dram_tpr9 = <0x00>;
	dram_tpr10 = <0x402f6633>;
	dram_tpr11 = <0x00>;
	dram_tpr12 = <0x00>;
	dram_tpr13 = <0x2008c60>;
	dram_dx_odt = <0x8080808>;
	dram_dx_dri = <0xe0e0e0e>;
	dram_ca_dri = <0xe0e>;
	dram_mr4 = <0x03>;
	dram_mr5 = <0x00>;
	dram_mr6 = <0x00>;
	dram_mr11 = <0x04>;
	dram_mr12 = <0x72>;
	dram_mr13 = <0x00>;
	dram_mr14 = <0x09>;
	dram_mr16 = <0x00>;
	dram_mr17 = <0x00>;
	dram_mr22 = <0x24>;
};

/* U-Boot reaches these through its aliases only; keeping them out of the
 * simple-bus means the kernel creates no platform devices for them (they
 * would collide with the dtsi nodes of the same unit address). */
/ {
	uboot-display {
		#address-cells = <2>;
		#size-cells = <2>;
		v_disp_01000000: disp@01000000 {
			reg = <0x00 0x1000000 0x00 0x1400000 0x00 0x6510000 0x00 0x200 0x00 0x6511000 0x00 0x1000 0x00 0x6512000 0x00 0x1000 0x00 0x6515000 0x00 0x1000 0x00 0x6516000 0x00 0x1000>;
			interrupts = <0x00 0x58 0x04 0x00 0x40 0x04 0x00 0x41 0x04 0x00 0x42 0x04 0x00 0x43 0x04>;
			clocks = <&clk_de &clk_display_top &clk_tcon_lcd &clk_tcon_lcd1 &clk_tcon_tv &clk_tcon_tv1 &clk_lvds>;
			boot_disp = <0x00>;
			fb_base = <0x00>;
			status = "okay";
			disp_init_enable = <0x01>;
			disp_mode = <0x00>;
			screen0_output_type = <0x01>;
			screen0_output_mode = <0x00>;
			screen0_output_format = <0x00>;
			screen0_output_bits = <0x00>;
			screen0_output_eotf = <0x04>;
			screen0_output_cs = <0x101>;
			screen0_output_dvi_hdmi = <0x02>;
			screen0_output_range = <0x02>;
			screen0_output_scan = <0x00>;
			screen0_output_aspect_ratio = <0x08>;
			screen1_output_type = <0x02>;
			screen1_output_mode = <0x0b>;
			screen1_output_format = <0x01>;
			screen1_output_bits = <0x00>;
			screen1_output_eotf = <0x04>;
			screen1_output_cs = <0x104>;
			screen1_output_dvi_hdmi = <0x00>;
			screen1_output_range = <0x02>;
			screen1_output_scan = <0x00>;
			screen1_output_aspect_ratio = <0x08>;
			dev0_output_type = <0x01>;
			dev0_output_mode = <0x00>;
