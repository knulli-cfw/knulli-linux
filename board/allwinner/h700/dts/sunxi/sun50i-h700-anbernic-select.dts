		lcd_gpio_0 = <&pio 0x08 0x09 0x01 0xffffffff 0xffffffff 0x01>;
		lcd_gpio_1 = <&pio 0x08 0x0a 0x01 0xffffffff 0xffffffff 0x01>;
		lcd_gpio_2 = <&pio 0x08 0x08 0x01 0xffffffff 0xffffffff 0x01>;
		lcd_gpio_3 = <&pio 0x08 0x0e 0x01 0xffffffff 0xffffffff 0x01>;
		lcd_gpio_4 = <&pio 0x08 0x0f 0x01 0xffffffff 0xffffffff 0x01>;
		lcd_panel_init = "rg28xx";
	};
};
