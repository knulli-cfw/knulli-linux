// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
/*
 * Anbernic H700, on the orangepi 5.4 sun50iw9 BSP.
 *
 * Generated from the vendor 4.9 device tree by
 * board/allwinner/h700/scripts/build_dts.py.  The vendor U-Boot 2018
 * shares this DTB with the kernel: it wants the legacy /clocks tree, the
 * sys_config nodes under /soc and allwinner,* pin properties, which the 5.4
 * kernel either ignores or understands as a fallback.
 */

/dts-v1/;

#include "sun50i-h700-anbernic.dtsi"

/ {
	model = "Anbernic H700";
	/* the extlinux entry this tree belongs to (S01knulli-device) */
	knulli,device = "select";

	joypad: rocknix-singleadc-joypad {
		joypad-name = "Anbernic RG35XX-Plus Controller";
		amux-count = <0>;
		rocknix,dpad-joystick;

		keyl3 {
			label = "GPIO Key L3";
			gpios = <&pio 4 8 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; /* PE8 */
			linux,code = <BTN_THUMBL>;
		};

		keyr3 {
			label = "GPIO Key R3";
			gpios = <&pio 4 9 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; /* PE9 */
			linux,code = <BTN_THUMBR>;
		};

		keymenu {
			label = "GPIO Key Menu";
			gpios = <&pio 4 3 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; /* PE3 */
			linux,code = <BTN_MODE>;
		};

		keyvol-up {
			label = "GPIO Key Vol up";
			gpios = <&pio 4 1 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; /* PE1 */
			linux,code = <KEY_VOLUMEUP>;
		};

		keyvol-down {
			label = "GPIO Key vol down";
			gpios = <&pio 4 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; /* PE2 */
			linux,code = <KEY_VOLUMEDOWN>;
		};
	};
};

&dram {
	dram_tpr13 = <0x2000c60>;
};

/ {
	uboot-display {
		v_disp_01000000: disp@01000000 {
			hdmi_mode_check = <0x01>;
			fb0_width = <0x00>;
			fb0_height = <0x00>;
		};

		v_lcd0_01c0c000: lcd0@01c0c000 {
			lcd_driver_name = "fog_fj035fhd05_v1";
			lcd_x = <0x280>;
			lcd_y = <0x1e0>;
			lcd_dclk_freq = <0x18>;
			lcd_hbp = <0x2e>;
			lcd_ht = <0x302>;
			lcd_hspw = <0x14>;
			lcd_vbp = <0x0f>;
			lcd_vt = <0x208>;
			lcd_vspw = <0x04>;
			lcd_frm = <0x01>;
			lcd_hv_clk_phase = <0x02>;
			lcd_hv_sync_polarity = <0x03>;
		};

		v_pwm2_0300a000: pwm2@0300a000 {
			pinctrl-0 = <&v_pwm2_0>;
			pinctrl-1 = <&v_pwm2_1>;
			clk_bypass_output = <0x01>;
			status = "okay";
		};
	};
};

&soc {
		charger0 {
			pmu_safe_vol = <0xd7a>;
		};

		dram_select_para {
			select_mode = <0x01>;
			select_gpio0 = <&pio 0x07 0x06 0x00 0x01 0xffffffff 0xffffffff>;
			select_gpio1 = <&pio 0x07 0x07 0x00 0x01 0xffffffff 0xffffffff>;
			select_gpio2 = <&pio 0x07 0x08 0x00 0x01 0xffffffff 0xffffffff>;
			select_gpio3 = <&pio 0x07 0x0a 0x00 0x01 0xffffffff 0xffffffff>;
		};

		dram_para14 {
			dram_clk = <0x2a0>;
			dram_type = <0x07>;
			dram_dx_odt = <0x6060606>;
			dram_dx_dri = <0xd0d0d0d>;
			dram_ca_dri = <0x1919>;
			dram_odt_en = <0x9988eeee>;
			dram_mr0 = <0x00>;
			dram_mr1 = <0xc3>;
			dram_mr2 = <0x06>;
			dram_mr3 = <0x01>;
			dram_tpr2 = <0x01>;
			dram_tpr6 = <0x2fb08080>;
			dram_tpr10 = <0x402f4489>;
			dram_tpr11 = <0xe0e0f0e>;
			dram_tpr12 = <0xf10110f>;
			dram_tpr13 = <0x8c60>;
		};

		dram_para15 {
			dram_clk = <0x2a0>;
			dram_type = <0x08>;
			dram_odt_en = <0x7887bbbb>;
			dram_para1 = <0x310a>;
			dram_para2 = <0x00>;
			dram_mr0 = <0x00>;
			dram_mr1 = <0x34>;
			dram_mr2 = <0x1b>;
			dram_mr3 = <0x33>;
			dram_mr4 = <0x03>;
			dram_mr11 = <0x04>;
			dram_mr12 = <0x72>;
			dram_mr14 = <0x09>;
			dram_mr22 = <0x24>;
			dram_tpr2 = <0x01>;
			dram_tpr6 = <0x40808080>;
			dram_tpr10 = <0x402f6633>;
			dram_tpr13 = <0x2008c60>;
		};
};

&pio {
	lcd_id_pin: lcd-id-pin {
		allwinner,pull = <1>;
	};

		v_pwm2_0: v-pwm2-0 {
			allwinner,pins = "PH2";
			allwinner,function = "pwm2";
			allwinner,muxsel = <0x04>;
			allwinner,drive = <0xffffffff>;
			allwinner,pull = <0x00>;
			allwinner,data = <0xffffffff>;
			drive-strength = <10>;
		};

		v_pwm2_1: v-pwm2-1 {
			allwinner,pins = "PH2";
			allwinner,function = "io_disabled";
			allwinner,muxsel = <0x07>;
			allwinner,drive = <0xffffffff>;
			allwinner,pull = <0x00>;
			allwinner,data = <0xffffffff>;
			drive-strength = <10>;
			function = "gpio_in";
		};

		v_uart0_1: v-uart0-1 {
			allwinner,pins = "PH0", "PH1";
			allwinner,function = "uart0";
			allwinner,muxsel = <0x07>;
			allwinner,drive = <0x01>;
			allwinner,pull = <0x00>;
		};

		v_sdc0_0: v-sdc0-0 {
			allwinner,pins = "PF0", "PF1", "PF2", "PF3", "PF4", "PF5";
			allwinner,function = "sdc0";
			allwinner,muxsel = <0x02>;
			allwinner,drive = <0x03>;
			allwinner,pull = <0x01>;
		};

		v_sdc2_0: v-sdc2-0 {
			allwinner,pins = "PC1", "PC5", "PC6", "PC8", "PC9", "PC10", "PC11", "PC13", "PC14", "PC15", "PC16";
			allwinner,function = "sdc2";
			allwinner,muxsel = <0x03>;
			allwinner,drive = <0x02>;
			allwinner,pull = <0x01>;
		};

		v_sdc2_2: v-sdc2-2 {
			allwinner,pins = "PC0";
			allwinner,function = "sdc2";
			allwinner,muxsel = <0x03>;
			allwinner,drive = <0x02>;
			allwinner,pull = <0x02>;
		};

		v_sdc2_1: v-sdc2-1 {
			allwinner,pins = "PC0", "PC1", "PC5", "PC6", "PC8", "PC9", "PC10", "PC11", "PC13", "PC14", "PC15", "PC16";
			allwinner,function = "io_disabled";
			allwinner,muxsel = <0x07>;
			allwinner,drive = <0x01>;
			allwinner,pull = <0x01>;
			function = "gpio_in";
		};

		v_uart1_0: v-uart1-0 {
			allwinner,pins = "PG6", "PG7", "PG8", "PG9";
			allwinner,pname = "uart1_tx", "uart1_rx", "uart1_rts", "uart1_cts";
			allwinner,function = "uart1";
			allwinner,muxsel = <0x02>;
			allwinner,drive = <0x01>;
			allwinner,pull = <0x01>;
		};

		v_uart1_1: v-uart1-1 {
			allwinner,pins = "PG6", "PG7", "PG8", "PG9";
			allwinner,function = "io_disabled";
			allwinner,muxsel = <0x07>;
			allwinner,drive = <0x01>;
			allwinner,pull = <0x00>;
			function = "gpio_in";
		};

		v_sdc1_0: v-sdc1-0 {
			allwinner,pins = "PG0", "PG1", "PG2", "PG3", "PG4", "PG5";
			allwinner,function = "sdc1";
			allwinner,muxsel = <0x02>;
			allwinner,drive = <0x03>;
			allwinner,pull = <0x01>;
		};

		v_sdc1_1: v-sdc1-1 {
			allwinner,pins = "PG0", "PG1", "PG2", "PG3", "PG4", "PG5";
			allwinner,function = "io_disabled";
			allwinner,muxsel = <0x07>;
			allwinner,drive = <0x01>;
			allwinner,pull = <0x01>;
			function = "gpio_in";
		};

		v_clk_losc_0: v-clk-losc-0 {
			allwinner,pins = "PG10";
			allwinner,function = "x32kfout";
			allwinner,muxsel = <0x03>;
			allwinner,drive = <0x02>;
			allwinner,pull = <0x01>;
		};
};

&twi5 {
		v_pmu: pmu {
			v_usb_power_supply: usb_power_supply {
				allen_usb2_id_det = <&pio 0x08 0x06 0x01 0x02 0xffffffff 0x00>;
				allen_usb2_vbus_en = <&pio 0x08 0x07 0x01 0x01 0xffffffff 0x00>;
				allen_usb2_pwr_en = <&pio 0x04 0x05 0x01 0x00 0xffffffff 0x00>;
			};

			v_bat_power_supply: bat-power-supply {
				pmu_battery_cap = <0xbb8>;
				pmu_battery_warning_level1 = <0x05>;
				wakeup_bat_out;
				wakeup_bat_untemp_work;
				wakeup_bat_ovtemp_work;
				low_pwr_led = <&pio 0x08 0x0b 0x01 0x01 0xffffffff 0x00>;
				moto_pwm_gpio = <&pio 0x07 0x02 0x01 0x01 0xffffffff 0x00>;
			};
		};
};

&disp {
	hdmi_mode_check = <0x01>;
	fb0_width = <0x00>;
	fb0_height = <0x00>;
	/* fb0 is sized at boot: room for a double-buffered 1280x720 HDMI fb */
	fb0_buffer_num = <6>;
};

&lcd0 {
	lcd_driver_name = "fog_fj035fhd05_v1";
	lcd_x = <0x280>;
	lcd_y = <0x1e0>;
	lcd_dclk_freq = <0x18>;
	lcd_hbp = <0x2e>;
	lcd_ht = <0x302>;
	lcd_hspw = <0x14>;
	lcd_vbp = <0x0f>;
	lcd_vt = <0x208>;
	lcd_vspw = <0x04>;
	lcd_frm = <0x01>;
	lcd_hv_clk_phase = <0x02>;
	lcd_hv_sync_polarity = <0x03>;
	/* init tables in the disp2 panel driver: PE6 high (pull-up) / low */
	lcd_panel_init = "rg35xx-plus-old", "rg35xx-plus-boe";
	lcd_id_gpio = <&pio 4 6 0 1 0xffffffff 0>;
};

/* bluetooth side of the RTL8821CS */
&uart1 {
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&v_uart1_0>;
	pinctrl-1 = <&v_uart1_1>;
	status = "okay";
};

/* RTL8821CS: PG18 wifi enable, PG19 bt reset, PG15/PG16 host wake, PG17
 * bt wake, cldo4 the module rail, and the 32 kHz fanout on PG10.  bt_rst_n
 * is active low for sunxi-bt: probe drives the assert level, on releases it. */
&rfkill {
	pinctrl-names = "default";
	pinctrl-0 = <&v_clk_losc_0>;
	status = "okay";

	wlan {
		compatible = "allwinner,sunxi-wlan";
		clocks = <&rtc_ccu CLK_OSC32K_OUT>;
		clock-names = "32k-fanout";
		assigned-clocks = <&rtc_ccu CLK_OSC32K_OUT>;
		assigned-clock-parents = <&rtc_ccu CLK_DCXO_32K_OUT>;
		wlan_busnum = <1>;
		wlan_power = "axp2202-cldo4";
		wlan_regon = <&pio 6 18 GPIO_ACTIVE_HIGH>; /* PG18 */
		wlan_hostwake = <&pio 6 15 GPIO_ACTIVE_HIGH>; /* PG15 */
	};

	bt {
		compatible = "allwinner,sunxi-bt";
		clocks = <&rtc_ccu CLK_OSC32K_OUT>;
		clock-names = "32k-fanout";
		bt_rst_n = <&pio 6 19 GPIO_ACTIVE_LOW>; /* PG19 */
	};
};

&btlpm {
	uart_index = <1>;
	bt_wake = <&pio 6 17 GPIO_ACTIVE_HIGH>; /* PG17 */
	bt_hostwake = <&pio 6 16 GPIO_ACTIVE_HIGH>; /* PG16 */
	status = "okay";
};

/* Internal codec, card "audiocodec".  PI5 enables the speaker amplifier on
 * cldo1; PI3 is the headphone jack, high when a plug is in (kernel patch
 * 0008 mutes the amplifier while it is). */
&codec {
	lineout_vol = <0x1f>;
	tx_hub_en;
	pa_pin_max = <1>;
	pa_pin_0 = <&pio 8 5 GPIO_ACTIVE_HIGH>; /* PI5 */
	pa_pin_level_0 = <1>;
	pa_pin_msleep_0 = <100>;
	pa-supply = <&v_cldo1>;
	hp-det-gpios = <&pio 8 3 GPIO_ACTIVE_HIGH>; /* PI3 */
	status = "okay";
};

&codec_plat {
	status = "okay";
};

&codec_mach {
	status = "okay";
};

/* third reg: the EHCI2 PMU block, whose SIDDQ phy0 needs cleared (0024) */
&udc {
	reg = <0x0 0x05100000 0x0 0x1000>,
	      <0x0 0x00000000 0x0 0x100>,
	      <0x0 0x05310800 0x0 0x100>;
	clocks = <&ccu CLK_BUS_OTG>, <&ccu CLK_USB_PHY0>, <&ccu CLK_USB_PHY2>, <&ccu CLK_BUS_EHCI2>;
	clock-names = "bus_otg", "phy", "phy2", "bus_ehci2";
	resets = <&ccu RST_BUS_OTG>, <&ccu RST_USB_PHY0>, <&ccu RST_USB_PHY2>, <&ccu RST_BUS_EHCI2>;
	reset-names = "otg", "phy", "phy2", "ehci2";
	det_vbus_supply = <&v_usb_power_supply>;
	status = "okay";
};

&ehci0 {
	drvvbus-supply = <&v_drivevbus>;
	status = "okay";
};

&ohci0 {
	drvvbus-supply = <&v_drivevbus>;
	status = "okay";
};

/* first boot: every panel, switched at runtime through
 * /sys/class/disp/disp/attr/lcd_panel (see h700-panels.conf) */
/ {
	panel-rg35xx-plus-old {
		compatible = "knulli,panel-rg35xx-plus-old";
		lcd_used = <0x01>;
		lcd_driver_name = "fog_fj035fhd05_v1";
		lcd_backlight = <0x32>;
		lcd_if = <0x00>;
		lcd_hv_if = <0x00>;
		lcd_x = <0x280>;
		lcd_y = <0x1e0>;
		lcd_width = <0x96>;
		lcd_height = <0x5e>;
		lcd_dclk_freq = <0x18>;
		lcd_pwm_used = <0x01>;
		lcd_pwm_ch = <0x00>;
		lcd_pwm_freq = <0xc350>;
		lcd_pwm_pol = <0x01>;
		lcd_pwm_max_limit = <0xff>;
		lcd_hbp = <0x2e>;
		lcd_ht = <0x302>;
		lcd_hspw = <0x14>;
		lcd_vbp = <0x0f>;
		lcd_vt = <0x208>;
		lcd_vspw = <0x04>;
		lcd_lvds_if = <0x00>;
		lcd_lvds_colordepth = <0x00>;
		lcd_lvds_mode = <0x00>;
		lcd_frm = <0x01>;
		lcd_hv_clk_phase = <0x02>;
		lcd_hv_sync_polarity = <0x03>;
		lcd_gamma_en = <0x00>;
		lcd_bright_curve_en = <0x00>;
		lcd_cmap_en = <0x00>;
		deu_mode = <0x00>;
		lcdgamma4iep = <0x16>;
		smart_color = <0x5a>;
		lcd_pin_power;
		lcd_power;
		lcd_bl_en;
		lcd_gpio_0 = <&pio 0x08 0x09 0x01 0xffffffff 0xffffffff 0x01>;
		lcd_gpio_1 = <&pio 0x08 0x0a 0x01 0xffffffff 0xffffffff 0x01>;
		lcd_gpio_2 = <&pio 0x08 0x08 0x01 0xffffffff 0xffffffff 0x01>;
		lcd_gpio_3 = <&pio 0x08 0x0e 0x01 0xffffffff 0xffffffff 0x01>;
		lcd_gpio_4 = <&pio 0x08 0x0f 0x01 0xffffffff 0xffffffff 0x01>;
		lcd_panel_init = "rg35xx-plus-old";
	};

	panel-rg35xx-plus-boe {
		compatible = "knulli,panel-rg35xx-plus-boe";
		lcd_used = <0x01>;
		lcd_driver_name = "fog_fj035fhd05_v1";
		lcd_backlight = <0x32>;
		lcd_if = <0x00>;
		lcd_hv_if = <0x00>;
		lcd_x = <0x280>;
		lcd_y = <0x1e0>;
		lcd_width = <0x96>;
		lcd_height = <0x5e>;
		lcd_dclk_freq = <0x18>;
		lcd_pwm_used = <0x01>;
		lcd_pwm_ch = <0x00>;
		lcd_pwm_freq = <0xc350>;
		lcd_pwm_pol = <0x01>;
		lcd_pwm_max_limit = <0xff>;
		lcd_hbp = <0x2e>;
		lcd_ht = <0x302>;
		lcd_hspw = <0x14>;
		lcd_vbp = <0x0f>;
		lcd_vt = <0x208>;
		lcd_vspw = <0x04>;
		lcd_lvds_if = <0x00>;
		lcd_lvds_colordepth = <0x00>;
		lcd_lvds_mode = <0x00>;
		lcd_frm = <0x01>;
		lcd_hv_clk_phase = <0x02>;
		lcd_hv_sync_polarity = <0x03>;
		lcd_gamma_en = <0x00>;
		lcd_bright_curve_en = <0x00>;
		lcd_cmap_en = <0x00>;
		deu_mode = <0x00>;
		lcdgamma4iep = <0x16>;
		smart_color = <0x5a>;
		lcd_pin_power;
		lcd_power;
		lcd_bl_en;
		lcd_gpio_0 = <&pio 0x08 0x09 0x01 0xffffffff 0xffffffff 0x01>;
		lcd_gpio_1 = <&pio 0x08 0x0a 0x01 0xffffffff 0xffffffff 0x01>;
		lcd_gpio_2 = <&pio 0x08 0x08 0x01 0xffffffff 0xffffffff 0x01>;
		lcd_gpio_3 = <&pio 0x08 0x0e 0x01 0xffffffff 0xffffffff 0x01>;
		lcd_gpio_4 = <&pio 0x08 0x0f 0x01 0xffffffff 0xffffffff 0x01>;
		lcd_panel_init = "rg35xx-plus-boe";
	};

	panel-rg35xx-h-old {
		compatible = "knulli,panel-rg35xx-h-old";
		lcd_used = <0x01>;
		lcd_driver_name = "fog_fj035fhd05_v1";
		lcd_backlight = <0x32>;
		lcd_if = <0x00>;
		lcd_hv_if = <0x00>;
		lcd_x = <0x280>;
		lcd_y = <0x1e0>;
		lcd_width = <0x96>;
		lcd_height = <0x5e>;
		lcd_dclk_freq = <0x18>;
		lcd_pwm_used = <0x01>;
		lcd_pwm_ch = <0x00>;
		lcd_pwm_freq = <0xc350>;
		lcd_pwm_pol = <0x01>;
		lcd_pwm_max_limit = <0xff>;
		lcd_hbp = <0x2e>;
		lcd_ht = <0x302>;
		lcd_hspw = <0x14>;
		lcd_vbp = <0x0f>;
		lcd_vt = <0x208>;
		lcd_vspw = <0x04>;
		lcd_lvds_if = <0x00>;
		lcd_lvds_colordepth = <0x00>;
		lcd_lvds_mode = <0x00>;
		lcd_frm = <0x01>;
		lcd_hv_clk_phase = <0x02>;
		lcd_hv_sync_polarity = <0x03>;
		lcd_gamma_en = <0x00>;
		lcd_bright_curve_en = <0x00>;
		lcd_cmap_en = <0x00>;
		deu_mode = <0x00>;
		lcdgamma4iep = <0x16>;
		smart_color = <0x5a>;
		lcd_pin_power;
		lcd_power;
		lcd_bl_en;
		lcd_gpio_0 = <&pio 0x08 0x09 0x01 0xffffffff 0xffffffff 0x01>;
		lcd_gpio_1 = <&pio 0x08 0x0a 0x01 0xffffffff 0xffffffff 0x01>;
		lcd_gpio_2 = <&pio 0x08 0x08 0x01 0xffffffff 0xffffffff 0x01>;
		lcd_gpio_3 = <&pio 0x08 0x0e 0x01 0xffffffff 0xffffffff 0x01>;
		lcd_gpio_4 = <&pio 0x08 0x0f 0x01 0xffffffff 0xffffffff 0x01>;
		lcd_panel_init = "rg35xx-h-old";
	};

	panel-rg35xx-h-boe {
		compatible = "knulli,panel-rg35xx-h-boe";
		lcd_used = <0x01>;
		lcd_driver_name = "fog_fj035fhd05_v1";
		lcd_backlight = <0x32>;
		lcd_if = <0x00>;
		lcd_hv_if = <0x00>;
		lcd_x = <0x280>;
		lcd_y = <0x1e0>;
		lcd_width = <0x96>;
		lcd_height = <0x5e>;
		lcd_dclk_freq = <0x18>;
		lcd_pwm_used = <0x01>;
		lcd_pwm_ch = <0x00>;
		lcd_pwm_freq = <0xc350>;
		lcd_pwm_pol = <0x01>;
		lcd_pwm_max_limit = <0xff>;
		lcd_hbp = <0x2e>;
		lcd_ht = <0x302>;
		lcd_hspw = <0x14>;
		lcd_vbp = <0x0f>;
