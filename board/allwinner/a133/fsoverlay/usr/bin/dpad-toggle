#!/bin/bash

# We only want to run the script if the board has no analog stick capability
if knulli-board-capability "analogstick"; then
    exit 1
fi

LOCK_FILE="/var/run/dpad-toggle-script.lock"

exec 200>"${LOCK_FILE}"
if ! flock -n 200; then
    exit 0
fi

trap 'flock -u 200;' EXIT

DPAD_BUTTON_STATE="/var/run/dpad-toggle.held"

# Threshold for long press to toggle d-pad (in seconds)
LONG_PRESS_THRESHOLD=2

BOARD_FILE="/boot/boot/knulli.board"
read -r BOARD < "$BOARD_FILE" 2>/dev/null

check_ingame() {
    HTTP_STATUS=$(curl -s -o /dev/null -w "%{http_code}" "http://localhost:1234/runningGame")
    test $? != 0                 && return 0
    test "${HTTP_STATUS}" != 201 && return 0 # in game
    return 1  # 201 when not in game
}

do_notification() {
    NOTIFICATION=$1
    curl -s http://localhost:1234/notify -d "$NOTIFICATION" >/dev/null
}

announce_state() {
    case "$1" in
      on)
        knulli-rumble 0.1

        if ! check_ingame; then
            do_notification "Virtual Joystick ON"
        fi
        ;;
      off)
        knulli-rumble 0.1
        sleep 0.2
        knulli-rumble 0.1

        if ! check_ingame; then
            do_notification "Virtual Joystick OFF"
        fi
        ;;
    esac
}

toggle_dpad() {
    case "$BOARD" in
      trimui-smart-pro|trimui-brick)
        DPAD_DIR="/tmp/trimui_inputd"
        DPAD_DISABLED_FILE="$DPAD_DIR/input_no_dpad"
        DPAD_AS_ANALOG_FILE="$DPAD_DIR/input_dpad_to_joystick"
        mkdir -p "$DPAD_DIR"

        if [ ! -f "$DPAD_AS_ANALOG_FILE" ]; then
            touch "$DPAD_DISABLED_FILE"
            touch "$DPAD_AS_ANALOG_FILE"
            announce_state "on"
        else
            rm "$DPAD_DISABLED_FILE"
            rm "$DPAD_AS_ANALOG_FILE"
            announce_state "off"
        fi
        ;;

      powkiddy-v90s|powkiddy-v20)
        STATE_FILE="/sys/devices/platform/adc_joystick/dpad_conv"
        IFS= read -r STATE < "$STATE_FILE" 2>/dev/null

        if [ "$STATE" -eq 0 ]; then
            echo 1 > "$STATE_FILE"
            announce_state "on"
        else
            echo 0 > "$STATE_FILE"
            announce_state "off"
        fi
        ;;
    esac
}

# Set starting state
: > "$DPAD_BUTTON_STATE"

# Wait for deletion of state file
if inotifywait -qq -t "$LONG_PRESS_THRESHOLD" -e delete_self "$DPAD_BUTTON_STATE"; then
    # Buttons released within timeout (short press) - do nothing
    :
else
    # Toggle if timeout is reached (long press)
    if [ -f "$DPAD_BUTTON_STATE" ]; then
        toggle_dpad
    fi
fi

exit 0
