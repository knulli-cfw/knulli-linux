Subject: [PATCH] net: wireless: xr829: build against mainline 5.15 cfg80211

The driver keys Android GKI backports (link_id, MLO station params,
assoc_failure, ch_switch arguments) on 5.15.x versions; a plain 5.15
kernel has none of them.  Gate those on 6.1 instead.
---
--- a/bsp/drivers/net/wireless/xr829/umac/cfg.c
+++ b/bsp/drivers/net/wireless/xr829/umac/cfg.c
@@ -383,7 +383,7 @@
 }
 
 static int ieee80211_add_key(struct wiphy *wiphy, struct net_device *dev,
-#if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 15, 41)
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 1, 0)
 			     int link_id,
 #endif
 			     u8 key_idx, bool pairwise, const u8 *mac_addr,
@@ -502,7 +502,7 @@
 }
 
 static int ieee80211_del_key(struct wiphy *wiphy, struct net_device *dev,
-#if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 15, 41)
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 1, 0)
 			     int link_id,
 #endif
 			     u8 key_idx, bool pairwise, const u8 *mac_addr)
@@ -546,7 +546,7 @@
 }
 
 static int ieee80211_get_key(struct wiphy *wiphy, struct net_device *dev,
-#if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 15, 41)
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 1, 0)
 			     int link_id,
 #endif
 			     u8 key_idx, bool pairwise, const u8 *mac_addr,
@@ -668,7 +668,7 @@
 
 static int ieee80211_config_default_key(struct wiphy *wiphy,
 					struct net_device *dev,
-#if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 15, 41)
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 1, 0)
 					int link_id,
 #endif
 					u8 key_idx, bool uni,
@@ -683,7 +683,7 @@
 
 static int ieee80211_config_default_mgmt_key(struct wiphy *wiphy,
 					     struct net_device *dev,
-#if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 15, 41)
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 1, 0)
 					     int link_id,
 #endif
 					     u8 key_idx)
@@ -1283,7 +1283,7 @@
 	return 0;
 }
 
-#if (LINUX_VERSION_CODE >= KERNEL_VERSION(5, 15, 0))
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(6, 1, 0))
 static int ieee80211_stop_ap(struct wiphy *wiphy, struct net_device *dev, unsigned int link_id)
 #else
 static int ieee80211_stop_ap(struct wiphy *wiphy, struct net_device *dev)
@@ -1504,7 +1504,7 @@
 	struct ieee80211_supported_band *sband;
 	struct ieee80211_sub_if_data *sdata = sta->sdata;
 	u32 mask, set;
-#if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 15, 41)
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 1, 0)
 	struct link_station_parameters *link_sta_params = &params->link_sta_params;
 #else
 	struct station_parameters *link_sta_params = params;
@@ -1641,7 +1641,7 @@
 	if (params->listen_interval >= 0)
 		sta->listen_interval = params->listen_interval;
 
-#if LINUX_VERSION_CODE < KERNEL_VERSION(5, 15, 41)
+#if LINUX_VERSION_CODE < KERNEL_VERSION(6, 1, 0)
