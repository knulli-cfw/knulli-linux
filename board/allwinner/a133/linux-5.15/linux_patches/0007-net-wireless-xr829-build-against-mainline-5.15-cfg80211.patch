@@ -1420,15 +1420,15 @@
 					  IEEE80211_QUEUE_STOP_REASON_CSA);
 	mutex_unlock(&local->mtx);
 
-#if (LINUX_VERSION_CODE >= KERNEL_VERSION(5, 15, 94))
