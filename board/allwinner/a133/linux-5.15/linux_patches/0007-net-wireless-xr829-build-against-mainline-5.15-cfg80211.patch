 	struct cfg80211_rx_assoc_resp resp = {
 		.uapsd_queues = -1,
 	};
@@ -3703,7 +3703,7 @@
 	} else {
 		if (!ieee80211_assoc_success(sdata, bss, mgmt, len)) {
