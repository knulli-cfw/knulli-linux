 			struct cfg80211_assoc_failure data = {
 				.bss[0] = assoc_data->bss,
 			};
@@ -3635,7 +3635,7 @@
 		.type = MLME_EVENT,
 		.u.mlme.data = ASSOC_EVENT,
 	};
-#if (LINUX_VERSION_CODE >= KERNEL_VERSION(5, 15, 78))
