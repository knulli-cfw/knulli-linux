 					  csa_ie.count, 0);
 #else
 	cfg80211_ch_switch_started_notify(sdata->dev, &csa_ie.chandef,
-					  csa_ie.count);
+					  csa_ie.count, false);
 #endif
 
 	if (local->ops->channel_switch) {
@@ -2906,7 +2906,7 @@
 		mutex_unlock(&sdata->local->mtx);
 
