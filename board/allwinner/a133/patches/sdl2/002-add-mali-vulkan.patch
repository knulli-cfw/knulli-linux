+    device->Vulkan_GetInstanceExtensions = MALI_Vulkan_GetInstanceExtensions;
+    device->Vulkan_GetDrawableSize = MALI_Vulkan_GetDrawableSize;
+    device->Vulkan_CreateSurface = MALI_Vulkan_CreateSurface;
+#endif
+
     device->PumpEvents = MALI_PumpEvents;
 
     return device;
@@ -221,25 +230,32 @@
     window->w = fb_width;
     window->h = fb_height;
 
-    /* OpenGL ES is the law here */
