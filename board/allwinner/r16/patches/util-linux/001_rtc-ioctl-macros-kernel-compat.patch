+/* Older kernel headers (e.g. 3.4) don't define RTC_VL_* but it's safe
+ * to use the modern ioctl numbers - the kernel will just return ENOTTY
+ * if it doesn't support them.
+ */
+#ifndef RTC_VL_READ
+# define RTC_VL_READ _IOR('p', 0x13, unsigned int)
+#endif
+#ifndef RTC_VL_CLR
+# define RTC_VL_CLR  _IO('p', 0x14)
+#endif
 #include <errno.h>
 #include <fcntl.h>
